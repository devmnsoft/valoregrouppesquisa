@model Valora.Application.ActionCenter.CreateActionPlanRequest@{ViewData["Title"]="Criar plano";}<main class="valora-page"><header class="leadership-hero"><div><p class="eyebrow">Valora Action™</p><h1>Novo plano de ação</h1><p>Registre a origem, a evidência e o resultado esperado.</p></div></header><form method="post" class="valora-card"><div asp-validation-summary="All"></div><label>Título<input asp-for="Title" required /></label><label>Resumo<textarea asp-for="Summary" required></textarea></label><div class="form-grid"><label>Origem<select asp-for="OriginType"><option value="manual">Manual</option><option value="diagnostic">Diagnóstico</option><option value="result">Resultado</option></select></label><label>Prioridade<select asp-for="Priority"><option value="medium">Média</option><option value="critical">Crítica</option><option value="high">Alta</option><option value="low">Baixa</option></select></label><label>Prazo<input asp-for="DueAt" type="date" /></label></div><label>Evidência que sustenta o plano<textarea asp-for="EvidenceSummary" required></textarea></label><label>Resultado esperado<textarea asp-for="ExpectedOutcome" required></textarea></label><button class="btn btn-primary">Salvar como rascunho</button></form></main>
