@{ ViewData["Title"]="Workspace do Diagnóstico"; var diagnosticId=(Guid)ViewData["DiagnosticId"]!; }
<main class="valora-page intelligence-workspace" data-page="diagnostic-workspace" data-diagnostic-id="@diagnosticId">
@Html.AntiForgeryToken()
<nav><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Surveys">Diagnósticos</a></li><li class="breadcrumb-item active">Workspace</li></ol></nav>
<section class="workspace-hero"><div><span class="eyebrow">Ciclo diagnóstico</span><h1 data-title>Workspace do Diagnóstico</h1><p data-description>Carregando o contexto do ciclo…</p><span class="valora-status" data-status>—</span> <span class="valora-status" data-confidence>Confiança —</span></div><div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" data-command="process">Processar Inteligência Valora™</button><button class="btn btn-outline-secondary" data-command="report/preview">Gerar Executive Report™</button><button class="btn btn-outline-danger" data-command="close">Encerrar Ciclo</button></div></section>
<div class="alert alert-danger d-none" data-error></div><div class="alert alert-info d-none" data-message></div>
<section class="metric-grid"><article class="metric-card"><span>Respostas</span><strong data-value="responses">—</strong><small>participações concluídas</small></article><article class="metric-card"><span>Evidências</span><strong data-value="evidence">—</strong><small>itens rastreáveis</small></article><article class="metric-card"><span>Cobertura</span><strong data-value="coverage">—</strong><small>mapeamento metodológico</small></article><article class="metric-card"><span>Processamento</span><strong data-value="processing">—</strong><small>último job do ciclo</small></article></section>
<div class="progress my-3"><div class="progress-bar" data-progress style="width:0%"></div></div>
<nav class="workspace-tabs" data-tabs>@foreach(var tab in new[]{("overview","Visão Geral"),("participation","Participação"),("responses","Respostas"),("evidence","Evidências"),("metrics","Metrics™"),("indices","Índices"),("inferences","Inferências"),("insights","Insights IA™"),("actions","Action™"),("heatmap","Heatmap™"),("radar","Radar™"),("evolution","Evolution™"),("journey","Journey™"),("benchmark","Benchmark™"),("report","Executive Report™"),("governance","Governança")}){<button type="button" class="btn btn-sm btn-outline-secondary" data-tab="@tab.Item1">@tab.Item2</button>}</nav>
<section class="workspace-section mt-3" aria-live="polite"><div class="survey-skeleton" data-loading><span></span><span></span><span></span></div><div data-content></div></section>
</main>
@section Scripts{<script src="/js/pages/diagnostic-workspace.js"></script>}
