@{ ViewData["Title"] = "Campanhas"; }
<main class="v9-page" data-page="campaigns-v9">
  <header class="v9-hero"><div><p class="eyebrow">Distribuição e adesão</p><h1>Campanhas de pesquisa</h1><p>Publique, compartilhe e acompanhe cada ciclo em um só lugar.</p></div><button class="valora-button valora-button--primary" data-new-campaign>Nova campanha</button></header>
  <section class="v9-kpis"><article><span>Campanhas</span><strong data-campaign-kpi="total">—</strong></article><article><span>Ativas</span><strong data-campaign-kpi="active">—</strong></article><article><span>Respostas</span><strong data-campaign-kpi="responses">—</strong></article><article><span>Adesão estimada</span><strong data-campaign-kpi="rate">—</strong></article></section>
  <section class="valora-card"><div class="v9-section-title"><div><p class="eyebrow">Operação</p><h2>Acompanhamento</h2></div><button class="valora-button valora-button--ghost" data-refresh>Atualizar</button></div><div class="v9-campaign-list" data-campaigns></div></section>
  <dialog class="v9-dialog" data-campaign-dialog><button class="v9-dialog__close" data-close aria-label="Fechar">×</button><form class="valora-form" data-campaign-form><p class="eyebrow">Novo ciclo</p><h2>Criar campanha</h2><label>Pesquisa publicada<select name="surveyId" required data-survey-options><option value="">Selecione uma pesquisa publicada</option></select></label><label>Nome da campanha<input name="name" required maxlength="120"></label><label>Mensagem<textarea name="message" rows="3" required maxlength="2000"></textarea></label><div class="v9-form-grid"><label>Canal<select name="channel"><option value="manual">Link manual</option><option value="email">E-mail</option></select></label><label>Assunto do e-mail<input name="subject" maxlength="180"></label><label>Início<input name="startsAt" type="datetime-local"></label><label>Encerramento<input name="endsAt" type="datetime-local"></label><label>Meta de participação (%)<input name="targetParticipationRate" type="number" min="0" max="100" step="0.1"></label><label>Público-alvo<input name="audience" maxlength="240"></label></div><label>Destinatários (um e-mail por linha)<textarea name="recipients" rows="5" autocomplete="off"></textarea></label><label><input name="hasConsent" type="checkbox"> Confirmo consentimento dos destinatários</label><label><input name="hasLegalBasis" type="checkbox"> Confirmo base legal para o envio</label><button class="valora-button valora-button--primary" type="submit">Salvar rascunho</button></form></dialog>
  <dialog class="v9-dialog v9-dialog--compact" data-share-dialog><button class="v9-dialog__close" data-close aria-label="Fechar">×</button><div data-share-body></div></dialog>
  <div class="valora-alert valora-alert--danger" data-error hidden></div>
</main>
@section Scripts { <script src="/js/pages/experience-v9.js"></script> }
