@model Valora.Web.Models.ViewModels.CommunicationsIndexViewModel
@{
    ViewData["Title"] = "Central de Comunicações";
}

<div class="container-fluid py-4" data-module="Communications">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Início</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Central de Comunicações</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold text-dark mb-1">Central de Comunicações & Entregas</h1>
            <p class="text-muted mb-0">Monitoramento da fila de e-mails, templates transacionais, entregabilidade e reprocessamento com proteção LGPD.</p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.Status.DevelopmentOutbox)
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning d-flex align-items-center px-3">
                    <i class="bi bi-shield-lock me-1"></i> Modo Outbox Seguro
                </span>
            }
            <button type="button" class="btn btn-primary" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise me-1"></i> Atualizar
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <!-- Métricas Executivas -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary me-3">
                        <i class="bi bi-send-check fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium d-block">Total de Disparos</span>
                        <strong class="fs-4 text-dark">@Model.TotalDispatches</strong>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success me-3">
                        <i class="bi bi-check2-circle fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium d-block">Entregues com Sucesso</span>
                        <strong class="fs-4 text-dark">@Model.Status.Sent</strong>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning me-3">
                        <i class="bi bi-hourglass-split fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium d-block">Na Fila / Processando</span>
                        <strong class="fs-4 text-dark">@Model.InQueueCount</strong>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger me-3">
                        <i class="bi bi-exclamation-triangle fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium d-block">Falhas / Quarentena</span>
                        <strong class="fs-4 text-dark">@Model.IssuesCount</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navegação por Abas -->
    <ul class="nav nav-pills mb-4" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="pills-jobs-tab" data-bs-toggle="pill" data-bs-target="#pills-jobs" type="button" role="tab" aria-controls="pills-jobs" aria-selected="true">
                <i class="bi bi-envelope-paper me-1"></i> Fila de Disparos (@Model.Jobs.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pills-templates-tab" data-bs-toggle="pill" data-bs-target="#pills-templates" type="button" role="tab" aria-controls="pills-templates" aria-selected="false">
                <i class="bi bi-file-earmark-richtext me-1"></i> Modelos Transacionais (@Model.Templates.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pills-security-tab" data-bs-toggle="pill" data-bs-target="#pills-security" type="button" role="tab" aria-controls="pills-security" aria-selected="false">
                <i class="bi bi-shield-check me-1"></i> Políticas & Governança
            </button>
        </li>
    </ul>

    <div class="tab-content" id="pills-tabContent">
        <!-- Aba 1: Fila de Disparos -->
        <div class="tab-pane fade show active" id="pills-jobs" role="tabpanel" aria-labelledby="pills-jobs-tab" tabindex="0">
            <!-- Barra de Filtros -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <form method="get" action="/Communications" class="row g-2 align-items-end">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-muted mb-1" for="commSearch">Pesquisa Textual</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" id="commSearch" name="search" value="@Model.Search" placeholder="Assunto, destinatário ou template..." />
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label small fw-semibold text-muted mb-1" for="commStatus">Status do Envio</label>
                            <select class="form-select form-select-sm" id="commStatus" name="status">
                                <option value="">Todos os status</option>
                                <option value="sent" selected="@(Model.StatusFilter == "sent")">Entregue</option>
                                <option value="queued" selected="@(Model.StatusFilter == "queued")">Na fila</option>
                                <option value="processing" selected="@(Model.StatusFilter == "processing")">Processando</option>
                                <option value="failed" selected="@(Model.StatusFilter == "failed")">Falha temporária</option>
                                <option value="dead_letter" selected="@(Model.StatusFilter == "dead_letter")">Quarentena (Dead Letter)</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                                <i class="bi bi-funnel me-1"></i> Filtrar
                            </button>
                            @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.StatusFilter))
                            {
                                <a href="/Communications" class="btn btn-sm btn-outline-secondary" title="Limpar filtros">
                                    <i class="bi bi-x-lg"></i>
                                </a>
                            }
                        </div>
                    </form>
                </div>
            </div>

            <!-- Tabela de Jobs -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0 fw-bold text-dark">Disparos Registrados (@Model.Jobs.Count)</h2>
                    <span class="badge bg-secondary-subtle text-secondary">Rastreabilidade Total</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.Jobs.Count == 0)
                    {
                        <div class="text-center py-5">
                            <div class="text-muted mb-3"><i class="bi bi-mailbox fs-1"></i></div>
                            <h3 class="h5 text-secondary">Nenhum envio registrado na fila</h3>
                            <p class="text-muted small mb-0">Disparos de convites para diagnósticos, resultados e certificados aparecerão automaticamente aqui.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" class="ps-3">Assunto da Mensagem</th>
                                        <th scope="col">Destinatário (Protegido)</th>
                                        <th scope="col">Tipo / Template</th>
                                        <th scope="col">Criado em</th>
                                        <th scope="col">Status</th>
                                        <th scope="col">Tentativas</th>
                                        <th scope="col" class="text-end pe-3">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var job in Model.Jobs)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-envelope text-primary fs-5"></i>
                                                    <div>
                                                        <strong class="d-block text-dark">@job.Subject</strong>
                                                        <span class="text-muted small font-monospace">Job #@job.Id.ToString()[..8]</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="font-monospace small text-dark">@job.ToEmailMasked</span>
                                            </td>
                                            <td>
                                                <span class="badge text-bg-light border text-capitalize">@job.TemplateCode</span>
                                            </td>
                                            <td class="text-nowrap small text-muted">
                                                @job.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </td>
                                            <td>
                                                <span class="badge @CommunicationsIndexViewModel.FormatStatusBadge(job.Status)">
                                                    @CommunicationsIndexViewModel.FormatStatusLabel(job.Status)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="small text-muted">@job.Attempts tent.</span>
                                            </td>
                                            <td class="text-end pe-3">
                                                @if (job.Status == "failed" || job.Status == "dead_letter")
                                                {
                                                    <form method="post" action="/Communications/Retry/@job.Id" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Reenfileirar disparo">
                                                            <i class="bi bi-arrow-repeat me-1"></i> Reenviar
                                                        </button>
                                                    </form>
                                                }
                                                else if (job.Status == "sent")
                                                {
                                                    <span class="small text-success"><i class="bi bi-check-all fs-5"></i></span>
                                                }
                                                else
                                                {
                                                    <span class="small text-muted"><i class="spinner-border spinner-border-sm me-1"></i> Em fila</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Aba 2: Modelos Transacionais -->
        <div class="tab-pane fade" id="pills-templates" role="tabpanel" aria-labelledby="pills-templates-tab" tabindex="0">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0 fw-bold text-dark">Modelos de E-mail Padronizados (@Model.Templates.Count)</h2>
                    <span class="badge bg-light text-dark border">Identidade Corporativa Valora</span>
                </div>
                <div class="card-body p-4">
                    @if (Model.Templates.Count == 0)
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-file-earmark-code fs-1 mb-2 d-block"></i>
                            <h3 class="h6">Nenhum template cadastrado</h3>
                            <p class="small mb-0">Os modelos oficiais do sistema são carregados automaticamente.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var t in Model.Templates)
                            {
                                <div class="col-md-6 col-xl-4">
                                    <div class="border rounded-3 p-3 bg-light bg-opacity-25 h-100 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <span class="badge text-bg-primary text-uppercase font-monospace" style="font-size: 0.7rem;">@t.Code</span>
                                            <span class="badge @(t.Status == "active" ? "text-bg-success" : "text-bg-secondary")">@t.Status</span>
                                        </div>
                                        <h3 class="h6 fw-bold text-dark mb-1">@t.Name</h3>
                                        <p class="text-muted small mb-3">Assunto: <em>@t.Subject</em></p>
                                        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center small text-muted">
                                            <span>Formato: HTML + Texto</span>
                                            <span class="text-success"><i class="bi bi-shield-check me-1"></i>Sanitizado</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Aba 3: Políticas & Governança -->
        <div class="tab-pane fade" id="pills-security" role="tabpanel" aria-labelledby="pills-security-tab" tabindex="0">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h2 class="h5 mb-0 fw-bold text-dark">Diretrizes de Entregabilidade e Proteção LGPD</h2>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 bg-light bg-opacity-25 h-100">
                                <h3 class="h6 fw-bold text-dark mb-2">
                                    <i class="bi bi-shield-lock text-primary me-2"></i>Privacidade e Mascaramento LGPD
                                </h3>
                                <p class="small text-muted mb-2">
                                    Os endereços de e-mail dos respondentes e colaboradores são mascarados na interface (ex.: <code>j***@@empresa.com</code>) para evitar vazamento inadvertido de dados pessoais por telas compartilhadas.
                                </p>
                                <p class="small text-muted mb-0">
                                    Nenhum segredo de conexão SMTP ou credencial de envio é exposto via API ou views públicas.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 bg-light bg-opacity-25 h-100">
                                <h3 class="h6 fw-bold text-dark mb-2">
                                    <i class="bi bi-arrow-repeat text-success me-2"></i>Política de Retentativas e Quarentena
                                </h3>
                                <p class="small text-muted mb-2">
                                    Disparos que enfrentam instabilidade temporária no servidor destinatário sofrem até 3 tentativas com backoff exponencial antes de serem movidos para quarentena (*Dead Letter*).
                                </p>
                                <p class="small text-muted mb-0">
                                    Administradores podem reenfileirar manualmente mensagens retidas após regularização da infraestrutura.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
