ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=valoradb;Username=valora;Password=valora_dev_123;Pooling=true;Maximum Pool Size=50;Timeout=30;Command Timeout=60;Application Name=ValoraInsight
Jwt__Issuer=ValoraInsight
Jwt__Audience=ValoraInsight
# Somente desenvolvimento. Gere um valor exclusivo e seguro para cada ambiente compartilhado.
Jwt__Secret=dev-only-change-this-jwt-secret-32chars
Jwt__AccessTokenMinutes=15
Jwt__ClockSkewSeconds=30
Email__Enabled=false
Email__FromName=Valora Group
Email__FromEmail=valoragroup@mnsoft.com.br
# Opt-in explícito. Os scripts recusam o seed fora de Development.
VALORA_SEED_DEMO=false
# URL interna usada pelo BFF Web para acessar a API.
Api__BaseUrl=http://localhost:5080
# Identificação segura de build exibida em Saúde do Sistema (sem secrets).
Build__Sha=local
# SMTP é opcional em desenvolvimento; mantenha desabilitado quando não configurado.
Email__Smtp__Host=
Email__Smtp__Username=
Email__Smtp__Password=
VALORA_BACKUP_DIR=
