@model Valora.Web.Models.ViewModels.CreateOrganizationViewModel
@{ ViewData["Title"]="Criar organização"; }
<section class="valora-page"><partial name="_PageHeader" model="@(new Valora.Web.Models.PageHeaderViewModel("Criar organização", "Configure identidade, plano e limites iniciais.", "Admin Hub"))" /><form method="post" class="admin-panel"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Name">Nome</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Slug">Identificador público</label><input asp-for="Slug" class="form-control"/><span asp-validation-for="Slug" class="text-danger"></span></div><div class="col-md-6"><label asp-for="PlanCode">Plano</label><select asp-for="PlanCode" asp-items="Model.Plans" class="form-select"><option value="">Selecione…</option></select><span asp-validation-for="PlanCode" class="text-danger"></span></div><div class="col-md-6"><label asp-for="UserLimit">Limite de usuários</label><input asp-for="UserLimit" class="form-control"/><span asp-validation-for="UserLimit" class="text-danger"></span></div></div><button class="btn btn-primary mt-4">Criar organização</button></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
