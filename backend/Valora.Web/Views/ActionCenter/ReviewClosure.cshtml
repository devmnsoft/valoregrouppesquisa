@model Valora.Web.Controllers.ActionPlanClosurePageViewModel
@using Valora.Application.ActionCenter
@{ ViewData["Title"] = "Revisar encerramento"; }
<main class="valora-page action-detail">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel("Revisar encerramento", Model.Plan.Title, "Valora Action™", ActionStatuses.Label(Model.Plan.Status), new[] { new PageHeaderAction("Voltar ao plano", Model.ReturnUrl, Icon: "arrow-left") }))" />
  <div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1"></div>
  <section class="action-summary-grid">
    <article class="valora-card"><h2>Plano</h2><dl class="action-facts"><div><dt>Responsável</dt><dd>@(Model.Plan.OwnerName??"Sem responsável")</dd></div><div><dt>Prazo</dt><dd>@(Model.Plan.DueAt?.ToString("dd/MM/yyyy")??"A definir")</dd></div><div><dt>Resultado esperado</dt><dd>@Model.Plan.ExpectedOutcome</dd></div><div><dt>Atividades</dt><dd>@Model.Readiness.TotalActivities</dd></div></dl></article>
    <article class="valora-card"><h2>Verificação final</h2><dl class="action-facts"><div><dt>Abertas</dt><dd>@Model.Readiness.OpenActivities</dd></div><div><dt>Bloqueadas</dt><dd>@Model.Readiness.BlockedActivities</dd></div><div><dt>Concluídas</dt><dd>@Model.Readiness.CompletedActivities</dd></div></dl>@if(Model.Readiness.Pending.Count>0){<div class="lifecycle-pending"><h3>Impedimentos</h3><ul>@foreach(var item in Model.Readiness.Pending){<li>@item</li>}</ul><a href="@(Model.ReturnUrl)#atividades">Abrir correções no plano</a></div>}</article>
  </section>
  <section class="valora-card"><h2>Atividades visíveis</h2><div class="table-responsive"><table class="valora-table"><thead><tr><th>Atividade</th><th>Situação</th><th>Responsável</th></tr></thead><tbody>@foreach(var item in Model.Activities.Items){<tr><td>@item.Title</td><td>@ActionStatuses.Label(item.Status)</td><td>@(item.ResponsibleName??"Sem responsável")</td></tr>}</tbody></table></div></section>
  <section class="valora-card"><h2>Confirmação</h2><form method="post" action="/ActionCenter/Plans/@Model.Plan.Id/Complete">@Html.AntiForgeryToken()<input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl"><input type="hidden" name="Version" value="@Model.Command.Version"><input type="hidden" name="CommandId" value="@Model.Command.CommandId"><label>Resultado alcançado *<textarea name="Result" minlength="10" maxlength="2000" required>@Model.Command.Result</textarea></label><label>Evidência de conclusão *<textarea name="Evidence" minlength="3" maxlength="2000" required>@Model.Command.Evidence</textarea></label><label><input type="checkbox" required> Confirmo que revisei o resultado e as evidências.</label><div class="dialog-actions"><a class="valora-button" href="@Model.ReturnUrl">Voltar sem concluir</a><button class="valora-button valora-button--primary" disabled="@(!Model.Readiness.CanComplete)">Concluir plano</button></div></form></section>
</main>
