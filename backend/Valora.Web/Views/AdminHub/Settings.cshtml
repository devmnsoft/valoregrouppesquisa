@model Valora.Web.Models.ViewModels.AdminSettingsFormModel
@{ ViewData["Title"] = "Configurações"; }
<section class="valora-page">
    <partial name="_PageHeader" model="@(new Valora.Web.Models.PageHeaderViewModel("Configurações", Model.OrganizationName is "" ? "Preferências administrativas, plano e uso." : $"Preferências da organização {Model.OrganizationName}.", "Admin Hub"))" />
    @if (TempData["AdminNotice"] is string adminNotice) { <div class="alert alert-success">@adminNotice</div> }
    @if (Model.Error is not null) { <div class="alert alert-danger" role="alert"><strong>@Model.Error</strong></div> }
    <div class="admin-metrics">
        <article class="admin-metric"><span>Organização</span><strong>@(Model.OrganizationName == "" ? "—" : Model.OrganizationName)</strong><small>Contexto autenticado</small></article>
        <article class="admin-metric"><span>Plano atual</span><strong>@Model.Plan</strong><small>Consulta em tempo real</small></article>
    </div>
    @if (Model.Usage.Count > 0) {
        <article class="admin-panel mt-3">
            <h2>Uso dos recursos</h2>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Recurso</th>
                            <th scope="col">Período</th>
                            <th scope="col">Consumo</th>
                            <th scope="col">Limite</th>
                            <th scope="col">Percentual</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Usage) {
                            <tr>
                                <td>@u.Key</td>
                                <td>@u.Period</td>
                                <td>@u.Consumed</td>
                                <td>@(u.Unlimited ? "Ilimitado" : (u.Limit?.ToString() ?? "—"))</td>
                                <td>@(u.Percentage is null ? "—" : $"{Math.Round(u.Percentage.Value)}%")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>
    }
    <article class="admin-panel mt-3">
        <h2>Preferências</h2>
        <p class="text-muted mb-0">Lembretes de diagnóstico, notificações de relatório e anonimização de respostas não possuem execução funcional conectada nesta versão. Os controles editáveis foram removidos até que a regra de negócio, processamento e evidências de auditoria estejam implementados de ponta a ponta.</p>
    </article>
</section>
