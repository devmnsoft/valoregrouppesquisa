@{ ViewData["Title"] = "Diagnósticos"; }
<main class="valora-page surveys-studio" data-page="surveys-page">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel("Diagnósticos", "Crie, publique e acompanhe ciclos de escuta com rastreabilidade.", "Estúdio de Diagnósticos", Actions: new[] { new PageHeaderAction("Novo diagnóstico", DataAction: "new-survey", Style: "primary", Icon: "plus") }))" />

  <section class="metric-grid" aria-label="Resumo dos diagnósticos" data-summary-cards>
    <article class="metric-card"><span>Total</span><strong data-metric="total">—</strong><small>diagnósticos cadastrados</small></article>
    <article class="metric-card"><span>Em campo</span><strong data-metric="active">—</strong><small>aceitando respostas</small></article>
    <article class="metric-card"><span>Rascunhos</span><strong data-metric="draft">—</strong><small>aguardando publicação</small></article>
    <article class="metric-card"><span>Encerrados</span><strong data-metric="closed">—</strong><small>com histórico preservado</small></article>
  </section>

  <section class="workspace-section" aria-labelledby="survey-list-title">
    <div class="workspace-toolbar">
      <div><h2 id="survey-list-title">Ciclos de escuta</h2><p>Somente formulários publicados e com perguntas devem ser colocados em campo.</p></div>
      <button class="btn btn-outline-secondary" type="button" data-refresh>Atualizar</button>
    </div>
    <div class="valora-toolbar mt-3" role="search">
      <label class="visually-hidden" for="survey-search">Buscar diagnóstico</label><input class="form-control" id="survey-search" type="search" placeholder="Buscar por título ou formulário" data-search>
      <label class="visually-hidden" for="survey-status">Filtrar por status</label><select class="form-select" id="survey-status" data-status><option value="">Todos os status</option><option value="draft">Rascunho</option><option value="published">Publicado</option><option value="active">Ativo</option><option value="closed">Encerrado</option><option value="archived">Arquivado</option></select>
    </div>
    <div class="alert alert-danger d-none mt-3" role="alert" aria-live="assertive" data-error></div>
    <div class="survey-skeleton mt-3" data-loading aria-label="Carregando diagnósticos"><span></span><span></span><span></span></div>
    <div class="table-responsive mt-3 d-none" data-table><table class="table align-middle"><thead><tr><th>Diagnóstico</th><th>Formulário</th><th>Período</th><th>Status</th><th><span class="visually-hidden">Ações</span></th></tr></thead><tbody data-items></tbody></table></div>
    <div class="empty-state d-none" data-empty><h3>Nenhum diagnóstico encontrado</h3><p>Crie um ciclo de escuta a partir de um formulário válido.</p><button class="btn btn-primary" type="button" data-new-survey>Criar diagnóstico</button></div>
  </section>
</main>

<dialog class="valora-dialog" data-survey-dialog aria-labelledby="survey-dialog-title">
  <form method="dialog" data-survey-form><header><div><span class="eyebrow">Ciclo de escuta</span><h2 id="survey-dialog-title">Novo diagnóstico</h2></div><button type="button" class="btn-close" data-dialog-close aria-label="Fechar"></button></header>
    <input type="hidden" name="id">
    <label class="form-label" for="survey-title">Título</label><input class="form-control" id="survey-title" name="title" required maxlength="160">
    <label class="form-label mt-3" for="survey-description">Descrição</label><textarea class="form-control" id="survey-description" name="description" rows="3" maxlength="1000"></textarea>
    <label class="form-label mt-3" for="survey-form">Formulário base</label><select class="form-select" id="survey-form" name="formId" required><option value="">Carregando formulários…</option></select>
    <p class="form-text">Publique o formulário e confirme que ele possui perguntas antes de ativar o diagnóstico.</p>
    <footer><button type="button" class="btn btn-outline-secondary" data-dialog-close>Cancelar</button><button type="submit" class="btn btn-primary" data-save>Salvar rascunho</button></footer>
  </form>
</dialog>
@section Scripts { <script src="/js/pages/surveys-page.js"></script> }
