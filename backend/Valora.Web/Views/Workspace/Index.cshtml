@model Valora.Web.Models.ViewModels.ExecutiveWorkspaceViewModel
@{ ViewData["Title"] = Model.Title; }
<link rel="stylesheet" href="~/css/executive-workspace.css" asp-append-version="true" />
<main class="executive-workspace" data-mode="@Model.Mode">
 @Html.AntiForgeryToken()
 <header class="workspace-hero"><div><span class="workspace-eyebrow">Valora Executive Workspace™</span><h1>@Model.Title</h1><p>@Model.Subtitle</p></div><div class="workspace-primary-actions"><button id="new-priority" class="button primary" type="button">+ Nova prioridade</button><a class="workspace-search-link" href="/Search">⌕ <span>Buscar</span><kbd>Ctrl K</kbd></a></div></header>
 <nav class="workspace-tabs" aria-label="Workspace"><a href="/Workspace">Visão geral</a><a href="/Workspace/MyDay">Meu Dia</a><a href="/Workspace/Priorities">Prioridades</a><a href="/Search">Busca Global</a></nav>
 <details class="workspace-help"><summary>Como usar</summary><p>Crie uma prioridade, atribua um responsável e registre avanços. Abra um item para vê-lo nos recentes ou fixe-o para acesso rápido.</p></details>
 <div id="workspace-feedback" class="workspace-feedback" role="status" aria-live="polite" hidden></div>
 <section id="workspace-loading" class="workspace-grid" aria-label="Carregando"><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></section>
 <section id="workspace-content" class="workspace-grid" hidden></section>
 <section id="workspace-empty" class="workspace-empty" hidden><span>✦</span><h2>Seu foco está em dia</h2><p>Nenhum registro corresponde a esta seção.</p><button class="button retry" type="button" hidden>Tentar novamente</button></section>
 <dialog id="priority-dialog" class="priority-dialog"><form id="priority-form"><header><h2 id="priority-form-title">Nova prioridade</h2><button type="button" class="icon-button dialog-close" aria-label="Fechar">×</button></header><div class="form-errors" tabindex="-1" hidden></div><input type="hidden" name="id"><input type="hidden" name="expectedUpdatedAt"><label>Título <span aria-hidden="true">*</span><input name="title" required minlength="3" maxlength="180"><small>Resuma o resultado que precisa de atenção.</small><span class="field-error"></span></label><label>Descrição<textarea name="description" maxlength="2000" rows="4"></textarea><span class="field-error"></span></label><div class="form-row"><label>Prioridade <span aria-hidden="true">*</span><select name="priority" required><option value="critical">Crítica</option><option value="high">Alta</option><option value="medium" selected>Média</option><option value="low">Baixa</option></select></label><label>Responsável<select name="ownerUserId"><option value="">Compartilhada</option></select><small>Digite a inicial com o seletor aberto para localizar.</small></label></div><label>Origem opcional<select name="source"><option value="">Sem recurso vinculado</option></select><small>Somente recursos que você pode consultar são exibidos.</small></label><label>Prazo<input name="dueAt" type="datetime-local"><small>O horário usa o fuso atual do navegador; uma data ausente permanece ausente.</small></label><footer><button type="button" class="button dialog-close">Cancelar</button><button class="button primary" type="submit">Revisar e salvar</button></footer></form></dialog>
 <dialog id="priority-details" class="priority-dialog details-dialog"><div class="details-content"></div></dialog>
</main>
<script nonce="@Context.Items["CspNonce"]">window.valoraWorkspaceMode='@Model.Mode';</script>
<script src="~/js/executive-workspace.js" asp-append-version="true"></script>
