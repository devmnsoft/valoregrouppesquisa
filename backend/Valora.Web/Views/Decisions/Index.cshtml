@model IReadOnlyList<Valora.Application.DecisionCenter.OrganizationalDecisionDto>
@{ ViewData["Title"]="Decisões Organizacionais"; }

<main class="dc-page"><header class="dc-hero"><small>RASTREABILIDADE EXECUTIVA</small><h1>Decisões organizacionais</h1><p>Contexto, evidências, responsável, prazo e resultado esperado em uma trilha auditável.</p></header><section class="dc-card">@if(Model.Count==0){<div class="dc-empty"><h2>Ainda não há decisões registradas</h2><p>Registre uma decisão somente quando houver evidência suficiente e responsabilidade definida.</p></div>}else{<table class="dc-table"><thead><tr><th>Decisão</th><th>Status</th><th>Prioridade</th><th>Impacto</th><th>Prazo</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a href="/Decisions/Details/@x.Id">@x.Title</a><small class="d-block">@x.EvidenceSummary</small></td><td><span class="dc-badge">@x.Status</span></td><td>@x.Priority</td><td>@x.ImpactLevel</td><td>@(x.DueAt?.ToString("dd/MM/yyyy")??"—")</td></tr>}</tbody></table>}</section></main>
