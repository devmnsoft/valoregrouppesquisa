@model Valora.Web.Models.ViewModels.BenchmarksViewModel
@{Layout="_Layout";}<partial name="_BenchmarkShell" model="Model" /><form class="bm-card" style="margin-top:16px" asp-action="Compare" method="post">@Html.AntiForgeryToken()<h2>Comparação contextual</h2><div class="bm-grid"><label>Tipo<select name="ComparisonType"><option value="history">Organização × histórico</option><option value="units">Unidade × unidade</option><option value="cohort">Organização × coorte anônima</option></select></label><label>Coorte<select name="CohortId"><option value="">Não aplicável</option>@foreach(var x in Model.Cohorts){<option value="@x.Id">@x.Name (n protegido)</option>}</select></label><label>Segmento<input name="Segment" value="Geral" required /></label><label>Critério<select name="Criterion"><option value="maturity">Maturidade</option><option value="dimension">Dimensão</option><option value="indicator">Indicador</option><option value="evolution">Evolução</option></select></label><label>Início<input type="date" name="PeriodStart" required /></label><label>Fim<input type="date" name="PeriodEnd" required /></label></div><button>Comparar com privacidade</button><p>A plataforma informará confiança e limitações. Diferença não implica causalidade.</p></form>
