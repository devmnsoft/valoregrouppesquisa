@model Valora.Web.Models.ViewModels.ArchitectureStudioViewModel
@{ ViewData["Title"]="Architecture Studio"; }
<link rel="stylesheet" href="/css/architecture-studio.css" asp-append-version="true" />
<section class="valora-page architecture-studio">
<header class="architecture-hero"><div><p class="eyebrow">Valora Organizational Architecture Studio™</p><h1>A organização como um sistema vivo</h1><p>Conecte pessoas, processos, decisões, evidências e dependências para enxergar causas — não apenas sintomas.</p></div><form asp-action="Snapshot" method="post"><button class="valora-button valora-button--primary" type="submit">Criar snapshot</button></form></header>
@if(!string.IsNullOrWhiteSpace(Model.Message)){<div class="valora-alert valora-alert--success">@Model.Message</div>}
<nav class="architecture-tabs" aria-label="Seções da arquitetura"><a asp-action="Index">Painel</a><a asp-action="OrganizationMap">Organograma</a><a asp-action="Responsibilities">RACI</a><a asp-action="Processes">Processos</a><a asp-action="DecisionRights">Decisões</a><a asp-action="Dependencies">Dependências</a><a asp-action="Risks">Riscos</a></nav>
<div class="architecture-metrics"><article><span>Maturidade</span><strong>@Model.Summary.MaturityScore.ToString("0")</strong><small>capacidade organizacional / 100</small></article><article><span>Unidades</span><strong>@Model.Summary.Units</strong><small>áreas ativas</small></article><article><span>Processos críticos</span><strong>@Model.Summary.CriticalProcesses</strong><small>exigem evidência e indicador</small></article><article><span>Sem responsável</span><strong>@Model.Summary.UnownedResponsibilities</strong><small>lacunas de execução</small></article><article><span>Dependências críticas</span><strong>@Model.Summary.CriticalDependencies</strong><small>sem mitigação</small></article><article><span>Riscos abertos</span><strong>@Model.Summary.OpenRisks</strong><small>achados estruturais</small></article></div>
@if(Model.Section=="OrganizationMap"){
 <section class="architecture-panel"><div class="panel-title"><div><p class="eyebrow">Mapa funcional</p><h2>Unidades, responsáveis e relações</h2></div><input type="search" placeholder="Filtrar por área" aria-label="Filtrar organograma" /></div><div class="org-map">@foreach(var u in Model.Units){<article class="unit-node"><span class="status-dot status-dot--@u.Status"></span><small>@u.UnitType</small><h3>@u.Name</h3><p>@(u.OwnerUserId.HasValue?"Responsável definido":"Responsável não definido")</p><span class="architecture-badge">@u.Status</span></article>}@if(Model.Units.Count==0){<div class="architecture-empty"><h3>O mapa começa pela primeira unidade</h3><p>Cadastre áreas e relações hierárquicas para revelar dependências.</p></div>}</div></section>
}else if(Model.Section=="Responsibilities"){
 <section class="architecture-panel"><p class="eyebrow">Responsibility Matrix Grid</p><h2>Matriz RACI</h2><div class="table-responsive"><table class="valora-table"><thead><tr><th>Processo</th><th>Pessoa</th><th>Área</th><th>Papel</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.Responsibilities){<tr><td>@x.ProcessId</td><td>@x.PersonProfileId</td><td>@x.UnitId</td><td><span class="raci raci--@x.ResponsibilityType.ToLowerInvariant()">@x.ResponsibilityType[0]</span> @x.ResponsibilityType</td><td>@x.Status</td></tr>}</tbody></table></div></section>
}else if(Model.Section=="Processes"){
 <section class="architecture-panel"><p class="eyebrow">Catálogo operacional</p><h2>Processos</h2><div class="architecture-list">@foreach(var p in Model.Processes){<article><div><span class="architecture-badge architecture-badge--@p.Criticality">@p.Criticality</span><h3>@p.Name</h3><p>@(p.OwnerPersonId.HasValue?"Dono definido":"Sem dono") · @p.CompletenessStatus</p></div><strong>@(string.IsNullOrWhiteSpace(p.IndicatorReference)?"Sem indicador":"Indicador vinculado")</strong></article>}</div></section>
}else if(Model.Section=="DecisionRights"){
 <section class="architecture-panel"><p class="eyebrow">Direitos de decisão</p><h2>Clareza de autoridade e limites</h2><div class="architecture-card-grid">@foreach(var d in Model.Decisions){<article><span class="architecture-badge">@d.DecisionType</span><h3>@d.Scope</h3><dl><dt>Limite</dt><dd>@d.DecisionLimit</dd><dt>Responsável</dt><dd>@(d.ResponsiblePersonId?.ToString()??"Não definido")</dd></dl></article>}</div></section>
}else if(Model.Section=="Dependencies"){
 <section class="architecture-panel"><p class="eyebrow">Mapa de dependências</p><h2>Impactos entre áreas e processos</h2><div class="architecture-list">@foreach(var d in Model.Dependencies){<article><div><span class="architecture-badge architecture-badge--@d.Criticality">@d.Criticality</span><h3>@d.DependencyType</h3><p>@d.Impact</p></div><strong>@(string.IsNullOrWhiteSpace(d.MitigationPlan)?"Mitigação pendente":"Plano definido")</strong></article>}</div></section>
}else if(Model.Section=="Risks"){
 <section class="architecture-panel"><p class="eyebrow">Riscos estruturais</p><h2>Evidências antes da percepção</h2><div class="architecture-card-grid">@foreach(var r in Model.Risks){<article><span class="architecture-badge architecture-badge--@r.Severity">@r.Severity</span><h3>@r.Title</h3><p><strong>Causa provável:</strong> @r.ProbableCause</p><p><strong>Evidência:</strong> @r.Evidence</p><p><strong>Ação:</strong> @r.RecommendedAction</p></article>}</div></section>
}else{<section class="architecture-panel"><div class="panel-title"><div><p class="eyebrow">Leitura executiva</p><h2>Fragilidades que pedem atenção</h2></div><a asp-action="Risks">Analisar riscos</a></div><div class="architecture-insights"><article><strong>@Model.Summary.UnownedResponsibilities</strong><p>responsabilidades sem dono</p></article><article><strong>@Model.Summary.ConcentratedDecisions</strong><p>concentrações decisórias</p></article><article><strong>@Model.Summary.CriticalDependencies</strong><p>dependências críticas sem mitigação</p></article></div></section>}
</section>
