@model Valora.Application.DecisionCenter.GovernanceCycleDto
@{ ViewData["Title"]=Model.Name; }
<style>.dc-page{display:grid;gap:1.4rem}.dc-hero{padding:2rem;border-radius:24px;background:linear-gradient(135deg,#102b35,#174b57);color:#fff}.dc-hero p{max-width:760px;color:#d4e9e8}.dc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem}.dc-card{background:#fff;border:1px solid #dce7e7;border-radius:18px;padding:1.2rem;box-shadow:0 8px 24px #173e4910}.dc-kpi strong{font-size:2rem;display:block}.dc-badge{display:inline-flex;padding:.3rem .65rem;border-radius:999px;background:#e7f1f0;font-size:.78rem;font-weight:700}.critical{background:#fee2e2;color:#991b1b}.high,.regression{background:#ffedd5;color:#9a3412}.dc-list{display:grid;gap:.75rem}.dc-row{display:flex;justify-content:space-between;gap:1rem;padding:1rem;border:1px solid #e3ecec;border-radius:14px}.dc-actions{display:flex;gap:.5rem;flex-wrap:wrap}.dc-empty{text-align:center;padding:2.5rem;color:#567}.dc-table{width:100%;border-collapse:collapse}.dc-table th,.dc-table td{padding:.85rem;border-bottom:1px solid #e5eeee;text-align:left}@@media(max-width:700px){.dc-row{flex-direction:column}.dc-table{display:block;overflow:auto}}</style>
<main class="dc-page"><header class="dc-hero"><span class="dc-badge">@Model.Status</span><h1>@Model.Name</h1><p>@Model.PeriodLabel</p></header><section class="dc-grid"><article class="dc-card"><h2>Fluxo do ciclo</h2><p>Diagnóstico → interpretação → prioridades → decisões → plano de ação → execução → monitoramento → nova avaliação → aprendizagem.</p></article><article class="dc-card"><h2>Aprendizados</h2><p>@(Model.LearningSummary??"Aprendizados serão registrados a partir das evidências de execução e nova avaliação.")</p></article></section></main>
