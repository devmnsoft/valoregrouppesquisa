@using Valora.Web.Models.ViewModels
@{ ViewData["Title"] = "Centro de Processamento Valora™"; }
<main class="valora-page v9-page" data-processing-center>
 <partial name="_PageHeader" model="@(new PageHeaderViewModel("Centro de Processamento Valora™", "Acompanhe como o Valora Insight™ transforma respostas em evidências, métricas, índices, inferências, insights, ações e entregáveis executivos.", "Operação da inteligência", "Inteligência Organizacional", new[] { new PageHeaderAction("Reprocessar inteligência", DataAction: "recalculate", Style: "primary", Icon: "activity") }))" />
 <div class="valora-alert valora-alert--danger" data-processing-error hidden></div>
 <section class="v9-kpis"><article><span>Pendentes</span><strong data-summary="pending">—</strong><small>Aguardando execução segura</small></article><article><span>Em execução</span><strong data-summary="running">—</strong><small>Jobs bloqueados pelo worker</small></article><article><span>Concluídos hoje</span><strong data-summary="completedToday">—</strong><small>Entregas atualizadas</small></article><article><span>Falhas / retry</span><strong><span data-summary="failed">—</span> / <span data-summary="retryScheduled">—</span></strong><small data-most-failed>Sem falha recorrente</small></article></section>
 <section class="valora-card"><div class="v9-section-title"><div><p class="eyebrow">Fila rastreável</p><h2>Processamentos recentes</h2></div><button class="valora-button" type="button" data-refresh>Atualizar</button></div>
 <form class="insight-filters" data-filters><label>Status<select class="form-select" name="status"><option value="">Todos</option><option value="pending">Pendente</option><option value="running">Rodando</option><option value="completed">Concluído</option><option value="failed">Falhou</option><option value="retry_scheduled">Retry</option><option value="insufficient_evidence">Dados insuficientes</option></select></label><label>Trigger<input class="form-control" name="trigger"></label><label>Diagnóstico<input class="form-control" name="surveyId" placeholder="UUID"></label><label>Resposta<input class="form-control" name="responseId" placeholder="UUID"></label></form>
 <div class="table-responsive"><table class="table"><thead><tr><th>Status</th><th>Origem</th><th>Referência</th><th>Tentativas</th><th>Agendado</th><th>Ações</th></tr></thead><tbody data-jobs></tbody></table></div><div class="valora-empty-state" data-empty hidden><strong>Nenhum processamento encontrado</strong><span>Novos jobs aparecerão após uma resposta, diagnóstico ou solicitação manual.</span></div></section>
 <dialog class="v9-dialog" data-job-drawer><button class="v9-dialog__close" data-close>×</button><p class="eyebrow">Detalhe rastreável</p><h2 data-job-title>Processamento</h2><div data-job-meta></div><h3>Timeline das etapas</h3><ol class="v9-timeline" data-stages></ol><div class="d-flex gap-2"><button class="valora-button valora-button--primary" data-reprocess>Reprocessar</button><button class="valora-button" data-cancel>Cancelar pendente</button></div><nav class="mt-3"><a href="/Intelligence">Dashboard</a> · <a href="/Intelligence/Evidence">Evidências</a> · <a href="/Intelligence/Insights">Insights</a> · <a href="/Intelligence/Action">Action</a> · <a href="/Intelligence/Journey">Journey</a> · <a href="/Intelligence/ExecutiveReport">Report</a></nav></dialog>
</main>
@section Scripts { <script src="/js/pages/intelligence-processing-page.js" asp-append-version="true"></script> }
