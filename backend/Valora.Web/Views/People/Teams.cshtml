@model Valora.Web.Models.ViewModels.PeopleViewModel
@{Layout="_Layout";}<partial name="_PeopleShell" model="Model"/><div class="people-grid">@foreach(var x in Model.Teams){<article class="people-card"><h2>@x.Name</h2><p>Liderança: @x.ResponsibleName</p><p>@x.MemberCount membros ativos</p></article>}</div><section class="people-card"><h2>Novo time</h2><form asp-action="CreateTeam" method="post">@Html.AntiForgeryToken()<label>Nome<input name="Name" required minlength="2" maxlength="120"/></label><label>Liderança responsável<select name="ResponsibleProfileId" required><option value="">Selecione</option>@foreach(var p in Model.Profiles.Where(x=>x.Status=="active")){<option value="@p.Id">@p.DisplayName</option>}</select></label><button type="submit">Criar time</button></form></section>
