@model Valora.Application.ActionCenter.ActionDashboardDto
@using Valora.Application.ActionCenter
@{ ViewData["Title"] = "Central de Ações"; var canManage=(bool)(ViewBag.CanManage ?? false); }
<main class="valora-page action-center-page">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel("Central de Ações", "Priorize compromissos e acompanhe a execução na organização selecionada.", "Valora Action™", "Contexto organizacional selecionado", canManage ? new[] { new PageHeaderAction("Novo plano", "/ActionCenter/Plans/Create", Style: "primary", Icon: "plus"), new PageHeaderAction("Ver planos", "/ActionCenter/Plans", Icon: "list"), new PageHeaderAction("Ver atividades", "/ActionCenter/Items", Icon: "list") } : new[] { new PageHeaderAction("Ver planos", "/ActionCenter/Plans", Icon: "list"), new PageHeaderAction("Ver atividades", "/ActionCenter/Items", Icon: "list") }))" />
  <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel("Como usar", "Use os indicadores para abrir exatamente os registros contados e a agenda para decidir a próxima execução.", new[] { "Revise atrasos e bloqueios.", "Defina responsáveis para compromissos sem dono.", "Registre progresso e evidência no detalhe." }, true))" />

  <section class="action-kpis" aria-label="Indicadores acionáveis">
    <a asp-action="Items" asp-route-Priority="critical" asp-route-Scope="Open" class="action-kpi action-kpi--danger"><span>Críticas abertas</span><strong>@Model.Critical</strong><small>Somente atividades não encerradas</small></a>
    <a asp-action="Items" asp-route-Due="overdue" class="action-kpi action-kpi--warning"><span>Atrasadas</span><strong>@Model.Overdue</strong><small>Prazo anterior ao dia local</small></a>
    <a asp-action="Items" asp-route-Status="blocked" class="action-kpi"><span>Bloqueadas</span><strong>@Model.Blocked</strong><small>Aguardam desbloqueio</small></a>
    <a asp-action="Items" asp-route-Assignment="Unassigned" asp-route-Scope="Open" class="action-kpi"><span>Sem responsável</span><strong>@Model.Unassigned</strong><small>Aguardam atribuição</small></a>
    <a asp-action="Plans" asp-route-Scope="Active" class="action-kpi action-kpi--success"><span>Planos ativos</span><strong>@Model.ActivePlans</strong><small>Aprovados ou em execução</small></a>
  </section>

  <nav class="action-quick-links" aria-label="Consultas rápidas da agenda"><strong>Consultas rápidas</strong><a asp-action="Items" asp-route-Due="overdue">Atrasos</a><a asp-action="Items" asp-route-Status="blocked">Bloqueios</a><a asp-action="Items" asp-route-Due="upcoming" asp-route-Scope="Open">Próximas entregas</a></nav>
  <section class="valora-card"><div class="section-heading"><div><p class="eyebrow">Agenda de execução</p><h2>Próximos compromissos</h2><p>Atividades abertas ordenadas por prazo, sem ocultar as que ainda não têm data.</p></div><a class="valora-button valora-button--ghost" asp-action="Items">Expandir agenda</a></div>
  @if (Model.Upcoming.Count == 0) { <div class="valora-empty"><h3>Nenhuma atividade corresponde ao escopo.</h3><p>@(canManage ? "Crie um plano e registre sua primeira atividade." : "Não há compromissos disponíveis para consulta.")</p>@if(canManage){<a class="valora-button valora-button--primary" asp-action="CreatePlan">Criar plano</a>}</div> } else { <div class="table-responsive" tabindex="0" aria-label="Agenda de execução com rolagem horizontal"><table class="valora-table"><thead><tr><th>Atividade e plano</th><th>Responsável</th><th>Situação</th><th>Prioridade</th><th>Progresso</th><th>Prazo</th></tr></thead><tbody>@foreach (var item in Model.Upcoming) { <tr><td><a asp-action="ItemDetails" asp-route-id="@item.Id" asp-route-returnUrl="/ActionCenter"><strong>@item.Title</strong></a><small class="action-secondary">@item.PlanTitle</small></td><td>@(item.ResponsibleName ?? "Sem responsável")</td><td>@ActionStatuses.Label(item.Status)</td><td>@ActionStatuses.Label(item.Priority)</td><td><progress max="100" value="@item.ProgressPercent" aria-label="Progresso de @item.ProgressPercent por cento"></progress> @item.ProgressPercent%</td><td>@(item.DueAt?.ToString("dd/MM/yyyy") ?? "Sem prazo")</td></tr> }</tbody></table></div> }</section>

  <section class="valora-card"><div class="section-heading"><div><p class="eyebrow">Acompanhamento</p><h2>Planos recentes</h2><p>Progresso operacional calculado a partir das atividades válidas.</p></div><a class="valora-button valora-button--ghost" asp-action="Plans">Ver todos</a></div>
  @if(Model.Plans.Count==0){<div class="valora-empty"><p>Nenhum plano disponível no escopo autorizado.</p></div>}else{<div class="action-plan-grid">@foreach(var plan in Model.Plans){<article><a asp-action="PlanDetails" asp-route-id="@plan.Id" asp-route-returnUrl="/ActionCenter"><strong>@plan.Title</strong></a><span>@ActionStatuses.Label(plan.Status) · @ActionStatuses.Label(plan.Priority)</span><span>@(plan.OwnerName ?? "Sem responsável") · @plan.ActiveItemCount atividade(s) aberta(s)</span><progress max="100" value="@plan.ProgressPercent" aria-label="Progresso de @plan.ProgressPercent por cento"></progress><small>@plan.ProgressPercent% concluído</small></article>}</div>}</section>
</main>
