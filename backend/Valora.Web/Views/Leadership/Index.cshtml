@model IReadOnlyList<Valora.Application.OneOnOne.LeadershipProfileDto>
@{ViewData["Title"]="Lideranças";}<main class="valora-page"><header class="leadership-hero"><div><p class="eyebrow">Valora Leadership™</p><h1>Desenvolvimento de lideranças</h1><p>Evolução orientada por evidências, sem rótulos ou julgamentos individuais.</p></div></header><section class="leadership-grid">@if(Model.Count==0){<div class="valora-card valora-empty"><h3>Perfis surgem com o acompanhamento</h3><p>Crie uma sessão One-on-One para iniciar uma linha de evolução segura.</p></div>}@foreach(var x in Model){<a class="valora-card leader-card" href="/Leadership/Details/@x.UserId"><span class="leader-avatar">@x.DisplayName[0]</span><h2>@x.DisplayName</h2><p>@(x.RoleTitle??"Liderança acompanhada")</p><div><span>Última sessão</span><strong>@(x.LastSessionAt?.ToString("dd/MM/yyyy")??"—")</strong></div><div><span>Compromissos</span><strong>@x.PendingCommitments</strong></div></a>}</section></main>
