@model Valora.Web.Models.ViewModels.ResponseDetailViewModel
@{
    ViewData["Title"] = $"Resultado da Submissão — {Model.Result.SurveyTitle}";
    var r = Model.Result;
}

<div class="container-fluid py-4" data-module="Responses">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Início</a></li>
                    <li class="breadcrumb-item"><a href="/Responses" class="text-decoration-none">Respostas</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Detalhes do Resultado</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold text-dark mb-1">@r.SurveyTitle</h1>
            <p class="text-muted mb-0">Formulário: <strong>@r.FormName</strong> (v@r.FormVersion) · Organização: <strong>@r.OrganizationName</strong></p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Responses" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
            </a>
            @if (r.ResultId.HasValue)
            {
                <a href="/Results" class="btn btn-primary">
                    <i class="bi bi-graph-up me-1"></i> Painel de Resultados
                </a>
            }
        </div>
    </div>

    <!-- Cards de Resumo e Maturidade -->
    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <div class="card-body d-flex flex-column justify-content-center">
                    <span class="text-muted small fw-medium text-uppercase mb-2">Nível de Maturidade</span>
                    <div class="display-3 fw-bold text-primary mb-2">
                        @(r.Percentage.HasValue ? $"{r.Percentage.Value:F1}%" : "-")
                    </div>
                    <h2 class="h5 fw-bold text-dark mb-2">@(r.MaturityLabel ?? "Em processamento")</h2>
                    <p class="text-muted small mb-0">
                        Score total: <strong>@(r.TotalScore.HasValue ? r.TotalScore.Value.ToString("F1") : "-")</strong> / @(r.MaxScore.HasValue ? r.MaxScore.Value.ToString("F1") : "-")
                    </p>
                    <div class="mt-3">
                        <span class="badge @(r.ProcessingStatus == "available" ? "bg-success-subtle text-success border border-success" : "bg-warning-subtle text-warning-emphasis border border-warning")">
                            Status: @(r.ProcessingStatus == "available" ? "Disponível" : r.ProcessingStatus)
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h3 class="h6 mb-0 fw-bold text-dark">
                        <i class="bi bi-lightning-charge me-2 text-warning"></i>Diagnóstico Executivo
                    </h3>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrWhiteSpace(r.StrategicTruth))
                    {
                        <div class="mb-3">
                            <strong class="d-block text-dark small fw-bold mb-1">Verdade Estratégica:</strong>
                            <p class="text-muted small mb-0">@r.StrategicTruth</p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(r.RiskIfNothingChanges))
                    {
                        <div class="mb-3">
                            <strong class="d-block text-danger small fw-bold mb-1">Risco se nada mudar:</strong>
                            <p class="text-muted small mb-0">@r.RiskIfNothingChanges</p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(r.NextLevel))
                    {
                        <div>
                            <strong class="d-block text-success small fw-bold mb-1">Próximo Nível Recomendado:</strong>
                            <p class="text-muted small mb-0">@r.NextLevel</p>
                        </div>
                    }

                    @if (string.IsNullOrWhiteSpace(r.StrategicTruth) && string.IsNullOrWhiteSpace(r.RiskIfNothingChanges))
                    {
                        <p class="text-muted small mb-0">Aguardando consolidação dos algoritmos de maturidade para esta submissão.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Scores por Dimensão -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h3 class="h6 mb-0 fw-bold text-dark">Scores por Dimensão Avaliada (@r.Dimensions.Count)</h3>
            <span class="badge bg-light text-dark border">Equilíbrio Sistêmico</span>
        </div>
        <div class="card-body p-4">
            @if (r.Dimensions.Count == 0)
            {
                <div class="text-muted small">Nenhum score dimensional associado a esta resposta.</div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var dim in r.Dimensions)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="border rounded-3 p-3 bg-light bg-opacity-25 h-100">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <strong class="text-dark">@dim.DimensionName</strong>
                                    <span class="badge bg-primary-subtle text-primary fw-bold">@(dim.Percentage.HasValue ? $"{dim.Percentage.Value:F1}%" : "-")</span>
                                </div>
                                <div class="progress mb-2" style="height: 6px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @(dim.Percentage ?? 0)%"></div>
                                </div>
                                <div class="d-flex justify-content-between small text-muted">
                                    <span>Score: @dim.Score / @dim.MaxScore</span>
                                    <span>@(dim.LevelLabel ?? "Nível padrão")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Relatórios e Planos de Ação Conectados -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h3 class="h6 mb-0 fw-bold text-dark">
                        <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>Relatórios Gerados (@r.Reports.Count)
                    </h3>
                </div>
                <div class="card-body p-3">
                    @if (r.Reports.Count == 0)
                    {
                        <p class="text-muted small mb-0">Nenhum relatório formal gerado ainda para esta resposta.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var rep in r.Reports)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <strong class="d-block small text-dark">@rep.Title</strong>
                                        <span class="text-muted font-monospace small">@rep.Format · @rep.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <span class="badge text-bg-light border">@rep.Status</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h3 class="h6 mb-0 fw-bold text-dark">
                        <i class="bi bi-kanban me-2 text-primary"></i>Planos de Ação Vinculados (@r.Plans.Count)
                    </h3>
                </div>
                <div class="card-body p-3">
                    @if (r.Plans.Count == 0)
                    {
                        <p class="text-muted small mb-0">Nenhum plano de ação desdobrado a partir desta resposta.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var plan in r.Plans)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <strong class="d-block small text-dark">@plan.Title</strong>
                                        <span class="text-muted small">Progresso: @plan.ProgressPercent% · Prazo: @(plan.DueAt?.ToString("dd/MM/yyyy") ?? "Sem prazo")</span>
                                    </div>
                                    <span class="badge text-bg-secondary">@plan.Status</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
