@model Valora.Web.Models.ViewModels.RiskComplianceIndexViewModel
@{ViewData["Title"]="Valora Risk, Compliance & Internal Controls Center™";}
<link rel="stylesheet" href="~/css/risk-compliance.css" asp-append-version="true" />
<section class="rc-hero"><div><span>GOVERNANÇA BASEADA EM EVIDÊNCIAS</span><h1>Risk, Compliance<br />& Internal Controls Center™</h1><p>Riscos reais, controles frágeis e correções prioritárias com confiança explícita e decisão humana preservada.</p></div><a asp-action="Heatmap">Abrir mapa de riscos →</a></section>
<nav class="rc-tabs"><a asp-action="Risks">Riscos</a><a asp-action="Heatmap">Heatmap</a><a asp-action="Controls">Controles</a><a asp-action="Compliance">Compliance</a><a asp-action="NonConformities">Não conformidades</a><a asp-action="MitigationPlans">Mitigação</a><a asp-action="Audits">Auditorias</a></nav>
<section class="rc-metrics">@foreach(var m in new[]{("Riscos críticos",Model.Dashboard.CriticalRisks,"danger"),("Baixa confiança",Model.Dashboard.LowConfidenceRisks,"warn"),("Controles frágeis",Model.Dashboard.FragileControls,"warn"),("Não conformidades",Model.Dashboard.OpenNonConformities,"danger"),("Mitigações atrasadas",Model.Dashboard.OverdueMitigations,"danger")}){<article class="@m.Item3"><span>@m.Item1</span><strong>@m.Item2</strong><small>organização atual</small></article>}<article><span>Aderência comprovada</span><strong>@(Model.Dashboard.EvidenceBasedAdherence?.ToString("0.##")??"—")@(Model.Dashboard.EvidenceBasedAdherence is null?"":"%")</strong><small>@(Model.Dashboard.EvidenceBasedAdherence is null?"sem avaliação suficiente":"somente avaliações evidenciadas")</small></article></section>
<div class="rc-grid"><section class="rc-panel wide"><header><div><span>PRIORIDADE EXECUTIVA</span><h2>Riscos em atenção</h2></div><a asp-action="Risks">Ver registro</a></header>@if(Model.Risks.Count==0){<div class="rc-empty"><strong>Nenhum risco registrado</strong><p>Registre somente riscos identificados; sinais ainda não validados devem permanecer como hipótese.</p></div>}else{@foreach(var r in Model.Risks){<article class="rc-row"><i class="score">@r.Criticality.ToString("0.#")</i><div><strong>@r.Title</strong><small>@r.Category · @r.OwnerName</small></div><em class="confidence @r.Confidence">@(r.Confidence=="hypothesis"?"Hipótese":r.Confidence=="low"?"Baixa confiança":"Evidenciado")</em><span>@r.Status</span></article>}}</section><section class="rc-panel"><header><div><span>CONTROLES</span><h2>Efetividade</h2></div><a asp-action="Controls">Abrir</a></header>@if(Model.Controls.Count==0){<div class="rc-empty"><strong>Sem controles mapeados</strong><p>Vincule cada controle a um risco ou requisito.</p></div>}else{@foreach(var c in Model.Controls){<article class="rc-mini"><div><strong>@c.Name</strong><small>@c.OwnerName</small></div><em>@c.State</em></article>}}</section></div>
<section class="rc-principles"><strong>Governança responsável</strong><span>Hipótese ≠ risco comprovado</span><span>Conformidade exige evidência</span><span>Isolamento por organização</span><span>Decisão humana preservada</span></section>
