@model Valora.Application.OneOnOne.OneOnOneDashboardDto
@{
    ViewData["Title"] = "One-on-One Executivo";
}

<main class="valora-page one-on-one" data-page="one-on-one-index">
    <nav class="v9-breadcrumb" aria-label="Navegação estrutural">
        <a href="/Dashboard">Início</a>
        <span>/</span>
        <a href="/People">Liderança & Pessoas</a>
        <span>/</span>
        <span>One-on-One™</span>
    </nav>

    <header class="leadership-hero valora-card">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <p class="eyebrow text-white-50">Valora One-on-One™</p>
                <h1 class="text-white">Conversas Estruturadas com Evidências</h1>
                <p class="text-white-50 m-0">
                    Acompanhamento contínuo de líderes e equipes. A IA sugere temas a partir dos diagnósticos organizacionais, mantendo a escuta ativa e a validação humana.
                </p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a class="valora-button valora-button--primary" href="/OneOnOne/Sessions/Create">
                    + Nova Sessão
                </a>
                <a class="valora-button valora-button--ghost text-white border-white" href="/OneOnOne/Sessions">
                    Ver Todas as Sessões
                </a>
            </div>
        </div>
    </header>

    <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel(
        "Como funciona o Valora One-on-One™",
        "O módulo conecta diagnósticos de clima e liderança a conversas reais de desenvolvimento. As sessões contam com pauta dinâmica sugerida por evidências, registro de feedbacks estruturados, compromissos com prazos e bloco de notas privadas 100% confidenciais."
    ))" />

    <section class="v9-kpis" aria-label="Indicadores de Conversas">
        <article class="valora-card">
            <span>Próximas conversas</span>
            <strong>@Model.Upcoming.Count</strong>
            <small>Agendadas no ciclo</small>
        </article>
        <article class="valora-card">
            <span>Conversas atrasadas</span>
            <strong class="@(Model.Overdue.Count > 0 ? "text-danger" : "text-success")">@Model.Overdue.Count</strong>
            <small>Requerem reagendamento</small>
        </article>
        <article class="valora-card">
            <span>Compromissos</span>
            <strong>@Model.Commitments.Count</strong>
            <small>Em acompanhamento</small>
        </article>
        <article class="valora-card">
            <span>Líderes participantes</span>
            <strong>@Model.Leaders.Count</strong>
            <small>Gestores engajados</small>
        </article>
    </section>

    <div class="row g-4 mt-1">
        <div class="col-lg-8">
            <section class="valora-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <p class="eyebrow">Agenda de Desenvolvimento</p>
                        <h2 class="h5 m-0">Próximas Conversas Agendadas</h2>
                    </div>
                    <a class="valora-button valora-button--ghost btn-sm" href="/OneOnOne/Sessions">Todas as sessões</a>
                </div>

                @if (Model.Upcoming.Count == 0)
                {
                    <div class="valora-empty py-4 text-center">
                        <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">💬</div>
                        <h3 class="h6">Nenhuma sessão agendada no momento</h3>
                        <p class="text-muted max-w-600 mx-auto">
                            Inicie um ciclo de escuta individual para acompanhar a evolução profissional, remover impedimentos operacionais e alinhar expectativas.
                        </p>
                        <a class="valora-button valora-button--primary btn-sm mt-2" href="/OneOnOne/Sessions/Create">
                            Agendar Primeira Conversa
                        </a>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <p class="eyebrow text-primary">Demonstração Metodológica</p>
                        <h4 class="h6">Exemplo de Sessão 1:1 Conduzida por Evidências</h4>
                        <div class="p-3 bg-light rounded-3 mt-2 border">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <strong>Alinhamento Trimestral · Gestão de Prioridades & Autonomia</strong>
                                <span class="badge bg-primary">Metodologia Valora</span>
                            </div>
                            <p class="text-muted small mt-1 mb-2">
                                Participantes: <strong>Mariana Ribeiro (Head de Operações)</strong> e <strong>Carlos Eduardo (Tech Lead)</strong>
                            </p>
                            <div class="row g-2 small">
                                <div class="col-sm-6">
                                    <span class="text-muted">Evidência de partida:</span>
                                    <p class="m-0">Score de 3.2 na dimensão <em>Clareza de Processos</em> no último diagnóstico interno.</p>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted">Compromisso gerado:</span>
                                    <p class="m-0">Revisar SLA de aprovações entre Engenharia e Produto até o final da sprint.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var s in Model.Upcoming)
                        {
                            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" href="/OneOnOne/Sessions/Details/@s.Id">
                                <div>
                                    <strong class="d-block text-dark">@s.Title</strong>
                                    <small class="text-muted">
                                        Líder: <strong>@s.LeaderName</strong> &bull; Participante: <strong>@s.ParticipantName</strong>
                                    </small>
                                </div>
                                <div class="text-end">
                                    <time class="d-block small text-muted">@(s.ScheduledAt?.ToString("dd/MM/yyyy HH:mm") ?? "A definir")</time>
                                    <span class="badge bg-secondary">@s.Status</span>
                                </div>
                            </a>
                        }
                    </div>
                }
            </section>
        </div>

        <div class="col-lg-4">
            <section class="valora-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <p class="eyebrow">Inteligência Orientadora</p>
                        <h2 class="h5 m-0">Sugestões de Pauta</h2>
                    </div>
                    <span class="privacy-mark">Validação Humana</span>
                </div>

                @if (Model.Suggestions.Count == 0)
                {
                    <div class="p-3 bg-light rounded-3 text-muted small">
                        <p class="m-0">
                            As sugestões de pauta baseadas em evidências aparecem automaticamente quando diagnósticos organizacionais apontam oportunidades de melhoria em equipes específicas.
                        </p>
                    </div>

                    <div class="mt-3">
                        <strong class="small d-block mb-2 text-dark">Sugestões padrão de referência:</strong>
                        <article class="ai-suggestion mb-2">
                            <strong class="text-primary small d-block">Segurança Psicológica & Escuta</strong>
                            <p class="small m-0 text-muted">Pergunte: "O que tem tornado o seu dia a dia mais desafiador recentemente e como posso ajudar a destravar?"</p>
                        </article>
                        <article class="ai-suggestion">
                            <strong class="text-primary small d-block">Alinhamento de Expectativas</strong>
                            <p class="small m-0 text-muted">Pergunte: "Quais são as duas prioridades que, se concluídas nesta quinzena, trarão maior impacto ao seu time?"</p>
                        </article>
                    </div>
                }
                else
                {
                    @foreach (var x in Model.Suggestions)
                    {
                        <article class="ai-suggestion mb-3">
                            <strong class="d-block text-dark">@x.Observation</strong>
                            <p class="small text-muted my-1">@x.Recommendation</p>
                            <small class="text-muted d-block border-top pt-1 mt-1">
                                <strong>Evidência:</strong> @x.Evidence &bull; <strong>Limitação:</strong> @x.Limitation
                            </small>
                        </article>
                    }
                }
            </section>
        </div>
    </div>
</main>
