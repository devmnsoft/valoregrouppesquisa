@model Valora.Web.Controllers.InsightDetailsPageViewModel
@using Valora.Application.ValoraAi
@using Valora.Application.ActionCenter
@using Valora.Application.Access
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@{
    var x = Model.Details.Insight;
    ViewData["Title"] = x.Title;
    var canApprove = (await Authorization.AuthorizeAsync(User, ValoraPermissions.Insights.Approve)).Succeeded;
    var canReject = (await Authorization.AuthorizeAsync(User, ValoraPermissions.Insights.Reject)).Succeeded;
    var canCreate = (await Authorization.AuthorizeAsync(User, ValoraPermissions.Action.Manage)).Succeeded;
    var user = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "anonymous";
    var scope=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes($"{x.OrganizationId:N}:{user}"))).ToLowerInvariant()[..24];
    var draftKey = $"valora:insight-rejection:{scope}:{x.Id:N}";
    var pending = x.Status == AiInsightStatuses.PendingReview;
}

<main class="valora-page v9-page" data-page="insight-details">
    <nav class="v9-breadcrumb" aria-label="Navegação estrutural">
        <a href="/Dashboard">Início</a>
        <span>/</span>
        <a href="/Intelligence">Inteligência Organizacional</a>
        <span>/</span>
        <a href="/Insights">Insights IA™</a>
        <span>/</span>
        <span>@x.Title</span>
    </nav>

    <partial name="_PageHeader" model="@(new PageHeaderViewModel(
        x.Title,
        x.Summary,
        "Insight Baseado em Evidências",
        x.Status,
        new[] { new PageHeaderAction("Voltar à Fila", Model.ReturnUrl) }
    ))" />

    <div class="row g-4 mt-1">
        <div class="col-lg-8 d-flex flex-column gap-4">
            <!-- Síntese e Contexto -->
            <section class="valora-card">
                <p class="eyebrow">Síntese e Contexto Sistêmico</p>
                <h2 class="h5 mb-3">Leitura Organizacional</h2>
                <p class="lead fs-6 text-dark">@x.Summary</p>

                <div class="row g-3 p-3 bg-light rounded-3 mt-2">
                    <div class="col-sm-6 col-md-3">
                        <small class="text-muted d-block">Dimensão Relacionada</small>
                        <strong class="text-dark">@(x.RelatedDimension ?? "Não vinculada")</strong>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <small class="text-muted d-block">Prioridade Estimada</small>
                        <strong class="text-dark">@x.Priority</strong>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <small class="text-muted d-block">Grau de Confiança</small>
                        <strong class="text-dark">@x.ConfidenceLevel</strong>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <small class="text-muted d-block">Versão de Revisão</small>
                        <strong class="text-dark">v@(x.ReviewVersion)</strong>
                    </div>
                </div>

                <div class="valora-alert valora-alert--info mt-3">
                    <strong>Diretriz Metodológica:</strong> A unidade de análise é o sistema organizacional. Esta leitura não deve ser utilizada para culpabilização individual, avaliação de desempenho pessoal ou diagnóstico psicológico.
                </div>
            </section>

            <!-- Entenda esta Análise (Recurso Mandatório Metodologia Valora™ - Sprint 32) -->
            <section class="valora-card border-primary" style="border-width: 2px;" aria-labelledby="explainability-heading">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <p class="eyebrow text-primary">Metodologia Valora™ · Rastreabilidade & Explicabilidade</p>
                        <h2 class="h5 m-0 text-dark fw-bold" id="explainability-heading">Entenda esta análise</h2>
                    </div>
                    <button type="button" class="valora-button valora-button--secondary btn-sm" data-action="open-explainability-modal" data-insight-id="@x.Id">
                        Abrir Modal Explicativo &rarr;
                    </button>
                </div>

                @if (Model.ExplainableAnalysis is not null)
                {
                    var exp = Model.ExplainableAnalysis;
                    <div class="d-flex flex-column gap-3">
                        <!-- 1. O que foi observado -->
                        <div class="p-3 bg-light rounded-3">
                            <strong class="d-block text-dark small mb-1">1. O que foi observado:</strong>
                            <p class="text-dark m-0">@exp.WhatWasObserved</p>
                        </div>

                        <!-- 2. Evidências consideradas -->
                        <div class="p-3 bg-light rounded-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-dark small">2. Evidências consideradas:</strong>
                                <span class="badge @(exp.Confidence.MeetsMinimumConvergentRule ? "bg-success" : "bg-warning text-dark")">
                                    @(exp.Confidence.MeetsMinimumConvergentRule ? "Regra de Convergência Atendida (>= 3 evidências)" : "Aguardando Evidências Convergentes")
                                </span>
                            </div>
                            <p class="small text-muted mb-2">@exp.Confidence.MethodologicalRule</p>
                            @if (exp.EvidenceConsidered.Count > 0)
                            {
                                <ul class="list-unstyled small m-0 d-flex flex-column gap-1">
                                    @foreach (var ev in exp.EvidenceConsidered)
                                    {
                                        <li class="p-2 bg-white rounded border d-flex justify-content-between align-items-center">
                                            <span>@ev.Summary</span>
                                            <span class="badge bg-secondary">@ev.SourceType</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <!-- 3. Capacidades relacionadas -->
                        <div class="p-3 bg-light rounded-3">
                            <strong class="d-block text-dark small mb-1">3. Capacidades relacionadas & Mapa Cognitivo:</strong>
                            @foreach (var cap in exp.RelatedCapabilities)
                            {
                                <div class="small text-muted">
                                    <span class="text-dark fw-semibold">@cap.DimensionName</span> · Pilar: @cap.Pillar
                                    <p class="m-0 mt-1">@cap.MethodologicalDefinition</p>
                                    @if (cap.CascadingInfluences.Count > 0)
                                    {
                                        <div class="mt-1">
                                            <strong class="text-dark">Efeito Cascata:</strong> @string.Join(", ", cap.CascadingInfluences)
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- 4. Grau de confiança -->
                        <div class="p-3 bg-light rounded-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-dark small">4. Grau de confiança:</strong>
                                <span class="badge @(exp.Confidence.Level == "Alta" ? "bg-success" : exp.Confidence.Level == "Moderada" ? "bg-info text-dark" : "bg-warning text-dark")">
                                    @exp.Confidence.Level
                                </span>
                            </div>
                            <p class="small text-muted m-0">@exp.Confidence.MethodologicalRule</p>
                        </div>

                        <!-- 5. Limitações metodológicas -->
                        <div class="p-3 bg-warning-subtle rounded-3 border border-warning">
                            <strong class="d-block text-dark small mb-1">5. Limitações & Princípio da Não-Causalidade:</strong>
                            <p class="small text-dark m-0 mb-1">@exp.Limitations.AssociationVsCausalityNotice</p>
                            <small class="text-muted d-block"><strong>Proteção Conceitual:</strong> @exp.Limitations.MethodologyBoundaries</small>
                        </div>

                        <!-- 6. Possível consequência -->
                        <div class="p-3 bg-light rounded-3">
                            <strong class="d-block text-dark small mb-1">6. Possível consequência:</strong>
                            <p class="small text-dark m-0">@exp.Consequence.SystemicRisk</p>
                        </div>

                        <!-- 7. Evolução no Valora Action™ -->
                        <div class="p-3 bg-light rounded-3">
                            <strong class="d-block text-dark small mb-1">7. Evolução recomendada & Decisão humana:</strong>
                            <p class="small text-dark mb-2">@exp.Evolution.RecommendedAction</p>
                            <div class="p-2 bg-white rounded border-start border-3 border-primary small text-dark">
                                <strong>Supervisão Humana Obrigatória:</strong> @exp.Evolution.HumanDecisionNotice
                            </div>
                        </div>
                    </div>
                }
            </section>

            <!-- Evidências e Limitações -->
            <section class="valora-card">
                <p class="eyebrow">Rastreabilidade Empírica</p>
                <h2 class="h5 mb-3">Evidências Consideradas</h2>

                @if (Model.Details.Evidence.Count == 0)
                {
                    <div class="p-3 bg-light rounded-3 border">
                        <p class="small text-muted mb-2">Não foi possível resolver vínculos canônicos de evidência para este registro. O resumo histórico é preservado abaixo:</p>
                        <blockquote class="m-0 border-start border-3 border-info ps-3 text-dark small">
                            @x.EvidenceSummary
                        </blockquote>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var e in Model.Details.Evidence)
                        {
                            <article class="p-3 bg-light rounded-3 border">
                                <h3 class="h6 text-dark mb-2">@e.Summary</h3>
                                <div class="row g-2 small text-muted">
                                    <div class="col-sm-6 col-md-3"><strong>Tipo:</strong> @e.Type</div>
                                    <div class="col-sm-6 col-md-3"><strong>Origem:</strong> @e.SourceType</div>
                                    <div class="col-sm-6 col-md-3"><strong>Contexto:</strong> @(e.Dimension ?? e.IndexCode ?? "Agregado")</div>
                                    <div class="col-sm-6 col-md-3"><strong>Data:</strong> @e.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            </article>
                        }
                    </div>
                }

                <div class="mt-3 pt-3 border-top">
                    <strong class="small d-block text-dark">Limitação Declarada:</strong>
                    <p class="small text-muted m-0">
                        @(x.Limitation ?? "Nenhuma limitação adicional registrada pela origem do diagnóstico.")
                    </p>
                </div>
            </section>

            <!-- Planos Vinculados -->
            <section class="valora-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <p class="eyebrow">Ação Executiva</p>
                        <h2 class="h5 m-0">Iniciativas e Planos de Ação Vinculados</h2>
                    </div>
                    @if (canCreate && x.Status is AiInsightStatuses.Approved or AiInsightStatuses.ConvertedToAction)
                    {
                        <a class="valora-button valora-button--primary btn-sm" asp-controller="ActionCenter" asp-action="CreatePlan" asp-route-originType="ai_insight" asp-route-originId="@x.Id" asp-route-returnUrl="@($"/Insights/Details/{x.Id}?returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}")">
                            + Novo Plano de Ação
                        </a>
                    }
                </div>

                @if (Model.Details.Plans.Count == 0)
                {
                    <div class="valora-empty py-3 text-center">
                        <p class="text-muted small m-0">Nenhum plano de ação foi criado a partir deste insight até o momento.</p>
                        @if (x.Status == AiInsightStatuses.PendingReview)
                        {
                            <small class="text-muted d-block mt-1">Valide e aprove o insight para desbloquear a criação de planos rastreáveis.</small>
                        }
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var p in Model.Details.Plans)
                        {
                            <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <strong class="d-block text-dark">@p.Title</strong>
                                    <small class="text-muted">
                                        Responsável: <strong>@(p.OwnerName ?? "Não definido")</strong> &bull; Prazo: <strong>@(p.DueAt?.ToString("dd/MM/yyyy") ?? "Não definido")</strong>
                                    </small>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge bg-secondary">@ActionStatuses.Label(p.Status) · @p.ProgressPercent%</span>
                                    <a class="valora-button valora-button--ghost btn-sm" asp-controller="ActionCenter" asp-action="PlanDetails" asp-route-id="@p.Id" asp-route-returnUrl="@($"/Insights/Details/{x.Id}?returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}")">
                                        Abrir Plano
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>

        <!-- Coluna Lateral Direita -->
        <div class="col-lg-4 d-flex flex-column gap-4">
            <!-- Revisão Humana -->
            <section class="valora-card">
                <p class="eyebrow">Governança Editorial</p>
                <h2 class="h5 mb-3">Revisão Humana Mandatória</h2>

                @if (pending)
                {
                    <div class="p-3 bg-warning bg-opacity-10 border border-warning rounded-3 mb-3">
                        <span class="badge bg-warning text-dark mb-1">Pendente de Revisão</span>
                        <p class="small text-muted m-0">
                            Este insight aguarda validação de um líder ou comitê antes de se tornar oficial ou gerar planos de ação executivos.
                        </p>
                    </div>

                    @if (!canApprove && !canReject)
                    {
                        <div class="valora-alert valora-alert--info">
                            Seu perfil atual não possui permissão para aprovar ou rejeitar insights de inteligência artificial.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @if (canApprove)
                            {
                                <form method="post" asp-action="Approve" asp-route-id="@x.Id">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                    <input type="hidden" name="commandKey" value="@Guid.NewGuid().ToString("N")" />
                                    <input type="hidden" name="expectedVersion" value="@x.ReviewVersion" />
                                    <button class="valora-button valora-button--primary w-100" type="submit" data-confirm="A aprovação registra revisão editorial humana sobre o insight. Deseja confirmar?">
                                        ✓ Aprovar Insight
                                    </button>
                                </form>
                            }
                            @if (canReject)
                            {
                                <button class="valora-button valora-button--danger w-100" type="button" data-dialog-target="#rejectInsightDialog">
                                    ✕ Rejeitar com Justificativa
                                </button>
                            }
                        </div>
                    }
                }
                else
                {
                    var statusDesc = x.Status switch
                    {
                        AiInsightStatuses.Approved => "Aprovado",
                        AiInsightStatuses.Rejected => "Rejeitado",
                        AiInsightStatuses.ConvertedToAction => "Em Execução",
                        _ => x.Status
                    };

                    <div class="p-3 bg-light rounded-3 border">
                        <span class="badge bg-success mb-2">@statusDesc</span>
                        <p class="small text-muted m-0">
                            Revisado em <strong>@(x.ReviewedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Data não disponível")</strong>
                        </p>
                    </div>

                    <div id="recoveredDraftNotice" class="valora-alert valora-alert--info mt-3" hidden>
                        Há uma justificativa não enviada recuperável neste navegador.
                        <button type="button" class="valora-button valora-button--ghost btn-sm mt-1" id="discardRecoveredDraft">Descartar rascunho</button>
                        <pre id="recoveredDraftText" class="small mt-2 p-2 bg-white rounded border"></pre>
                    </div>
                }
            </section>

            <!-- Auditoria e Rastreabilidade -->
            <section class="valora-card">
                <p class="eyebrow">Auditoria</p>
                <h2 class="h5 mb-2">Rastreabilidade</h2>
                <ul class="list-unstyled small text-muted d-flex flex-column gap-2 m-0">
                    <li><strong>Criado em:</strong> @x.CreatedAt.ToString("dd/MM/yyyy HH:mm")</li>
                    <li><strong>Versão editorial:</strong> @x.ReviewVersion</li>
                    <li><strong>Execução de IA:</strong> <code class="small">@(x.AiRunId.ToString("N")[..8])</code></li>
                </ul>
                <div class="pt-3 mt-3 border-top d-flex gap-2">
                    <a class="valora-button valora-button--ghost btn-sm" asp-controller="Decisions" asp-action="Index">Decisões</a>
                    <a class="valora-button valora-button--ghost btn-sm" asp-controller="Reports" asp-action="Index">Relatórios</a>
                </div>
            </section>
        </div>
    </div>

    <!-- Modal de Rejeição -->
    @if (pending && canReject)
    {
        <dialog class="confirmation-modal" id="rejectInsightDialog" aria-labelledby="rejectInsightTitle">
            <form method="post" asp-action="Reject" asp-route-id="@x.Id">
                @Html.AntiForgeryToken()
                <header>
                    <h2 id="rejectInsightTitle" class="h5 m-0">Rejeitar Insight de IA</h2>
                </header>
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <input type="hidden" name="InsightId" value="@x.Id" />
                <input type="hidden" name="CommandKey" value="@Guid.NewGuid().ToString("N")" />
                <input type="hidden" name="ExpectedVersion" value="@x.ReviewVersion" />

                <div class="my-3">
                    <label class="form-label small" for="rejectInsightReason">
                        Justificativa da rejeição <span class="text-danger">*</span>
                    </label>
                    <textarea class="form-control" id="rejectInsightReason" name="Reason" required minlength="10" maxlength="1000" rows="5" placeholder="Explique os motivos da rejeição (mínimo de 10 caracteres)...">@ViewData["RejectionReason"]</textarea>
                    <small class="form-text text-muted">Entre 10 e 1.000 caracteres.</small>
                </div>

                <div asp-validation-summary="All" role="alert" class="text-danger small"></div>

                <footer class="d-flex justify-content-end gap-2 pt-2 border-top">
                    <button type="button" class="valora-button valora-button--ghost btn-sm" data-dialog-close>Cancelar</button>
                    <button type="button" class="valora-button valora-button--ghost btn-sm" id="discardRejectDraft">Descartar rascunho</button>
                    <button class="valora-button valora-button--danger btn-sm" type="submit">Confirmar Rejeição</button>
                </footer>
            </form>
        </dialog>
    }
</main>

<script nonce="@Context.Items["CspNonce"]">
(() => {
    const key = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(draftKey));
    const version = @x.ReviewVersion;
    const field = document.getElementById('rejectInsightReason');
    const notice = document.getElementById('recoveredDraftNotice');
    const text = document.getElementById('recoveredDraftText');

    let read = () => null, write = () => {}, remove = () => {};
    try {
        read = () => {
            try {
                const raw = sessionStorage.getItem(key);
                if (!raw) return null;
                const value = JSON.parse(raw);
                return value && typeof value === 'object' && typeof value.text === 'string' ? value : null;
            } catch { return null; }
        };
        write = v => { try { sessionStorage.setItem(key, JSON.stringify(v)); } catch {} };
        remove = () => { try { sessionStorage.removeItem(key); } catch {} };
    } catch {}

    @if (TempData["RejectionDraftSent"]?.ToString() == x.Id.ToString("N"))
    {
        <text>try { remove(); } catch {}</text>
    }

    const draft = read();
    if (field) {
        if (!field.value && draft?.text) field.value = draft.text;
        field.addEventListener('input', () => {
            try { write({ text: field.value, version, updatedAt: new Date().toISOString() }); } catch {}
        });
        document.getElementById('discardRejectDraft')?.addEventListener('click', () => {
            try { remove(); } catch {}
            field.value = '';
        });
        if (@((ViewData["OpenRejectDialog"] as bool? == true || TempData["OpenRejectDialog"] is not null).ToString().ToLowerInvariant())) {
            document.getElementById('rejectInsightDialog')?.showModal();
            field.focus();
        }
    } else if (draft?.text && notice && text) {
        notice.hidden = false;
        text.textContent = draft.text;
        document.getElementById('discardRecoveredDraft')?.addEventListener('click', () => {
            try { remove(); } catch {}
            notice.hidden = true;
        });
    }
})();
</script>
