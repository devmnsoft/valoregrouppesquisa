@model Valora.Web.Models.ViewModels.IntelligenceWorkspaceViewModel
@{ ViewData["Title"] = Model.Title; var id = ViewData["BenchmarkId"]?.ToString(); var compare = ViewData["CompareMode"] is true; var admin = ViewData["AdminMode"] is true; }
<main class="valora-page v9-page benchmark-premium" data-benchmark data-id="@id" data-compare="@compare.ToString().ToLowerInvariant()" data-admin="@admin.ToString().ToLowerInvariant()">
 <nav class="v9-breadcrumb"><a href="/Intelligence">Inteligência Organizacional</a><span>/</span><a href="/Benchmark">Benchmark</a></nav>
 <header class="v9-hero v9-hero--executive"><div><p class="eyebrow">Valora Benchmark™</p><h1>Posicionamento organizacional</h1><p>Compare ciclos e recortes internos com evidência, privacidade e limitações explícitas.</p></div><div><a class="valora-button valora-button--ghost" href="/Benchmark/Compare">Comparar diagnósticos</a></div></header>
 <div class="valora-alert" data-external><strong>Referência externa.</strong> Benchmark externo indisponível por amostra insuficiente.</div>
 <section class="v9-kpis"><article><span>Maturidade atual</span><strong data-score>—</strong><small data-level>Sem snapshot</small></article><article><span>Evolução</span><strong data-delta>—</strong><small>Último ciclo comparável</small></article><article><span>Respostas</span><strong data-responses>—</strong><small>Amostra agregada</small></article><article><span>Dimensões críticas</span><strong data-critical>—</strong><small>Prioridade por evidência</small></article></section>
 <section class="valora-card" data-comparison hidden><div class="v9-section-title"><div><p class="eyebrow">Comparação controlada</p><h2>Selecione snapshots reais</h2></div></div><form data-compare-form><label>Diagnóstico atual<select class="valora-input" name="baseSnapshotId" required></select></label><label>Diagnóstico anterior<select class="valora-input" name="comparedSnapshotId"><option value="">Anterior automático</option></select></label><button class="valora-button valora-button--primary">Comparar</button></form><div data-compare-result></div></section>
 <section class="valora-card" data-admin-panel hidden><div class="v9-section-title"><div><p class="eyebrow">Governança</p><h2>Amostra e anonimização</h2></div></div><form data-settings><label>Mínimo de organizações<input class="valora-input" type="number" name="minimumOrganizations" min="2" /></label><label>Mínimo de respostas<input class="valora-input" type="number" name="minimumResponses" min="5" /></label><label><input type="checkbox" name="externalEnabled" /> Benchmark externo habilitado</label><label><input type="checkbox" name="requireAnonymization" checked /> Anonimização obrigatória</label><button class="valora-button valora-button--primary">Salvar regras</button></form></section>
 <section class="valora-card"><div class="v9-section-title"><div><p class="eyebrow">Leitura multidimensional</p><h2>Atual × referência disponível</h2></div></div><div class="valora-skeleton" data-loading>Consultando snapshots autorizados…</div><div class="valora-alert valora-alert--danger" data-error hidden></div><div class="benchmark-dimensions" data-dimensions></div><div class="valora-empty" data-empty hidden><h3>Primeiro benchmark ainda não gerado</h3><p>Gere um snapshot a partir de um diagnóstico concluído. Nenhuma média externa será estimada.</p></div></section>
 <section class="valora-card"><div class="v9-section-title"><div><p class="eyebrow">Histórico</p><h2>Snapshots gerados</h2></div></div><div data-snapshots></div></section>
</main>
@section Scripts { <script src="/js/pages/intelligence-benchmark.js" asp-append-version="true"></script><script src="/js/pages/intelligence-workspace.js" asp-append-version="true"></script> }
