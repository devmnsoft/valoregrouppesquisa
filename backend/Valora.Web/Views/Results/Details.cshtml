@model ResultDetailsViewModel
@{ ViewData["Title"] = "Detalhes do resultado"; }
<section class="valora-page" data-page="result-page">
  <input asp-for="ResponseId" type="hidden">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel("Resultado executivo", "Compreenda a leitura processada e transforme evidências revisadas em acompanhamento.", "Resultados", "Leitura protegida", new[] { new PageHeaderAction("Voltar às respostas", "/Responses", Icon: "chevron-left") }))" />
  <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel("Como usar esta leitura", "Revise as evidências e limitações antes de compartilhar ou gerar um certificado. O acesso usa sua sessão autenticada e o escopo da organização."))" />
  <div class="valora-card result-executive">
    <div class="valora-error-state d-none" role="alert" aria-live="assertive"></div>
    <div class="valora-empty-state" aria-live="polite">Carregando leitura segura…</div>
    <div data-results></div>
  </div>
</section>
@section Scripts { <script src="/js/pages/result-page.js"></script> }
