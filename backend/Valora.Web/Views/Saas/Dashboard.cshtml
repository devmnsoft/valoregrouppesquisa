@{ ViewData["Title"] ??= "SaaS"; var mode = ViewData["Mode"]?.ToString() ?? "usage"; }
<main class="saas-console" data-saas-mode="@mode">
  <header class="saas-hero">
    <div><span class="saas-eyebrow">Valora Insight™ · SaaS</span><h1>@ViewData["Title"]</h1><p>@ViewData["Subtitle"]</p></div>
    <a class="saas-upgrade" href="/Organization/Upgrade">Conhecer upgrade</a>
  </header>
  <section class="saas-kpis" aria-label="Resumo da assinatura">
    <article><span>Plano atual</span><strong data-field="plan">Carregando…</strong><small data-field="status">Assinatura</small></article>
    <article><span>Próxima renovação</span><strong data-field="renewal">—</strong><small>Ciclo contratado</small></article>
    <article><span>Consumo mensal</span><strong data-field="consumption">—</strong><div class="saas-progress"><i data-field="progress"></i></div></article>
  </section>
  <section class="saas-panel"><div><h2>Limites e recursos</h2><p>Acompanhe o que está disponível. Ao atingir um limite, os dados existentes permanecem preservados.</p></div>
    <div class="saas-table-wrap"><table><thead><tr><th>Recurso</th><th>Uso</th><th>Limite</th><th>Situação</th></tr></thead><tbody data-field="metrics"><tr><td colspan="4">Carregando dados da organização…</td></tr></tbody></table></div>
  </section>
</main>

<script>
document.addEventListener('DOMContentLoaded', async () => {
  const root = document.querySelector('[data-saas-mode]');
  const field = name => root.querySelector(`[data-field="${name}"]`);
  try {
    const [subscriptionResponse, usageResponse] = await Promise.all([
      fetch('/api/v1/subscription', { credentials: 'same-origin' }),
      fetch('/api/v1/usage/current', { credentials: 'same-origin' })
    ]);
    if (!subscriptionResponse.ok || !usageResponse.ok) throw new Error('unavailable');
    const subscription = await subscriptionResponse.json();
    const usage = await usageResponse.json();
    field('plan').textContent = subscription.planName || subscription.planId || 'Plano atual';
    field('status').textContent = subscription.status || '—';
    field('renewal').textContent = subscription.renewalAt ? new Date(subscription.renewalAt).toLocaleDateString('pt-BR') : 'Sem renovação agendada';
    const metrics = usage.metrics || [];
    const highest = metrics.reduce((value, metric) => Math.max(value, metric.percentUsed || 0), 0);
    field('consumption').textContent = `${highest}%`;
    field('progress').style.width = `${Math.min(100, highest)}%`;
    field('metrics').innerHTML = metrics.map(metric => `<tr><td>${metric.name}</td><td>${metric.used}</td><td>${metric.unlimited ? 'Ilimitado' : metric.limit}</td><td>${metric.limitReached ? 'Limite atingido' : 'Disponível'}</td></tr>`).join('') || '<tr><td colspan="4">Nenhum consumo registrado neste mês.</td></tr>';
  } catch {
    field('metrics').innerHTML = '<tr><td colspan="4">Não foi possível carregar o consumo agora. Tente novamente em instantes.</td></tr>';
  }
});
</script>
