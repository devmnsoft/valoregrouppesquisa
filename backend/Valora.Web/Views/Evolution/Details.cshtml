@model Valora.Web.Controllers.EvolutionDetailsViewModel

@{
    ViewData["Title"]=Model.Cycle.Title;
}

<main class="valora-page"><header class="leadership-hero"><div><p class="eyebrow">@Model.Cycle.Status · @Model.Cycle.Trend</p><h1>@Model.Cycle.Title</h1><p>@Model.Cycle.EvidenceSummary</p></div></header><section class="valora-card"><h2>Snapshots preservados</h2>@if(Model.Snapshots.Count==0){<p>Amostra insuficiente: gere a primeira leitura quando houver evidências.</p>}@foreach(var s in Model.Snapshots){<article><strong>@s.CalculatedAt.ToString("dd/MM/yyyy HH:mm") · @s.Trend</strong><p>@s.Interpretation</p><small>@s.EvidenceSummary</small></article>}<form method="post" action="/Evolution/Cycles/@Model.Cycle.Id/Snapshot"><h3>Gerar snapshot</h3><textarea name="evidence" required placeholder="Evidências observadas"></textarea><textarea name="interpretation" required placeholder="Interpretação sem atribuir causalidade"></textarea><textarea name="recommendation" required placeholder="Recomendação para decisão humana"></textarea><button class="btn btn-primary">Preservar nova leitura</button></form></section></main>
