@{
  var groups = new[] {
    new { Title = "Visão Geral", Items = new[] {
      new { Label="Visão Executiva", Url="/Dashboard", Roles="admin_valora,consultor_valora,empresa_admin,gestor_pesquisa,analista_resultados,gestor_area", Permission="" },
      new { Label="Diagnósticos gratuitos", Url="/FreeDiagnostics", Roles="admin_valora,consultor_valora,empresa_admin,gestor_pesquisa,analista_resultados", Permission="canViewResponses" },
      new { Label="Respostas", Url="/Responses", Roles="admin_valora,consultor_valora,empresa_admin,gestor_pesquisa,analista_resultados,gestor_area", Permission="canViewResponses" }
    }},
    new { Title = "Gestão", Items = new[] {
      new { Label="Organizações", Url="/Organization", Roles="admin_valora,consultor_valora", Permission="" },
      new { Label="Usuários", Url="/Users", Roles="admin_valora,consultor_valora,empresa_admin", Permission="" },
      new { Label="Planos", Url="/Plans", Roles="admin_valora", Permission="" },
      new { Label="Módulos", Url="/Modules", Roles="admin_valora", Permission="" }
    }},
    new { Title = "Diagnósticos", Items = new[] {
      new { Label="Formulários", Url="/Forms", Roles="admin_valora,consultor_valora,empresa_admin,gestor_pesquisa", Permission="" },
      new { Label="Pesquisas", Url="/Surveys", Roles="admin_valora,consultor_valora,empresa_admin,gestor_pesquisa", Permission="" },
      new { Label="Links públicos", Url="/Surveys/PublicLinks", Roles="admin_valora,consultor_valora,empresa_admin,gestor_pesquisa", Permission="" },
      new { Label="Convites", Url="/Invites", Roles="admin_valora,consultor_valora,empresa_admin,gestor_pesquisa", Permission="" }
    }},
    new { Title = "Inteligência", Items = new[] {
      new { Label="Relatórios", Url="/Reports", Roles="admin_valora,consultor_valora,empresa_admin,analista_resultados,gestor_area", Permission="" },
      new { Label="Certificados", Url="/Certificates", Roles="admin_valora,consultor_valora,empresa_admin,analista_resultados", Permission="" },
      new { Label="Exportações", Url="/Exports", Roles="admin_valora,consultor_valora,empresa_admin,analista_resultados", Permission="" },
      new { Label="Benchmark", Url="/Benchmark", Roles="admin_valora,consultor_valora,empresa_admin,analista_resultados", Permission="" }
    }},
    new { Title = "Operação", Items = new[] {
      new { Label="Comunicações", Url="/Communications", Roles="admin_valora,consultor_valora,empresa_admin", Permission="" },
      new { Label="E-mail", Url="/Email/Templates", Roles="admin_valora,consultor_valora,empresa_admin", Permission="" },
      new { Label="LGPD", Url="/Lgpd", Roles="admin_valora,consultor_valora,empresa_admin", Permission="" },
      new { Label="Auditoria", Url="/Audit", Roles="admin_valora,consultor_valora", Permission="" },
      new { Label="Migração", Url="/Migration", Roles="admin_valora", Permission="" },
      new { Label="Configurações", Url="/Settings", Roles="admin_valora,consultor_valora,empresa_admin", Permission="" },
      new { Label="Status", Url="/EnvironmentStatus", Roles="admin_valora,consultor_valora", Permission="" }
    }}
  };
}
<aside class="app-sidebar valora-sidebar d-none d-lg-flex" data-admin-sidebar>
  <a class="brand-mark" data-brand-root href="/Dashboard" aria-label="Valora Group — Visão Executiva">
    <span class="brand-text"><strong>Valora Group™</strong><small>Governance • Controller • Advisory</small></span>
  </a>
  <div class="sidebar-context"><small>Organização atual</small><strong data-current-organization>Carregando organização…</strong><span class="valora-badge" data-current-plan>Plano</span></div>
  <nav class="sidebar-nav valora-sidebar-nav" aria-label="Menu administrativo por perfil">
    @foreach (var group in groups) {<section class="sidebar-group"><p>@group.Title</p>@foreach (var item in group.Items) {<a class="nav-link" href="@item.Url" data-allowed-roles="@item.Roles" data-required-permission="@item.Permission">@item.Label</a>}</section>}
  </nav>
</aside>
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
  <div class="offcanvas-header"><h2 id="mobileSidebarLabel" class="h6 mb-0">Menu Valora</h2><button type="button" class="icon-button" data-action="close-navigation" aria-label="Fechar navegação" title="Fechar navegação"><valora-icon name="x" /></button></div>
  <div class="offcanvas-body valora-sidebar-nav">@foreach (var group in groups) {<section class="sidebar-group"><p>@group.Title</p>@foreach (var item in group.Items) {<a class="nav-link" href="@item.Url" data-allowed-roles="@item.Roles" data-required-permission="@item.Permission">@item.Label</a>}</section>}</div>
</div>
