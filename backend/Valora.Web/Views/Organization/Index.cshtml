@{ ViewData["Title"] = "Organização"; }
<section class="page-card official-module" data-page="organization-page">
  <header class="module-heading"><div><p class="eyebrow">Administração empresarial</p><h1>Organização 360</h1><p class="text-muted">Perfil, identidade, assinatura, consumo e evolução da sua empresa.</p></div><button class="btn btn-outline-primary" data-refresh>Atualizar dados</button></header>
  <div class="alert alert-danger d-none mt-3" role="alert" data-error></div><div class="alert alert-success d-none mt-3" role="status" data-success></div>
  <nav class="nav nav-tabs mt-4" role="tablist"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#org-overview">Visão geral</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#org-profile">Dados da empresa</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#org-branding">Identidade visual</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#org-plan">Plano e consumo</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#org-onboarding">Onboarding</button></nav>
  <div class="tab-content py-4"><div class="tab-pane fade show active" id="org-overview"><div class="row g-3" data-summary-cards></div></div>
  <div class="tab-pane fade" id="org-profile"><form data-organization-form class="row g-3"><input type="hidden" name="expectedVersion"><div class="col-md-6"><label class="form-label">Nome público</label><input class="form-control" name="publicName" maxlength="160" required></div><div class="col-md-6"><label class="form-label">E-mail</label><input class="form-control" name="email" type="email" maxlength="254" required></div><div class="col-md-6"><label class="form-label">Telefone</label><input class="form-control" name="phone" maxlength="24"></div><div class="col-md-3"><label class="form-label">Idioma</label><select class="form-select" name="defaultLanguageCode"><option value="pt-BR">Português (Brasil)</option><option value="en-US">English</option><option value="es-ES">Español</option></select></div><div class="col-md-3"><label class="form-label">Fuso horário</label><input class="form-control" name="timeZone" required></div><div><button class="btn btn-primary" type="submit">Salvar alterações</button></div></form></div>
  <div class="tab-pane fade" id="org-branding"><form data-branding-form class="row g-4"><input type="hidden" name="version"><div class="col-lg-7"><div class="row g-3"><div class="col-sm-6"><label class="form-label">Cor primária</label><div class="color-field"><input type="color" data-color-picker="primaryColor"><input class="form-control" name="primaryColor" pattern="#[0-9A-Fa-f]{6}" required></div></div><div class="col-sm-6"><label class="form-label">Cor secundária</label><div class="color-field"><input type="color" data-color-picker="secondaryColor"><input class="form-control" name="secondaryColor" pattern="#[0-9A-Fa-f]{6}" required></div></div><div class="col-12"><label class="form-label">Logotipo (HTTPS ou asset interno)</label><input class="form-control" name="logoUrl" placeholder="/img/brand/sua-marca.svg"></div><div class="col-md-8"><label class="form-label">Slug público</label><div class="input-group"><span class="input-group-text">/o/</span><input class="form-control" name="publicSlug" required></div></div><div class="col-md-4"><label class="form-label">White label</label><div class="form-check form-switch mt-2"><input class="form-check-input" name="whiteLabelEnabled" type="checkbox"><label class="form-check-label">Aplicar no sistema</label></div></div><div class="col-12"><span class="plan-capability" data-branding-plan></span></div><div><button class="btn btn-primary" type="submit">Salvar identidade visual</button></div></div></div><div class="col-lg-5"><aside class="branding-preview" data-branding-preview><header><span data-preview-logo>V</span><strong>Portal da organização</strong></header><article><small>Indicador executivo</small><strong>74%</strong><p>Prévia de card usando sua identidade.</p><button type="button">Ação principal</button></article></aside></div></form></div><div class="tab-pane fade" id="org-plan"><div data-subscription></div><div data-usage></div></div><div class="tab-pane fade" id="org-onboarding"><div data-onboarding></div></div></div>
</section>
@section Scripts { <script src="/js/pages/organization-page.js"></script> }
