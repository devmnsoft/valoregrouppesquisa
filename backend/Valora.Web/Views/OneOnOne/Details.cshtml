@model Valora.Application.OneOnOne.OneOnOneDetailsDto
@{ViewData["Title"]=Model.Session.Title;}<main class="valora-page one-on-one"><header class="leadership-hero"><div><p class="eyebrow">@Model.Session.LeaderName &amp; @Model.Session.ParticipantName</p><h1>@Model.Session.Title</h1><p>@(Model.Session.ScheduledAt?.ToString("dd/MM/yyyy 'às' HH:mm")??"Data a definir") <span class="badge status-@Model.Session.Status">@Model.Session.Status</span></p></div></header><div class="ooo-layout"><div><section class="valora-card"><div class="section-heading"><h2>Pauta</h2>@if(Model.Agenda.Count==0){<form method="post" action="/OneOnOne/Sessions/@Model.Session.Id/Agenda"><input type="hidden" name="evidence" value="@Model.Session.EvidenceSummary"/><button class="btn btn-primary">Gerar pauta sugerida</button></form>}</div>@if(Model.Agenda.Count==0){<div class="valora-empty"><h3>Pauta aberta à escuta</h3><p>A IA pode propor perguntas, nunca conclusões sobre pessoas.</p></div>}@foreach(var x in Model.Agenda){<article class="agenda-item"><span>@x.SortOrder</span><div><strong>@x.Title</strong><p>@x.Description</p><small>Evidência: @x.Evidence</small></div></article>}</section><section class="valora-card"><h2>Feedbacks construtivos</h2>@foreach(var x in Model.Feedbacks){<blockquote><p>@x.Feedback</p><small>Evidência: @x.Evidence</small></blockquote>}<form method="post" action="/OneOnOne/Sessions/@Model.Session.Id/Feedback" class="ooo-form"><label>Destinatário<input name="toUserId" value="@Model.Session.ParticipantUserId" required/></label><label class="wide">Feedback<textarea name="feedbackText" required></textarea></label><label class="wide">Evidência<textarea name="evidence" required></textarea></label><button class="btn btn-primary">Registrar feedback</button></form></section><section class="valora-card private-card"><div class="section-heading"><h2>Notas privadas</h2><span class="privacy-mark">🔒 Visível apenas ao autor ou perfil autorizado</span></div>@foreach(var x in Model.PrivateNotes){<p>@x.Note <small>@x.CreatedAt.ToString("dd/MM HH:mm")</small></p>}<form method="post" action="/OneOnOne/Sessions/@Model.Session.Id/PrivateNote"><textarea name="note" required placeholder="Nota privada — não entra em relatórios nem sugestões de IA"></textarea><button class="btn btn-outline-secondary">Salvar nota privada</button></form></section></div><aside><section class="valora-card"><h2>Compromissos</h2>@foreach(var x in Model.Commitments){<article class="commitment"><strong>@x.Title</strong><span class="badge">@x.Status</span><small>Prazo @x.DueAt.ToString("dd/MM/yyyy")</small></article>}<form method="post" action="/OneOnOne/Sessions/@Model.Session.Id/Commitment" class="stack-form"><input name="title" required placeholder="Compromisso"/><textarea name="description" placeholder="Resultado esperado"></textarea><input name="responsibleUserId" value="@Model.Session.LeaderUserId" required/><input name="dueAt" type="date" required/><label><input type="checkbox" name="createAction" value="true"/> Vincular ao Action Center</label><button class="btn btn-primary">Adicionar</button></form></section>@if(Model.Session.Status!="completed"){<section class="valora-card"><h2>Concluir sessão</h2><form method="post" action="/OneOnOne/Sessions/@Model.Session.Id/Complete" class="stack-form"><textarea name="Summary" minlength="20" required placeholder="Resumo da conversa (mínimo de 20 caracteres)"></textarea><textarea name="EvidenceSummary" required placeholder="Evidências consideradas"></textarea><button class="btn btn-primary">Concluir e registrar evolução</button></form></section>}else{<section class="valora-card"><h2>Resumo</h2><p>@Model.Session.Summary</p><small>Evidência: @Model.Session.EvidenceSummary</small></section>}</aside></div></main>
