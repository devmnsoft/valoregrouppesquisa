@model Valora.Web.Models.ViewModels.CertificatesIndexViewModel
@{
    ViewData["Title"] = "Certificados";
}

<div class="container-fluid px-0 py-2">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                    <i class="bi bi-patch-check me-1"></i>Inteligência Valora
                </span>
                <span class="text-muted small">Governança &amp; Emissão Oficial</span>
            </div>
            <h1 class="h3 fw-bold text-dark mb-1">Certificados de Diagnóstico</h1>
            <p class="text-muted mb-0">
                Consulte, emita, baixe e valide certificados vinculados aos ciclos diagnósticos concluídos.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" asp-controller="Responses" class="btn btn-outline-secondary">
                <i class="bi bi-card-checklist me-1"></i>Submissões &amp; Respostas
            </a>
            <a href="/Certificates/Validate" target="_blank" class="btn btn-outline-primary">
                <i class="bi bi-shield-check me-1"></i>Portal de Validação Pública
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <div>@successMsg</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <div>@errorMsg</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <!-- Callout de Governança -->
    <div class="alert alert-warning border-warning border-opacity-25 bg-warning bg-opacity-10 mb-4 p-3 rounded-3" role="status">
        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-shield-exclamation text-warning fs-5 mt-1"></i>
            <div>
                <strong>Conclusão ≠ certificação de maturidade.</strong>
                <p class="small mb-0 text-dark">
                    A conclusão do questionário não constitui, por si só, certificação de maturidade ou classificação automática.
                    Quando os critérios de maturidade estiverem indefinidos no modelo, a elegibilidade permanece pendente de revisão.
                    Consulte a <a href="/Reports" class="fw-semibold text-decoration-none">Central de Entregas</a> para conferir relatórios detalhados.
                </p>
            </div>
        </div>
    </div>

    <!-- Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-medium">Total Registrado</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary p-2 rounded-circle">
                        <i class="bi bi-award fs-6"></i>
                    </span>
                </div>
                <div class="fs-3 fw-bold text-dark">@Model.TotalCertificates</div>
                <span class="text-muted small">documentos emitidos pela organização</span>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-medium">Certificados Válidos</span>
                    <span class="badge bg-success bg-opacity-10 text-success p-2 rounded-circle">
                        <i class="bi bi-check-circle fs-6"></i>
                    </span>
                </div>
                <div class="fs-3 fw-bold text-success">@Model.IssuedCount</div>
                <span class="text-muted small">aptos para consulta pública e download</span>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-medium">Revogados</span>
                    <span class="badge bg-danger bg-opacity-10 text-danger p-2 rounded-circle">
                        <i class="bi bi-slash-circle fs-6"></i>
                    </span>
                </div>
                <div class="fs-3 fw-bold text-danger">@Model.RevokedCount</div>
                <span class="text-muted small">inválidos para verificação externa</span>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="search" name="search" value="@Model.Search" class="form-control border-start-0" placeholder="Buscar por participante, código de validação, organização ou nível de maturidade..." />
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">Filtrar</button>
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Certificates Table Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h2 class="h5 fw-bold text-dark mb-0">
                <i class="bi bi-file-earmark-check text-primary me-2"></i>Certificados Emitidos
            </h2>
            <span class="badge bg-secondary bg-opacity-10 text-secondary">
                @Model.TotalCertificates @(Model.TotalCertificates == 1 ? "registro" : "registros")
            </span>
        </div>

        <div class="card-body p-0">
            @if (Model.Certificates.Count == 0)
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-patch-question fs-1 text-secondary mb-2 d-block"></i>
                    <h3 class="h6 fw-semibold text-dark mb-1">Nenhum certificado encontrado</h3>
                    <p class="small text-muted mb-3">
                        Certificados são gerados após a conclusão de diagnósticos e validação de suficiência amostral.
                    </p>
                    <a asp-action="Index" asp-controller="Responses" class="btn btn-sm btn-primary">
                        Consultar Respostas Concluídas
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th scope="col" class="ps-4">Participante</th>
                                <th scope="col">Código de Validação</th>
                                <th scope="col">Maturidade / Nível</th>
                                <th scope="col">Emissão</th>
                                <th scope="col">Situação</th>
                                <th scope="col" class="text-end pe-4">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Certificates)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-semibold text-dark">@c.ParticipantName</div>
                                        <div class="small text-muted">@c.ParticipantEmailMasked · @c.CompanyName</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <code class="text-primary bg-light px-2 py-1 rounded small user-select-all">@c.ValidationCode</code>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Copiar código de validação" onclick="copyCode('@c.ValidationCode')">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @c.Level
                                        </span>
                                        @if (c.TotalScore.HasValue)
                                        {
                                            <small class="text-muted d-block mt-1">Pontuação: @c.TotalScore.Value.ToString("F1")</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="small text-muted">
                                            @(c.IssuedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @c.StatusBadgeClass">
                                            @c.StatusDisplayName
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            @if (c.IsIssued)
                                            {
                                                <a href="/Certificates/@c.Id/Download" class="btn btn-outline-primary" title="Baixar certificado oficial">
                                                    <i class="bi bi-download me-1"></i>Baixar
                                                </a>
                                                <a href="/Certificates/Validate/@c.ValidationCode" target="_blank" class="btn btn-outline-secondary" title="Verificar no portal público">
                                                    <i class="bi bi-box-arrow-up-right me-1"></i>Validar
                                                </a>
                                                <form method="post" asp-action="Revoke" asp-controller="Certificates" asp-route-id="@c.Id" class="d-inline ms-1">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger" title="Revogar certificado" onclick="return confirm('Deseja realmente revogar este certificado? Ele perderá a validade na consulta pública.');">
                                                        <i class="bi bi-x-circle me-1"></i>Revogar
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Revogado</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Quick Validation & Guidelines Footer -->
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h3 class="h6 fw-bold text-dark mb-0">
                        <i class="bi bi-search text-primary me-2"></i>Validação Rápida de Autenticidade
                    </h3>
                </div>
                <div class="card-body p-4">
                    <p class="small text-muted mb-3">
                        Informe o código de validação constante em qualquer certificado emitido pela plataforma para conferir sua autenticidade.
                    </p>
                    <form method="get" action="/Certificates/Validate" target="_blank">
                        <div class="mb-3">
                            <label for="validationInput" class="form-label fw-semibold small text-muted">
                                Código de autenticidade
                            </label>
                            <input id="validationInput" name="certificateCode" class="form-control" placeholder="Ex.: VALORA-2026-XXXXXXXX" required minlength="6" maxlength="120" />
                        </div>
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-shield-check me-1"></i>Consultar Validade Pública
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h3 class="h6 fw-bold text-dark mb-0">
                        <i class="bi bi-shield-lock text-success me-2"></i>Políticas de Segurança e Rastreabilidade
                    </h3>
                </div>
                <div class="card-body p-4">
                    <ul class="list-unstyled mb-0 small text-muted">
                        <li class="mb-2">
                            <i class="bi bi-check2 text-success me-1"></i>
                            <strong>Imutabilidade:</strong> Todos os certificados emitidos registram snapshot criptografado no banco de dados.
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check2 text-success me-1"></i>
                            <strong>Privacidade LGPD:</strong> A visualização pública oculta detalhes sensíveis de contato do participante.
                        </li>
                        <li>
                            <i class="bi bi-check2 text-success me-1"></i>
                            <strong>Revogação Auditável:</strong> Em caso de inconformidade ou fraude, a revogação é imediata e registrada na trilha de auditoria.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyCode(code) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(code).then(function() {
                    alert('Código de validação copiado para a área de transferência!');
                }).catch(function() {
                    prompt('Copie o código abaixo:', code);
                });
            } else {
                prompt('Copie o código abaixo:', code);
            }
        }
    </script>
}
