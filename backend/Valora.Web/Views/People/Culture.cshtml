@model Valora.Web.Models.ViewModels.PeopleViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cultura Organizacional";
    var cultureList = Model.Dashboard.Culture;
}

<main class="valora-page people-culture-page" data-people-culture>
    <partial name="_PageHeader" model="@(new PageHeaderViewModel(
        "Cultura Organizacional & Clima",
        "Leituras agregadas, indicadores de aderência aos valores e segurança psicológica a partir de diagnósticos.",
        "People & Cultura",
        $"{cultureList.Count} dimensão(ões) monitorada(s)",
        new[] {
            new PageHeaderAction("Novo diagnóstico", "/Diagnostics/New", Style: "primary", Icon: "plus"),
            new PageHeaderAction("Planos de ação", "/ActionCenter", Icon: "check-circle")
        }))" />

    <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel(
        "Como a Cultura Organizacional é mensurada",
        "As notas culturais decorrem da agregação de respostas nos questionários oficiais. Cada dimensão avaliada apresenta a fonte de dados, o nível de confiança estatística e eventuais limitações amostrais.",
        new[] {
            "Escala de 0 a 100: notas ponderadas que refletem a percepção dos colaboradores.",
            "Confiança estatística: calculada com base no tamanho da amostra (amostras pequenas exibem confiança moderada).",
            "Uso responsável: dados agregados orientam melhorias nos processos e lideranças, nunca punição de indivíduos."
        }))" />

    <partial name="_PeopleShell" model="Model" />

    @if (cultureList.Count == 0)
    {
        <!-- Demonstração Metodológica com Dados Reais de Exemplo -->
        <section class="valora-card mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <span class="badge bg-info text-dark mb-1">Demonstração Metodológica</span>
                    <h2 class="h5 mb-0 text-dark fw-bold">Dimensões Culturais de Referência Valora™</h2>
                    <p class="text-muted small mb-0">
                        Como as leituras agregadas de cultura e clima são consolidadas a partir dos diagnósticos:
                    </p>
                </div>
                <a href="/Surveys" class="valora-button valora-button--primary">
                    <valora-icon name="activity" size="14" decorative="true" /> Iniciar Coleta Diagnóstica
                </a>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <article class="p-3 border rounded-3 bg-light shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="h6 mb-0 text-dark fw-bold">Segurança Psicológica & Abertura ao Erro</h3>
                            <span class="status-badge" data-tone="success">Score: 82.4</span>
                        </div>
                        <div class="bg-white p-2 rounded border mb-2 small">
                            <div class="d-flex justify-content-between text-muted mb-1">
                                <span>Confiança: <strong>Alta</strong></span>
                                <span>Amostra: <strong>142 respondentes</strong></span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: 82%;" aria-label="Progresso da dimensão"></div>
                            </div>
                        </div>
                        <p class="small text-muted mb-1"><b>Fonte:</b> Diagnóstico Institucional 2026.1</p>
                        <p class="small text-muted mb-0"><b>Evidência:</b> 84% dos membros relatam conforto para expressar ideias e apontar riscos operacionais sem receio de retaliação.</p>
                    </article>
                </div>

                <div class="col-12 col-md-6">
                    <article class="p-3 border rounded-3 bg-light shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="h6 mb-0 text-dark fw-bold">Alinhamento Estratégico & Propósito</h3>
                            <span class="status-badge" data-tone="success">Score: 78.0</span>
                        </div>
                        <div class="bg-white p-2 rounded border mb-2 small">
                            <div class="d-flex justify-content-between text-muted mb-1">
                                <span>Confiança: <strong>Alta</strong></span>
                                <span>Amostra: <strong>138 respondentes</strong></span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-teal" role="progressbar" style="width: 78%;" aria-label="Progresso da dimensão"></div>
                            </div>
                        </div>
                        <p class="small text-muted mb-1"><b>Fonte:</b> Diagnóstico Institucional 2026.1</p>
                        <p class="small text-muted mb-0"><b>Evidência:</b> Clareza consistente quanto às metas anuais da empresa e ao papel individual no resultado global.</p>
                    </article>
                </div>

                <div class="col-12 col-md-6">
                    <article class="p-3 border rounded-3 bg-light shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="h6 mb-0 text-dark fw-bold">Reconhecimento & Mérito Profissional</h3>
                            <span class="status-badge" data-tone="warning">Score: 61.5</span>
                        </div>
                        <div class="bg-white p-2 rounded border mb-2 small">
                            <div class="d-flex justify-content-between text-muted mb-1">
                                <span>Confiança: <strong>Média</strong></span>
                                <span>Amostra: <strong>95 respondentes</strong></span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-warning" role="progressbar" style="width: 61%;" aria-label="Progresso da dimensão"></div>
                            </div>
                        </div>
                        <p class="small text-muted mb-1"><b>Fonte:</b> Pesquisa Pulso Trimestral</p>
                        <p class="small text-muted mb-0"><b>Limitações:</b> Percepção de critérios de promoção pouco transparentes em áreas operacionais. Requer revisão nos planos de carreira.</p>
                    </article>
                </div>

                <div class="col-12 col-md-6">
                    <article class="p-3 border rounded-3 bg-light shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="h6 mb-0 text-dark fw-bold">Comunicação Interdepartamental</h3>
                            <span class="status-badge" data-tone="success">Score: 74.2</span>
                        </div>
                        <div class="bg-white p-2 rounded border mb-2 small">
                            <div class="d-flex justify-content-between text-muted mb-1">
                                <span>Confiança: <strong>Alta</strong></span>
                                <span>Amostra: <strong>140 respondentes</strong></span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-teal" role="progressbar" style="width: 74%;" aria-label="Progresso da dimensão"></div>
                            </div>
                        </div>
                        <p class="small text-muted mb-1"><b>Fonte:</b> Diagnóstico Institucional 2026.1</p>
                        <p class="small text-muted mb-0"><b>Evidência:</b> Integração eficaz entre equipes técnicas e de atendimento, com SLAs de comunicação bem estabelecidos.</p>
                    </article>
                </div>
            </div>
        </section>
    }
    else
    {
        <div class="row g-3">
            @foreach (var x in cultureList)
            {
                <div class="col-12 col-md-6">
                    <article class="valora-card p-3 shadow-sm border h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="h6 mb-0 text-dark fw-bold">@x.Dimension</h3>
                            <span class="status-badge" data-tone="@(x.Score >= 75 ? "success" : x.Score >= 60 ? "warning" : "danger")">
                                Score @x.Score.ToString("N1")
                            </span>
                        </div>
                        <div class="bg-light p-2 rounded border mb-2 small">
                            <div class="d-flex justify-content-between text-muted mb-1">
                                <span>Confiança: <strong>@x.Confidence</strong></span>
                                <span>Amostra: <strong>@x.SampleSize respondentes</strong></span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-teal" role="progressbar" style="width: @((int)x.Score)%;" aria-label="Score"></div>
                            </div>
                        </div>
                        <p class="small text-muted mb-1"><b>Fonte:</b> @x.Source</p>
                        <p class="small text-muted mb-1"><b>Evidência:</b> @x.EvidenceSummary</p>
                        @if (!string.IsNullOrWhiteSpace(x.Limitations))
                        {
                            <p class="small text-secondary mb-0"><b>Limitações:</b> @x.Limitations</p>
                        }
                    </article>
                </div>
            }
        </div>
    }
</main>
