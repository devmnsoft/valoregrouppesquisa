@{ ViewData["Title"] = "Auditoria"; }
<section class="valora-page page-card official-module" data-page="audit-page">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel("Auditoria", "Eventos de negócio, contexto e rastreabilidade sem exposição de dados sensíveis.", "Governança · Evidências", Actions: new[] { new PageHeaderAction("Atualizar", DataAction: "refresh", Style: "primary", Icon: "refresh") }))" />
  <div class="row g-3 mt-2" data-summary-cards><div class="col-md-4"><div class="metric-card"><span>Eventos</span><strong data-card="eventos">Carregando…</strong></div></div><div class="col-md-4"><div class="metric-card"><span>Filtros</span><strong data-card="filtros">Carregando…</strong></div></div><div class="col-md-4"><div class="metric-card"><span>Recursos</span><strong data-card="recursos">Carregando…</strong></div></div></div>
  <div class="alert alert-warning d-none mt-3" data-gap-controlled="true" data-gap-card>Recurso em ativação controlada. Consulte ASPNET_WEB_API_GAPS.md.</div>
  <div class="alert alert-danger d-none mt-3" role="alert" data-error></div>
  <div class="table-responsive mt-3"><table class="table table-sm align-middle"><thead><tr><th>Nome</th><th>Status</th><th>Detalhes</th><th>Ação</th></tr></thead><tbody data-items></tbody></table></div>
</section>
@section Scripts { <script src="/js/pages/audit-page.js"></script> }
