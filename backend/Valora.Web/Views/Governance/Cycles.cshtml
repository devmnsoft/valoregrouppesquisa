@model IReadOnlyList<Valora.Application.DecisionCenter.GovernanceCycleDto>
@{ ViewData["Title"]="Ciclos de Governança"; }

<main class="dc-page"><header class="dc-hero"><h1>Ciclos de governança</h1><p>Conecte avaliação, prioridades, decisões, execução e aprendizagem sem perder a origem das evidências.</p></header><section class="dc-card dc-list">@if(Model.Count==0){<div class="dc-empty">Nenhum ciclo iniciado.</div>}else foreach(var x in Model){<article class="dc-row"><div><span class="dc-badge">@x.Status</span><h2><a href="/Governance/Cycles/Details/@x.Id">@x.Name</a></h2><p>@x.PeriodLabel</p></div><small>Aberto em @x.OpenedAt.ToString("dd/MM/yyyy")</small></article>}</section></main>
