@{ ViewData["Title"] = "Pesquisas"; }
<section class="valora-page official-module" data-page="surveys-page">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel("Diagnósticos", "Crie, publique e acompanhe ciclos de escuta com rastreabilidade.", "Estúdio de Diagnósticos", Actions: new[] { new PageHeaderAction("Criar formulário", "/Forms", Icon: "file-text"), new PageHeaderAction("Novo diagnóstico", "/Forms", Style: "primary", Icon: "plus") }))" />
  <div class="valora-card">
  <div class="row g-3 mt-2" data-summary-cards><div class="col-md-4"><div class="metric-card"><span>Pesquisas</span><strong data-card="pesquisas">Carregando…</strong></div></div><div class="col-md-4"><div class="metric-card"><span>Ações</span><strong data-card="ações">Carregando…</strong></div></div><div class="col-md-4"><div class="metric-card"><span>Limites</span><strong data-card="limites">Carregando…</strong></div></div></div>
  <div class="alert alert-warning d-none mt-3" data-gap-controlled="true" data-gap-card>Recurso em ativação controlada. Consulte ASPNET_WEB_API_GAPS.md.</div>
  <div class="alert alert-danger d-none mt-3" role="alert" data-error></div>
  <div class="table-responsive mt-3"><table class="table table-sm align-middle"><thead><tr><th>Nome</th><th>Status</th><th>Detalhes</th><th>Ação</th></tr></thead><tbody data-items></tbody></table></div>
  </div>
</section>
@section Scripts { <script src="/js/pages/surveys-page.js"></script> }
