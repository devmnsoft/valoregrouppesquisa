@model Valora.Application.DecisionCenter.OrganizationalDecisionDto
@{ ViewData["Title"]=Model.Title; }

<main class="dc-page"><header class="dc-hero"><small>@Model.DecisionType · @Model.Priority</small><h1>@Model.Title</h1><p>@Model.Summary</p></header><section class="dc-grid"><article class="dc-card"><h2>Evidências</h2><p>@Model.EvidenceSummary</p><small>Uma causa provável permanece hipótese até nova validação.</small></article><article class="dc-card"><h2>Impacto e resultado esperado</h2><span class="dc-badge">@Model.ImpactLevel</span><p>@Model.ExpectedOutcome</p></article><article class="dc-card"><h2>Acompanhamento</h2><p>Status: <strong>@Model.Status</strong></p><p>Prazo: @(Model.DueAt?.ToString("dd/MM/yyyy")??"Não definido")</p><a href="/ActionPlans">Transforme esta prioridade em uma ação acompanhável</a></article></section></main>
