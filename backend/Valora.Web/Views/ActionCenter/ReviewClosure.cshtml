@model Valora.Web.Controllers.ActionPlanClosurePageViewModel
@using Valora.Application.ActionCenter
@{ ViewData["Title"] = "Revisar encerramento"; var page = Model.Activities; var closureUrl = Url.Action("ReviewClosure", new { id=Model.Plan.Id, activityPage=page.CurrentPage, activityStatus=Model.ActivityStatus, returnUrl=Model.ReturnUrl })!; }
<main class="valora-page action-detail action-closure" data-closure-page data-plan-id="@Model.Plan.Id">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel("Revisar encerramento", Model.Plan.Title, "Valora Action™", ActionStatuses.Label(Model.Plan.Status), new[] { new PageHeaderAction("Voltar ao plano", Model.ReturnUrl, Icon: "arrow-left") }))" />
  <div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div>
  <details class="valora-card action-help"><summary>Como usar</summary><p>Confira os impedimentos e consulte as atividades antes de preencher a confirmação final. O conteúdo digitado é preservado neste navegador ao trocar filtros ou páginas.</p></details>
  <section class="action-summary-grid">
    <article class="valora-card"><h2>Plano</h2><dl class="action-facts"><div><dt>Situação</dt><dd>@ActionStatuses.Label(Model.Plan.Status)</dd></div><div><dt>Responsável</dt><dd>@(Model.Plan.OwnerName??"Sem responsável")</dd></div><div><dt>Prazo</dt><dd>@(Model.Plan.DueAt?.ToString("dd/MM/yyyy")??"A definir")</dd></div><div><dt>Resultado esperado</dt><dd>@Model.Plan.ExpectedOutcome</dd></div></dl></article>
    <article class="valora-card"><h2>Verificação final</h2><dl class="action-facts"><div><dt>Total verificado</dt><dd>@Model.Readiness.TotalActivities</dd></div><div><dt>Abertas</dt><dd>@Model.Readiness.OpenActivities</dd></div><div><dt>Bloqueadas</dt><dd>@Model.Readiness.BlockedActivities</dd></div><div><dt>Concluídas</dt><dd>@Model.Readiness.CompletedActivities</dd></div><div><dt>Canceladas</dt><dd>@Model.Readiness.CanceledActivities</dd></div></dl>@if(Model.Readiness.Pending.Count>0){<div class="lifecycle-pending"><h3>Impedimentos</h3><ul>@foreach(var item in Model.Readiness.Pending){<li>@item</li>}</ul><a class="valora-button" href="@(Model.ReturnUrl)#atividades">Corrigir no plano</a></div>}else{<p class="alert alert-success">As pré-condições do plano estão atendidas. Preencha e confirme o encerramento.</p>}</article>
  </section>
  <section class="valora-card" aria-labelledby="closure-activities-title"><div class="section-heading"><div><h2 id="closure-activities-title">Atividades autorizadas</h2><p>Exibindo @page.Items.Count de @page.Total registro(s) autorizado(s) para este filtro. As contagens acima verificam o plano sem revelar atividades fora do seu acesso.</p></div></div>
    <nav class="action-filter-links" aria-label="Filtrar atividades"><a href="@Url.Action("ReviewClosure",new{id=Model.Plan.Id,returnUrl=Model.ReturnUrl})" aria-current="@(Model.ActivityStatus is null?"page":null)">Todas</a>@foreach(var filter in new[]{("open","Abertas"),("blocked","Bloqueadas"),("completed","Concluídas"),("canceled","Canceladas")}){<a href="@Url.Action("ReviewClosure",new{id=Model.Plan.Id,activityStatus=filter.Item1,returnUrl=Model.ReturnUrl})" aria-current="@(Model.ActivityStatus==filter.Item1?"page":null)">@filter.Item2</a>}</nav>
    @if(page.Items.Count==0){<div class="valora-empty"><h3>Nenhuma atividade neste filtro</h3><p>Escolha outro filtro para continuar a revisão.</p></div>}else{<div class="table-responsive" tabindex="0"><table class="valora-table"><thead><tr><th>Atividade</th><th>Situação</th><th>Responsável</th><th>Prazo</th></tr></thead><tbody>@foreach(var item in page.Items){<tr><td><a asp-action="ItemDetails" asp-route-id="@item.Id" asp-route-returnUrl="@closureUrl">@item.Title</a></td><td>@ActionStatuses.Label(item.Status)</td><td>@(item.ResponsibleName??"Sem responsável")</td><td>@(item.DueAt?.ToString("dd/MM/yyyy")??"A definir")</td></tr>}</tbody></table></div>}
    <nav class="pagination" aria-label="Páginas das atividades">@if(page.HasPrevious){<a asp-action="ReviewClosure" asp-route-id="@Model.Plan.Id" asp-route-activityPage="@(page.CurrentPage-1)" asp-route-activityStatus="@Model.ActivityStatus" asp-route-returnUrl="@Model.ReturnUrl">Anterior</a>}else{<span aria-disabled="true">Anterior</span>}<span>Página @page.CurrentPage de @page.TotalPages</span>@if(page.HasNext){<a asp-action="ReviewClosure" asp-route-id="@Model.Plan.Id" asp-route-activityPage="@(page.CurrentPage+1)" asp-route-activityStatus="@Model.ActivityStatus" asp-route-returnUrl="@Model.ReturnUrl">Próxima</a>}else{<span aria-disabled="true">Próxima</span>}</nav>
  </section>
  <section class="valora-card"><h2>Resultado, evidência e confirmação</h2><form method="post" asp-action="ReviewClosure" asp-route-id="@Model.Plan.Id" data-closure-form data-unsaved-warning>
    @Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@Model.ReturnUrl"><input type="hidden" name="activityPage" value="@page.CurrentPage"><input type="hidden" name="activityStatus" value="@Model.ActivityStatus"><input asp-for="Command.Version" type="hidden"><input asp-for="Command.CommandId" type="hidden">
    <div class="action-form-grid"><label class="action-field--full" asp-for="Command.Result">Resultado alcançado <span aria-hidden="true">*</span><textarea asp-for="Command.Result" minlength="10" maxlength="2000" rows="6" required aria-describedby="result-error"></textarea><span id="result-error" asp-validation-for="Command.Result" class="field-validation-error"></span></label><label class="action-field--full" asp-for="Command.Evidence">Evidência de conclusão <span aria-hidden="true">*</span><textarea asp-for="Command.Evidence" minlength="3" maxlength="2000" rows="6" required aria-describedby="evidence-error"></textarea><span id="evidence-error" asp-validation-for="Command.Evidence" class="field-validation-error"></span></label></div>
    <label class="action-confirm"><input asp-for="Command.Confirmed" required aria-describedby="confirmation-error"> Confirmo que revisei o resultado e as evidências e desejo concluir este plano.</label><span id="confirmation-error" asp-validation-for="Command.Confirmed" class="field-validation-error"></span>
    <div class="dialog-actions"><a class="valora-button" href="@Model.ReturnUrl">Voltar sem concluir</a><button class="valora-button valora-button--primary" disabled="@(!Model.Readiness.CanComplete)" data-submit-once>Concluir plano</button></div>
  </form></section>
</main>
@section Scripts { <script src="~/js/action-plan-closure.js" asp-append-version="true" defer></script> }
