@{ ViewData["Title"] = "Plano de Ação"; }
<main class="valora-page action-plans-page" data-action-plans-page>
  <partial name="_PageHeader" model="@(new PageHeaderViewModel("Valora Action™", "Converta evidências organizacionais em compromissos claros, responsáveis e mensuráveis.", "Plano de ação", "Inteligência", new[] { new PageHeaderAction("Nova ação", DataAction: "new-action", Style: "primary", Icon: "plus") }))" />
  <div class="valora-alert valora-alert--danger" data-error role="alert" hidden></div>
  <section class="valora-card action-toolbar"><label>Buscar<input class="form-control" type="search" data-filter-search placeholder="Título, capacidade ou responsável"></label><label>Status<select class="form-select" data-filter-status><option value="">Todos</option><option value="recommended">Aberto</option><option value="planned">Planejado</option><option value="in_progress">Em andamento</option><option value="waiting">Bloqueado</option><option value="completed">Concluído</option><option value="cancelled">Cancelado</option></select></label><label>Prioridade<select class="form-select" data-filter-priority><option value="">Todas</option><option value="critical">Crítica</option><option value="high">Alta</option><option value="medium">Média</option><option value="low">Baixa</option></select></label><div class="view-switch" role="group" aria-label="Visualização"><button class="valora-button is-active" data-view="kanban">Kanban</button><button class="valora-button" data-view="list">Lista</button></div></section>
  <section data-action-loading class="report-skeleton">Carregando ações reais…</section><section class="action-board" data-action-board aria-live="polite"></section>
  <dialog class="v9-dialog" data-action-dialog><button type="button" class="v9-dialog__close" data-close-action aria-label="Fechar">×</button><form data-action-form><p class="eyebrow">Ação rastreável</p><h2>Nova ação</h2><div class="v9-form-grid"><label>Título<input name="title" required maxlength="180"></label><label>Dimensão/capacidade<input name="capability" required maxlength="120"></label><label>Prioridade<select name="priority"><option value="high">Alta</option><option value="critical">Crítica</option><option value="medium">Média</option><option value="low">Baixa</option></select></label><label>Responsável<input name="owner" maxlength="160"></label><label>Prazo<input name="dueAt" type="date"></label><label>Complexidade<select name="complexity"><option value="medium">Média</option><option value="low">Baixa</option><option value="high">Alta</option></select></label></div><label>Descrição<textarea name="description" required maxlength="1500"></textarea></label><label>Evidência de origem<textarea name="evidenceJustification" required minlength="20" maxlength="2000"></textarea></label><label>Indicador vinculado<input name="indicators" required></label><label>Resultado esperado<textarea name="expectedResult" required></textarea></label><label>Critério de conclusão<textarea name="completionCriteria" required></textarea></label><button class="valora-button valora-button--primary">Criar ação</button></form></dialog>
</main>
@section Scripts { <script src="/js/api/intelligence-api.js"></script><script src="/js/pages/action-plans-page.js" asp-append-version="true"></script> }
