@model Valora.Application.ActionCenter.ActionDashboardDto
@{ViewData["Title"]="Action Center";}<main class="valora-page"><header class="leadership-hero"><div><p class="eyebrow">Valora Action™</p><h1>Execução com rastreabilidade</h1><p>Ações nascem de evidências e permanecem sob decisão humana.</p></div><a class="btn btn-primary" href="/ActionCenter/Plans/Create">Novo plano</a></header><section class="v9-kpis"><article><span>Críticas</span><strong>@Model.Critical</strong></article><article><span>Atrasadas</span><strong>@Model.Overdue</strong></article><article><span>Sem responsável</span><strong>@Model.Unassigned</strong></article><article><span>Planos ativos</span><strong>@Model.ActivePlans</strong></article></section><section class="valora-card"><div class="section-heading"><h2>Próximos compromissos</h2><a href="/ActionCenter/Items">Ver ações</a></div>@if(Model.Upcoming.Count==0){<div class="valora-empty"><h3>Nenhuma ação registrada</h3><p>Crie um plano sustentado por evidência para iniciar a execução.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Ação</th><th>Prioridade</th><th>Status</th><th>Progresso</th><th>Prazo</th></tr></thead><tbody>@foreach(var i in Model.Upcoming){<tr><td><a href="/ActionCenter/Items/Details/@i.Id">@i.Title</a></td><td><span class="badge">@i.Priority</span></td><td>@i.Status</td><td><progress max="100" value="@i.ProgressPercent"></progress> @i.ProgressPercent%</td><td>@(i.DueAt?.ToString("dd/MM/yyyy")??"A definir")</td></tr>}</tbody></table></div>}</section></main>
