@model Valora.Application.Indicators.IndicatorAlertDto
<article class="cc-alert cc-alert--@Model.Severity"><div><span class="cc-badge">@Model.Severity</span><h3>@Model.IndicatorName</h3><p>@Model.Message</p><small>Origem: regra do indicador · Recomendação: revise a fonte e defina uma ação responsável.</small></div>@if(Model.Status!="resolved"){<form action="/CommandCenter/Alerts/Resolve" method="post" data-confirm="Deseja marcar este alerta como resolvido? O histórico será preservado.">@Html.AntiForgeryToken()<input type="hidden" name="AlertId" value="@Model.Id"/><input type="hidden" name="ReturnSeverity" value="@Context.Request.Query["severity"]"/><label>Nota de resolução<input name="ResolutionNote" required minlength="5" maxlength="500" placeholder="Descreva a providência tomada" /></label><button class="cc-button cc-button--primary" type="submit" data-loading-text="Resolvendo…">Resolver alerta</button></form>}else{<span class="cc-badge cc-badge--resolved">Resolvido em @Model.ResolvedAt?.ToString("dd/MM/yyyy")</span>}</article>
