@{ ViewData["Title"] = "Certificados"; }
<section class="valora-page operational-page" data-certificates-index>
  <partial name="_PageHeader" model="@(new PageHeaderViewModel("Certificados", "Emita, consulte e valide certificados vinculados aos diagnósticos concluídos.", "Inteligência Valora", "Certificados", new[] { new PageHeaderAction("Consultar resultados", "/Results", Icon: "search") }))" />
  <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel("Como usar certificados", "Emita certificados apenas para diagnósticos concluídos. Use o código seguro para validar autenticidade sem expor dados protegidos."))" />
  <partial name="_PageProgressChecklist" model="@(new PageProgressChecklistViewModel("Emissão segura", "A elegibilidade é validada antes da emissão e cada acesso permanece rastreável.", new[] { new GuidedStepCardViewModel("Resultado válido", "Confirme conclusão e suficiência.", "complete"), new GuidedStepCardViewModel("Elegibilidade", "Revise as regras do certificado.", "current"), new GuidedStepCardViewModel("Emitir", "Registre a emissão auditável."), new GuidedStepCardViewModel("Baixar", "Use o arquivo gerado pela plataforma."), new GuidedStepCardViewModel("Validar", "Consulte o código público sem expor dados.") }))" />
  <div class="operational-grid">
    <section class="valora-card operational-panel" aria-labelledby="certificate-validation-title">
      <div><p class="eyebrow">Validação pública</p><h2 id="certificate-validation-title">Validar autenticidade</h2><p>Informe o código exibido no documento. A consulta confirma apenas certificados emitidos e preserva os dados protegidos.</p></div>
      <form method="get" action="/Certificates/Validate" class="stacked-form">
        <div class="valora-field"><label for="certificate-code">Código do certificado</label><input class="form-control" id="certificate-code" name="certificateCode" required minlength="6" maxlength="120" autocomplete="off" spellcheck="false" placeholder="Ex.: VALORA-2026-XXXXXXXX" aria-describedby="certificate-code-help"><small id="certificate-code-help">Copie o código exatamente como aparece no certificado.</small></div>
        <div class="form-actions"><button class="valora-button valora-button--primary" type="submit">Validar certificado</button><a class="valora-button valora-button--ghost" href="/Results">Voltar aos resultados</a></div>
      </form>
    </section>
    <aside class="valora-card operational-panel"><p class="eyebrow">Regras de emissão</p><h2>Documento rastreável</h2><ul class="status-checklist"><li><strong>Diagnóstico concluído</strong><span>A emissão depende de uma coleta finalizada e válida.</span></li><li><strong>Status gerado</strong><span>Downloads só ficam disponíveis depois do processamento.</span></li><li><strong>Registro auditável</strong><span>Emissão e downloads preservam data e contexto.</span></li></ul><div class="valora-alert valora-alert--warning" role="status"><strong>Atenção.</strong><span>Um código não confirmado pode estar incorreto, revogado ou ainda em processamento.</span></div></aside>
  </div>
</section>
