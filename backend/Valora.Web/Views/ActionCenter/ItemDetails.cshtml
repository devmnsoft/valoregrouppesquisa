@model Valora.Web.Controllers.ActionItemPageViewModel
@using System.Text.Json
@{ var detail=Model.Details; ViewData["Title"]=detail.Item.Title; var i=detail.Item; var progressCommand=Model.Command as Valora.Application.ActionCenter.ProgressActionRequest; var transitionCommand=Model.Command as Valora.Application.ActionCenter.TransitionActionRequest; var completeCommand=Model.Command as Valora.Application.ActionCenter.CompleteActionRequest; string Label(string value)=>value switch { "pending"=>"Pendente", "in_progress"=>"Em execução", "blocked"=>"Bloqueada", "completed"=>"Concluída", "canceled"=>"Cancelada", "overdue"=>"Atrasada", "critical"=>"Crítica", "high"=>"Alta", "medium"=>"Média", "low"=>"Baixa", _=>value }; }
<main class="valora-page action-detail">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel(i.Title, i.Description, "Valora Action™", $"{Label(i.Priority)} · {Label(i.Status)}", new[] { new PageHeaderAction("Voltar às atividades", "/ActionCenter/Items", Icon:"arrow-left") }))" />
  <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel("Como usar", "Registre avanços até 99%. Use Concluir somente quando houver resultado e evidência verificável.", new[] { "Confira responsável e prazo.", "Documente cada mudança.", "Revise o histórico antes de agir." }))" />
  <div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div> @if(TempData["ActionSuccess"] is string ok){<div class="alert alert-success" role="status">@ok</div>}
  <section class="action-summary-grid"><article class="valora-card"><h2>Resumo da execução</h2><dl class="action-facts"><div><dt>Situação</dt><dd>@Label(i.Status)</dd></div><div><dt>Prioridade</dt><dd>@Label(i.Priority)</dd></div><div><dt>Responsável</dt><dd>@(i.ResponsibleName??"Sem responsável")</dd></div><div><dt>Plano</dt><dd><a href="/ActionCenter/Plans/Details/@i.ActionPlanId">@(i.PlanTitle??"Abrir plano")</a></dd></div><div><dt>Prazo</dt><dd>@(i.DueAt?.ToString("dd/MM/yyyy")??"A definir")</dd></div><div><dt>Progresso operacional</dt><dd><progress max="100" value="@i.ProgressPercent"></progress> @i.ProgressPercent%</dd></div></dl></article><article class="valora-card"><h2>Resultados e evidências</h2><h3>Resultado esperado</h3><p>@i.ExpectedOutcome</p><h3>Evidência inicial</h3><p>@i.EvidenceSummary</p>@if(i.Status=="completed"){<h3>Resultado alcançado</h3><p>@i.CompletionResult</p><h3>Evidência de conclusão</h3><p>@i.CompletionEvidence</p>}</article></section>
  @if(detail.CanProgress||detail.CanBlock||detail.CanResume||detail.CanComplete){<section class="valora-card"><div class="section-heading"><div><h2>Ações disponíveis</h2><p>Somente transições permitidas para a situação atual são exibidas.</p></div><div class="action-buttons">@if(detail.CanProgress){<button type="button" class="valora-button" data-action-dialog-open="progress-dialog">Registrar progresso</button>} @if(detail.CanBlock){<button type="button" class="valora-button valora-button--ghost" data-action-dialog-open="block-dialog">Registrar bloqueio</button>} @if(detail.CanResume){<button type="button" class="valora-button valora-button--primary" data-action-dialog-open="resume-dialog">Retomar atividade</button>} @if(detail.CanComplete){<button type="button" class="valora-button valora-button--primary" data-action-dialog-open="complete-dialog">Concluir atividade</button>}</div></div></section>}
  <section class="valora-card"><h2>Histórico</h2>@if(detail.History.Count==0){<p>Nenhuma mudança registrada.</p>}else{<ol class="action-history">@foreach(var h in detail.History){<li><strong>@Label(h.FromStatus??"Início") → @Label(h.ToStatus)</strong><span>@h.ChangedAt.ToString("dd/MM/yyyy HH:mm") · @(h.AuthorName??"Autor não identificado")</span>@if(h.ProgressPercent is not null){<span>@h.ProgressPercent%</span>}<p>@h.Reason</p></li>}</ol>}<nav class="pagination" aria-label="Páginas do histórico"><a class="valora-button valora-button--ghost @(detail.HistoryPage<=1?"disabled":"")" aria-disabled="@(detail.HistoryPage<=1)" href="?historyPage=@(detail.HistoryPage-1)">Anterior</a><span>Página @detail.HistoryPage de @detail.HistoryPages</span><a class="valora-button valora-button--ghost @(detail.HistoryPage>=detail.HistoryPages?"disabled":"")" aria-disabled="@(detail.HistoryPage>=detail.HistoryPages)" href="?historyPage=@(detail.HistoryPage+1)">Próxima</a></nav></section>
</main>
@if(detail.CanProgress){<dialog id="progress-dialog"><form method="post" action="/ActionCenter/Items/@i.Id/Progress">@Html.AntiForgeryToken()<h2>Registrar progresso</h2><p>Informe de 0 a 99%. Esta ação não conclui a atividade.</p><label for="progress">Progresso (%) *</label><input id="progress" name="ProgressPercent" type="number" min="0" max="99" value="@(progressCommand?.ProgressPercent??Math.Min(i.ProgressPercent,99))" required><label for="note">Nota do acompanhamento</label><textarea id="note" name="Note" maxlength="1000">@progressCommand?.Note</textarea><input type="hidden" name="Version" value="@(progressCommand?.Version??i.Version)"><input type="hidden" name="CommandId" value="@(progressCommand?.CommandId??Guid.NewGuid().ToString())"><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Registrar</button></div></form></dialog>}
@if(detail.CanBlock){<dialog id="block-dialog"><form method="post" action="/ActionCenter/Items/@i.Id/Block">@Html.AntiForgeryToken()<h2>Registrar bloqueio</h2><p>A atividade ficará bloqueada até uma transição explícita.</p><label for="reason">Motivo *</label><textarea id="reason" name="Reason" minlength="3" maxlength="1000" required>@transitionCommand?.Reason</textarea><input type="hidden" name="Version" value="@(transitionCommand?.Version??i.Version)"><input type="hidden" name="CommandId" value="@(transitionCommand?.CommandId??Guid.NewGuid().ToString())"><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Confirmar bloqueio</button></div></form></dialog>}
@if(detail.CanResume){<dialog id="resume-dialog" aria-labelledby="resume-title"><form method="post" action="/ActionCenter/Items/@i.Id/Resume">@Html.AntiForgeryToken()<h2 id="resume-title">Retomar @i.Title</h2><p>O progresso de @i.ProgressPercent% será preservado e a atividade voltará para Em execução.</p><label for="resume-reason">Justificativa *</label><textarea id="resume-reason" name="Reason" minlength="3" maxlength="1000" required>@transitionCommand?.Reason</textarea><input type="hidden" name="Version" value="@(transitionCommand?.Version??i.Version)"><input type="hidden" name="CommandId" value="@(transitionCommand?.CommandId??Guid.NewGuid().ToString())"><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Retomar atividade</button></div></form></dialog>}
@if(detail.CanComplete){<dialog id="complete-dialog"><form method="post" action="/ActionCenter/Items/@i.Id/Complete">@Html.AntiForgeryToken()<h2>Concluir atividade</h2><p>A conclusão define 100% e registra o resultado na memória organizacional.</p><label for="result">Resultado alcançado *</label><textarea id="result" name="Result" minlength="10" maxlength="2000" required>@completeCommand?.Result</textarea><label for="evidence">Evidência de conclusão *</label><textarea id="evidence" name="Evidence" minlength="3" maxlength="2000" required>@completeCommand?.Evidence</textarea><input type="hidden" name="Version" value="@(completeCommand?.Version??i.Version)"><input type="hidden" name="CommandId" value="@(completeCommand?.CommandId??Guid.NewGuid().ToString())"><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Concluir</button></div></form></dialog>}

<script src="~/js/action-center.js" asp-append-version="true" data-open-dialog="@Model.OpenDialog"></script>
