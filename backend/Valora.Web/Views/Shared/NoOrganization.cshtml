@{
    ViewData["Title"] = "Organização Necessária";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 text-center">
            <div class="card shadow-sm border-0 p-4">
                <div class="card-body">
                    <div class="display-4 text-warning mb-3">
                        <i class="bi bi-building-exclamation"></i>
                    </div>
                    <h1 class="h3 fw-bold mb-2">Organização não selecionada</h1>
                    <p class="text-muted mb-4">
                        Este módulo exige um contexto organizacional ativo. Selecione ou alterne para a organização desejada no seletor do cabeçalho para continuar navegando.
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <a href="/" class="btn btn-primary">
                            <i class="bi bi-house me-1"></i> Ir para o Início
                        </a>
                        <a href="/Workspace" class="btn btn-outline-secondary">
                            <i class="bi bi-briefcase me-1"></i> Ver Workspaces
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
