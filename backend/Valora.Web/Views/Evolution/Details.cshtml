@inject Microsoft.Extensions.Logging.ILogger<Valora.Web.Controllers.EvolutionController> MetadataLogger
@model Valora.Web.Controllers.EvolutionDetailsViewModel
@using Valora.Application.Evolution
@using System.Text.Json
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{
    var title = string.IsNullOrWhiteSpace(Model.Cycle.Title) ? "Ciclo histórico sem título" : Model.Cycle.Title;
    ViewData["Title"] = title;
    var command = ViewData["SnapshotCommand"] as EvolutionSnapshotViewModel ?? new();
    var canManage = ViewData["EvolutionCanWrite"] is true && (await Authorization.AuthorizeAsync(User, null, Valora.Application.Access.ValoraPermissions.Evolution.Manage)).Succeeded;
    var canMonitor = ViewData["EvolutionCanWrite"] is true && (await Authorization.AuthorizeAsync(User, null, Valora.Application.Access.ValoraPermissions.Evolution.SnapshotsGenerate)).Succeeded;
    var open = Model.Cycle.Status is not "closed" and not "archived";
    var preview = ViewData["ComparisonPreview"] as EvolutionReevaluationPreview;
    var monitoring = Model.Snapshots.Where(x => x.SnapshotType is not "reevaluation" and not "reference_review").ToList();
    var evaluations = Model.Snapshots.Where(x => x.SnapshotType == "reevaluation").ToList();
    var back = Uri.EscapeDataString(Model.ReturnUrl);
    var zoneName = ViewData["OrganizationTimeZone"] as string ?? "UTC";
    var zone = TimeZoneInfo.FindSystemTimeZoneById(zoneName);
    string When(DateTime value) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(value, DateTimeKind.Utc), zone).ToString("dd/MM/yyyy HH:mm");
    var status = Model.Cycle.Status switch { "closed" => "Encerrado", "archived" => "Arquivado", "reviewed" => "Reavaliado", "monitoring" => "Em acompanhamento", _ => "Aberto" };
}
@section Styles { <link rel="stylesheet" href="~/css/evolution.css" asp-append-version="true"> }
<main class="valora-page evolution-details">
    <partial name="_PageHeader" model="@(new PageHeaderViewModel(title, Model.Cycle.Summary, "Valora Evolution", Actions: new[] { new PageHeaderAction("Voltar", Model.ReturnUrl) }))" />
    @if (TempData["EvolutionSuccess"] is string success) { <div class="valora-alert valora-alert--success" role="status">@success</div> }
    <div asp-validation-summary="All" role="alert"></div>
    @if (ViewData["EvolutionWriteLimitation"] is string limitation) { <p class="valora-alert" role="status">@limitation</p> }
    <section aria-labelledby="objective-heading">
        <h2 id="objective-heading">Objetivo e situação</h2>
        <dl class="summary-grid"><div><dt>Situação</dt><dd>@status</dd></div><div><dt>Período</dt><dd>@Model.Cycle.PeriodStart.ToString("dd/MM/yyyy") a @(Model.Cycle.PeriodEnd?.ToString("dd/MM/yyyy") ?? "definir")</dd></div><div><dt>Meta</dt><dd>@(Model.Cycle.TargetScore?.ToString("0.00") ?? "Não informada") @(Model.Cycle.TargetScore.HasValue ? "pontos" : "")</dd></div></dl>
    </section>
    <section aria-labelledby="baseline-heading">
        <h2 id="baseline-heading">Medição inicial</h2>
        @if (Model.Baseline is {} baseline) { <partial name="_Measurement" model="baseline" /> }
        else {
            <p>@(Model.Cycle.BaselineScore?.ToString("0.00") ?? "Sem valor informado") @(Model.Cycle.BaselineScore.HasValue ? "pontos" : "")</p>
            <p>@(Model.Cycle.BaselineSource == "organizational_measurement" ? "Medição preservada com metadados incompletos. Solicite revisão da origem; comparação indisponível." : Model.Cycle.BaselineSource == "legacy_review_required" ? "Referência anterior pendente de revisão: a origem histórica da medição não está comprovada." : "Referência manual informada. Não possui base calculada para comparação quantitativa.")</p>
        }
        <p>@Model.Cycle.EvidenceSummary</p>
        @foreach (var review in Model.Snapshots.Where(x => x.SnapshotType == "reference_review")) {
            <article class="timeline-item"><h3>Revisão de referência · @When(review.CalculatedAt) (@zoneName)</h3><p>@review.EvidenceSummary</p><p>@review.Interpretation</p><p>Próximo passo: @review.Recommendation</p></article>
        }
        @if (open && canManage && Model.Cycle.BaselineSource == "legacy_review_required") {
            <form method="post" action="/Evolution/Cycles/@Model.Cycle.Id/ReviewReference?returnUrl=@back" data-submit-once>
                @Html.AntiForgeryToken()
                <input type="hidden" name="version" value="@Model.Version">
                <input type="hidden" name="commandId" value="@Guid.NewGuid().ToString("N")">
                <div class="valora-field"><label for="review-evidence">Evidências históricas verificadas</label><textarea id="review-evidence" name="evidence" required minlength="3" maxlength="2000" rows="3">@ViewData["ReviewEvidence"]</textarea></div>
                <div class="valora-field"><label for="review-next">Pendência e próximo passo</label><textarea id="review-next" name="nextStep" required minlength="3" maxlength="2000" rows="3">@ViewData["ReviewNextStep"]</textarea></div>
                <button class="valora-button valora-button--primary">Registrar revisão inconclusiva</button>
            </form>
        }
    </section>
    <section aria-labelledby="execution-heading">
        <h2 id="execution-heading">Planos e execução</h2>
        @if (Model.Cycle.DiagnosticId is {} diagnostic) { <a href="/ActionCenter/Plans?diagnosticId=@diagnostic&amp;returnUrl=@Uri.EscapeDataString($"/Evolution/Cycles/Details/{Model.Cycle.Id}?returnUrl={back}")">Consultar planos vinculados</a> }
        else { <a href="/ActionCenter/Plans?returnUrl=@Uri.EscapeDataString($"/Evolution/Cycles/Details/{Model.Cycle.Id}")">Consultar planos da organização</a> }
    </section>
    <section aria-labelledby="monitoring-heading">
        <h2 id="monitoring-heading">Acompanhamentos</h2>
        @if (monitoring.Count == 0) { <p>Nenhum acompanhamento registrado.</p> }
        @foreach (var item in monitoring) {
            <article class="timeline-item"><strong>@When(item.CalculatedAt) (@zoneName)</strong><p>@item.Interpretation</p><p>@item.EvidenceSummary</p><p>@item.CompletedActions ações concluídas · @item.DelayedActions atrasadas · @item.OpenAlerts alertas abertos</p><p>Próximo passo: @item.Recommendation</p><small>Sem nova medição quantitativa neste acompanhamento.</small></article>
        }
        @if (open && canMonitor) {
            <form method="post" action="/Evolution/Cycles/@Model.Cycle.Id/Snapshot?returnUrl=@back" data-submit-once>
                @Html.AntiForgeryToken()
                <div class="valora-field"><label for="Evidence">Evidências observadas</label><textarea id="Evidence" name="Evidence" required maxlength="2000" rows="3">@command.Evidence</textarea>@Html.ValidationMessage("Evidence")</div>
                <div class="valora-field"><label for="Interpretation">Interpretação</label><textarea id="Interpretation" name="Interpretation" required maxlength="2000" rows="3">@command.Interpretation</textarea>@Html.ValidationMessage("Interpretation")</div>
                <div class="valora-field"><label for="Recommendation">Próximo passo</label><textarea id="Recommendation" name="Recommendation" required maxlength="2000" rows="3">@command.Recommendation</textarea>@Html.ValidationMessage("Recommendation")</div>
                <button class="valora-button valora-button--primary">Registrar acompanhamento</button>
            </form>
        }
    </section>
    <section aria-labelledby="reevaluation-heading">
        <h2 id="reevaluation-heading">Reavaliações</h2>
        @if (evaluations.Count == 0) { <p>Nenhuma reavaliação quantitativa registrada.</p> }
        @foreach (var item in evaluations) {
            var first = EvolutionPreservedMetadata.Read(item.MetadataJson, "Baseline");
            var current = EvolutionPreservedMetadata.Read(item.MetadataJson, "Current");
            if (first is null || current is null) {
                MetadataLogger.LogWarning("Incomplete evolution snapshot metadata {SnapshotId}", item.Id);
            }
            <article class="timeline-item"><h3>@When(item.CalculatedAt) (@zoneName)</h3><div class="form-grid"><div><h4>Inicial</h4>@if (first is not null) { <partial name="_Measurement" model="first" /> } else { <p>Referência histórica pendente de revisão.</p> }</div><div><h4>Posterior</h4>@if (current is not null) { <partial name="_Measurement" model="current" /> } else { <p>Referência histórica pendente de revisão.</p> }</div></div><p>@item.Interpretation</p>@if (first is not null && current is not null && item.Delta is {} delta) { <strong>@delta.ToString("+0.00;-0.00;0.00") pontos na escala de 0 a 100</strong> }</article>
        }
        @if (open && canManage && Model.Baseline is not null) {
            <form method="post" action="/Evolution/Cycles/@Model.Cycle.Id/Preview?returnUrl=@back" data-submit-once>
                @Html.AntiForgeryToken()
                <div class="valora-field"><label for="SourceSurveyId">Nova medição organizacional</label><select id="SourceSurveyId" name="SourceSurveyId" required data-measurement-select><option value="">Selecione a pesquisa de origem</option>@foreach (var option in Model.Options) { <option value="@option.SourceSurveyId" selected="@((ViewData["SelectedSurveyId"] as Guid?) == option.SourceSurveyId)">@option.DiagnosticTitle · @option.Percentage.ToString("0.00") pontos · @When(option.CalculatedAt) (@zoneName) · @option.ScoredResponseCount respostas · @option.MethodologyVersion @(option.Limitation is null ? "" : " · " + option.Limitation)</option> }</select>@Html.ValidationMessage("SourceSurveyId")</div>
                <button type="button" class="valora-button" data-measurements-more data-page="2">Carregar mais medições</button><span role="status" data-measurements-status></span>
                <button class="valora-button valora-button--primary">Comparar medições</button>
            </form>
        }
        @if (canManage && preview is not null) {
            <div role="region" aria-label="Prévia da comparação" tabindex="-1" id="comparison-preview"><h3>Prévia da comparação</h3><div class="form-grid"><div><h4>Inicial</h4><partial name="_Measurement" model="preview.Baseline" /></div><div><h4>Posterior</h4><partial name="_Measurement" model="preview.Current" /></div></div><p>@preview.Comparison.Limitation</p>@if (preview.Comparison.AbsoluteVariation is {} delta) { <strong>@delta.ToString("+0.00;-0.00;0.00") pontos na escala de 0 a 100</strong> }
                <form method="post" action="/Evolution/Cycles/@Model.Cycle.Id/Reevaluate?returnUrl=@back" data-submit-once>@Html.AntiForgeryToken()<input type="hidden" name="sourceSurveyId" value="@preview.Current.SurveyId"><input type="hidden" name="version" value="@preview.Version"><input type="hidden" name="fingerprint" value="@preview.Fingerprint"><input type="hidden" name="commandId" value="@Guid.NewGuid().ToString("N")"><button class="valora-button valora-button--primary">Confirmar reavaliação</button></form>
            </div>
        }
    </section>
    <section aria-labelledby="learning-heading">
        <h2 id="learning-heading">Aprendizados e próximo passo</h2>
        @if (!open) { <p>@Model.Cycle.LearningSummary</p><p>Tratamento das pendências: @Model.Cycle.PendingTreatment</p>@if (evaluations.Count == 0) { <p>Ciclo encerrado sem reavaliação quantitativa</p> } }
        else if (canManage) {
            <form method="post" action="/Evolution/Cycles/@Model.Cycle.Id/Close?returnUrl=@back" data-submit-once>@Html.AntiForgeryToken()<input type="hidden" name="version" value="@Model.Version"><div class="valora-field"><label for="learning">Síntese e aprendizados</label><textarea id="learning" name="learning" required minlength="3" maxlength="2000" rows="3">@ViewData["Learning"]</textarea></div><div class="valora-field"><label for="pendingTreatment">Tratamento das pendências</label><textarea id="pendingTreatment" name="pendingTreatment" required minlength="3" maxlength="2000" rows="3">@ViewData["PendingTreatment"]</textarea></div><label><input type="checkbox" required> Confirmo o encerramento deste ciclo. Planos e atividades continuam com suas situações atuais.</label><button class="valora-button">Encerrar ciclo</button></form>
        }
    </section>
</main>
@section Scripts { <script src="~/js/pages/evolution.js" asp-append-version="true"></script><script>document.getElementById('comparison-preview')?.focus();</script> }
