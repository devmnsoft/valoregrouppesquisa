@model Valora.Web.Models.ViewModels.ResponsesIndexViewModel
@{
    ViewData["Title"] = "Respostas Coletadas";
}

<div class="container-fluid py-4" data-module="Responses">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Início</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Respostas da Coleta</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold text-dark mb-1">Respostas & Submissões</h1>
            <p class="text-muted mb-0">Monitoramento e auditoria de respostas submetidas através de instrumentos e formulários diagnósticos.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Exports" class="btn btn-outline-secondary">
                <i class="bi bi-download me-1"></i> Central de Exportações
            </a>
            <button type="button" class="btn btn-primary" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise me-1"></i> Atualizar
            </button>
        </div>
    </div>

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <!-- Métricas Superiores -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary me-3">
                        <i class="bi bi-inbox fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium d-block">Total de Submissões</span>
                        <strong class="fs-4 text-dark">@Model.TotalCount</strong>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success me-3">
                        <i class="bi bi-check2-circle fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium d-block">Respostas Concluídas</span>
                        <strong class="fs-4 text-dark">@Model.CompletedCount</strong>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info me-3">
                        <i class="bi bi-journal-check fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium d-block">Instrumentos Ativos</span>
                        <strong class="fs-4 text-dark">@Model.SurveysCount</strong>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning me-3">
                        <i class="bi bi-shield-lock fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium d-block">Privacidade</span>
                        <strong class="fs-4 text-dark">LGPD Segura</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Barra de Busca -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" action="/Responses" class="row g-2 align-items-end">
                <div class="col-12 col-md-10">
                    <label class="form-label small fw-semibold text-muted mb-1" for="responseSearch">Filtrar por Diagnóstico, Formulário ou Participante</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="responseSearch" name="search" value="@Model.Search" placeholder="Digite parte do título, formulário ou participante..." />
                    </div>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                        <i class="bi bi-filter me-1"></i> Filtrar
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a href="/Responses" class="btn btn-sm btn-outline-secondary" title="Limpar filtro">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Tabela de Respostas -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0 fw-bold text-dark">Submissões Registradas (@Model.TotalCount)</h2>
            <span class="badge bg-secondary-subtle text-secondary">Acesso Administrativo Autorizado</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Items.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="text-muted mb-3"><i class="bi bi-inbox fs-1"></i></div>
                    <h3 class="h5 text-secondary">Nenhuma resposta encontrada</h3>
                    <p class="text-muted small mb-0">Aguardando submissões dos participantes nos links de diagnóstico ativos.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-3">Diagnóstico / Pesquisa</th>
                                <th scope="col">Formulário de Coleta</th>
                                <th scope="col">Participante</th>
                                <th scope="col">Data da Submissão</th>
                                <th scope="col">Status</th>
                                <th scope="col" class="text-end pe-3">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-file-earmark-text text-primary fs-5"></i>
                                            <div>
                                                <strong class="d-block text-dark">@item.SurveyTitle</strong>
                                                <span class="text-muted small font-monospace">Registro #@item.Id.ToString()[..8]</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge text-bg-light border">@item.FormName</span>
                                    </td>
                                    <td>
                                        <div>
                                            <span class="d-block fw-semibold text-dark">@item.ParticipantName</span>
                                            <small class="text-muted">@item.ParticipantEmail</small>
                                        </div>
                                    </td>
                                    <td class="text-nowrap small text-muted">
                                        @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        <span class="badge @item.StatusBadgeClass">@item.StatusLabel</span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <a href="/Responses/@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i> Ver Resultado
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
