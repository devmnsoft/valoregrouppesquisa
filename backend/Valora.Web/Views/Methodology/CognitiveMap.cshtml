@{ ViewData["Title"] = "Mapa Cognitivo Valora™"; }
<main class="valora-page v9-page methodology-page" data-cognitive-map>
 <nav class="v9-breadcrumb"><a href="/Intelligence">Inteligência Organizacional</a><span>/</span><span>Mapa Cognitivo</span></nav>
 <partial name="_PageHeader" model="@(new PageHeaderViewModel("Mapa Cognitivo Valora™", "Influências metodológicas prováveis, com racional e peso explícitos.", "Arquitetura sistêmica", "Relações oficiais"))" />
 <section class="valora-card"><div class="v9-section-title"><div><p class="eyebrow">Matriz de influência</p><h2>Efeitos sistêmicos governados</h2></div><label>Conceito<select class="valora-input" data-concept><option value="">Todas as relações</option></select></label></div><div class="valora-alert"><strong>Leitura responsável.</strong> Relação metodológica indica influência provável; não comprova causalidade em uma organização.</div><div class="valora-skeleton" data-loading>Compondo mapa…</div><div class="valora-alert valora-alert--danger" data-error hidden></div><div class="relation-matrix" data-relations hidden></div><div class="valora-empty" data-empty hidden><h3>Sem relações para este filtro</h3><p>Nenhuma causalidade será presumida.</p></div></section>
 <dialog class="valora-card intelligence-module__drawer methodology-drawer" data-drawer><button class="valora-button valora-button--ghost" data-close>Fechar</button><div data-detail></div></dialog>
</main>
@section Scripts { <script src="/js/pages/methodology-cognitive-map.js" asp-append-version="true"></script> }
