@model IReadOnlyList<Valora.Application.Journey.JourneyEventDto>

@{
    ViewData["Title"]="Journey";
}

<main class="valora-page"><header class="leadership-hero"><div><p class="eyebrow">Valora Journey™</p><h1>Memória organizacional</h1><p>Decisões, evidências e execução preservadas em ordem histórica.</p></div></header><form method="get" class="valora-card form-grid"><label>De<input type="date" name="From"/></label><label>Até<input type="date" name="To"/></label><label>Origem<input name="SourceType"/></label><label>Impacto<select name="ImpactLevel"><option value="">Todos</option><option>critical</option><option>high</option><option>medium</option><option>low</option></select></label><button>Filtrar</button></form><section class="valora-card journey-timeline">@if(Model.Count==0){<div class="valora-empty"><h3>A memória será construída pela execução</h3><p>Eventos automáticos surgem com ações, decisões e snapshots.</p></div>}@foreach(var e in Model){<article><time>@e.OccurredAt.ToString("dd/MM/yyyy HH:mm")</time><div><span class="badge">@e.EventType</span><h2><a href="/Journey/Details/@e.Id">@e.Title</a></h2><p>@e.Description</p><small>Evidência: @e.EvidenceSummary</small></div></article>}</section></main>
