@model Valora.Application.SolutionPacks.SolutionPackDetails
@{ViewData["Title"]=Model.Name;}
<style>.detail{max-width:1100px;margin:auto}.panel{padding:1.4rem;border:1px solid #e3e8ee;border-radius:18px;margin:1rem 0;background:#fff}.tag{padding:.3rem .6rem;border-radius:20px;background:#e9f1f5;color:#234b60}.timeline{border-left:3px solid #c79a4a;padding-left:1rem}.item{padding:.8rem 0;border-bottom:1px solid #edf0f3}</style>
<div class="detail"><a asp-action="Index">← Marketplace</a><section class="panel"><span class="tag">@Model.Segment</span> <span class="tag">@Model.Status</span><h1>@Model.Name</h1><p>@Model.Description</p><strong>Versão @Model.CurrentVersion</strong></section><section class="panel"><h2>Conteúdo incluído</h2>@foreach(var item in Model.Items){<div class="item"><strong>@item.Name</strong><br/><small>@item.ItemType · módulo @item.SourceModule</small></div>}@if(Model.Items.Count==0){<p>A próxima versão ainda não recebeu itens.</p>}</section><section class="panel"><h2>Dependências e limitações</h2>@foreach(var d in Model.Dependencies){<div class="item">@d.DependencyType — @(d.RequiredModule??d.RequiredPermission)</div>}<p>Nenhum dado existente será sobrescrito sem confirmação explícita no preview.</p></section><section class="panel timeline"><h2>Evidências e metodologia</h2><p>@(Model.Evidence??"O fornecedor ainda não anexou evidências metodológicas. A decisão de uso permanece humana.")</p></section></div>
