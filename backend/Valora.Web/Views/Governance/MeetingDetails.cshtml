@model Valora.Application.DecisionCenter.GovernanceMeetingDto
@{ ViewData["Title"]=Model.Title; }

<main class="dc-page"><header class="dc-hero"><span class="dc-badge">@Model.Status</span><h1>@Model.Title</h1><p>@Model.ScheduledAt.ToString("dd/MM/yyyy HH:mm")</p></header><section class="dc-grid"><article class="dc-card"><h2>Pauta</h2><p>@Model.Agenda</p></article><article class="dc-card"><h2>Ata / resumo</h2><p>@(Model.MinutesSummary??"A ata será registrada após a reunião.")</p></article><article class="dc-card"><h2>Próximos passos</h2><p>@(Model.NextSteps??"Ainda não definidos.")</p></article></section></main>
