@model Valora.Web.Controllers.ActionPlanDetailsViewModel
@using Valora.Application.ActionCenter
@{
    ViewData["Title"] = Model.Plan.Title;
    var plan = Model.Plan;
    var planActivitiesPage = Model.Activities;
    var command = Model.Command as CreateActionItemRequest;
    var assignCommand = Model.Command as AssignResponsibleRequest; var dueCommand = Model.Command as RescheduleActionRequest;
    var transitionCommand = Model.Command as PlanTransitionRequest; var completePlanCommand = Model.Command as CompleteActionPlanRequest;
    var capabilities = Model.Capabilities;
    var primaryAction = plan.Status switch { "draft" when capabilities.CanSubmit => "submit-plan-dialog", "proposed" when capabilities.CanApprove => "approve-plan-dialog", "approved" when capabilities.CanStart => "start-plan-dialog", _ => null };
    var canCreate = capabilities.CanAssign && (plan.Status is "draft" or "proposed" or "approved" or "in_execution");
    var planCurrentUrl = Url.Action("PlanDetails", "ActionCenter", new { id = plan.Id, itemPage = planActivitiesPage.CurrentPage, historyPage = Model.History.CurrentPage, historyType = Model.HistoryType, returnUrl = Model.ReturnUrl })!;
}
<div data-action-center-module>
    <main class="valora-page action-detail">
        <partial name="_PageHeader" model="@(new PageHeaderViewModel(plan.Title, plan.Summary, "Valora Action™", $"{ActionStatuses.Label(plan.Priority)} · {ActionStatuses.Label(plan.Status)}", new[] { new PageHeaderAction("Voltar aos planos", Model.ReturnUrl, Icon: "arrow-left") }))" />
        <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel("Como usar", "Acompanhe o resultado pelas atividades autorizadas e registre entregas verificáveis.", new[] { "Revise prazo e responsável.", "Crie atividades com evidência.", "Acompanhe bloqueios antes do prazo." }))" />
        @if(TempData["ActionSuccess"] is string ok){<div class="alert alert-success" role="status">@ok</div>}@if(TempData["ClosureDraftKey"] is string closureDraftKey){<span hidden data-closure-clear-key="@closureDraftKey"></span>}
        <div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div>
        <section class="valora-card lifecycle-card lifecycle-card--@plan.Status" aria-labelledby="lifecycle-title">
          <div class="section-heading"><div><h2 id="lifecycle-title">Etapas do plano</h2><p>Situação formal: <strong>@ActionStatuses.Label(plan.Status)</strong>. O progresso das atividades não altera esta situação automaticamente.</p></div>@if(plan.Status=="in_execution"&&capabilities.CanComplete){<a class="valora-button valora-button--primary" asp-action="ReviewClosure" asp-route-id="@plan.Id" asp-route-returnUrl="@planCurrentUrl">Revisar encerramento</a>}else if(primaryAction is not null){<button class="valora-button valora-button--primary" type="button" data-action-dialog-open="@primaryAction">@(plan.Status switch{"draft"=>"Submeter para avaliação","proposed"=>"Aprovar plano",_=>"Iniciar execução"})</button>}</div>
          <ol class="lifecycle-steps"><li class="@(plan.Status=="draft"?"current":"")"><b>1. Preparação</b><span>Conteúdo, evidência e responsável</span></li><li class="@(plan.Status=="proposed"?"current":"")"><b>2. Avaliação</b><span>Aprovação vinculada à versão</span></li><li class="@(plan.Status is "approved" or "in_execution"?"current":"")"><b>3. Execução</b><span>Início real e atividades</span></li><li class="@(plan.Status=="completed"?"current":"")"><b>4. Encerramento</b><span>Resultado e evidência</span></li></ol>
          @if(plan.Status=="canceled"){<div class="alert alert-warning"><strong>Plano cancelado.</strong> Este encerramento não representa execução bem-sucedida.<br><b>Motivo:</b> @(string.IsNullOrWhiteSpace(plan.CancellationReason)?"Motivo não recuperado nos dados históricos.":plan.CancellationReason)<br><b>Autoria:</b> @(plan.CompletedByName??"Autoria não recuperada nos dados históricos.")</div>}
          @if(Model.Closure?.Pending.Count>0){<div class="lifecycle-pending"><h3>@(plan.Status switch{"draft"=>"O que falta para submeter","approved"=>"Condições para iniciar","in_execution"=>"Condições para encerrar",_=>"Pendências da etapa"})</h3><ul>@foreach(var pending in Model.Closure.Pending){<li>@pending</li>}</ul><div class="action-buttons">@foreach(var destination in Model.Closure.Destinations.DistinctBy(x=>x.Code)){if(destination.Code=="owner"&&capabilities.CanAssign){<button type="button" class="valora-button" data-action-dialog-open="assign-plan-dialog">@destination.Label</button>}else if(destination.Code=="due"&&capabilities.CanReschedule){<button type="button" class="valora-button" data-action-dialog-open="reschedule-plan-dialog">@destination.Label</button>}else if(destination.Code=="content"&&capabilities.CanEditContent){<a class="valora-button" asp-action="EditPlan" asp-route-id="@plan.Id" asp-route-returnUrl="@planCurrentUrl">@destination.Label</a>}else{<a class="valora-button" href="#@destination.UrlFragment">@destination.Label</a>}}</div></div>}
          @if(Model.Closure?.Warnings.Count>0){<div class="alert alert-warning"><strong>Avisos de prontidão</strong><ul>@foreach(var warning in Model.Closure.Warnings){<li>@warning</li>}</ul></div>}
          <div class="action-buttons">@if(capabilities.CanReturn){<button type="button" class="valora-button" data-action-dialog-open="return-plan-dialog">Devolver para ajustes</button>}@if(capabilities.CanCancel){<button type="button" class="valora-button valora-button--danger" data-action-dialog-open="cancel-plan-dialog">Cancelar plano</button>}</div>
        </section>
        <section class="action-summary-grid">
            <article class="valora-card" id="resumo">
                <h2>Resumo do plano</h2>
                <dl class="action-facts">
                    <div><dt>Situação</dt><dd>@ActionStatuses.Label(plan.Status)</dd></div>
                    <div id="responsavel"><dt>Responsável</dt><dd>@(plan.OwnerName ?? "Sem responsável")</dd></div>
                    <div id="prazo"><dt>Prazo</dt><dd>@(plan.DueAt?.ToString("dd/MM/yyyy") ?? "A definir")</dd></div>
                    <div><dt>Progresso operacional</dt><dd><progress max="100" value="@plan.ProgressPercent"></progress> @plan.ProgressPercent%</dd></div>
                </dl>
                @if(capabilities.CanEditContent||capabilities.CanAssign||capabilities.CanReschedule){<div class="action-buttons">@if(capabilities.CanEditContent){<a class="valora-button valora-button--primary" asp-action="EditPlan" asp-route-id="@plan.Id" asp-route-returnUrl="@planCurrentUrl">Editar plano</a>}@if(capabilities.CanAssign){<button type="button" class="valora-button" data-action-dialog-open="assign-plan-dialog">@(plan.OwnerUserId is null?"Definir responsável do plano":"Alterar responsável do plano")</button>}@if(capabilities.CanReschedule){<button type="button" class="valora-button" data-action-dialog-open="reschedule-plan-dialog">Alterar prazo do plano</button>}</div>}
            </article>
            <article class="valora-card"><h2>Resultado e evidência</h2><h3>Resultado esperado</h3><p>@plan.ExpectedOutcome</p><h3>Evidência de origem</h3><p>@plan.EvidenceSummary</p>@if(plan.Status=="completed"){<h3>Resultado alcançado</h3><p>@(string.IsNullOrWhiteSpace(plan.CompletionResult)?"Resultado de conclusão não recuperado nos dados históricos.":plan.CompletionResult)</p><h3>Evidência de conclusão</h3><p>@(string.IsNullOrWhiteSpace(plan.CompletionEvidence)?"Evidência de conclusão não recuperada nos dados históricos.":plan.CompletionEvidence)</p>}@if(plan.Status is "completed" or "canceled"){<div class="action-buttons"><a class="valora-button" asp-action="PrintPlan" asp-route-id="@plan.Id">Visualizar impressão</a></div>}</article>
        </section>
        <section class="valora-card" id="atividades">
            <div class="section-heading">
                <div><h2>Atividades</h2><p>@(planActivitiesPage.Total) compromisso(s) autorizado(s) neste plano.</p></div>
                @if (canCreate) { <button type="button" class="valora-button valora-button--primary" data-action-dialog-open="create-item-dialog">Nova atividade</button> }
            </div>
            @if (planActivitiesPage.Items.Count == 0) {
                <div class="valora-empty"><h3>@(planActivitiesPage.CurrentPage > 1 ? "Página sem resultados" : "Nenhuma atividade cadastrada")</h3><p>@(planActivitiesPage.CurrentPage > 1 ? "Volte à primeira página para continuar a navegação." : plan.Status is "completed" or "canceled" ? "O plano foi encerrado sem atividades visíveis no seu escopo." : "Crie a primeira atividade para acompanhar a execução deste plano.")</p></div>
            } else {
                <div class="table-responsive"><table class="valora-table">
                    <thead><tr><th>Atividade</th><th>Situação</th><th>Prioridade</th><th>Responsável</th><th>Progresso</th><th>Prazo</th></tr></thead>
                    <tbody>@foreach (var item in planActivitiesPage.Items) { <tr><td><a asp-action="ItemDetails" asp-route-id="@item.Id" asp-route-returnUrl="@planCurrentUrl">@item.Title</a></td><td>@ActionStatuses.Label(item.Status)</td><td>@ActionStatuses.Label(item.Priority)</td><td>@(item.ResponsibleName ?? "Sem responsável")</td><td>@item.ProgressPercent%</td><td>@(item.DueAt?.ToString("dd/MM/yyyy") ?? "A definir")</td></tr> }</tbody>
                </table></div>
                <nav class="pagination" aria-label="Páginas das atividades">
                    @if (planActivitiesPage.HasPrevious) { <a asp-action="PlanDetails" asp-route-id="@plan.Id" asp-route-itemPage="@(planActivitiesPage.CurrentPage - 1)" asp-route-returnUrl="@Model.ReturnUrl">Anterior</a> } else { <span class="disabled" aria-disabled="true">Anterior</span> }
                    <span>Página @(planActivitiesPage.CurrentPage) de @(planActivitiesPage.TotalPages)</span>
                    @if (planActivitiesPage.HasNext) { <a asp-action="PlanDetails" asp-route-id="@plan.Id" asp-route-itemPage="@(planActivitiesPage.CurrentPage + 1)" asp-route-returnUrl="@Model.ReturnUrl">Próxima</a> } else { <span class="disabled" aria-disabled="true">Próxima</span> }
                </nav>
            }
        </section>
        <section class="valora-card" id="historico">
          <div class="section-heading"><div><h2>Histórico</h2><p>Decisões de ciclo de vida e alterações operacionais, com autoria e versão.</p></div>
            <form method="get" asp-action="PlanDetails"><input type="hidden" name="id" value="@plan.Id"><input type="hidden" name="itemPage" value="@planActivitiesPage.CurrentPage"><input type="hidden" name="returnUrl" value="@Model.ReturnUrl"><label for="historyType">Tipo de alteração</label><select id="historyType" name="historyType" onchange="this.form.submit()"><option value="">Todas</option><option value="edit" selected="@(Model.HistoryType=="edit")">Edição</option><option value="assign" selected="@(Model.HistoryType=="assign")">Responsável</option><option value="reschedule" selected="@(Model.HistoryType=="reschedule")">Prazo</option><option value="submit" selected="@(Model.HistoryType=="submit")">Submissão</option><option value="approve" selected="@(Model.HistoryType=="approve")">Aprovação</option><option value="return" selected="@(Model.HistoryType=="return")">Devolução</option><option value="start" selected="@(Model.HistoryType=="start")">Início</option><option value="complete" selected="@(Model.HistoryType=="complete")">Conclusão</option><option value="cancel" selected="@(Model.HistoryType=="cancel")">Cancelamento</option><option value="approval_invalidated" selected="@(Model.HistoryType=="approval_invalidated")">Aprovação invalidada</option></select></form>
          </div>
          @if(Model.History.Items.Count==0){<div class="valora-empty"><h3>Nenhuma alteração registrada</h3><p>As próximas edições, atribuições e mudanças de prazo aparecerão aqui.</p></div>}else{<ol class="action-history">@foreach(var h in Model.History.Items){<li><strong>@(h.Operation switch{"assign"=>"Responsável alterado","reschedule"=>"Prazo reagendado","edit"=>"Conteúdo do plano atualizado","submit"=>"Plano submetido","return"=>"Plano devolvido","approve"=>"Plano aprovado","start"=>"Execução iniciada","complete"=>"Plano concluído","cancel"=>"Plano cancelado","approval_invalidated"=>"Aprovação invalidada por alteração material",_=>"Plano atualizado"})</strong><span>@h.ChangedAt.ToString("dd/MM/yyyy HH:mm") · @(h.AuthorName??"Autor não identificado")</span>@if(h.Operation=="edit"){<details><summary>Ver campos alterados</summary><div class="history-values" data-history-diff data-before="@h.FromValue" data-after="@h.ToValue"><noscript>Os detalhes estruturados exigem JavaScript.</noscript></div></details>}else{<div class="history-values"><span><b>Antes:</b> @(h.FromValue??"—")</span><span><b>Depois:</b> @(h.ToValue??"—")</span></div>}@if(!string.IsNullOrWhiteSpace(h.Reason)){<p><b>Justificativa:</b> @h.Reason</p>}</li>}</ol>}
          <nav class="pagination" aria-label="Páginas do histórico">@if(Model.History.HasPrevious){<a asp-action="PlanDetails" asp-route-id="@plan.Id" asp-route-itemPage="@planActivitiesPage.CurrentPage" asp-route-historyPage="@(Model.History.CurrentPage-1)" asp-route-historyType="@Model.HistoryType" asp-route-returnUrl="@Model.ReturnUrl">Anterior</a>}else{<span aria-disabled="true">Anterior</span>}<span>Página @Model.History.CurrentPage de @Model.History.TotalPages</span>@if(Model.History.HasNext){<a asp-action="PlanDetails" asp-route-id="@plan.Id" asp-route-itemPage="@planActivitiesPage.CurrentPage" asp-route-historyPage="@(Model.History.CurrentPage+1)" asp-route-historyType="@Model.HistoryType" asp-route-returnUrl="@Model.ReturnUrl">Próxima</a>}else{<span aria-disabled="true">Próxima</span>}</nav>
        </section>
    </main>
    @if (canCreate) {
      <dialog id="assign-plan-dialog" data-action-dialog aria-labelledby="assign-plan-title"><form method="post" action="/ActionCenter/Plans/@plan.Id/Assign">@Html.AntiForgeryToken()<input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl"><input type="hidden" name="HistoryPage" value="@Model.History.CurrentPage"><input type="hidden" name="HistoryType" value="@Model.HistoryType"><input type="hidden" name="Version" value="@(assignCommand?.Version??plan.Version)"><input type="hidden" name="CommandId" value="@(assignCommand?.CommandId??Guid.NewGuid().ToString("N"))"><div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div><h2 id="assign-plan-title">Responsável do plano</h2><p>Atual: <strong>@(plan.OwnerName??"Sem responsável")</strong>. Os responsáveis das atividades não serão modificados.</p><div data-responsible-selector data-selected-responsible="@(assignCommand is null?plan.OwnerUserId:assignCommand.ResponsibleUserId)"><label>Buscar pessoa elegível<input type="search" data-responsible-search></label><label>Novo responsável<select name="ResponsibleUserId" data-responsible-select data-empty-label="Sem responsável"><option value="">Sem responsável</option></select></label><span data-responsible-status role="status"></span><button type="button" data-responsible-more>Carregar mais</button></div><label>Justificativa<textarea name="Reason" maxlength="1000">@assignCommand?.Reason</textarea></label><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Confirmar responsável</button></div></form></dialog>
      <dialog id="reschedule-plan-dialog" data-action-dialog aria-labelledby="reschedule-plan-title"><form method="post" action="/ActionCenter/Plans/@plan.Id/Reschedule">@Html.AntiForgeryToken()<input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl"><input type="hidden" name="HistoryPage" value="@Model.History.CurrentPage"><input type="hidden" name="HistoryType" value="@Model.HistoryType"><input type="hidden" name="Version" value="@(dueCommand?.Version??plan.Version)"><input type="hidden" name="CommandId" value="@(dueCommand?.CommandId??Guid.NewGuid().ToString("N"))"><div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div><h2 id="reschedule-plan-title">Alterar prazo do plano</h2><p>Prazo atual: <strong>@(plan.DueAt?.ToString("dd/MM/yyyy")??"A definir")</strong>. Os prazos das atividades não serão modificados.</p><label>Novo prazo *<input type="date" name="DueAt" value="@(dueCommand?.DueAt?.ToString("yyyy-MM-dd")??plan.DueAt?.ToString("yyyy-MM-dd"))" required></label><label>Justificativa *<textarea name="Reason" minlength="3" maxlength="1000" required>@dueCommand?.Reason</textarea></label><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Confirmar novo prazo</button></div></form></dialog>
    }
    @if (canCreate) {
        <dialog id="create-item-dialog" data-action-dialog class="action-detail" aria-labelledby="create-item-title">
            <form method="post" asp-action="CreateItem">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div>
                <h2 id="create-item-title">Nova atividade em @plan.Title</h2>
                <label for="title">Título <span aria-hidden="true">*</span></label><input id="title" name="Title" minlength="3" maxlength="180" value="@command?.Title" required />
                <label for="description">Descrição</label><textarea id="description" name="Description" maxlength="2000">@command?.Description</textarea>
                <label for="outcome">Resultado esperado <span aria-hidden="true">*</span></label><textarea id="outcome" name="ExpectedOutcome" minlength="3" maxlength="2000" required>@command?.ExpectedOutcome</textarea>
                <label for="evidence">Evidência inicial <span aria-hidden="true">*</span></label><textarea id="evidence" name="EvidenceSummary" minlength="3" maxlength="2000" required>@command?.EvidenceSummary</textarea>
                <div class="form-grid">
                    <div data-responsible-selector data-selected-responsible="@command?.ResponsibleUserId">
                        <label for="responsible-search">Buscar responsável</label><input id="responsible-search" type="search" autocomplete="off" aria-describedby="responsible-status" data-responsible-search />
                        <label for="responsible">Responsável</label><select id="responsible" name="ResponsibleUserId" aria-describedby="responsible-status" data-responsible-select data-empty-label="Sem responsável"><option value="">Sem responsável</option>@foreach (var owner in Model.ResponsibleOptions.Items) { <option value="@owner.Id" selected="@(command?.ResponsibleUserId == owner.Id)">@owner.Title</option> }</select>
                        <span id="responsible-status" class="option-status" role="status" aria-live="polite" data-responsible-status></span>
                        <button type="button" class="valora-button valora-button--ghost" data-responsible-more>Carregar mais</button>
                    </div>
                    <label for="priority">Prioridade <span aria-hidden="true">*</span><select id="priority" name="Priority" required><option value="medium" selected="@(command?.Priority is null or "medium")">Média</option><option value="high" selected="@(command?.Priority == "high")">Alta</option><option value="critical" selected="@(command?.Priority == "critical")">Crítica</option><option value="low" selected="@(command?.Priority == "low")">Baixa</option></select></label>
                    <label for="due">Prazo<input id="due" name="DueAt" type="date" value="@command?.DueAt?.ToString("yyyy-MM-dd")" /></label>
                </div>
                <input type="hidden" name="ActionPlanId" value="@plan.Id" /><input type="hidden" name="OriginType" value="manual" /><input type="hidden" name="CommandId" value="@(command?.CommandId ?? Guid.NewGuid().ToString())" /><input type="hidden" name="returnUrl" value="@Model.ReturnUrl" /><input type="hidden" name="itemPage" value="@planActivitiesPage.CurrentPage" />
                <div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button type="submit" class="valora-button valora-button--primary">Criar atividade</button></div>
            </form>
        </dialog>
    }
    @if(plan.Status is not "completed" and not "canceled") {
      @foreach(var op in new[]{("submit-plan-dialog","Submeter para avaliação","Submit",false),("return-plan-dialog","Devolver para ajustes","Return",true),("approve-plan-dialog","Aprovar plano","Approve",false),("start-plan-dialog","Iniciar execução","Start",false),("cancel-plan-dialog","Cancelar plano","Cancel",true)}) {
        var show = op.Item3 switch { "Submit" => capabilities.CanSubmit, "Return" => capabilities.CanReturn, "Approve" => capabilities.CanApprove, "Start" => capabilities.CanStart, "Cancel" => capabilities.CanCancel, _ => false };
        if(show){<dialog id="@op.Item1" data-action-dialog aria-labelledby="@(op.Item1)-title"><form method="post" action="/ActionCenter/Plans/@plan.Id/@op.Item3">@Html.AntiForgeryToken()<input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl"><input type="hidden" name="HistoryPage" value="@Model.History.CurrentPage"><input type="hidden" name="HistoryType" value="@Model.HistoryType"><input type="hidden" name="Version" value="@(transitionCommand?.Version??plan.Version)"><input type="hidden" name="CommandId" value="@(transitionCommand?.CommandId??Guid.NewGuid().ToString("N"))"><div asp-validation-summary="All" class="alert alert-danger" role="alert"></div><h2 id="@(op.Item1)-title">@op.Item2</h2><p>Plano: <strong>@plan.Title</strong><br>Situação atual: @ActionStatuses.Label(plan.Status). A decisão será registrada no histórico e não alterará atividades em cascata.</p><label>Observação @(op.Item4?"*":"(opcional)")<textarea name="Note" minlength="@(op.Item4?3:0)" maxlength="1000" required="@op.Item4">@transitionCommand?.Note</textarea></label><div class="dialog-actions"><button type="button" data-dialog-close>Voltar</button><button class="valora-button valora-button--primary">Confirmar @op.Item2.ToLowerInvariant()</button></div></form></dialog>}
      }
    }
    <script src="~/js/responsible-selector.js" asp-append-version="true"></script>
    <script src="~/js/action-center.js" asp-append-version="true" data-open-dialog="@Model.OpenDialog"></script>
    <script src="~/js/action-plan-closure.js" asp-append-version="true" defer></script>
</div>
