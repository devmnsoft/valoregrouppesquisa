@{ ViewData["Title"] = "Usuários"; }
<section class="page-card" data-page="users-page"><header class="module-heading"><div><p class="eyebrow">Acessos da organização</p><h1>Usuários</h1><p class="text-muted">Gerencie pessoas, convites e sessões com segurança.</p></div><button class="btn btn-primary" data-new-invitation>Novo convite</button></header><div class="alert alert-danger d-none" data-error></div><nav class="nav nav-tabs mt-4"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#users-list">Usuários</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#invitations-list">Convites</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#sessions-list">Sessões</button></nav><div class="tab-content py-4"><div class="tab-pane show active" id="users-list"><form data-filters class="row g-2 mb-3"><div class="col-md-7"><input class="form-control" name="search" placeholder="Buscar por nome ou e-mail"></div><div class="col-md-3"><select class="form-select" name="status"><option value="">Todos os status</option><option value="active">Ativos</option><option value="inactive">Inativos</option></select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Filtrar</button></div></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Usuário</th><th>Perfis</th><th>Status</th><th>Último acesso</th></tr></thead><tbody data-users></tbody></table></div></div><div class="tab-pane" id="invitations-list"><div data-invitations></div></div><div class="tab-pane" id="sessions-list"><p class="text-muted">Selecione um usuário para consultar e revogar suas sessões ativas.</p></div></div></section>
@section Scripts { <script src="/js/pages/users-page.js"></script> }
