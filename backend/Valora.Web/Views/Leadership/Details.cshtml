@model Valora.Application.OneOnOne.LeadershipProfileDto
@{ViewData["Title"]=Model.DisplayName;}<main class="valora-page"><header class="leadership-hero"><div><p class="eyebrow">Perfil de liderança</p><h1>@Model.DisplayName</h1><p>@(Model.RoleTitle??"Desenvolvimento contínuo")</p></div><a href="/OneOnOne/Sessions" class="btn btn-primary">Ver sessões</a></header><section class="v9-kpis"><article><span>Último acompanhamento</span><strong>@(Model.LastSessionAt?.ToString("dd/MM/yyyy")??"—")</strong></article><article><span>Compromissos pendentes</span><strong>@Model.PendingCommitments</strong></article></section><section class="valora-card"><h2>Evolução baseada em evidências</h2><p>@(Model.DevelopmentSummary??"Ainda não há evidência suficiente para resumir a evolução.")</p><small>Esta leitura apoia a conversa humana; não é avaliação moral ou diagnóstico individual.</small></section><section class="valora-card journey-timeline"><h2>Histórico e Journey</h2><div class="valora-empty"><p>Snapshots e eventos concluídos preservam a evolução sem expor notas privadas.</p></div></section></main>
