@model IReadOnlyList<Valora.Application.ActionCenter.ActionPlanDto>

@{
    ViewData["Title"]="Planos de Ação";
}

<main class="valora-page"><header class="leadership-hero"><div><p class="eyebrow">Valora Action™</p><h1>Planos de ação</h1></div><a class="btn btn-primary" href="/ActionCenter/Plans/Create">Criar plano</a></header><section class="valora-card">@if(Model.Count==0){<div class="valora-empty"><h3>Transforme evidência em compromisso</h3><p>Nenhum plano foi criado.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Título</th><th>Origem</th><th>Status</th><th>Prioridade</th><th>Progresso</th><th>Prazo</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><a href="/ActionCenter/Plans/Details/@p.Id">@p.Title</a></td><td>@p.OriginType</td><td>@p.Status</td><td>@p.Priority</td><td>@p.ProgressPercent%</td><td>@(p.DueAt?.ToString("dd/MM/yyyy")??"—")</td></tr>}</tbody></table></div>}</section></main>
