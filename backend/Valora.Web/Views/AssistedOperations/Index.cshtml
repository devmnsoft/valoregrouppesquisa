@{ Layout="_AdminLayout"; var module=(string)ViewData["Module"]!; }
<div class="page-container operation-workspace" data-operation-module="@module">
  <nav class="breadcrumb" aria-label="Navegação estrutural"><a href="/Dashboard">Visão Geral</a><span>/</span><span>Operação</span><span>/</span><strong>@ViewData["Title"]</strong></nav>
  <header class="page-header"><div><span class="eyebrow">OPERAÇÃO ASSISTIDA</span><h1>@ViewData["Title"]</h1><p>@ViewData["Subtitle"]</p></div><button class="btn btn-primary" type="button" data-primary-action>Nova solicitação</button></header>
  <section class="metric-grid" aria-label="Resumo"><article class="metric-card"><span>Total acompanhado</span><strong data-metric="total">—</strong><small>registros no escopo autorizado</small></article><article class="metric-card"><span>Exigem atenção</span><strong data-metric="attention">—</strong><small>prioridade operacional</small></article><article class="metric-card"><span>Atualização</span><strong>Agora</strong><small>dados consultados em tempo real</small></article></section>
  <section class="surface-card"><div class="table-toolbar"><div><h2>Visão operacional</h2><p>Dados reais, segregados por organização.</p></div><label class="search-field">Filtrar <input type="search" data-filter placeholder="Status, módulo ou título"></label></div><div class="alert alert-danger d-none" data-error></div><div class="empty-state d-none" data-empty><h3>Nenhum registro no período</h3><p>O estado vazio é real; ajuste o filtro ou use a ação principal para iniciar o fluxo.</p></div><div class="table-responsive"><table class="premium-table"><thead data-head></thead><tbody data-rows><tr><td><span class="skeleton">Carregando dados operacionais…</span></td></tr></tbody></table></div></section>
  <dialog class="operation-drawer" data-drawer><form method="dialog"><header><div><span class="eyebrow">REGISTRO OPERACIONAL</span><h2 data-drawer-title>Novo registro</h2></div><button value="cancel" class="icon-button" aria-label="Fechar">×</button></header><div data-form-fields></div><footer><button value="cancel" class="btn btn-outline-secondary">Cancelar</button><button value="default" type="button" class="btn btn-primary" data-save>Salvar com rastreabilidade</button></footer></form></dialog>
</div>
@section Scripts { <script src="/js/pages/assisted-operations.js" asp-append-version="true"></script> }
