@model Valora.Web.Models.ViewModels.ProcessesIndexViewModel
@{ViewData["Title"]="Process Intelligence & Automation Studio™";}
<link rel="stylesheet" href="~/css/processes.css" asp-append-version="true" />
<section class="process-hero"><div><span>EXECUÇÃO ORGANIZACIONAL</span><h1>Process Intelligence<br />& Automation Studio™</h1><p>Transforme recomendações em fluxos executáveis, auditáveis e monitoráveis — com evidência e decisão humana preservadas.</p></div><a asp-action="Definitions" class="process-primary">Explorar processos →</a></section>
<nav class="process-tabs" aria-label="Áreas do Studio"><a asp-action="Definitions">Definições</a><a asp-action="Builder">Builder</a><a asp-action="Instances">Instâncias</a><a asp-action="Approvals">Aprovações</a><a asp-action="Sla">SLA</a><a asp-action="Insights">Insights</a><a asp-action="Templates">Templates</a></nav>
<section class="process-metrics" aria-label="Indicadores executivos">
@foreach(var metric in new[]{("Processos ativos",Model.Dashboard.ActiveProcesses,"stable"),("Em andamento",Model.Dashboard.RunningInstances,"stable"),("SLA em risco",Model.Dashboard.SlaAtRisk,"risk"),("SLA atrasado",Model.Dashboard.SlaOverdue,"late"),("Aprovações",Model.Dashboard.PendingApprovals,"risk"),("Gargalos",Model.Dashboard.Bottlenecks,"late")}){<article class="metric @metric.Item3"><span>@metric.Item1</span><strong>@metric.Item2</strong><small>dados da organização atual</small></article>}
</section>
<div class="process-grid"><section class="process-panel wide"><header><div><span>FLUXO OPERACIONAL</span><h2>Execuções recentes</h2></div><a asp-action="Instances">Ver todas</a></header>@if(Model.Dashboard.RecentInstances.Count==0){<div class="process-empty"><strong>Nenhuma execução iniciada</strong><p>Publique um processo com etapas inicial e final para iniciar uma execução monitorável.</p></div>}else{@foreach(var item in Model.Dashboard.RecentInstances){<article class="instance-row"><i></i><div><strong>@item.Title</strong><span>@item.ProcessName · @item.CurrentStepName</span></div><em class="status">@item.Status</em><time>@(item.DueAt?.ToString("dd/MM HH:mm")??"Sem SLA")</time></article>}}</section>
<section class="process-panel"><header><div><span>ATENÇÃO</span><h2>SLAs prioritários</h2></div><a asp-action="Sla">Painel</a></header>@if(Model.Sla.Count==0){<div class="process-empty compact"><strong>Nenhum SLA em atenção</strong><p>Os riscos aparecerão quando houver evidência temporal.</p></div>}else{@foreach(var item in Model.Sla.Take(5)){<article class="sla-row"><span class="sla-dot @item.Risk"></span><div><strong>@item.InstanceTitle</strong><small>@item.StepName · @item.DueAt.ToString("dd/MM HH:mm")</small></div></article>}}</section></div>
<section class="principles"><strong>Governança por desenho</strong><span>Evidência antes da conclusão</span><span>Decisão humana preservada</span><span>Histórico imutável de eventos</span><span>Isolamento por organização</span></section>
