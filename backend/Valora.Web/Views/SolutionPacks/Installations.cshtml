@model Valora.Web.Models.ViewModels.SolutionPackInstallationsViewModel
@{ViewData["Title"]="Instalações de Solution Packs";}
<h1>Instalações e atualizações</h1><p>Histórico isolado da organização, com versão instalada e possibilidade técnica de rollback.</p><div class="row">@foreach(var i in Model.Installations){<div class="col-md-6"><article class="card p-3 mb-3"><h2>@i.PackName</h2><p>Versão @i.VersionNumber · @i.Status</p><small>Instalado em @i.InstalledAt.ToString("g")</small>@if(i.CanRollback){<span class="badge bg-warning text-dark">Rollback disponível</span>}</article></div>}@if(Model.Installations.Count==0){<div class="alert alert-info">Nenhum pacote foi instalado nesta organização.</div>}</div><h2>Updates</h2>@foreach(var u in Model.Updates){<p><strong>@u.PackName</strong>: @u.InstalledVersion → @u.AvailableVersion</p>}
