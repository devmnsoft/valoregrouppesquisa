@model Valora.Web.Models.ViewModels.CreateAdminUserViewModel
@{ ViewData["Title"] = "Novo usuário"; }
<section class="valora-page">
    <partial name="_PageHeader" model="@(new Valora.Web.Models.PageHeaderViewModel("Novo usuário", Model.OrganizationName is "" ? "Criação de pessoa na organização do contexto." : $"Criando pessoa na organização {Model.OrganizationName}.", "Admin Hub"))" />
    @if (TempData["AdminNotice"] is string adminNotice) { <div class="alert alert-success">@adminNotice</div> }
    @if (Model.Error is not null) { <div class="alert alert-danger" role="alert"><strong>@Model.Error</strong></div> }
    <form method="post" asp-action="CreateUser" class="admin-panel" data-dirty-guard="true">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Name">Nome completo</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Email">E-mail</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Password">Senha inicial</label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger"></span><small class="text-muted">A senha é validada pela política do sistema antes do cadastro.</small></div>
            <div class="col-md-6">
                <label asp-for="RoleCode">Papel</label>
                <select asp-for="RoleCode" asp-items="Model.Roles" class="form-select">
                    <option value="">Selecione…</option>
                </select>
                <span asp-validation-for="RoleCode" class="text-danger"></span>
            </div>
        </div>
        <button class="btn btn-primary mt-4" type="submit">Criar usuário</button>
        <a asp-action="Users" class="btn btn-link ms-2">Cancelar</a>
    </form>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_FormDirtyGuard" />
}
