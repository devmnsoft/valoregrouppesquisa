@model Valora.Application.DecisionCenter.DecisionCenterOverviewDto
@{ ViewData["Title"]="Valora Decision Center™"; }

<main class="dc-page"><header class="dc-hero"><small>GOVERNANÇA E DECISÃO</small><h1>Valora Decision Center™</h1><p>Transforme evidências em prioridades acompanháveis. A plataforma organiza o contexto; a decisão permanece humana.</p></header><section class="dc-grid"><article class="dc-card dc-kpi"><span>Alertas críticos abertos</span><strong>@Model.CriticalAlerts</strong><a href="/DecisionCenter/Alerts">Revisar alertas</a></article><article class="dc-card dc-kpi"><span>Decisões pendentes</span><strong>@Model.PendingDecisions</strong><a href="/Decisions">Acompanhar decisões</a></article><article class="dc-card dc-kpi"><span>Indicadores em regressão</span><strong>@Model.RegressingMetrics</strong><a href="/Indicators">Ver evidências</a></article><article class="dc-card dc-kpi"><span>Ações atrasadas</span><strong>@Model.OverdueActions</strong><a href="/ActionPlans">Abrir Action Center</a></article></section><section class="dc-grid"><article class="dc-card"><h2>Alertas prioritários</h2>@if(Model.Alerts.Count==0){<div class="dc-empty">Nenhum alerta sustentado por evidências está aberto.</div>}else foreach(var x in Model.Alerts){<div class="dc-row"><div><span class="dc-badge @x.Severity">@x.Severity</span><strong>@x.Title</strong><p>@x.EvidenceSummary</p></div></div>}</article><article class="dc-card"><h2>Ciclos ativos</h2>@if(Model.Cycles.Count==0){<div class="dc-empty">Inicie um ciclo para conectar diagnóstico, decisão e aprendizagem.</div>}else foreach(var x in Model.Cycles){<div class="dc-row"><a href="/Governance/Cycles/Details/@x.Id">@x.Name</a><span>@x.PeriodLabel</span></div>}</article></section></main>
