@model Valora.Web.Models.ViewModels.RiskComplianceSectionViewModel
@{ViewData["Title"]=Model.Title;}
<link rel="stylesheet" href="~/css/risk-compliance.css" asp-append-version="true" />
<section class="rc-section-head"><span>@Model.Eyebrow</span><h1>@Model.Title</h1><p>@Model.Description</p><a asp-action="Index">← Visão executiva</a></section>
<nav class="rc-tabs"><a asp-action="Risks">Riscos</a><a asp-action="Heatmap">Heatmap</a><a asp-action="Controls">Controles</a><a asp-action="Compliance">Compliance</a><a asp-action="NonConformities">Não conformidades</a><a asp-action="MitigationPlans">Mitigação</a><a asp-action="Audits">Auditorias</a></nav>
@if(Model.Heatmap.Count>0){<section class="rc-heatmap" aria-label="Mapa de probabilidade por impacto"><div class="axis y">IMPACTO</div>@for(var impact=5;impact>=1;impact--){@for(var probability=1;probability<=5;probability++){var points=Model.Heatmap.Where(x=>(int)x.Impact==impact&&(int)x.Probability==probability).ToList();<article class="cell level-@(impact*probability)"><b>@impact × @probability</b>@foreach(var p in points){<span title="@p.Title">@p.Title <small>@(p.Confidence=="hypothesis"?"hipótese":"evidenciado")</small></span>}</article>}}<div class="axis x">PROBABILIDADE →</div></section>}
else if(Model.Risks.Count>0){<section class="rc-table"><header><span>Risco</span><span>Categoria</span><span>Criticidade</span><span>Confiança</span><span>Status</span></header>@foreach(var r in Model.Risks){<article><strong>@r.Title<small>@r.OwnerName</small></strong><span>@r.Category</span><b>@r.Criticality.ToString("0.#")</b><em class="confidence @r.Confidence">@(r.Confidence=="hypothesis"?"Hipótese":r.Confidence=="low"?"Baixa":"Evidenciado")</em><span>@r.Status</span></article>}</section>}
else if(Model.Controls.Count>0){<section class="rc-table four"><header><span>Controle</span><span>Estado</span><span>Último teste</span><span>Responsável</span></header>@foreach(var c in Model.Controls){<article><strong>@c.Name</strong><em>@c.State</em><span>@(c.LastTestResult??"Não testado")</span><span>@c.OwnerName</span></article>}</section>}
else if(Model.Frameworks.Count>0){<section class="rc-table four"><header><span>Framework</span><span>Versão</span><span>Requisitos</span><span>Aderência evidenciada</span></header>@foreach(var f in Model.Frameworks){<article><strong>@f.Name</strong><span>@f.Version</span><span>@f.RequirementCount</span><b>@(f.Adherence?.ToString("0.##")??"Não avaliada")@(f.Adherence is null?"":"%")</b></article>}</section>}
else if(Model.NonConformities.Count>0){<section class="rc-table four"><header><span>Não conformidade</span><span>Severidade</span><span>Status</span><span>Mitigação</span></header>@foreach(var n in Model.NonConformities){<article><strong>@n.Title<small>@n.DetectedAt.ToString("dd/MM/yyyy")</small></strong><em>@n.Severity</em><span>@n.Status</span><span>@(n.MitigationPlanId is null?"Plano necessário":"Plano vinculado")</span></article>}</section>}
else{<section class="rc-empty rc-large"><strong>Nenhum dado evidenciado nesta área</strong><p>A tela permanece vazia por desenho: o Valora não inventa riscos, conformidade, testes ou auditorias. Registros surgirão após validação humana.</p></section>}
