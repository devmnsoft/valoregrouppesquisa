@model IReadOnlyList<Valora.Application.Evolution.EvolutionCycleDto>
@using Valora.Application.Evolution
@{
    ViewData["Title"] = "Ciclos de evolução";
    var command = ViewData["CycleCommand"] as EvolutionCycleViewModel ?? new();
    var options = ViewData["ResultOptions"] as IReadOnlyList<EvolutionResultOptionDto> ?? [];
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/Evolution";
    var zoneName = ViewData["OrganizationTimeZone"] as string ?? "UTC";
    var zone = TimeZoneInfo.FindSystemTimeZoneById(zoneName);
    string When(DateTime value) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(value, DateTimeKind.Utc), zone).ToString("dd/MM/yyyy HH:mm");
    string Status(string value) => value switch { "closed" => "Encerrado", "archived" => "Arquivado", "reviewed" => "Reavaliado", "monitoring" => "Em acompanhamento", _ => "Aberto" };
}
@section Styles { <link rel="stylesheet" href="~/css/evolution.css" asp-append-version="true"> }
<main class="valora-page evolution-cycles">
    <partial name="_PageHeader" model="@(new PageHeaderViewModel("Ciclos de evolução", "Objetivos, execução e medições preservadas.", "Valora Evolution", Actions: new[] { new PageHeaderAction("Novo ciclo", DataAction: "new-cycle", Style: "primary", Icon: "plus"), new PageHeaderAction("Voltar", returnUrl) }))" />
    <div asp-validation-summary="All" role="alert"></div>
    @if (Model.Count == 0) { <partial name="_EmptyState" model="@(new EmptyStateViewModel("Nenhum ciclo cadastrado", "Ainda não há ciclos de evolução neste contexto."))" /> }
    else {
        <div class="table-responsive"><table class="valora-table"><thead><tr><th>Ciclo</th><th>Início</th><th>Situação</th><th>Referência inicial</th><th>Valor na base inicial</th></tr></thead><tbody>
            @foreach (var cycle in Model) { <tr><td><a href="/Evolution/Cycles/Details/@cycle.Id?returnUrl=@Uri.EscapeDataString(returnUrl)">@(string.IsNullOrWhiteSpace(cycle.Title) ? "Ciclo histórico sem título" : cycle.Title)</a><small class="d-block">@(cycle.BaselineSource == "legacy_review_required" ? "Referência pendente de revisão" : cycle.BaselineSource == "manual_informed" ? "Referência manual" : "Medição organizacional preservada")</small></td><td>@cycle.PeriodStart.ToString("dd/MM/yyyy")</td><td>@Status(cycle.Status)</td><td>@(cycle.BaselineScore?.ToString("0.00") ?? "Sem medição")</td><td>@(cycle.CurrentScore?.ToString("0.00") ?? "Sem medição")</td></tr> }
        </tbody></table></div>
    }
    <dialog class="valora-dialog" data-cycle-dialog aria-labelledby="cycle-title">
        <form method="post" action="/Evolution/Cycles/Open?returnUrl=@Uri.EscapeDataString(returnUrl)" data-submit-once>
            @Html.AntiForgeryToken()
            <header><h2 id="cycle-title">Criar ciclo de evolução</h2><button type="button" class="btn-close" data-dialog-close aria-label="Fechar"></button></header>
            <input type="hidden" name="DiagnosticId" value="@command.DiagnosticId">
            <input type="hidden" name="ResultId" value="@command.ResultId">
            <div asp-validation-summary="All" role="alert"></div>
            <fieldset><legend>Referência inicial</legend><label><input type="radio" name="ReferenceMode" value="calculated" checked="@(command.ReferenceMode == "calculated")"> Medição calculada</label><label><input type="radio" name="ReferenceMode" value="manual" checked="@(command.ReferenceMode == "manual")"> Valor manual</label><p class="form-help">A medição calculada preserva uma leitura organizacional. O valor manual registra uma referência informada.</p></fieldset>
            <div data-calculated-fields hidden="@(command.ReferenceMode != "calculated")">
                <div class="valora-field"><label for="cycle-result">Pesquisa da medição inicial</label><select id="cycle-result" name="SourceSurveyId" data-measurement-select><option value="">Selecione</option>@foreach (var option in options) { <option value="@option.SourceSurveyId" data-score="@option.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(command.SourceSurveyId == option.SourceSurveyId)">@option.DiagnosticTitle · medição organizacional · @option.Percentage.ToString("0.00") pontos · @option.ScoredResponseCount respostas · @When(option.CalculatedAt) (@zoneName) · @option.MethodologyVersion</option> }</select>@Html.ValidationMessage("SourceSurveyId")</div>
                <button type="button" class="valora-button" data-measurements-more data-diagnostic="@command.DiagnosticId" data-page="2">Carregar mais medições</button><span role="status" data-measurements-status></span>
                <div class="valora-field"><label for="calculated-score">Nota calculada</label><input id="calculated-score" type="number" min="0" max="100" step="0.01" readonly value="" data-calculated-score></div>
            </div>
            <div class="valora-field" data-manual-fields hidden="@(command.ReferenceMode != "manual")"><label for="cycle-baseline">Valor manual (0 a 100)</label><input id="cycle-baseline" name="BaselineScore" value="@command.BaselineScore?.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="100" step="0.01">@Html.ValidationMessage("BaselineScore")</div>
            <div class="form-grid">
                <div class="valora-field"><label for="cycle-name">Nome do ciclo</label><input id="cycle-name" name="Title" value="@command.Title" required minlength="3" maxlength="160">@Html.ValidationMessage("Title")</div>
                <div class="valora-field"><label for="cycle-start">Data inicial</label><input id="cycle-start" name="PeriodStart" value="@command.PeriodStart.ToString("yyyy-MM-dd")" type="date" required>@Html.ValidationMessage("PeriodStart")</div>
                <div class="valora-field"><label for="cycle-end">Data final</label><input id="cycle-end" name="PeriodEnd" value="@command.PeriodEnd?.ToString("yyyy-MM-dd")" type="date">@Html.ValidationMessage("PeriodEnd")</div>
                <div class="valora-field"><label for="cycle-target">Meta (0 a 100)</label><input id="cycle-target" name="TargetScore" value="@command.TargetScore?.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="100" step="0.01">@Html.ValidationMessage("TargetScore")</div>
            </div>
            <div class="valora-field"><label for="cycle-summary">Objetivo</label><textarea id="cycle-summary" name="Summary" required maxlength="1000" rows="3">@command.Summary</textarea>@Html.ValidationMessage("Summary")</div>
            <div class="valora-field"><label for="cycle-evidence">Evidência inicial</label><textarea id="cycle-evidence" name="EvidenceSummary" required maxlength="2000" rows="3">@command.EvidenceSummary</textarea>@Html.ValidationMessage("EvidenceSummary")</div>
            <partial name="_FormActions" model="@(new FormActionsViewModel("Criar ciclo", "Cancelar"))" />
        </form>
    </dialog>
</main>
@section Scripts {
    <script src="~/js/pages/evolution.js" asp-append-version="true"></script>
    @if (!ViewData.ModelState.IsValid) { <script>document.querySelector('[data-cycle-dialog]')?.showModal();</script> }
}
