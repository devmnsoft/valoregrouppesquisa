@{ ViewData["Title"] = "Cockpit Executivo"; }
<main class="v9-page" data-page="cockpit-v9">
  <header class="v9-hero v9-hero--executive"><div><p class="eyebrow">Cockpit Executivo</p><h1>Decisões melhores começam com clareza</h1><p>Uma leitura consolidada de maturidade, adesão e execução estratégica.</p></div><button class="valora-button valora-button--primary" data-generate-report>Gerar relatório executivo</button></header>
  <section class="v9-kpis"><article><span>Maturidade geral</span><strong data-cockpit="maturity">—</strong><small>Leitura consolidada</small></article><article><span>Pesquisas ativas</span><strong data-cockpit="surveys">—</strong><small>Ciclos em campo</small></article><article><span>Respostas</span><strong data-cockpit="responses">—</strong><small>Participações recebidas</small></article><article><span>Adesão</span><strong data-cockpit="rate">—</strong><small>Conclusão dos ciclos</small></article></section>
  <div class="v9-executive-grid"><section class="valora-card"><p class="eyebrow">Tendência</p><h2>Evolução da escuta</h2><div class="v9-chart" data-trend aria-label="Gráfico de tendência"></div></section><section class="valora-card"><p class="eyebrow">Prioridade executiva</p><h2>O que merece sua atenção agora</h2><div class="v9-attention" data-attention></div></section></div>
