@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken">
  <title>@ViewData["Title"] - Valora Group</title>
  <meta name="theme-color" content="#0c3448">
  <link href="/lib/bootstrap/bootstrap.min.css" rel="stylesheet" asp-append-version="true">
  <link rel="stylesheet" href="/css/design-system/tokens.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/design-system/typography.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/design-system/layout.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/design-system/components.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/design-system/forms.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/design-system/tables.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/design-system/feedback.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/design-system/dashboard.css" asp-append-version="true">
  <!-- v9 supplies legacy-compatible primitives; the administrative theme deliberately
       follows it so the premium shell wins the cascade. Responsive rules stay last. -->
  <link rel="stylesheet" href="/css/valora-v9.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/valora-admin.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/valora.modules.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/valora-components.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/design-system/responsive.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/valora-responsive.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/print.css" asp-append-version="true">
</head>
<body class="valora-shell admin-body">
  <a class="valora-skip-link" href="#main-content">Ir para o conteúdo principal</a>
  @if (Configuration.GetValue<bool>("App:MaintenanceModeEnabled"))
  {
    <div class="alert alert-warning rounded-0 mb-0 text-center" role="status"><strong>Manutenção programada:</strong> @(Configuration["App:MaintenanceMessage"] ?? "O sistema está em manutenção programada. Tente novamente mais tarde.")</div>
  }
  <div id="loadingOverlay" class="loading-overlay d-none">
    <div class="spinner-border text-info"></div>
    <p id="loadingMessage">Carregando...</p>
  </div>
  <div class="app-shell valora-admin-shell">
    @await Component.InvokeAsync("Navigation")
    <main class="app-main" id="main-content" tabindex="-1">
      @await Html.PartialAsync("_Topbar")
      @await Html.PartialAsync("_OrganizationContextBanner")
      <section class="content-wrapper valora-admin-content">@RenderBody()</section>
      @await Html.PartialAsync("_Footer")
    </main>
  </div>
  @await Html.PartialAsync("_ToastContainer")
    <script src="/lib/bootstrap/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="/web-config.js" asp-append-version="true"></script>
<script src="/js/config.js" asp-append-version="true"></script>
<script src="/js/core/logger.js"></script>
<script src="/js/core/errors.js"></script>
<script src="/js/core/storage.js"></script>
<script src="/js/core/auth-session.js"></script>
<script src="/js/security/role-definitions.js"></script>
<script src="/js/security/module-definitions.js"></script>
<script src="/js/security/permissions.js"></script>
<script src="/js/core/guards.js"></script>
<script src="/js/core/masks.js"></script>
<script src="/js/core/formatters.js"></script>
<script src="/js/core/validators.js"></script>
<script src="/js/core/loading.js"></script>
<script src="/js/core/toast.js"></script>
<script src="/js/core/modal.js"></script>
<script src="/js/core/table.js"></script>
<script src="/js/core/form.js"></script>
<script src="/js/api/ajax-client.js"></script>
<script src="/js/api/auth-api.js"></script>
<script src="/js/api/plans-api.js"></script>
<script src="/js/api/surveys-api.js"></script>
<script src="/js/api/public-survey-api.js"></script>
<script src="/js/api/results-api.js"></script>
<script src="/js/api/certificates-api.js"></script>
<script src="/js/api/communications-api.js"></script>
<script src="/js/api/free-diagnostics-api.js"></script>
<script src="/js/api/audit-api.js"></script>
<script src="/js/api/migration-api.js"></script>
<script src="/js/api/health-api.js"></script>
<script src="/js/api/organization-api.js"></script>
<script src="/js/api/users-api.js"></script>
<script src="/js/api/access-api.js"></script>
<script src="/js/api/forms-api.js"></script>
<script src="/js/api/public-links-api.js"></script>
<script src="/js/api/responses-api.js"></script>
<script src="/js/api/settings-api.js"></script>
<script src="/js/api/usage-api.js"></script>
<script src="/js/router.js"></script>
<script src="/js/app.js"></script>
<script src="/js/shell/navigation-shell.js" asp-append-version="true" defer></script>
<script src="/js/shell/topbar-shell.js" asp-append-version="true" defer></script>
<script src="/js/components/valora-experience.js" asp-append-version="true" defer></script>
<script src="/js/components/footer.js"></script>
<script src="/js/components/status-badge.js"></script>
<script src="/js/components/copy-link-button.js"></script>
<script src="/js/components/plan-limit-alert.js"></script>
<script src="/js/components/pagination.js"></script>
<script src="/js/components/filter-panel.js"></script>
<script src="/js/components/table-toolbar.js"></script>
<script src="/js/components/error-state.js"></script>
<script src="/js/components/empty-state.js"></script>
<script src="/js/components/plan-card.js"></script>
<script src="/js/components/survey-card.js"></script>
<script src="/js/components/result-card.js"></script>
<script src="/js/components/certificate-card.js"></script>
@await RenderSectionAsync("Scripts", required: false)</body></html>
