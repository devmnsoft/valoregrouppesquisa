@model IReadOnlyList<Valora.Application.Evolution.EvolutionCycleDto>
@{ ViewData["Title"] = "Evolução"; var active = Model.FirstOrDefault(x => x.Status is "open" or "monitoring"); }
<main class="valora-page">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel("Evolução organizacional", "Compare ciclos, reconheça marcos e acompanhe mudanças sustentadas por evidências.", "Valora Evolution™", "Linha do tempo", new[] { new PageHeaderAction("Gerenciar ciclos", "/Evolution/Cycles", Style: "primary", Icon: "calendar"), new PageHeaderAction("Abrir indicadores", "/Indicators", Icon: "chart") }))" />
  <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel("Como interpretar a evolução", "Use o baseline como ponto de partida e compare apenas ciclos equivalentes. Tendências orientam investigação; não representam causalidade automática.", new[] { "Confirme o ciclo e a linha de base.", "Registre evidências e marcos.", "Compare o valor atual com a meta." }))" />
  <section class="v9-kpis"><partial name="_MetricCard" model="@(new MetricCardViewModel("Score atual", active?.CurrentScore?.ToString("0.0") ?? "—", "Última leitura válida"))" /><partial name="_MetricCard" model="@(new MetricCardViewModel("Baseline", active?.BaselineScore?.ToString("0.0") ?? "—", "Ponto inicial do ciclo"))" /><partial name="_MetricCard" model="@(new MetricCardViewModel("Meta", active?.TargetScore?.ToString("0.0") ?? "—", "Resultado acordado"))" /><partial name="_MetricCard" model="@(new MetricCardViewModel("Tendência", active?.Trend ?? "Sem base", "Requer ciclos comparáveis"))" /></section>
  <section class="valora-card"><div class="section-heading"><div><p class="eyebrow">Histórico comparável</p><h2>Ciclos recentes</h2><p>Acompanhe antes, depois, progresso e contexto de cada leitura.</p></div><a class="valora-button valora-button--ghost" href="/Evolution/Cycles">Ver linha do tempo</a></div>@if (Model.Count == 0) { <partial name="_EmptyState" model="@(new EmptyStateViewModel("Sem ciclo comparável", "Abra um ciclo com baseline e evidência para preservar a primeira leitura.", "Criar ciclo", "/Evolution/Cycles"))" /> } else { <div class="data-table-shell"><div class="table-responsive"><table class="valora-table"><thead><tr><th>Ciclo</th><th>Status</th><th>Baseline</th><th>Atual</th><th>Meta</th><th>Tendência</th></tr></thead><tbody>@foreach (var cycle in Model.Take(8)) { <tr><td><a href="/Evolution/Cycles/Details/@cycle.Id"><strong>@cycle.Title</strong></a><small class="d-block text-muted">Desde @cycle.PeriodStart.ToString("dd/MM/yyyy")</small></td><td><partial name="_StatusBadge" model="@(new StatusBadgeViewModel(cycle.Status, cycle.Status is "open" or "monitoring" ? "success" : "neutral"))" /></td><td>@(cycle.BaselineScore?.ToString("0.0") ?? "—")</td><td>@(cycle.CurrentScore?.ToString("0.0") ?? "—")</td><td>@(cycle.TargetScore?.ToString("0.0") ?? "—")</td><td>@(cycle.Trend ?? "Amostra insuficiente")</td></tr> }</tbody></table></div></div> }</section>
</main>
