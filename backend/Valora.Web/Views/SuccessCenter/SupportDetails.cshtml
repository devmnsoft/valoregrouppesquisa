@model Valora.Web.Models.ViewModels.SuccessCenter.SupportTicketDetailsViewModel
@{ViewData["Title"]=Model.Subject;Layout="_AdminLayout";}
<main class="page-container success-center">
 <nav class="breadcrumb"><a href="/SuccessCenter/Support">Chamados</a><span>/</span><strong>Detalhes</strong></nav>
 <header class="page-header"><div><span class="eyebrow">CHAMADO</span><h1>@Model.Subject</h1><p><span class="badge bg-primary">@Model.Status</span> @Model.Category · prioridade @Model.Priority</p></div></header>
 @if(Model.Success is not null){<div class="alert alert-success" role="status">@Model.Success</div>} @if(Model.Error is not null){<div class="alert alert-danger" role="alert">@Model.Error</div>}
 <div class="row g-4"><section class="col-lg-8"><article class="surface-card"><h2>Conversa e histórico</h2><p>@Model.Description</p>
 @foreach(var item in Model.Timeline){<div class="border-top py-3"><div><strong>@item.Author</strong> <small>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></div><p class="mb-0">@item.Text</p></div>}
 @if(Model.Status is not "closed" and not "cancelled"){<form asp-action="Reply" asp-route-id="@Model.Id" method="post" class="mt-4" data-prevent-double-submit><div asp-validation-summary="All" class="text-danger" role="alert"></div><label asp-for="Reply.Message" class="form-label"></label><textarea asp-for="Reply.Message" name="Message" class="form-control" rows="4"></textarea><span asp-validation-for="Reply.Message" class="text-danger"></span><button class="btn btn-primary mt-3" type="submit">Registrar resposta</button></form>}
 </article></section><aside class="col-lg-4"><section class="surface-card"><h2>Próxima ação</h2>@if(Model.Status=="resolved"){<p>Reabra se ainda precisar de atendimento.</p><form asp-action="Reopen" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-primary" type="submit">Reabrir chamado</button></form>}else{<p>Resolva somente após confirmar que a solicitação foi atendida.</p><form asp-action="Resolve" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-primary" type="submit">Marcar como resolvido</button></form>}<details class="mt-4"><summary><strong>Como usar</strong></summary><p>A conversa é cronológica. Comentários internos da equipe de atendimento não são exibidos nesta visão.</p></details></section></aside></div>
</main>
@section Scripts{<partial name="_ValidationScriptsPartial" />}
