@model Valora.Web.Models.ViewModels.BenchmarksViewModel
@{Layout="_Layout";}<partial name="_BenchmarkShell" model="Model" /><div class="bm-card" style="margin-top:16px"><h2>Evolução histórica</h2>@foreach(var x in Model.History.Take(8)){<p>@x.PeriodEnd.ToString("MM/yyyy") · @x.MaturityScore.ToString("N1") <span class="bm-badge">@x.ConfidenceLevel · n=@x.SampleSize</span></p><div class="radar" style="--score:@($"{x.MaturityScore.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></div>}@if(Model.History.Count==0){<p>Nenhum snapshot real disponível. Gere dados a partir de Diagnostics, Indicators ou Evolution.</p>}</div>
