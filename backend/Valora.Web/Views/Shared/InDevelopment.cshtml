@model Valora.Web.Models.ViewModels.InDevelopmentViewModel
@{
    ViewData["Title"] = Model.Title;
}
<main class="valora-page" id="main-content">
    <partial name="_PageHeader" model="@(new PageHeaderViewModel(
        Model.Title,
        Model.Description,
        "Valora Insight™",
        "Funcionalidade Planejada",
        new[] { new PageHeaderAction("Voltar", Model.ReturnUrl ?? "/Dashboard", Style: "secondary", Icon: "arrow-left") }
    ))" />

    <section class="valora-card mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h2 class="h4 mb-0">Planejamento e Escopo da Funcionalidade</h2>
                <small class="text-muted">Esclarecimento transparente sobre objetivos, público e operação alternativa disponível.</small>
            </div>
            <span class="badge bg-warning text-dark border">Em Planejamento de Engenharia</span>
        </div>

        <div class="alert alert-info d-flex align-items-start gap-3 my-3">
            <span class="fs-4">ℹ️</span>
            <div>
                <strong>Para que servirá:</strong>
                <p class="mb-0 mt-1">@Model.Purpose</p>
            </div>
        </div>

        <div class="row g-3 my-2">
            <div class="col-12 col-md-6">
                <div class="metric-card h-100 p-3">
                    <span class="text-muted small fw-bold text-uppercase">👥 Quem a utilizará</span>
                    <div class="mt-2 text-dark">@Model.TargetAudience</div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="metric-card h-100 p-3">
                    <span class="text-muted small fw-bold text-uppercase">📥 Informações que receberá</span>
                    <div class="mt-2 text-dark">@Model.InputInformation</div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="metric-card h-100 p-3">
                    <span class="text-muted small fw-bold text-uppercase">🎯 Resultado que entregará</span>
                    <div class="mt-2 text-dark">@Model.ExpectedOutcome</div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="metric-card h-100 p-3 bg-light border-primary">
                    <span class="text-primary small fw-bold text-uppercase">🔄 Alternativa funcional atual</span>
                    <div class="mt-2 text-dark">@Model.CurrentAlternative</div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap mt-4 pt-3 border-top">
            @if (!string.IsNullOrWhiteSpace(Model.AlternativeUrl))
            {
                <a class="valora-button valora-button--primary" href="@Model.AlternativeUrl">Acessar Alternativa Atual</a>
            }
            <a class="valora-button valora-button--secondary" href="@(Model.ReturnUrl ?? "/Dashboard")">Voltar</a>
            <a class="valora-button valora-button--secondary" href="/Dashboard">Ir para o Dashboard</a>
        </div>
    </section>
</main>
