<header class="topbar valora-topbar navbar navbar-expand-lg" data-admin-topbar>
  <button class="valora-button valora-button--ghost d-lg-none me-2" type="button" data-action="toggleWebMobileAdminMenu" aria-expanded="false" aria-controls="mobileSidebar" aria-label="Abrir navegação"><span aria-hidden="true">≡</span></button>
  <div class="topbar-title">
    <nav class="valora-breadcrumbs" aria-label="Breadcrumb"><a href="/Dashboard">Início</a><span>/</span><span>@ViewData["Title"]</span></nav>
    <strong>@(ViewData["Title"] ?? "Painel Valora")</strong>
  </div>
  <div class="ms-auto d-flex gap-2 align-items-center flex-wrap topbar-actions">
    <button class="valora-button valora-button--ghost" type="button" aria-label="Abrir busca global"><span aria-hidden="true">⌕</span><span class="d-none d-xl-inline ms-2">Buscar</span><kbd class="d-none d-xl-inline ms-2">Ctrl K</kbd></button>
    <span class="valora-badge" data-user-profile aria-label="Perfil atual"></span>
    <a class="valora-button valora-button--primary quick-action" href="/Surveys">Novo diagnóstico</a>
    <button id="logoutButton" class="valora-button valora-button--ghost" type="button">Sair</button>
  </div>
</header>
