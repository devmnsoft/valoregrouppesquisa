@model Valora.Web.Models.ViewModels.SuccessCenter.CreateSupportTicketViewModel
@{ViewData["Title"]="Abrir chamado";Layout="_AdminLayout";}
<div class="page-container success-center"><nav class="breadcrumb"><a href="/SuccessCenter">Sucesso do Cliente</a><span>/</span><a href="/SuccessCenter/Support">Chamados</a><span>/</span><strong>Novo</strong></nav><header class="page-header"><div><span class="eyebrow">ATENDIMENTO RASTREÁVEL</span><h1>Abrir chamado</h1><p>Informe apenas o contexto necessário. Evite dados pessoais ou sensíveis.</p></div></header>
<form asp-action="Create" method="post" class="surface-card premium-form"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-4"><div class="col-12"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" autocomplete="off"><span asp-validation-for="Subject" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select"><option value="">Selecione</option><option value="access">Acesso</option><option value="diagnostic">Diagnóstico</option><option value="report">Relatório</option><option value="certificate">Certificado</option><option value="ai">IA</option><option value="billing">Pagamento/plano</option><option value="integration">Integração</option><option value="operational_question">Dúvida operacional</option><option value="incident">Incidente</option></select><span asp-validation-for="Category" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select"><option value="low">Baixa</option><option value="normal">Normal</option><option value="high">Alta</option><option value="critical">Crítica — operação bloqueada</option></select><span asp-validation-for="Priority" class="text-danger"></span></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="7" placeholder="O que ocorreu, em qual tela e qual resultado era esperado?"></textarea><span asp-validation-for="Description" class="text-danger"></span></div></div><footer class="form-actions"><a class="btn btn-outline-secondary" href="/SuccessCenter/Support">Cancelar</a><button class="btn btn-primary" type="submit">Abrir chamado</button></footer></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial" />}
