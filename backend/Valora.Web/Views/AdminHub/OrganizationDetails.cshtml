@model Valora.Web.Models.ViewModels.AdminOrganizationDetailsViewModel
@{ ViewData["Title"]=Model.Organization.Name; }
<section class="valora-page"><partial name="_PageHeader" model="@(new Valora.Web.Models.PageHeaderViewModel(Model.Organization.Name, "Plano, uso, unidades e histórico do tenant.", "Organizações"))" /><div class="admin-metrics"><article class="admin-metric"><span>Plano</span><strong>@Model.Organization.Plan</strong></article><article class="admin-metric"><span>Usuários</span><strong>@Model.Organization.Users</strong></article><article class="admin-metric"><span>Unidades</span><strong>@Model.Organization.Units</strong></article><article class="admin-metric"><span>Status</span><strong>@Model.Organization.Status</strong></article></div><article class="admin-panel mt-3"><h2>Histórico</h2>@if(Model.RecentEvents.Count==0){<div class="admin-empty">Nenhum evento registrado.</div>}</article></section>
