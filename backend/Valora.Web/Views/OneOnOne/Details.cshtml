@{ ViewData["Title"] = "Detalhes da sessão"; var id = ViewData["SessionId"]; }
<main class="valora-page leadership-page" data-session-id="@id"><nav class="v9-breadcrumb"><a href="/OneOnOne">One-on-One</a><span>/</span><a href="/OneOnOne/Sessions">Sessões</a><span>/</span><span>Detalhes</span></nav><header class="leadership-hero"><div><p class="eyebrow">Sessão em preparação</p><h1>Conversa de desenvolvimento</h1><p>Registre fatos, contexto e compromissos sem produzir diagnóstico psicológico.</p></div><span class="status-pill">Agendada</span></header><section class="leadership-grid"><article class="valora-card"><h2>Pauta metodológica</h2>@foreach(var item in new[]{"Observação","Evidência","Correlação","Causa provável","Impacto organizacional","Prioridade","Plano de evolução"}){<label>@item<textarea class="valora-input" rows="2"></textarea></label>}</article><aside><article class="valora-card"><h2>Decisões e próximos passos</h2><label>Decisões<textarea class="valora-input" rows="4"></textarea></label><label>Riscos percebidos<textarea class="valora-input" rows="3"></textarea></label></article><article class="valora-card private-note"><h2>Nota privada</h2><p>Visível somente a usuários com <code>one_on_one.notes.manage</code>.</p><textarea class="valora-input" rows="4"></textarea></article><article class="valora-card"><h2>Ações combinadas</h2><div class="valora-empty"><p>Nenhuma ação criada.</p><a class="valora-button" href="/ActionPlans">Adicionar no plano de ação</a></div></article></aside></section></main>
