<script>
    (function () {
        var form = document.querySelector('form[data-dirty-guard="true"]');
        if (!form) return;
        var dirty = false;
        ['input', 'change'].forEach(function (kind) {
            form.addEventListener(kind, function () { dirty = true; }, true);
        });
        window.addEventListener('beforeunload', function (event) {
            if (!dirty) return;
            event.preventDefault();
            event.returnValue = '';
        });
        form.querySelectorAll('a[href]').forEach(function (link) {
            link.addEventListener('click', function (event) {
                if (dirty && !window.confirm('Há alterações não salvas. Deseja sair desta página?')) {
                    event.preventDefault();
                }
            });
        });
    })();
</script>
