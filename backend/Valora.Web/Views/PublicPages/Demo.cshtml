@{ Layout = "_PublicLayout"; ViewData["Description"] = "Solicite uma demonstração orientada do Valora Insight™."; }
<section class="commercial-hero compact"><div class="container-public"><p class="eyebrow">Demonstração orientada</p><h1>Veja o Valora aplicado ao contexto da sua empresa.</h1><p class="lead">Conte brevemente o cenário. A conversa é objetiva, sem alteração automática de plano ou compromisso de contratação.</p></div></section>
<section class="commercial-content container-public"><form class="demo-form" data-demo-form novalidate><div class="form-grid"><label>Nome*<input name="name" maxlength="180" autocomplete="name" required></label><label>Empresa*<input name="companyName" maxlength="220" autocomplete="organization" required></label><label>E-mail corporativo*<input name="email" maxlength="254" type="email" autocomplete="email" required></label><label>Telefone*<input name="phone" maxlength="30" autocomplete="tel" required></label><label>Cargo<input name="roleTitle" maxlength="120" autocomplete="organization-title"></label><label>Tamanho da empresa*<select name="companySize" required><option value="">Selecione</option><option>Até 20 pessoas</option><option>21 a 100 pessoas</option><option>101 a 500 pessoas</option><option>Mais de 500 pessoas</option></select></label><label>Interesse principal*<select name="interest" required><option value="">Selecione</option><option value="maturity">Maturidade organizacional</option><option value="leadership">Liderança e cultura</option><option value="continuous">Inteligência contínua</option><option value="consulting">Uso em consultoria</option></select></label><label class="full">Mensagem<textarea name="message" maxlength="1200" rows="4"></textarea></label></div><label class="consent-row"><input type="checkbox" name="consent" required> Li a <a href="/privacy">política de privacidade</a> e autorizo o contato.</label><input class="hp-field" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"><button class="premium-button primary" type="submit">Solicitar demonstração</button><div class="form-feedback" role="status" aria-live="polite"></div></form></section>
@section Scripts { <script src="~/js/public/demo-request.js" asp-append-version="true" defer></script> }
