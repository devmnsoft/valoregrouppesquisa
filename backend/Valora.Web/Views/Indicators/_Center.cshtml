@model Valora.Application.Indicators.IndicatorDashboardDto
@using Valora.Application.Indicators
@{var page=(string?)ViewData["IndicatorPage"]??"Overview";var active=Model.Indicators.Count(x=>x.Status=="active");var critical=Model.Alerts.Count(x=>x.Status!="resolved"&&x.Severity=="critical");var worsening=Model.Trends.Count(x=>x.Value.Trend==IndicatorTrend.Worsening);var improving=Model.Trends.Count(x=>x.Value.Trend==IndicatorTrend.Improving);}
<link rel="stylesheet" href="~/css/valora-indicators.css" asp-append-version="true" />
<main class="ind"><header class="ind-hero"><small>VALORA INDICATORS &amp; ANALYTICS CENTER™</small><h1>@(page=="Overview"?"Evolução verificável":page)</h1><p>Indicadores com fonte, metas claras, histórico preservado e limitações explícitas. Tendência não implica causalidade e a decisão humana permanece soberana.</p></header>
<aside class="ind-help" aria-label="Orientação"><strong>Como usar</strong><p>Use esta página para acompanhar os indicadores estratégicos da organização, entender tendências, identificar alertas e conectar dados a decisões e planos de ação.</p></aside>
<nav class="ind-nav" aria-label="Indicadores"><a href="/Indicators" aria-current="@(page=="Overview"?"page":null)">Visão geral</a><a href="/Indicators/Catalog" aria-current="@(page=="Catálogo"?"page":null)">Catálogo</a><a href="/Indicators/Targets" aria-current="@(page=="Metas"?"page":null)">Metas</a><a href="/Indicators/Measurements" aria-current="@(page=="Medições"?"page":null)">Medições</a><a href="/Indicators/Analytics" aria-current="@(page=="Analytics"?"page":null)">Analytics</a><a href="/Indicators/Scorecards" aria-current="@(page=="Scorecards"?"page":null)">Scorecards</a><a href="/Indicators/Alerts" aria-current="@(page=="Alertas"?"page":null)">Alertas</a></nav>
<div asp-validation-summary="ModelOnly"></div>
@if(TempData["Success"] is string success){<div class="ind-card improving">@success</div>}
@if(page=="Overview"){
<section class="ind-grid"><article class="ind-card"><span>Indicadores ativos</span><strong class="metric">@active</strong></article><article class="ind-card"><span>Melhorando</span><strong class="metric">@improving</strong></article><article class="ind-card"><span>Piorando</span><strong class="metric">@worsening</strong></article><article class="ind-card"><span>Alertas críticos</span><strong class="metric">@critical</strong></article><article class="ind-card"><span>Sem fonte confiável</span><strong class="metric">@Model.Indicators.Count(x=>!x.HasReliableSource)</strong></article></section>
<section class="ind-card"><h2>Leitura executiva</h2>@if(!Model.Indicators.Any()){<p>Este indicador ainda não possui dados suficientes. Cadastre a fonte antes de usar uma medição como evidência.</p>}else{<table class="ind-table"><thead><tr><th>Indicador</th><th>Valor</th><th>Tendência</th><th>Fonte</th></tr></thead><tbody>@foreach(var i in Model.Indicators.Take(8)){var t=Model.Trends[i.Id];<tr><td>@i.Name</td><td>@(i.LatestValue?.ToString("0.##")??"—") @i.Unit</td><td><span class="badge @t.Trend.ToString().ToLowerInvariant()">@t.Trend</span></td><td>@(i.SourceName??"Incompleto — não usar como evidência forte")</td></tr>}</tbody></table>}</section>}
@if(page=="Catálogo"){
<section class="ind-card"><h2>Novo indicador</h2><form asp-controller="Indicators" asp-action="Create" method="post" class="ind-form"><label>Nome<input name="Name" required maxlength="160" /></label><label>Categoria<input name="Category" required maxlength="80" /></label><label>Unidade<input name="Unit" required maxlength="30" /></label><label>Fonte verificável<input name="SourceName" required maxlength="160" /></label><label>Periodicidade<select name="Periodicity"><option value="monthly">Mensal</option><option value="quarterly">Trimestral</option><option value="yearly">Anual</option></select></label><label><span>Tipo</span><span><input type="checkbox" name="IsCalculated" value="true" /> Calculado</span></label><label>Fórmula (se calculado)<input name="Formula" maxlength="2000" /></label><button class="btn-ind">Criar indicador</button></form></section>
<section class="ind-card"><h2>Catálogo confiável</h2>@if(!Model.Indicators.Any()){<p>Nenhum indicador cadastrado.</p>}else{<table class="ind-table"><thead><tr><th>Nome</th><th>Categoria</th><th>Fonte</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var i in Model.Indicators){<tr><td>@i.Name</td><td>@i.Category</td><td>@(i.SourceName??"Fonte ausente")</td><td><span class="badge">@i.Status</span></td><td>@if(i.Status=="active"){<form action="/Indicators/@i.Id/Archive" method="post">@Html.AntiForgeryToken()<button class="btn-ind btn-muted" data-confirm="Arquivar este indicador? Ele deixará de aparecer como ativo nas rotinas de acompanhamento.">Arquivar</button></form>}</td></tr>}</tbody></table>}</section>}
@if(page=="Metas"){
<section class="ind-card"><h2>Registrar meta</h2>@if(!Model.Indicators.Any()){<p>Crie um indicador antes de definir metas.</p>}else{<form id="target-form" method="post" class="ind-form" onsubmit="this.action='/Indicators/'+this.elements.indicator.value+'/Targets'"><label>Indicador<select name="indicator" required>@foreach(var i in Model.Indicators.Where(x=>x.Status=="active")){<option value="@i.Id">@i.Name</option>}</select></label><label>Valor alvo<input name="TargetValue" type="number" step="any" required /></label><label>Início<input name="PeriodStart" type="date" required /></label><label>Fim<input name="PeriodEnd" type="date" required /></label><label>Comparação<select name="ComparisonRule"><option value="higher_is_better">Maior é melhor</option><option value="lower_is_better">Menor é melhor</option><option value="ideal_range">Faixa ideal</option><option value="exact">Valor exato</option></select></label>@Html.AntiForgeryToken()<button class="btn-ind">Definir meta</button></form>}</section><section class="ind-card"><h2>Metas e períodos</h2>@if(!Model.Targets.Any()){<p>Nenhuma meta real definida.</p>}else{<table class="ind-table"><tr><th>Indicador</th><th>Alvo</th><th>Período</th><th>Regra</th></tr>@foreach(var t in Model.Targets){<tr><td>@Model.Indicators.FirstOrDefault(x=>x.Id==t.IndicatorId)?.Name</td><td>@t.TargetValue</td><td>@t.PeriodStart.ToString("d") — @t.PeriodEnd.ToString("d")</td><td>@t.ComparisonRule</td></tr>}</table>}</section>}
@if(page=="Medições"){
<section class="ind-card"><h2>Nova medição manual</h2>@if(!Model.Indicators.Any()){<p>Crie um indicador antes de medir.</p>}else{<form method="post" class="ind-form" onsubmit="this.action='/Indicators/'+this.elements.indicator.value+'/Measurements'"><label>Indicador<select name="indicator" required>@foreach(var i in Model.Indicators.Where(x=>x.Status=="active")){<option value="@i.Id">@i.Name</option>}</select></label><label>Valor<input name="Value" type="number" step="any" required /></label><label>Data<input name="MeasuredAt" type="date" required /></label><label>Fonte desta medição<input name="SourceName" required maxlength="160" /></label><label>Justificativa<input name="Justification" required maxlength="1000" /></label>@Html.AntiForgeryToken()<button class="btn-ind">Registrar medição</button></form>}</section><section class="ind-card"><h2>Histórico preservado</h2><p>Selecione um indicador para registrar sua medição. Revisões não substituem silenciosamente o histórico.</p></section>}
@if(page=="Analytics"){
<section class="ind-grid">@foreach(var i in Model.Indicators){var t=Model.Trends[i.Id];<article class="ind-card"><span class="badge @t.Trend.ToString().ToLowerInvariant()">@t.Trend</span><h3>@i.Name</h3><strong class="metric">@(i.LatestValue?.ToString("0.##")??"—") @i.Unit</strong><p>@t.SampleSize medições · variação @(t.Delta?.ToString("+0.##;-0.##;0")??"—")</p><small>@t.Limitation</small></article>}@if(!Model.Indicators.Any()){<article class="ind-card">Sem dados reais para desenhar gráficos. Nenhuma série fictícia será exibida.</article>}</section><section class="ind-card"><h2>Snapshot auditável</h2><form action="/Indicators/Snapshots/Create" method="post" class="ind-form"><label>Nome do snapshot<input name="name" required maxlength="160" /></label>@Html.AntiForgeryToken()<button class="btn-ind">Capturar estado atual</button></form></section>}
@if(page=="Scorecards"){<section class="ind-card"><h2>Scorecards executivos</h2><p class="limitations">Cada item deve apontar para um indicador real; fontes e limitações permanecem visíveis. Nenhum dado demonstrativo é gerado.</p>@{var cards=ViewData["Scorecards"] as IReadOnlyList<Valora.Application.Indicators.ExecutiveScorecardDto>;}@if(cards?.Any()!=true){<p>Nenhum scorecard criado.</p>}else foreach(var card in cards){<article><h3>@card.Name</h3><p>@card.Objective · @card.ItemCount indicadores · @card.PeriodStart.ToString("d")–@card.PeriodEnd.ToString("d")</p></article>}</section>}
@if(page=="Alertas"){<section class="ind-grid">@foreach(var a in Model.Alerts){<article class="ind-card"><span class="badge @a.Severity">@a.Severity</span><h3>@a.IndicatorName</h3><p>@a.Message</p><small>Regra configurada · @a.CreatedAt.ToString("g")</small>@if(a.Status!="resolved"){<form action="/Indicators/Alerts/@a.Id/Resolve" method="post">@Html.AntiForgeryToken()<button class="btn-ind">Resolver mantendo histórico</button></form>}</article>}@if(!Model.Alerts.Any()){<article class="ind-card">Nenhum alerta gerado por regra configurada.</article>}</section>}
<footer class="limitations"><strong>Limites da leitura:</strong> maturidade representa capacidade, não volume de dados. Indicadores sem fonte não constituem evidência forte; associações entre ações e resultados não comprovam causalidade.</footer><script src="~/js/valora-center-forms.js" asp-append-version="true"></script></main>
