@model Valora.Web.Models.ViewModels.KnowledgeCenterViewModel
@{ViewData["Title"]="Knowledge & Learning Center";var s=Model.Summary;}
<link rel="stylesheet" href="~/css/knowledge-center.css" asp-append-version="true" />
<section class="knowledge-shell">
 <header class="knowledge-hero"><div><span class="eyebrow">VALORA KNOWLEDGE & LEARNING CENTER™</span><h1>Conhecimento que evolui com a organização</h1><p>Transforme decisões, evidências e experiências reais em orientação verificável e reutilizável.</p></div><form asp-action="Index" method="get" class="knowledge-search"><label for="knowledge-query">Busca central</label><div><input id="knowledge-query" name="query" value="@Model.Query" placeholder="Busque por tema, evidência ou prática…"/><button>Buscar</button></div></form></header>
 @if(Model.Message is not null){<div class="knowledge-alert success">@Model.Message</div>} @if(Model.Error is not null){<div class="knowledge-alert error">@Model.Error</div>}
 <nav class="knowledge-tabs" aria-label="Áreas do Knowledge Center"><a asp-action="Index" class="@(Model.Section=="Overview"?"active":"")">Visão geral</a><a asp-action="Articles" class="@(Model.Section=="Articles"?"active":"")">Artigos</a><a asp-action="Playbooks" class="@(Model.Section=="Playbooks"?"active":"")">Playbooks</a><a asp-action="Lessons" class="@(Model.Section=="Lessons"?"active":"")">Lições</a><a asp-action="LearningPaths" class="@(Model.Section=="LearningPaths"?"active":"")">Trilhas</a><a asp-action="Dictionary" class="@(Model.Section=="Dictionary"?"active":"")">Dicionário Valora</a></nav>
 @if(Model.Section=="Overview"){
 <div class="metric-grid"><article><strong>@s.PublishedArticles</strong><span>artigos publicados</span></article><article><strong>@s.ArticlesInReview</strong><span>aguardando revisão</span></article><article><strong>@s.ActivePlaybooks</strong><span>playbooks ativos</span></article><article><strong>@s.RecentLessons</strong><span>lições recentes</span></article><article><strong>@s.LearningPaths</strong><span>trilhas de aprendizagem</span></article><article><strong>@s.DictionaryTerms</strong><span>conceitos Valora</span></article></div>
 <div class="knowledge-grid"><section class="panel"><h2>Aprendizados recentes</h2>@foreach(var x in Model.Lessons.Take(4)){<article class="item"><span class="badge @(x.Critical?"critical":"")">@(x.Critical?"crítica":x.OriginType)</span><h3>@x.Title</h3><p>@x.Learning</p><small>Origem verificável: @x.OriginReference</small></article>}@if(Model.Lessons.Count==0){<div class="empty"><b>A memória começa com uma experiência real.</b><p>Registre uma lição e sua origem para reduzir a dependência de conhecimento informal.</p></div>}</section><section class="panel"><h2>Conhecimento publicado</h2>@foreach(var x in Model.Articles.Where(x=>x.Status=="published").Take(4)){<article class="item"><span class="badge published">publicado · v@x.Version</span><h3>@x.Title</h3><p>@x.Content</p><small>@x.Category · atualizado @x.UpdatedAt.ToString("dd/MM/yyyy")</small></article>}@if(!Model.Articles.Any(x=>x.Status=="published")){<div class="empty"><b>Nenhum artigo publicado ainda.</b><p>Crie, revise e publique conteúdo baseado em evidências.</p></div>}</section></div>}
 @if(Model.Section=="Articles"){
 <form method="get" class="filters"><input name="query" value="@Model.Query" placeholder="Título ou conteúdo"/><select name="status"><option value="">Todos os status</option>@foreach(var x in Valora.Application.Knowledge.KnowledgeStatuses.All){<option value="@x" selected="@(Model.Status==x)">@x</option>}</select><select name="categoryId"><option value="">Todas as categorias</option>@foreach(var x in Model.Categories){<option value="@x.Id" selected="@(Model.CategoryId==x.Id)">@x.Name</option>}</select><button>Filtrar</button></form>
 <div class="knowledge-grid"><section class="panel"><h2>Biblioteca</h2>@foreach(var x in Model.Articles){<article class="item"><span class="badge @x.Status">@x.Status · v@x.Version</span><h3>@x.Title</h3><p>@x.Content</p><small>@x.Category · @x.UpdatedAt.ToString("dd/MM/yyyy")</small><div class="actions">@if(x.Status=="draft"){<form asp-action="SubmitReview" method="post"><input type="hidden" name="id" value="@x.Id"/><button>Enviar para revisão</button></form>}@if(x.Status=="review"){<form asp-action="Publish" method="post"><input type="hidden" name="id" value="@x.Id"/><button>Publicar</button></form>}@if(x.Status!="archived"){<form asp-action="Archive" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="quiet">Arquivar</button></form>}</div></article>}@if(Model.Articles.Count==0){<div class="empty"><b>Nenhum resultado.</b><p>Ajuste os filtros ou crie o primeiro artigo.</p></div>}</section>
 <section class="panel form-panel"><h2>Novo artigo</h2><p>Todo artigo nasce como rascunho e passa por revisão antes de publicar.</p><form asp-action="CreateArticle" method="post"><label>Título<input name="Title" required minlength="3" maxlength="180"/></label><label>Categoria<select name="CategoryId" required><option value="">Selecione…</option>@foreach(var x in Model.Categories){<option value="@x.Id">@x.Name</option>}</select></label><label>Conteúdo<textarea name="Content" required minlength="20" maxlength="20000" rows="8"></textarea></label><label class="check"><input type="checkbox" name="AiAssisted" value="true"/> Teve auxílio de IA (revisão humana obrigatória)</label><button class="primary">Salvar rascunho</button></form></section></div>}
 @if(Model.Section=="Playbooks"){<section class="panel"><h2>Playbooks por área</h2><div class="card-grid">@foreach(var x in Model.Playbooks){<article class="item"><span class="badge @x.Status">@x.Status</span><h3>@x.Title</h3><p>@x.Objective</p><small>@x.Area · @x.StepCount passos</small></article>}</div>@if(Model.Playbooks.Count==0){<div class="empty"><b>Nenhum playbook disponível.</b><p>Playbooks publicados precisam de objetivo, área e passos com responsáveis sugeridos.</p></div>}</section>}
 @if(Model.Section=="Lessons"){
 <div class="knowledge-grid"><section class="panel"><h2>Lições aprendidas</h2>@foreach(var x in Model.Lessons){<article class="item"><span class="badge @(x.Critical?"critical":"")">@x.OriginType</span><h3>@x.Title</h3><p>@x.Learning</p><small>@x.OriginReference · @x.Impact</small></article>}</section><section class="panel form-panel"><h2>Registrar aprendizado</h2><form asp-action="CreateLesson" method="post"><label>Título<input name="Title" required maxlength="180"/></label><label>O que aprendemos?<textarea name="Learning" required minlength="10"></textarea></label><label>Origem<select name="OriginType"><option value="action">Ação</option><option value="decision">Decisão</option><option value="diagnostic">Diagnóstico</option><option value="meeting">Reunião</option><option value="report">Relatório</option><option value="incident">Incidente</option></select></label><label>Referência da origem<input name="OriginReference" required/></label><label>Impacto<textarea name="Impact" required></textarea></label><label>Evidência ou justificativa<textarea name="Evidence"></textarea></label><label class="check"><input type="checkbox" name="Critical" value="true"/> Lição crítica</label><button class="primary">Registrar lição</button></form></section></div>}
 @if(Model.Section=="LearningPaths"){<section class="panel"><h2>Trilhas de aprendizagem</h2><div class="card-grid">@foreach(var x in Model.LearningPaths){<article class="item"><span class="badge">@x.Status</span><h3>@x.Title</h3><p>@x.Objective</p><div class="progress"><i style="width:@x.CompletionPercent%"></i></div><small>@x.ItemCount itens · @x.AssignmentCount atribuições · @x.CompletionPercent%</small></article>}</div>@if(Model.LearningPaths.Count==0){<div class="empty"><b>A aprendizagem ainda não foi estruturada em trilhas.</b><p>Combine artigos publicados e acompanhe o progresso de forma rastreável.</p></div>}</section>}
 @if(Model.Section=="Dictionary"){
 <div class="knowledge-grid"><section class="panel"><h2>Dicionário Cognitivo Valora</h2>@foreach(var x in Model.Terms){<article class="item"><span class="badge">@x.Code · @x.Category</span><h3>@x.Name</h3><p>@x.Definition</p><small>Uso metodológico: @x.MethodologicalUse</small></article>}</section><section class="panel form-panel"><h2>Novo conceito</h2><form asp-action="CreateTerm" method="post"><label>Código<input name="Code" required pattern="[a-z0-9._-]+"/></label><label>Nome<input name="Name" required/></label><label>Categoria<input name="Category" required/></label><label>Definição<textarea name="Definition" required minlength="10"></textarea></label><label>Uso metodológico<textarea name="MethodologicalUse" required minlength="10"></textarea></label><button class="primary">Criar conceito rastreável</button></form></section></div>}
</section>
