@model Valora.Web.Navigation.NavigationViewModel

<aside class="app-sidebar valora-sidebar d-none d-lg-flex" data-admin-sidebar>
    <a class="brand-mark" data-brand-root href="/Dashboard" aria-label="Valora Group — Valora Insight">
        <span class="brand-wordmark"><strong>Valora Group</strong></span>
        <span class="brand-text"><small>Valora Insight™</small></span>
    </a>
    <div class="sidebar-context">
        <small>Organização atual</small>
        <strong data-current-organization>@(Model.OrganizationName ?? "Contexto indisponível")</strong>
        @if (Model.PlanCode is not null)
        {
            <span class="valora-badge" data-current-plan>@Model.PlanCode</span>
        }
    </div>
    <nav class="sidebar-nav valora-sidebar-nav" aria-label="Navegação principal">
        @if (Model.Sections.Count > 0)
        {
            <partial name="_NavigationGroups" model="@(new Valora.Web.Navigation.NavigationGroupsViewModel(Model.Sections, "desktop", "desktop-navigation"))" />
        }
        else
        {
            <p class="sidebar-empty">Não foi possível carregar os acessos desta organização. Tente novamente ou fale com o suporte.</p>
        }
    </nav>
    <footer class="sidebar-footer">
        <a href="/PublicPages/Contact" aria-label="Ajuda e suporte">
            <valora-icon name="help-circle" size="19" decorative="true" />
            <span>Ajuda e suporte</span>
        </a>
        <a href="/Account/Logout" aria-label="Sair da conta">
            <valora-icon name="log-out" size="19" decorative="true" />
            <span>Sair</span>
        </a>
        <button class="icon-button" type="button" data-action="collapse-navigation" aria-expanded="true" aria-label="Recolher navegação" title="Recolher navegação">
            <valora-icon name="chevron-left" size="20" decorative="true" />
        </button>
    </footer>
</aside>

<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
    <div class="offcanvas-header">
        <div>
            <h2 id="mobileSidebarLabel" class="h6 mb-0">Valora Group</h2>
            <small>Valora Insight™</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
    </div>
    <div class="offcanvas-body valora-sidebar-nav">
        @if (Model.Sections.Count > 0)
        {
            <partial name="_NavigationGroups" model="@(new Valora.Web.Navigation.NavigationGroupsViewModel(Model.Sections, "mobile", "mobile-navigation"))" />
        }
        else
        {
            <p class="sidebar-empty">Os acessos não estão disponíveis. O suporte pode ajudar informando a referência @Model.CorrelationId.</p>
            <a class="nav-link" href="/PublicPages/Contact">Ajuda e suporte</a>
            <a class="nav-link" href="/Account/Logout">Sair da conta</a>
        }
    </div>
</div>
