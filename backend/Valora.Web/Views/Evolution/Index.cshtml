@model IReadOnlyList<Valora.Application.Evolution.EvolutionCycleDto>@{ViewData["Title"]="Evolution";var active=Model.FirstOrDefault(x=>x.Status is "open" or "monitoring");}<main class="valora-page"><header class="leadership-hero"><div><p class="eyebrow">Valora Evolution™</p><h1>Evolução baseada em capacidade</h1><p>Scores são lidos com evidências, ações e mudanças de padrão — nunca como causalidade automática.</p></div><a class="btn btn-primary" href="/Evolution/Cycles">Ver ciclos</a></header><section class="v9-kpis"><article><span>Score atual</span><strong>@(active?.CurrentScore?.ToString("0.0")??"—")</strong></article><article><span>Baseline</span><strong>@(active?.BaselineScore?.ToString("0.0")??"—")</strong></article><article><span>Meta</span><strong>@(active?.TargetScore?.ToString("0.0")??"—")</strong></article><article><span>Tendência</span><strong>@(active?.Trend??"Amostra insuficiente")</strong></article></section><section class="valora-card"><h2>Ciclos recentes</h2>@if(Model.Count==0){<div class="valora-empty"><h3>Sem ciclo comparável</h3><p>Abra um ciclo com baseline e evidência para preservar a primeira leitura.</p></div>}else{@foreach(var c in Model){<p><a href="/Evolution/Cycles/Details/@c.Id">@c.Title</a> · @c.Status · @c.Trend</p>}}</section></main>
