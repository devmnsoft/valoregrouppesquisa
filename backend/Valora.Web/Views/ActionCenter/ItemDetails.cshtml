@model Valora.Web.Controllers.ActionItemPageViewModel
@using System.Text.Json
@using Valora.Application.ActionCenter
@{ var detail=Model.Details; ViewData["Title"]=detail.Item.Title; var i=detail.Item; var progressCommand=Model.Command as ProgressActionRequest; var transitionCommand=Model.Command as TransitionActionRequest; var completeCommand=Model.Command as CompleteActionRequest; var editCommand=Model.Command as EditActionItemRequest; var assignCommand=Model.Command as AssignResponsibleRequest; var dueCommand=Model.Command as RescheduleActionRequest; var canManage=detail.CanEdit||detail.CanAssign||detail.CanReschedule; }
<div data-action-center-module>
<main class="valora-page action-detail">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel(i.Title, i.Description, "Valora Action™", $"{ActionStatuses.Label(i.Priority)} · {ActionStatuses.Label(i.Status)}", new[] { new PageHeaderAction("Voltar", Model.ReturnUrl, Icon:"arrow-left") }))" />
  <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel("Como usar", "Registre avanços até 99%. Use Concluir somente quando houver resultado e evidência verificável.", new[] { "Confira responsável e prazo.", "Documente cada mudança.", "Revise o histórico antes de agir." }))" />
  <div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div> @if(TempData["ActionSuccess"] is string ok){<div class="alert alert-success" role="status">@ok</div>}
  <section class="action-summary-grid"><article class="valora-card"><h2>Resumo da execução</h2><dl class="action-facts"><div><dt>Situação</dt><dd>@ActionStatuses.Label(i.Status)</dd></div><div><dt>Prioridade</dt><dd>@ActionStatuses.Label(i.Priority)</dd></div><div><dt>Responsável</dt><dd>@(i.ResponsibleName??"Sem responsável")</dd></div><div><dt>Plano</dt><dd><a href="/ActionCenter/Plans/Details/@i.ActionPlanId">@(i.PlanTitle??"Abrir plano")</a></dd></div><div><dt>Prazo</dt><dd>@(i.DueAt?.ToString("dd/MM/yyyy")??"A definir")</dd></div><div><dt>Progresso operacional</dt><dd><progress max="100" value="@i.ProgressPercent"></progress> @i.ProgressPercent%</dd></div></dl></article><article class="valora-card"><h2>Resultados e evidências</h2><h3>Resultado esperado</h3><p>@i.ExpectedOutcome</p><h3>Evidência inicial</h3><p>@i.EvidenceSummary</p>@if(i.Status=="completed"){<h3>Resultado alcançado</h3><p>@i.CompletionResult</p><h3>Evidência de conclusão</h3><p>@i.CompletionEvidence</p>}</article></section>
  @if(canManage||detail.CanComplete){<section class="valora-card"><div class="section-heading"><div><h2>Ações disponíveis</h2><p>Dados operacionais e transições são alterados separadamente, com histórico e controle de versão.</p></div><div class="action-buttons">@if(detail.CanEdit){<button type="button" class="valora-button valora-button--primary" data-action-dialog-open="edit-dialog">Editar atividade</button>}@if(detail.CanAssign){<button type="button" class="valora-button" data-action-dialog-open="assign-dialog">@(i.ResponsibleUserId is null?"Definir responsável":"Alterar responsável")</button>}@if(detail.CanReschedule){<button type="button" class="valora-button" data-action-dialog-open="reschedule-dialog">Alterar prazo</button>}@if(detail.CanProgress){<button type="button" class="valora-button" data-action-dialog-open="progress-dialog">Registrar progresso</button>} @if(detail.CanBlock){<button type="button" class="valora-button valora-button--ghost" data-action-dialog-open="block-dialog">Bloquear</button>} @if(detail.CanResume){<button type="button" class="valora-button valora-button--primary" data-action-dialog-open="resume-dialog">Retomar atividade</button>} @if(detail.CanComplete){<button type="button" class="valora-button valora-button--primary" data-action-dialog-open="complete-dialog">Concluir atividade</button>}</div></div></section>}
  <section class="valora-card"><h2>Histórico</h2>@if(detail.History.Count==0){<p>Nenhuma mudança registrada.</p>}else{<ol class="action-history">@foreach(var h in detail.History){<li><strong>@(h.Operation switch{"assign"=>"Responsável alterado","reschedule"=>"Prazo reagendado","edit"=>"Atividade editada","complete"=>"Atividade concluída",_=>$"{ActionStatuses.Label(h.FromStatus??"Início")} → {ActionStatuses.Label(h.ToStatus)}"})</strong><span>@h.ChangedAt.ToString("dd/MM/yyyy HH:mm") · @(h.AuthorName??"Autor não identificado")</span>@if(h.FromValue is not null||h.ToValue is not null){<span>Antes: @(h.FromValue??"—")</span><span>Depois: @(h.ToValue??"—")</span>}@if(h.ProgressPercent is not null){<span>@h.ProgressPercent%</span>}@if(!string.IsNullOrWhiteSpace(h.Reason)){<p>@h.Reason</p>}</li>}</ol>}<nav class="pagination" aria-label="Páginas do histórico">@if(detail.HistoryPage>1){<a class="valora-button valora-button--ghost" asp-action="ItemDetails" asp-route-id="@i.Id" asp-route-historyPage="@(detail.HistoryPage-1)" asp-route-returnUrl="@Model.ReturnUrl">Anterior</a>}else{<span class="valora-button valora-button--ghost disabled" aria-disabled="true">Anterior</span>}<span>Página @detail.HistoryPage de @detail.HistoryPages</span>@if(detail.HistoryPage<detail.HistoryPages){<a class="valora-button valora-button--ghost" asp-action="ItemDetails" asp-route-id="@i.Id" asp-route-historyPage="@(detail.HistoryPage+1)" asp-route-returnUrl="@Model.ReturnUrl">Próxima</a>}else{<span class="valora-button valora-button--ghost disabled" aria-disabled="true">Próxima</span>}</nav></section>
</main>
@if(canManage){
<dialog id="edit-dialog" data-action-dialog aria-labelledby="edit-title"><form method="post" action="/ActionCenter/Items/@i.Id/Edit">@Html.AntiForgeryToken()<input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl"><input type="hidden" name="HistoryPage" value="@detail.HistoryPage"><input type="hidden" name="Version" value="@(editCommand?.Version??i.Version)"><input type="hidden" name="CommandId" value="@(editCommand?.CommandId??Guid.NewGuid().ToString("N"))"><div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div><h2 id="edit-title">Editar atividade</h2><p>Origem, evidências e vínculos são preservados.</p><label>Título *<input name="Title" value="@(editCommand?.Title??i.Title)" required minlength="3" maxlength="180"></label><label>Descrição<textarea name="Description" maxlength="2000">@(editCommand?.Description??i.Description)</textarea></label><label>Prioridade *<select name="Priority"><option value="critical" selected="@((editCommand?.Priority??i.Priority)=="critical")">Crítica</option><option value="high" selected="@((editCommand?.Priority??i.Priority)=="high")">Alta</option><option value="medium" selected="@((editCommand?.Priority??i.Priority)=="medium")">Média</option><option value="low" selected="@((editCommand?.Priority??i.Priority)=="low")">Baixa</option></select></label><label>Resultado esperado *<textarea name="ExpectedOutcome" required minlength="3" maxlength="2000">@(editCommand?.ExpectedOutcome??i.ExpectedOutcome)</textarea></label><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Salvar alterações</button></div></form></dialog>
<dialog id="assign-dialog" data-action-dialog aria-labelledby="assign-title"><form method="post" action="/ActionCenter/Items/@i.Id/Assign">@Html.AntiForgeryToken()<input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl"><input type="hidden" name="HistoryPage" value="@detail.HistoryPage"><input type="hidden" name="Version" value="@(assignCommand?.Version??i.Version)"><input type="hidden" name="CommandId" value="@(assignCommand?.CommandId??Guid.NewGuid().ToString("N"))"><div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div><h2 id="assign-title">@(i.ResponsibleUserId is null?"Definir responsável":"Alterar responsável")</h2><p>Responsável atual: <strong>@(i.ResponsibleName??"Sem responsável")</strong>. Esta alteração não afeta o responsável do plano.</p><div data-responsible-selector data-selected-responsible="@(assignCommand is null?i.ResponsibleUserId:assignCommand.ResponsibleUserId)"><label>Buscar pessoa elegível<input type="search" data-responsible-search autocomplete="off"></label><label>Novo responsável<select name="ResponsibleUserId" data-responsible-select data-empty-label="Sem responsável"><option value="">Sem responsável</option></select></label><span data-responsible-status role="status"></span><button type="button" data-responsible-more>Carregar mais</button></div><label>Justificativa<textarea name="Reason" maxlength="1000">@assignCommand?.Reason</textarea></label><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Confirmar atribuição</button></div></form></dialog>
<dialog id="reschedule-dialog" data-action-dialog aria-labelledby="due-title"><form method="post" action="/ActionCenter/Items/@i.Id/Reschedule">@Html.AntiForgeryToken()<input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl"><input type="hidden" name="HistoryPage" value="@detail.HistoryPage"><input type="hidden" name="Version" value="@(dueCommand?.Version??i.Version)"><input type="hidden" name="CommandId" value="@(dueCommand?.CommandId??Guid.NewGuid().ToString("N"))"><div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div><h2 id="due-title">Alterar prazo</h2><p>Prazo atual: <strong>@(i.DueAt?.ToString("dd/MM/yyyy")??"A definir")</strong>. O reagendamento ficará no histórico.</p><label>Novo prazo *<input type="date" name="DueAt" value="@(dueCommand?.DueAt?.ToString("yyyy-MM-dd")??i.DueAt?.ToString("yyyy-MM-dd"))" required></label><label>Justificativa *<textarea name="Reason" required minlength="3" maxlength="1000">@dueCommand?.Reason</textarea></label><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Confirmar novo prazo</button></div></form></dialog>}
@if(detail.CanProgress){<dialog id="progress-dialog" data-action-dialog aria-labelledby="progress-dialog-title"><form method="post" action="/ActionCenter/Items/@i.Id/Progress">@Html.AntiForgeryToken()<input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl"><input type="hidden" name="HistoryPage" value="@detail.HistoryPage"><div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div><h2 id="progress-dialog-title">Registrar progresso</h2><p>Informe de 0 a 99%. Esta ação não conclui a atividade.</p><label for="progress">Progresso (%) *</label><input id="progress" name="ProgressPercent" type="number" min="0" max="99" value="@(progressCommand?.ProgressPercent??Math.Min(i.ProgressPercent,99))" required><label for="note">Nota do acompanhamento</label><textarea id="note" name="Note" maxlength="1000">@progressCommand?.Note</textarea><input type="hidden" name="Version" value="@(progressCommand?.Version??i.Version)"><input type="hidden" name="CommandId" value="@(progressCommand?.CommandId??Guid.NewGuid().ToString())"><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Registrar</button></div></form></dialog>}
@if(detail.CanBlock){<dialog id="block-dialog" data-action-dialog aria-labelledby="block-dialog-title"><form method="post" action="/ActionCenter/Items/@i.Id/Block">@Html.AntiForgeryToken()<input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl"><input type="hidden" name="HistoryPage" value="@detail.HistoryPage"><div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div><h2 id="block-dialog-title">Registrar bloqueio</h2><p>A atividade ficará bloqueada até uma transição explícita.</p><label for="reason">Motivo *</label><textarea id="reason" name="Reason" minlength="3" maxlength="1000" required>@transitionCommand?.Reason</textarea><input type="hidden" name="Version" value="@(transitionCommand?.Version??i.Version)"><input type="hidden" name="CommandId" value="@(transitionCommand?.CommandId??Guid.NewGuid().ToString())"><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Confirmar bloqueio</button></div></form></dialog>}
@if(detail.CanResume){<dialog id="resume-dialog" data-action-dialog aria-labelledby="resume-title"><form method="post" action="/ActionCenter/Items/@i.Id/Resume">@Html.AntiForgeryToken()<input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl"><input type="hidden" name="HistoryPage" value="@detail.HistoryPage"><div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div><h2 id="resume-title">Retomar @i.Title</h2><p>O progresso de @i.ProgressPercent% será preservado e a atividade voltará para Em execução.</p><label for="resume-reason">Justificativa *</label><textarea id="resume-reason" name="Reason" minlength="3" maxlength="1000" required>@transitionCommand?.Reason</textarea><input type="hidden" name="Version" value="@(transitionCommand?.Version??i.Version)"><input type="hidden" name="CommandId" value="@(transitionCommand?.CommandId??Guid.NewGuid().ToString())"><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Retomar atividade</button></div></form></dialog>}
@if(detail.CanComplete){<dialog id="complete-dialog" data-action-dialog aria-labelledby="complete-dialog-title"><form method="post" action="/ActionCenter/Items/@i.Id/Complete">@Html.AntiForgeryToken()<input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl"><input type="hidden" name="HistoryPage" value="@detail.HistoryPage"><div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div><h2 id="complete-dialog-title">Concluir atividade</h2><p>A conclusão define 100% e registra o resultado na memória organizacional.</p><label for="result">Resultado alcançado *</label><textarea id="result" name="Result" minlength="10" maxlength="2000" required>@completeCommand?.Result</textarea><label for="evidence">Evidência de conclusão *</label><textarea id="evidence" name="Evidence" minlength="3" maxlength="2000" required>@completeCommand?.Evidence</textarea><input type="hidden" name="Version" value="@(completeCommand?.Version??i.Version)"><input type="hidden" name="CommandId" value="@(completeCommand?.CommandId??Guid.NewGuid().ToString())"><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Concluir</button></div></form></dialog>}

<script src="~/js/responsible-selector.js" asp-append-version="true"></script>
<script src="~/js/action-center.js" asp-append-version="true" data-open-dialog="@Model.OpenDialog"></script>
</div>
