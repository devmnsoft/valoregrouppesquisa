@model Valora.Application.OneOnOne.OneOnOneDashboardDto
@{ViewData["Title"]="One-on-One";}
<main class="valora-page one-on-one"><header class="leadership-hero"><div><p class="eyebrow">Valora One-on-One™</p><h1>Conversas melhores, com evidências</h1><p>Organize pautas e evolução sem substituir o diálogo e a decisão humana.</p></div><a class="btn btn-primary" href="/OneOnOne/Sessions/Create">Nova sessão</a></header><section class="v9-kpis"><article><span>Próximas</span><strong>@Model.Upcoming.Count</strong></article><article><span>Atrasadas</span><strong>@Model.Overdue.Count</strong></article><article><span>Compromissos</span><strong>@Model.Commitments.Count</strong></article><article><span>Líderes acompanhados</span><strong>@Model.Leaders.Count</strong></article></section><section class="valora-card"><div class="section-heading"><h2>Próximas conversas</h2><a href="/OneOnOne/Sessions">Todas as sessões</a></div>@if(Model.Upcoming.Count==0){<div class="valora-empty"><h3>Abra espaço para uma boa conversa</h3><p>Agende o primeiro acompanhamento para construir uma evolução baseada em evidências.</p></div>}else{@foreach(var s in Model.Upcoming){<a class="ooo-row" href="/OneOnOne/Sessions/Details/@s.Id"><span><strong>@s.Title</strong><small>@s.LeaderName · @s.ParticipantName</small></span><time>@s.ScheduledAt?.ToString("dd/MM HH:mm")</time><em class="badge">@s.Status</em></a>}}</section><section class="valora-card"><div class="section-heading"><h2>Sugestões orientadoras</h2><span class="privacy-mark">IA com validação humana</span></div>@if(Model.Suggestions.Count==0){<p class="text-muted">Sugestões surgirão apenas quando houver evidência verificável suficiente.</p>}@foreach(var x in Model.Suggestions){<article class="ai-suggestion"><strong>@x.Observation</strong><p>@x.Recommendation</p><small>Evidência: @x.Evidence · Limitação: @x.Limitation</small></article>}</section></main>
