@model Valora.Web.Models.ViewModels.IntelligenceWorkspaceViewModel
@{ ViewData["Title"] = Model.Title; var id=ViewData["HeatmapId"]?.ToString(); }
<main class="valora-page v9-page benchmark-premium" data-heatmap data-id="@id">
 <nav class="v9-breadcrumb"><a href="/Intelligence">Inteligência Organizacional</a><span>/</span><a href="/Heatmap">Heatmap</a></nav>
 <header class="v9-hero v9-hero--executive"><div><p class="eyebrow">Valora Heatmap™</p><h1>Concentração organizacional</h1><p>Encontre forças, fragilidades, riscos e oportunidades sem individualizar pessoas ou presumir causas.</p></div></header>
 <section class="valora-card"><div class="v9-section-title"><div><p class="eyebrow">Filtros</p><h2>Gerar mapa com evidência real</h2></div></div><form data-generate><label for="heatmap-diagnostic">Diagnóstico<select class="valora-input" id="heatmap-diagnostic" name="diagnosticId" required><option value="">Carregando diagnósticos…</option></select><small class="form-text">Somente diagnósticos disponíveis para a organização ativa são listados.</small></label><label for="heatmap-view">Visão<select class="valora-input" id="heatmap-view" name="viewBy"><option value="dimension">Dimensão</option><option value="index">Índice</option><option value="area">Área</option><option value="unit">Unidade</option><option value="leadership">Liderança agregada</option><option value="period">Período</option></select></label><button class="valora-button valora-button--primary">Gerar Heatmap</button></form></section>
 <section class="v9-kpis"><article><span>Células críticas</span><strong data-critical>—</strong><small>Com amostra suficiente</small></article><article><span>Forças</span><strong data-strengths>—</strong><small>Faixas saudável e excelente</small></article><article><span>Amostra insuficiente</span><strong data-insufficient>—</strong><small>Sem inferência</small></article><article><span>Evidências</span><strong data-evidence>—</strong><small>Respostas agregadas</small></article></section>
 <section class="valora-card"><div class="v9-section-title"><div><p class="eyebrow">Mapa por intensidade</p><h2>Dimensões e recortes autorizados</h2></div></div><div class="valora-skeleton" data-loading>Consultando mapas autorizados…</div><div class="valora-alert valora-alert--danger" data-error hidden></div><div class="benchmark-dimensions" data-cells></div><div class="valora-empty" data-empty hidden><h3>Nenhum Heatmap gerado</h3><p>Selecione um diagnóstico concluído. Scores não serão simulados e grupos pequenos serão protegidos.</p></div></section>
 <section class="valora-card"><p class="eyebrow">Interpretação responsável</p><h2>Leitura assistida</h2><p data-ai>Todo sinal precisa de evidência; score baixo não atribui culpa nem determina causa.</p></section>
 <section class="valora-card"><p class="eyebrow">Histórico</p><h2>Snapshots recentes</h2><div data-snapshots></div></section>
</main>
@section Scripts { <script src="/js/pages/intelligence-heatmap.js" asp-append-version="true"></script><script src="/js/pages/intelligence-workspace.js" asp-append-version="true"></script> }
