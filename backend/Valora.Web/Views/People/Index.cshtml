@model Valora.Web.Models.ViewModels.PeopleViewModel
@{Layout="_Layout";}<partial name="_PeopleShell" model="Model"/><div class="people-grid"><section class="people-card"><h2>Perfis</h2><strong>@Model.Dashboard.Profiles</strong></section><section class="people-card"><h2>Times</h2><strong>@Model.Dashboard.Teams</strong></section><section class="people-card"><h2>Cultura</h2><strong>@Model.Dashboard.Culture.Count leituras agregadas</strong></section><section class="people-card"><h2>Engajamento</h2><strong>@Model.Dashboard.Engagement.Count sinais</strong></section><section class="people-card"><h2>Desenvolvimento</h2><strong>@Model.Dashboard.DevelopmentPlans.Count planos</strong></section><section class="people-card"><h2>Riscos</h2><strong>@Model.Dashboard.Risks.Count sinais para acompanhamento</strong></section></div><section class="people-card"><h2>Novo perfil</h2><form asp-action="CreateProfile" method="post">@Html.AntiForgeryToken()<label>Nome de exibição<input name="DisplayName" required minlength="2" maxlength="120"/></label><label>Função<input name="RoleTitle" maxlength="120"/></label><button type="submit">Criar perfil</button></form></section>
