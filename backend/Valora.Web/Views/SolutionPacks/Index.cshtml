@model Valora.Web.Models.ViewModels.SolutionPackMarketplaceViewModel
@{ViewData["Title"]="Solution Packs Marketplace";}
<style>.sp-hero{padding:2.3rem;border-radius:24px;color:#fff;background:linear-gradient(125deg,#14213d,#315c75 60%,#c79a4a);box-shadow:0 18px 55px #14213d30}.sp-toolbar{display:flex;gap:.7rem;flex-wrap:wrap;margin:1.4rem 0}.sp-toolbar input,.sp-toolbar select{border:1px solid #d9e0e8;border-radius:12px;padding:.72rem;background:#fff}.sp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem}.sp-card{border:1px solid #e4e9ef;border-radius:18px;padding:1.25rem;background:linear-gradient(180deg,#fff,#f8fafc);box-shadow:0 8px 28px #14213d0d}.sp-badge{display:inline-block;border-radius:999px;padding:.3rem .65rem;background:#e7f0f3;color:#234b60;font-size:.78rem;font-weight:700}.sp-official{background:#fff1cf;color:#75510b}.sp-actions{display:flex;justify-content:space-between;align-items:center;margin-top:1rem}.sp-btn{background:#173f54;color:white!important;padding:.65rem .9rem;border-radius:10px;text-decoration:none}</style>
<section class="sp-hero"><span class="sp-badge sp-official">Valora Insight™</span><h1>Solution Packs & Marketplace Center</h1><p>Implante diagnósticos, processos e inteligência setorial com versões, dependências, preview e auditoria.</p></section>
<form class="sp-toolbar" method="get"><select name="segment"><option value="">Todos os segmentos</option><option>Saúde</option><option>Educação</option><option>Indústria</option><option>Governo</option><option>Terceiro setor</option></select><input name="category" value="@Model.Category" placeholder="Categoria"/><button class="sp-btn">Filtrar</button><a class="sp-btn" asp-action="Builder">Criar pacote</a><a asp-action="Installations">Instalações</a></form>
<div class="sp-grid">@foreach(var p in Model.Packs){<article class="sp-card"><div><span class="sp-badge">@p.Segment</span> @if(p.IsOfficial){<span class="sp-badge sp-official">Oficial MNSOFT</span>}</div><h2>@p.Name</h2><p>@p.Description</p><small>@p.Category · versão @(p.CurrentVersion??"em preparação") · @p.Status</small><div class="sp-actions"><span>Conteúdo preservado por organização</span><a class="sp-btn" asp-action="Details" asp-route-id="@p.Id">Ver pacote</a></div></article>}@if(Model.Packs.Count==0){<article class="sp-card"><h2>Catálogo em preparação</h2><p>Altere os filtros ou crie um pacote privado a partir dos templates validados da sua organização.</p></article>}</div>
