@{ ViewData["Title"] = "Campanhas"; }
<main class="v9-page" data-page="campaigns-v9">
  <header class="v9-hero"><div><p class="eyebrow">Distribuição e adesão</p><h1>Campanhas de pesquisa</h1><p>Defina metas, recortes de público, unidades e acompanhe a evolução de respostas em tempo real.</p></div><button class="valora-button valora-button--primary" data-new-campaign>Nova campanha</button></header>
  <section class="v9-kpis"><article><span>Campanhas</span><strong data-campaign-kpi="total">—</strong></article><article><span>Ativas</span><strong data-campaign-kpi="active">—</strong></article><article><span>Respostas</span><strong data-campaign-kpi="responses">—</strong></article><article><span>Adesão estimada</span><strong data-campaign-kpi="rate">—</strong></article></section>
  <section class="valora-card"><div class="v9-section-title"><div><p class="eyebrow">Operação</p><h2>Acompanhamento</h2></div><button class="valora-button valora-button--ghost" data-refresh>Atualizar</button></div><div class="v9-campaign-list" data-campaigns></div></section>
  <dialog class="v9-dialog" data-campaign-dialog><button class="v9-dialog__close" data-close aria-label="Fechar">×</button><form class="valora-form" data-campaign-form><p class="eyebrow">Novo ciclo</p><h2>Criar campanha</h2><label>Pesquisa vinculada<select name="surveyId" required data-survey-options><option value="">Selecione uma pesquisa</option></select></label><label>Nome da campanha<input name="name" required maxlength="120" placeholder="Ex: Clima Organizacional 2026 — Onda 1"></label><div class="v9-form-grid"><label>Unidade (opcional)<select name="unitId" data-unit-options><option value="">Todas as unidades</option></select></label><label>Departamento / Setor (opcional)<select name="departmentId" data-department-options><option value="">Todos os setores</option></select></label></div><div class="v9-form-grid"><label>Público-alvo<input name="audience" placeholder="Ex: Toda a organização, Líderes, TI" maxlength="240"></label><label>Meta de respostas (mínimo)<input name="responseGoal" type="number" min="0" step="1" value="30"></label><label>Início da coleta<input name="startsAt" type="datetime-local"></label><label>Encerramento da coleta<input name="endsAt" type="datetime-local"></label></div><button class="valora-button valora-button--primary" type="submit">Salvar campanha</button></form></dialog>
  <dialog class="v9-dialog v9-dialog--compact" data-share-dialog><button class="v9-dialog__close" data-close aria-label="Fechar">×</button><div data-share-body></div></dialog>
  <div class="valora-alert valora-alert--danger" data-error hidden></div>
</main>
@section Scripts { <script src="/js/pages/experience-v9.js"></script> }
