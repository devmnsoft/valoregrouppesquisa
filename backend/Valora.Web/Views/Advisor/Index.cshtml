@model Valora.Web.Models.ViewModels.AdvisorIndexViewModel
@{ViewData["Title"]="Valora Advisor™";}
<link rel="stylesheet" href="~/css/advisor.css" asp-append-version="true" />
<section class="advisor-hero"><div><span class="advisor-kicker">INTELIGÊNCIA ORGANIZACIONAL</span><h1>Valora Advisor™</h1><p>Leituras orientadoras rastreáveis, limitadas às evidências reais da organização.</p></div><div class="methodology-seal"><strong>Metodologia primeiro</strong><span>A IA não substitui evidência nem decisão humana.</span></div></section>
@if(TempData["AdvisorError"] is string error){<div class="advisor-alert" role="alert">@error</div>}
<div class="advisor-shell">
<aside class="advisor-history"><h2>Histórico</h2><a class="new-reading" asp-action="Index">+ Nova leitura</a>@if(Model.Conversations.Count==0){<p class="empty">Nenhuma conversa ainda. Defina um objetivo e escolha fontes.</p>}else{@foreach(var item in Model.Conversations){<a class="history-item @(Model.ActiveConversation?.Conversation.Id==item.Id?"active":"")" asp-action="Index" asp-route-id="@item.Id"><strong>@item.Objective</strong><span>@item.UpdatedAt.ToLocalTime().ToString("dd/MM · HH:mm")</span></a>}}</aside>
<main class="advisor-dialogue">
@if(Model.ActiveConversation is null){<div class="advisor-empty"><span>✦</span><h2>Comece pela decisão que precisa compreender</h2><p>O Advisor só produzirá uma leitura quando você selecionar evidências verificáveis.</p></div>}else{<header><span class="status-dot"></span><div><h2>@Model.ActiveConversation.Conversation.Objective</h2><small>Contexto organizacional isolado · histórico auditável</small></div></header>@foreach(var message in Model.ActiveConversation.Messages){<partial name="_AdvisorMessageBubble" model="message" />}}
<form asp-action="Ask" method="post" class="advisor-composer" id="advisor-form">@Html.AntiForgeryToken()<input asp-for="Ask.ConversationId" type="hidden" />
@if(Model.ActiveConversation is null){<label asp-for="Ask.Objective">Objetivo da leitura</label><input asp-for="Ask.Objective" placeholder="Ex.: compreender fatores associados à queda de participação" /><span asp-validation-for="Ask.Objective"></span>}else{<input asp-for="Ask.Objective" type="hidden" value="@Model.ActiveConversation.Conversation.Objective" />}
<label asp-for="Ask.Question">Pergunta orientadora</label><textarea asp-for="Ask.Question" rows="3" placeholder="O que as evidências permitem afirmar — e o que ainda precisa ser validado?"></textarea><span asp-validation-for="Ask.Question"></span><button type="submit">Analisar evidências <span>→</span></button></form>
</main>
<aside class="advisor-context"><h2>Fontes da leitura</h2><p>Selecione dados reais. Itens de outra organização nunca são exibidos.</p>@if(Model.ContextOptions.Count==0){<div class="context-empty">Não há fontes disponíveis. Importe ou registre dados antes de solicitar uma análise.</div>}else{@foreach(var source in Model.ContextOptions){<label class="source-card"><input type="checkbox" form="advisor-form" name="Ask.SourceKeys" value="@($"{source.SourceType}:{source.SourceId}")" /><span><strong>@source.Title</strong><small>@source.SourceType · @source.Summary</small></span></label>}}<div class="limitation-panel"><strong>Limites permanentes</strong><ul><li>Associação não comprova causalidade.</li><li>Benchmark exige base real identificada.</li><li>Toda decisão requer confirmação humana.</li></ul></div></aside>
</div>
@section Scripts{<partial name="_ValidationScriptsPartial" />}
