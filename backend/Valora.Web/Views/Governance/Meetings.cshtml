@model IReadOnlyList<Valora.Application.DecisionCenter.GovernanceMeetingDto>
@{ ViewData["Title"]="Reuniões de Governança"; }

<main class="dc-page"><header class="dc-hero"><h1>Reuniões de governança</h1><p>Pautas e encaminhamentos vinculados ao acompanhamento real.</p><a class="btn btn-light" href="/Governance/Meetings/Create">Cadastrar reunião</a></header><section class="dc-card dc-list">@if(Model.Count==0){<div class="dc-empty">Nenhuma reunião cadastrada.</div>}else foreach(var x in Model){<article class="dc-row"><div><span class="dc-badge">@x.Status</span><h2><a href="/Governance/Meetings/Details/@x.Id">@x.Title</a></h2><p>@x.Agenda</p></div><time>@x.ScheduledAt.ToString("dd/MM/yyyy HH:mm")</time></article>}</section></main>
