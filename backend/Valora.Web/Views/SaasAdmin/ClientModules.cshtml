@model Valora.Web.Models.ViewModels.SaasClientModulesViewModel
@using System.Globalization
@{ ViewData["Title"] = $"Módulos · {Model.Client.TradeName}"; var br = CultureInfo.GetCultureInfo("pt-BR"); }
<main class="saas-console"><partial name="_PageHeader" model="@(new PageHeaderViewModel(Model.Client.TradeName, "Contratação por módulo com acesso preservado e auditoria.", "Cliente SaaS", Model.Client.Status, new[] { new PageHeaderAction("Voltar aos clientes", "/Admin/Clients") }))" />
 <nav class="client-admin-tabs" aria-label="Áreas do cliente"><a href="/Admin/Clients/@Model.Client.Id/Users">Usuários</a><a class="active" href="/Admin/Clients/@Model.Client.Id/Modules">Módulos</a><a href="/Admin/Clients/@Model.Client.Id/Billing">Plano e cobrança</a><a href="/Admin/Clients/@Model.Client.Id/Audit">Auditoria</a></nav>
 <section class="module-admin-grid">
 @foreach (var module in Model.Modules)
 { <article><header><span class="module-market-icon"><valora-icon name="@module.Icon" decorative="true" /></span><div><h2>@module.Name</h2><span class="badge">@module.ContractStatus</span></div></header><p>@module.Description</p><small>@(module.BasePrice == 0 ? "Incluso" : module.BasePrice.ToString("C", br) + "/mês") · @module.FeatureCount funcionalidades</small><form method="post" action="/Admin/Clients/@Model.Client.Id/Modules">@Html.AntiForgeryToken()<input type="hidden" name="ClientId" value="@Model.Client.Id" /><input type="hidden" name="ModuleCode" value="@module.Code" /><label>Novo status<select name="Status" required><option value="active">Ativo</option><option value="read_only">Somente consulta</option><option value="suspended">Suspenso</option><option value="cancelled">Cancelado</option></select></label><label>Motivo da alteração<textarea name="Reason" required minlength="10" maxlength="1000" rows="2"></textarea></label><button class="valora-button valora-button--primary" type="submit" data-confirm="Esta ação altera o acesso dos usuários e será auditada. Deseja continuar?" data-confirm-title="Alterar contratação?" data-loading-text="Salvando…">Salvar alteração</button></form></article> }
 </section>
</main>
