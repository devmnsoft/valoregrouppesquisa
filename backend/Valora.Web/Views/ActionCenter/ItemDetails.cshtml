@model Valora.Application.ActionCenter.ActionItemDto

@{
    ViewData["Title"]=Model.Title;
}

<main class="valora-page"><header class="leadership-hero"><div><p class="eyebrow">@Model.Priority · @Model.Status</p><h1>@Model.Title</h1><p>@Model.Description</p></div></header><section class="leadership-grid"><article class="valora-card"><h2>Rastreabilidade</h2><p><strong>Origem:</strong> @Model.OriginType</p><p><strong>Evidência:</strong> @Model.EvidenceSummary</p><p><strong>Resultado esperado:</strong> @Model.ExpectedOutcome</p></article><article class="valora-card"><h2>Acompanhamento</h2><progress max="100" value="@Model.ProgressPercent"></progress><form method="post" action="/ActionCenter/Items/@Model.Id/Progress"><input name="progressPercent" type="number" min="0" max="99" value="@Model.ProgressPercent"/><input name="note" placeholder="Nota do check-in"/><button>Registrar</button></form></article></section><section class="leadership-grid"><form class="valora-card" method="post" action="/ActionCenter/Items/@Model.Id/Block"><h2>Registrar bloqueio</h2><textarea name="reason" required></textarea><button>Bloquear ação</button></form><form class="valora-card" method="post" action="/ActionCenter/Items/@Model.Id/Complete"><h2>Concluir com evidência</h2><textarea name="result" minlength="10" required placeholder="Resultado alcançado"></textarea><textarea name="evidence" required placeholder="Evidência de conclusão"></textarea><button class="btn btn-primary">Concluir ação</button></form></section></main>
