{
  "ConnectionStrings": {
    "Postgres": "",
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "ValoraInsight",
    "Audience": "ValoraInsight",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "ClockSkewSeconds": 30
  },
  "App": {
    "PublicBaseUrl": "http://localhost:5088",
    "AdminBaseUrl": "http://localhost:5088",
    "EnvironmentName": "Development",
    "EnableDemoSeed": false,
    "EnableDetailedErrors": false,
    "MaintenanceModeEnabled": false,
    "MaintenanceMessage": "O sistema está em manutenção programada. Tente novamente mais tarde."
  },
  "Security": {
    "RequireHttps": false,
    "AllowedOrigins": [ "http://localhost:5088", "http://127.0.0.1:5088" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5088", "http://127.0.0.1:5088" ]
  },
  "Storage": { "Provider": "Local", "BasePath": "./storage" },
  "Certificates": { "PdfEnabled": false },
  "Reports": { "PdfEnabled": false },
  "Integrations": { "PowerBiEnabled": false, "WebhooksEnabled": false },
  "Backup": { "Configured": false, "LastKnownAt": "" },
  "Authentication": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "PasswordResetBaseUrl": "https://app.valora.example/Account/ResetPassword"
  },
  "AllowedHosts": "*",
  "Valora": {
    "Environment": "development",
    "Version": "8.0.0",
    "ReleaseDate": "2026-08-07",
    "BuildId": "local",
    "Processing": {
      "Enabled": true,
      "PollIntervalSeconds": 10,
      "MaxConcurrentJobs": 1,
      "MaxAttempts": 3
    }
  },
  "Demo": {
    "SeedEnabled": false
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Email": {
    "Enabled": false,
    "Provider": "Smtp",
    "FromName": "Valora Group",
    "FromEmail": "valoragroup@mnsoft.com.br",
    "ReplyTo": "valoragroup@mnsoft.com.br",
    "SmtpHost": "",
    "SmtpPort": 587,
    "Username": "",
    "Password": "",
    "From": "valoragroup@mnsoft.com.br",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "Username": "",
      "Password": "",
      "TimeoutSeconds": 30
    }
  },
  "FreeSurveySecurity": {
    "Enabled": true,
    "MaxSubmissionsPerIpPerHour": 20,
    "MaxSubmissionsPerEmailPerDay": 3,
    "MaxSubmissionsPerTokenPerHour": 30,
    "DuplicateSubmissionWindowSeconds": 60,
    "MinSecondsToSubmit": 20,
    "EnableHoneypot": true
  }
}
