@model Valora.Application.ActionCenter.ActionDashboardDto
@{ ViewData["Title"] = "Central de Ações"; }
<main class="valora-page">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel("Central de Ações", "Converta evidências em compromissos com responsáveis, prioridade e prazo.", "Valora Action™", "Execução", new[] { new PageHeaderAction("Novo plano", "/ActionCenter/Plans/Create", Style: "primary", Icon: "plus"), new PageHeaderAction("Ver todas as ações", "/ActionCenter/Items", Icon: "list") }))" />
  <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel("Como conduzir a execução", "Crie um plano a partir de uma evidência validada, distribua responsáveis e acompanhe os compromissos até a conclusão.", new[] { "Registre a origem e o resultado esperado.", "Defina prioridade, responsável e prazo.", "Revise atrasos e atualize o progresso." }))" />
  <partial name="_PageProgressChecklist" model="@(new PageProgressChecklistViewModel("Transforme recomendação em evolução", "Toda ação deve ter origem, dono, prazo e evidência de conclusão.", new[] { new GuidedStepCardViewModel("Recomendação selecionada", "Registre a evidência que originou o compromisso.", "current"), new GuidedStepCardViewModel("Responsável e prazo", "Defina dono, prioridade e data limite."), new GuidedStepCardViewModel("Execução", "Atualize status e progresso."), new GuidedStepCardViewModel("Evidência de conclusão", "Anexe a comprovação do resultado."), new GuidedStepCardViewModel("Evolução", "Compare o impacto no próximo ciclo.") }))" />
  <section class="v9-kpis" aria-label="Resumo da execução"><partial name="_MetricCard" model="@(new MetricCardViewModel("Críticas", Model.Critical.ToString(), "Exigem decisão imediata", "danger"))" /><partial name="_MetricCard" model="@(new MetricCardViewModel("Atrasadas", Model.Overdue.ToString(), "Fora do prazo acordado", "warning"))" /><partial name="_MetricCard" model="@(new MetricCardViewModel("Sem responsável", Model.Unassigned.ToString(), "Aguardando atribuição"))" /><partial name="_MetricCard" model="@(new MetricCardViewModel("Planos ativos", Model.ActivePlans.ToString(), "Em acompanhamento", "success"))" /></section>
  <section class="valora-card"><div class="section-heading"><div><p class="eyebrow">Agenda executiva</p><h2>Próximos compromissos</h2><p>Ações ordenadas para facilitar a gestão de risco e prazo.</p></div><a class="valora-button valora-button--ghost" href="/ActionCenter/Items">Ver ações</a></div>
  @if (Model.Upcoming.Count == 0) { <partial name="_EmptyState" model="@(new EmptyStateViewModel("Nenhuma ação registrada", "Crie o primeiro plano sustentado por evidência para iniciar a execução.", "Criar plano", "/ActionCenter/Plans/Create"))" /> } else { <div class="data-table-shell"><div class="table-responsive"><table class="valora-table"><thead><tr><th>Ação</th><th>Prioridade</th><th>Status</th><th>Progresso</th><th>Prazo</th></tr></thead><tbody>@foreach (var item in Model.Upcoming) { <tr><td><a href="/ActionCenter/Items/Details/@item.Id"><strong>@item.Title</strong></a></td><td><partial name="_SeverityBadge" model="@(new StatusBadgeViewModel(item.Priority, item.Priority is "critical" ? "danger" : item.Priority is "high" ? "warning" : "neutral"))" /></td><td><partial name="_StatusBadge" model="@(new StatusBadgeViewModel(item.Status, item.Status is "completed" ? "success" : "neutral"))" /></td><td><progress max="100" value="@item.ProgressPercent" aria-label="Progresso de @item.ProgressPercent por cento"></progress> <span>@item.ProgressPercent%</span></td><td>@(item.DueAt?.ToString("dd/MM/yyyy") ?? "A definir")</td></tr> }</tbody></table></div></div> }</section>
</main>
