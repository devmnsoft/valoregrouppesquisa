@model IReadOnlyList<Valora.Application.OneOnOne.OneOnOneSessionDto>
@{
    ViewData["Title"] = "Histórico de Sessões One-on-One";
}

<main class="valora-page" data-page="one-on-one-sessions">
    <nav class="v9-breadcrumb" aria-label="Navegação estrutural">
        <a href="/Dashboard">Início</a>
        <span>/</span>
        <a href="/OneOnOne">One-on-One™</a>
        <span>/</span>
        <span>Sessões</span>
    </nav>

    <header class="leadership-hero valora-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <p class="eyebrow text-white-50">Desenvolvimento Contínuo</p>
                <h1 class="text-white">Sessões One-on-One Cadastradas</h1>
                <p class="text-white-50 m-0">Histórico de conversas, feedbacks e compromissos acordados entre líderes e liderados.</p>
            </div>
            <a class="valora-button valora-button--primary" href="/OneOnOne/Sessions/Create">
                + Nova Sessão
            </a>
        </div>
    </header>

    <section class="valora-card mt-3">
        @if (Model.Count == 0)
        {
            <div class="valora-empty py-5 text-center">
                <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">📅</div>
                <h3 class="h6">Nenhuma sessão registrada nesta organização</h3>
                <p class="text-muted max-w-600 mx-auto">
                    Crie a primeira sessão de acompanhamento para registrar pautas, feedbacks com evidências e compromissos rastreáveis.
                </p>
                <a class="valora-button valora-button--primary btn-sm mt-2" href="/OneOnOne/Sessions/Create">
                    Criar Sessão
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead>
                        <tr>
                            <th>Título / Conversa</th>
                            <th>Líder Facilitador</th>
                            <th>Participante Liderado</th>
                            <th>Data e Horário</th>
                            <th>Status</th>
                            <th>Compromissos Pendentes</th>
                            <th class="text-end">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>
                                    <a class="fw-semibold text-decoration-none text-dark" href="/OneOnOne/Sessions/Details/@s.Id">
                                        @s.Title
                                    </a>
                                </td>
                                <td>@s.LeaderName</td>
                                <td>@s.ParticipantName</td>
                                <td>@(s.ScheduledAt?.ToString("dd/MM/yyyy HH:mm") ?? "A definir")</td>
                                <td>
                                    <span class="badge @(s.Status == "completed" ? "bg-success" : s.Status == "cancelled" ? "bg-secondary" : "bg-primary")">
                                        @(s.Status == "completed" ? "Concluída" : s.Status == "scheduled" ? "Agendada" : s.Status)
                                    </span>
                                </td>
                                <td>
                                    @if (s.PendingCommitments > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@s.PendingCommitments pendente(s)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Nenhum</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="valora-button valora-button--ghost btn-sm" href="/OneOnOne/Sessions/Details/@s.Id">
                                        Ver Detalhes
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>
