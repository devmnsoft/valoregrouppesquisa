@model IReadOnlyList<Valora.Application.Evolution.EvolutionCycleDto>
@{ ViewData["Title"] = "Ciclos de evolução"; var command=ViewData["CycleCommand"] as Valora.Web.Models.ViewModels.EvolutionCycleViewModel ?? new Valora.Web.Models.ViewModels.EvolutionCycleViewModel(); }
<main class="valora-page">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel("Ciclos de evolução", "Defina períodos comparáveis e preserve a história de cada transformação.", "Valora Evolution™", Actions: new[] { new PageHeaderAction("Novo ciclo", DataAction: "new-cycle", Style: "primary", Icon: "plus"), new PageHeaderAction("Voltar à evolução", "/Evolution") }))" />
  <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel("Organize a linha do tempo", "Crie um ciclo com período, baseline e meta. Depois registre snapshots com evidências para acompanhar o progresso sem sobrescrever o histórico."))" />
  @if (TempData["EvolutionError"] is string error) { <div class="valora-alert valora-alert--danger" role="alert"><strong>Não foi possível criar o ciclo.</strong><span>@error</span></div> }
  <section class="valora-card"><div class="section-heading"><div><p class="eyebrow">Linha do tempo</p><h2>Ciclos cadastrados</h2></div></div>@if (Model.Count == 0) { <partial name="_EmptyState" model="@(new EmptyStateViewModel("Nenhum ciclo cadastrado", "Crie o primeiro ciclo para estabelecer o baseline da evolução."))" /> } else { <div class="data-table-shell"><div class="table-responsive"><table class="valora-table"><thead><tr><th>Ciclo</th><th>Início</th><th>Status</th><th>Baseline</th><th>Atual</th><th>Tendência</th></tr></thead><tbody>@foreach (var cycle in Model) { <tr><td><a href="/Evolution/Cycles/Details/@cycle.Id"><strong>@cycle.Title</strong></a></td><td>@cycle.PeriodStart.ToString("dd/MM/yyyy")</td><td><partial name="_StatusBadge" model="@(new StatusBadgeViewModel(cycle.Status, cycle.Status is "open" or "monitoring" ? "success" : "neutral"))" /></td><td>@(cycle.BaselineScore?.ToString("0.0") ?? "—")</td><td>@(cycle.CurrentScore?.ToString("0.0") ?? "—")</td><td>@(cycle.Trend ?? "Sem base")</td></tr> }</tbody></table></div></div> }</section>
  <dialog class="valora-dialog" data-cycle-dialog aria-labelledby="cycle-title"><form method="post" action="/Evolution/Cycles/Open" data-submit-once><header><div><p class="eyebrow">Novo período</p><h2 id="cycle-title">Criar ciclo de evolução</h2></div><button type="button" class="btn-close" data-dialog-close aria-label="Fechar"></button></header>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div><details class="page-help"><summary>Como usar</summary><p>Defina o período e o objetivo. O baseline manual é apenas uma referência até que avaliações comparáveis sejam vinculadas; salvar não atribui melhoria ao plano.</p></details><div class="form-grid"><div class="valora-field"><label for="cycle-name">Nome do ciclo</label><input class="form-control" id="cycle-name" name="Title" value="@command.Title" required minlength="3" maxlength="160" placeholder="Ex.: Ciclo de liderança 2026">@Html.ValidationMessage("Title")</div><div class="valora-field"><label for="cycle-start">Data inicial</label><input class="form-control" id="cycle-start" name="PeriodStart" value="@(command.PeriodStart==default?null:command.PeriodStart.ToString("yyyy-MM-dd"))" type="date" required>@Html.ValidationMessage("PeriodStart")</div><div class="valora-field"><label for="cycle-end">Data final</label><input class="form-control" id="cycle-end" name="PeriodEnd" value="@command.PeriodEnd?.ToString("yyyy-MM-dd")" type="date">@Html.ValidationMessage("PeriodEnd")</div><div class="valora-field"><label for="cycle-baseline">Baseline</label><input class="form-control" id="cycle-baseline" name="BaselineScore" value="@command.BaselineScore" type="number" min="0" max="100" step="0.1"></div><div class="valora-field"><label for="cycle-target">Meta</label><input class="form-control" id="cycle-target" name="TargetScore" value="@command.TargetScore" type="number" min="0" max="100" step="0.1"></div></div><div class="valora-field"><label for="cycle-summary">Objetivo do ciclo</label><textarea class="form-control" id="cycle-summary" name="Summary" required maxlength="1000" rows="3">@command.Summary</textarea>@Html.ValidationMessage("Summary")</div><div class="valora-field"><label for="cycle-evidence">Evidência inicial</label><textarea class="form-control" id="cycle-evidence" name="EvidenceSummary" required maxlength="2000" rows="3">@command.EvidenceSummary</textarea>@Html.ValidationMessage("EvidenceSummary")</div><partial name="_FormActions" model="@(new FormActionsViewModel("Criar ciclo", "Cancelar"))" /></form></dialog>
</main>
@section Scripts { <script>const cycleDialog=document.querySelector('[data-cycle-dialog]');let cycleTrigger;document.querySelector('[data-action="new-cycle"]')?.addEventListener('click',event=>{cycleTrigger=event.currentTarget;cycleDialog?.showModal();});document.querySelectorAll('[data-dialog-close],[data-form-cancel]').forEach(x=>x.addEventListener('click',()=>x.closest('dialog')?.close()));cycleDialog?.addEventListener('close',()=>cycleTrigger?.focus());@if(ViewData["CycleCommand"] is not null){<text>cycleDialog?.showModal();</text>}</script> }
