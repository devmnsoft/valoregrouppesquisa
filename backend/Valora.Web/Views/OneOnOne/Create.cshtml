@model Valora.Application.OneOnOne.CreateOneOnOneSessionRequest
@{ViewData["Title"]="Nova sessão";}<main class="valora-page narrow"><header class="leadership-hero"><div><p class="eyebrow">Nova conversa</p><h1>Preparar One-on-One</h1><p>Defina contexto; a pauta continuará aberta à escuta humana.</p></div></header><form method="post" class="valora-card ooo-form"><div asp-validation-summary="All" class="text-danger"></div><label>Líder<input asp-for="LeaderUserId" required/></label><label>Participante<input asp-for="ParticipantUserId" required/></label><label>Data e hora<input asp-for="ScheduledAt" type="datetime-local"/></label><label class="wide">Objetivo<input asp-for="Title" required maxlength="200" placeholder="Ex.: acompanhar evolução e remover impedimentos"/></label><label>Diagnóstico relacionado (opcional)<input asp-for="DiagnosticId"/></label><label>Resultado relacionado (opcional)<input asp-for="ResultId"/></label><label class="wide">Evidência inicial<textarea asp-for="EvidenceSummary" rows="3" placeholder="Fatos observáveis que contextualizam a conversa"></textarea></label><div class="wide form-actions"><a href="/OneOnOne/Sessions" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary">Criar sessão</button></div></form></main>
