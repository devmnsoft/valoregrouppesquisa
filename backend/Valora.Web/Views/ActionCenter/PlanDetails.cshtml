@model Valora.Web.Controllers.ActionPlanDetailsViewModel
@{ ViewData["Title"]=Model.Plan.Title; var p=Model.Plan; string Label(string value)=>value switch { "draft"=>"Rascunho", "proposed"=>"Proposto", "approved"=>"Aprovado", "in_execution"=>"Em execução", "completed"=>"Concluído", "canceled"=>"Cancelado", "pending"=>"Pendente", "in_progress"=>"Em execução", "blocked"=>"Bloqueada", "overdue"=>"Atrasada", "critical"=>"Crítica", "high"=>"Alta", "medium"=>"Média", "low"=>"Baixa", _=>value }; var canCreate=p.Status is "draft" or "proposed" or "approved" or "in_execution"; }
<main class="valora-page action-detail">
 <partial name="_PageHeader" model="@(new PageHeaderViewModel(p.Title,p.Summary,"Valora Action™",$"{Label(p.Priority)} · {Label(p.Status)}",new[]{new PageHeaderAction("Voltar aos planos","/ActionCenter/Plans",Icon:"arrow-left")}))" />
 <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel("Como usar","Acompanhe o resultado do plano pelas atividades não canceladas e abra cada atividade para registrar evidências.",new[]{"Revise prazo e responsável.","Crie atividades com entregas verificáveis.","Acompanhe bloqueios antes do prazo."}))" />
 <section class="action-summary-grid"><article class="valora-card"><h2>Resumo do plano</h2><dl class="action-facts"><div><dt>Situação</dt><dd>@Label(p.Status)</dd></div><div><dt>Responsável</dt><dd>@(p.OwnerName??"Sem responsável")</dd></div><div><dt>Prazo</dt><dd>@(p.DueAt?.ToString("dd/MM/yyyy")??"A definir")</dd></div><div><dt>Progresso operacional</dt><dd><progress max="100" value="@p.ProgressPercent"></progress> @p.ProgressPercent%</dd></div></dl><p>O progresso é a média das atividades não canceladas. Sem atividades, permanece em 0%.</p></article><article class="valora-card"><h2>Resultado e evidência</h2><h3>Resultado esperado</h3><p>@p.ExpectedOutcome</p><h3>Evidência de origem</h3><p>@p.EvidenceSummary</p></article></section>
 <section class="valora-card"><div class="section-heading"><div><h2>Atividades</h2><p>@Model.Items.Count compromisso(s) neste plano.</p></div>@if(canCreate){<button type="button" class="valora-button valora-button--primary" data-open="create-item-dialog">Nova atividade</button>}</div>@if(Model.Items.Count==0){<p>Nenhuma atividade. Crie a primeira entrega para iniciar o acompanhamento.</p>}else{<div class="table-responsive"><table class="valora-table"><thead><tr><th>Atividade</th><th>Situação</th><th>Prioridade</th><th>Progresso</th><th>Prazo</th></tr></thead><tbody>@foreach(var i in Model.Items){<tr><td><a href="/ActionCenter/Items/Details/@i.Id">@i.Title</a></td><td>@Label(i.Status)</td><td>@Label(i.Priority)</td><td>@i.ProgressPercent%</td><td>@(i.DueAt?.ToString("dd/MM/yyyy")??"A definir")</td></tr>}</tbody></table></div>}</section>
</main>
@if(canCreate){<dialog id="create-item-dialog" class="action-detail"><form method="post" action="/ActionCenter/Items/Create">@Html.AntiForgeryToken()<h2>Nova atividade em @p.Title</h2><label for="title">Título *</label><input id="title" name="Title" minlength="3" maxlength="180" required><label for="description">Descrição</label><textarea id="description" name="Description" maxlength="2000"></textarea><label for="outcome">Resultado esperado *</label><textarea id="outcome" name="ExpectedOutcome" minlength="3" maxlength="2000" required></textarea><label for="evidence">Evidência inicial *</label><textarea id="evidence" name="EvidenceSummary" minlength="3" maxlength="2000" required></textarea><label for="priority">Prioridade *</label><select id="priority" name="Priority"><option value="medium">Média</option><option value="high">Alta</option><option value="critical">Crítica</option><option value="low">Baixa</option></select><label for="due">Prazo</label><input id="due" name="DueAt" type="date"><input type="hidden" name="ActionPlanId" value="@p.Id"><input type="hidden" name="OriginType" value="manual"><div class="dialog-actions"><button type="button" data-close>Cancelar</button><button class="valora-button valora-button--primary">Criar atividade</button></div></form></dialog><script>document.querySelector('[data-open]')?.addEventListener('click',()=>document.getElementById('create-item-dialog').showModal());document.querySelector('[data-close]')?.addEventListener('click',e=>e.target.closest('dialog').close());</script>}
