@model Valora.Web.Controllers.OnboardingStepViewModel
@{ ViewData["Title"] = "Onboarding · " + Model.Title; }
<section class="onboarding-step">
  <header class="help-topic-header"><a href="/Onboarding/Checklist">← Voltar ao checklist</a><span class="eyebrow">Configuração guiada</span><h1>@Model.Title</h1><p>@Model.Description</p></header>
  <article class="next-best-action"><div><strong>O que fazer agora</strong><p>Abra a configuração, revise os dados no contexto da organização selecionada e volte para marcar esta etapa como concluída.</p></div><a class="valora-button valora-button--primary" href="@Model.NextUrl">@Model.NextLabel →</a></article>
</section>
