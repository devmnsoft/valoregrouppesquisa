@model Valora.Web.Models.ViewModels.ExecutiveWorkspaceViewModel
@using Microsoft.AspNetCore.Authorization
@using Valora.Application.Access
@inject IAuthorizationService AuthorizationService
@{ ViewData["Title"] = Model.Title; var canManagePriorities = (await AuthorizationService.AuthorizeAsync(User, ValoraPermissions.Priorities.Manage)).Succeeded; var canManageActions = (await AuthorizationService.AuthorizeAsync(User, "action.manage")).Succeeded; }
<link rel="stylesheet" href="~/css/executive-workspace.css" asp-append-version="true" />
<main class="executive-workspace" data-mode="@Model.Mode">
 @Html.AntiForgeryToken()
 <header class="workspace-hero"><div><span class="workspace-eyebrow">Valora Executive Workspace™</span><h1>@Model.Title</h1><p>@Model.Subtitle</p></div><div class="workspace-primary-actions">@if (canManagePriorities) { <button id="new-priority" class="button primary" type="button">+ Nova prioridade</button> }<a class="workspace-search-link" href="/Search">⌕ <span>Buscar</span><kbd>Ctrl K</kbd></a></div></header>
 <nav class="workspace-tabs" aria-label="Workspace"><a href="/Workspace">Visão geral</a><a href="/Workspace/MyDay">Meu Dia</a><a href="/Workspace/Priorities">Prioridades</a><a href="/Search">Busca Global</a></nav>
 <details class="workspace-help"><summary>Como usar</summary><p>Crie uma prioridade, atribua um responsável e registre avanços. Abra um item para vê-lo nos recentes ou fixe-o para acesso rápido.</p></details>
 @if (Model.Mode == "priorities") { <form id="priority-filters" class="workspace-filters"><label>Situação<select name="status"><option value="">Todas</option><option value="active">Ativas</option><option value="completed">Concluídas</option><option value="cancelled">Canceladas</option></select></label><label>Nível<select name="priority"><option value="">Todos</option><option value="critical">Crítica</option><option value="high">Alta</option><option value="medium">Média</option><option value="low">Baixa</option></select></label><label>Prazo<select name="due"><option value="">Todos</option><option value="overdue">Atrasadas</option><option value="today">Hoje</option><option value="none">Sem prazo</option></select></label><button class="button" type="submit">Aplicar filtros</button></form> }
 <div id="workspace-feedback" class="workspace-feedback" role="status" aria-live="polite" hidden></div>
 <section id="workspace-loading" class="workspace-grid" aria-label="Carregando"><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></section>
 <section id="workspace-content" class="workspace-grid" hidden></section>
 <section id="workspace-empty" class="workspace-empty" hidden><span>✦</span><h2>Seu foco está em dia</h2><p>Nenhum registro corresponde a esta seção.</p><button class="button retry" type="button" hidden>Tentar novamente</button></section>
 <dialog id="priority-dialog" class="priority-dialog"><form id="priority-form"><header><h2 id="priority-form-title">Nova prioridade</h2><button type="button" class="icon-button dialog-close" aria-label="Fechar">×</button></header><div class="form-errors" tabindex="-1" hidden></div><input type="hidden" name="id"><input type="hidden" name="expectedUpdatedAt"><label>Título <span aria-hidden="true">*</span><input name="title" required minlength="3" maxlength="180"><small>Resuma o resultado que precisa de atenção.</small><span class="field-error"></span></label><label>Descrição<textarea name="description" maxlength="2000" rows="4"></textarea><span class="field-error"></span></label><div class="form-row"><label>Prioridade <span aria-hidden="true">*</span><select name="priority" required><option value="critical">Crítica</option><option value="high">Alta</option><option value="medium" selected>Média</option><option value="low">Baixa</option></select><span class="field-error"></span></label><label>Responsável<input name="ownerSearch" type="search" placeholder="Buscar responsável" autocomplete="off"><select name="ownerUserId"><option value="">Compartilhada</option></select><span class="field-error"></span></label></div><label>Origem opcional<input name="sourceSearch" type="search" placeholder="Buscar recurso" autocomplete="off"><select name="source"><option value="">Sem recurso vinculado</option></select><small>Somente recursos que você pode consultar são exibidos.</small><span class="field-error"></span></label><label>Prazo<input name="dueAt" type="datetime-local"><small>O horário usa o fuso atual do navegador; uma data ausente permanece ausente.</small><span class="field-error"></span></label><footer><button type="button" class="button dialog-close">Cancelar</button><button class="button primary" type="submit">Salvar prioridade</button></footer></form></dialog>
 <dialog id="priority-details" class="priority-dialog details-dialog"><div class="details-content"></div></dialog>
 <dialog id="priority-command" class="priority-dialog"><form id="priority-command-form"><header><div><span class="workspace-eyebrow">Atualizar prioridade</span><h2 id="priority-command-title"></h2></div><button type="button" class="icon-button command-close" aria-label="Fechar">×</button></header><p id="priority-command-consequence"></p><p class="priority-name"></p><div class="form-errors" tabindex="-1" hidden></div><label class="progress-field">Progresso (%)<input name="progressPercent" type="number" min="0" max="99" step="1"><span class="field-error"></span></label><label><span class="note-label">Justificativa</span> <span aria-hidden="true">*</span><textarea name="note" required minlength="2" maxlength="1000" rows="4"></textarea><span class="field-error"></span></label><footer><button type="button" class="button command-close">Cancelar</button><button class="button primary" type="submit">Confirmar</button></footer></form></dialog>
 <dialog id="activity-dialog" class="priority-dialog"><form id="activity-form"><header><div><span class="workspace-eyebrow">Prioridade → execução</span><h2>Vincular atividade</h2></div><button type="button" class="icon-button activity-close" aria-label="Fechar">×</button></header><div class="form-errors" tabindex="-1" hidden></div><fieldset><legend>Como deseja continuar?</legend><label><input type="radio" name="mode" value="existing" checked> Vincular atividade existente</label><label><input type="radio" name="mode" value="create"> Criar atividade</label></fieldset><section data-activity-mode="existing"><label>Atividade autorizada <span aria-hidden="true">*</span><select name="actionId"></select></label></section><section data-activity-mode="create" hidden><label>Plano <span aria-hidden="true">*</span><select name="planId"></select></label><label><input type="checkbox" name="createPlan"> Criar um novo plano</label><label class="new-plan" hidden>Nome do novo plano <input name="planTitle" maxlength="180"></label><label>Título <span aria-hidden="true">*</span><input name="title" minlength="3" maxlength="180"></label><label>Contexto<textarea name="description" maxlength="2000" rows="3"></textarea></label><label>Resultado esperado <span aria-hidden="true">*</span><textarea name="expectedOutcome" minlength="3" maxlength="2000" rows="3"></textarea></label><label>Evidência de partida <span aria-hidden="true">*</span><textarea name="evidenceSummary" minlength="3" maxlength="2000" rows="3"></textarea></label><div class="form-row"><label>Prioridade<select name="priority"><option value="critical">Crítica</option><option value="high">Alta</option><option value="medium" selected>Média</option><option value="low">Baixa</option></select></label><label>Prazo<input name="dueAt" type="datetime-local"></label></div><p class="review-note">Revise plano, resultado, evidência e prazo antes de confirmar. Nenhuma referência sensível é copiada automaticamente.</p></section><footer><button type="button" class="button activity-close">Cancelar</button><button class="button primary" type="submit">Confirmar vínculo</button></footer></form></dialog>
</main>
<script nonce="@Context.Items["CspNonce"]">window.valoraWorkspaceMode='@Model.Mode';window.valoraCanManageActions=@canManageActions.ToString().ToLowerInvariant();</script>
<script src="~/js/executive-workspace.js" asp-append-version="true"></script>
