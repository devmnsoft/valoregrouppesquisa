@{ Layout = "_PublicLayout"; ViewData["Title"] = "Validar certificado"; }
<section class="section" data-page="public-certificate-validate"><div class="container-public"><div class="brand-page-header"><img src="/img/brand/valora-symbol.jpeg" alt="Valora Group"><div><p class="eyebrow">Validação</p><h1>Validar certificado</h1></div></div><form class="form-public" data-certificate-validate-form><input name="code" value="@ViewData["CertificateCode"]" placeholder="Código do certificado" required><button class="btn-public primary" type="submit">Validar</button></form><div class="certificate-card" data-certificate-validation></div></div></section>
@section Scripts { <script src="/js/public/public-certificate.js"></script> }
