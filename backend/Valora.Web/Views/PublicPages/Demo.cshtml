@{ Layout = "_PublicLayout"; ViewData["Title"] = "Solicitar demonstração"; }
<section class="public-editorial"><div class="container-public demo-layout"><div class="editorial-hero"><p class="eyebrow">Demonstração executiva</p><h1>Veja o Valora Insight™ aplicado ao contexto da sua organização.</h1><p class="lead">Em uma conversa objetiva, apresentamos o fluxo de diagnóstico, a leitura de maturidade e os controles disponíveis para o seu porte.</p><ul><li>30 minutos, com especialista da Valora Group</li><li>Sem compromisso de contratação</li><li>Escopo direcionado ao seu principal interesse</li></ul></div><form class="public-card form-public demo-form" data-demo-form><label>Nome *<input name="name" required maxlength="120" autocomplete="name"></label><label>Empresa *<input name="companyName" required maxlength="160" autocomplete="organization"></label><label>E-mail corporativo *<input name="email" required type="email" maxlength="160" autocomplete="email"></label><label>Telefone *<input name="phone" required maxlength="24" autocomplete="tel"></label><label>Cargo<input name="roleTitle" maxlength="100" autocomplete="organization-title"></label><label>Tamanho da empresa *<select name="companySize" required><option value="">Selecione</option><option>Até 20 pessoas</option><option>21 a 100 pessoas</option><option>101 a 500 pessoas</option><option>Mais de 500 pessoas</option></select></label><label>Interesse principal *<select name="interest" required><option value="">Selecione</option><option value="diagnostics">Diagnósticos e maturidade</option><option value="reports">Relatórios executivos</option><option value="governance">Governança multiunidade</option><option value="integrations">Integrações</option></select></label><label>Mensagem<textarea name="message" maxlength="2000" rows="4"></textarea></label><label class="consent"><input name="consent" type="checkbox" required>Li a <a href="/privacy">Política de Privacidade</a> e autorizo o contato.</label><input name="website" class="honeypot" tabindex="-1" autocomplete="off"><button class="premium-button primary" type="submit">Solicitar demonstração</button><div class="form-feedback" role="status" hidden></div></form></div></section>
@section Scripts { <script src="/js/public/demo-request.js" asp-append-version="true" defer></script> }
