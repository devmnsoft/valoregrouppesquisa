@model Valora.Application.ValoraAi.AiInsight
@using Valora.Application.ValoraAi
@{ ViewData["Title"] = Model.Title; }
<main class="valora-page v9-page">
 <partial name="_PageHeader" model="@(new PageHeaderViewModel(Model.Title, Model.Summary, "Insight baseado em evidências", Model.Status, new[] { new PageHeaderAction("Voltar aos insights", "/Insights") }))" />
 <div class="v9-executive-grid"><section class="valora-card"><p class="eyebrow">Contexto</p><h2>Interpretação</h2><p>@Model.Summary</p><dl><dt>Dimensão</dt><dd>@(Model.RelatedDimension ?? "Não vinculada")</dd><dt>Índice</dt><dd>@(Model.RelatedIndexCode ?? "Não vinculado")</dd><dt>Confiança</dt><dd><span class="badge">@Model.ConfidenceLevel</span></dd></dl></section><section class="valora-card"><p class="eyebrow">Rastreabilidade</p><h2>Evidências utilizadas</h2><p>@Model.EvidenceSummary</p><p><strong>Limitação:</strong> @(Model.Limitation ?? "Nenhuma limitação adicional registrada.")</p></section></div>
 <section class="valora-card">
  <p class="eyebrow">Plano de evolução</p><h2>Recomendação prática</h2><p>@Model.Recommendation</p>
  <div class="d-flex flex-wrap gap-2" role="group" aria-label="Ações do insight">
   @if (Model.Status == AiInsightStatuses.PendingReview)
   {
    <form method="post" asp-action="Approve" asp-route-id="@Model.Id">
     @Html.AntiForgeryToken()
     <button class="valora-button valora-button--primary" type="submit" data-confirm="A aprovação registra sua revisão humana e altera o status deste insight. Deseja continuar?" data-confirm-title="Aprovar insight?" data-loading-text="Aprovando…">Aprovar</button>
    </form>
    <button class="valora-button" type="button" data-dialog-target="#rejectInsightDialog">Rejeitar</button>
   }
   else
   {
    <span class="valora-alert valora-alert--info" role="status">Este insight já foi revisado e não possui ações de aprovação pendentes.</span>
   }
   <a class="valora-button" href="/ActionCenter/Plans/Create?originType=ai_insight&amp;originId=@Model.Id">Criar plano de ação</a>
   <a class="valora-button" href="/Decisions">Abrir decisões</a>
   <a class="valora-button" href="/Reports">Usar em relatório</a>
  </div>
  <small>A decisão final permanece sempre sob responsabilidade humana.</small>
 </section>
 @if (Model.Status == AiInsightStatuses.PendingReview)
 {
  <dialog class="confirmation-modal" id="rejectInsightDialog" aria-labelledby="rejectInsightTitle">
   <form method="post" asp-action="Reject" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()
    <header><span class="confirmation-modal__icon" aria-hidden="true">!</span><div><p class="eyebrow">Revisão humana</p><h2 id="rejectInsightTitle">Rejeitar insight</h2></div></header>
    <input type="hidden" name="InsightId" value="@Model.Id" />
    <div class="valora-field"><label for="rejectInsightReason">Motivo da rejeição</label><textarea class="form-control" id="rejectInsightReason" name="Reason" required minlength="10" maxlength="1000" rows="4" aria-describedby="rejectInsightHint"></textarea><small id="rejectInsightHint">Explique o que precisa ser revisto. O motivo será preservado para auditoria.</small></div>
    <footer><button class="valora-button valora-button--ghost" type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--danger" type="submit" data-confirm="A rejeição e o motivo ficarão registrados no histórico. Deseja continuar?" data-confirm-title="Confirmar rejeição?" data-loading-text="Rejeitando…">Rejeitar insight</button></footer>
   </form>
  </dialog>
 }
</main>
