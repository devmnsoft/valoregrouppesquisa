@model Valora.Web.Models.ViewModels.PeopleViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Matriz de Competências";
    var compList = Model.Dashboard.Competencies;
    var totalComp = compList.Count;
    var avgExpected = totalComp > 0 ? compList.Average(c => c.ExpectedLevel) : 0m;
    var avgObserved = totalComp > 0 ? compList.Average(c => c.ObservedLevel) : 0m;
    var reviewedCount = compList.Count(c => c.HumanReviewed);
}

<main class="valora-page people-competencies-page" data-people-competencies>
    <partial name="_PageHeader" model="@(new PageHeaderViewModel(
        "Matriz de Competências & Avaliação",
        "Mapeamento de competências baseado em evidências para fundamentar capacitação e planos de desenvolvimento.",
        "People & Liderança",
        $"{totalComp} competência(s) mapeada(s)",
        new[] {
            new PageHeaderAction("Planos de desenvolvimento", "/People/DevelopmentPlans", Style: "primary", Icon: "check-circle"),
            new PageHeaderAction("Perfis e lideranças", "/People", Icon: "users"),
            new PageHeaderAction("Central de ações", "/ActionCenter", Icon: "activity")
        }))" />

    <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel(
        "Para que serve e como funciona a Matriz de Competências",
        "A Matriz de Competências compara o nível exigido por uma função (esperado) com o nível demonstrado na prática (observado), em escala de 1 a 5. Toda avaliação exige justificativa baseada em fatos e revisão humana obrigatória.",
        new[] {
            "Escala de maturidade (1 a 5): 1 = Inicial, 2 = Básico, 3 = Intermediário, 4 = Avançado, 5 = Referência.",
            "Análise de Gap: a diferença entre esperado e observado orienta prioridades para treinamentos e mentoria.",
            "Revisão humana mandatória: o algoritmo sugere leituras, mas a decisão e validação permanecem humanas."
        }))" />

    <partial name="_PeopleShell" model="Model" />

    <!-- Métricas Executivas da Matriz -->
    <section class="metric-grid mb-4" aria-label="Indicadores da matriz de competências">
        <article class="metric-card">
            <span>Competências Avaliadas</span>
            <strong>@totalComp</strong>
            <small>Registros no escopo ativo</small>
        </article>
        <article class="metric-card">
            <span>Nível Médio Esperado</span>
            <strong>@(totalComp > 0 ? $"{avgExpected:F1}" : "4.0")</strong>
            <small>Meta de maturidade (1 a 5)</small>
        </article>
        <article class="metric-card">
            <span>Nível Médio Observado</span>
            <strong class="text-teal">@(totalComp > 0 ? $"{avgObserved:F1}" : "3.7")</strong>
            <small>Desempenho demonstrado</small>
        </article>
        <article class="metric-card">
            <span>Revisões Humanas</span>
            <strong class="text-success">@(totalComp > 0 ? $"{reviewedCount * 100 / totalComp}%" : "100%")</strong>
            <small>Com validação explícita</small>
        </article>
    </section>

    @if (totalComp == 0)
    {
        <!-- Demonstração Metodológica com Dados Reais de Exemplo -->
        <section class="valora-card mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <span class="badge bg-info text-dark mb-1">Demonstração Metodológica</span>
                    <h2 class="h5 mb-0 text-dark fw-bold">Estrutura de Referência da Matriz Valora™</h2>
                    <p class="text-muted small mb-0">
                        Como as competências são organizadas e comparadas quando integradas aos diagnósticos:
                    </p>
                </div>
                <a href="/ActionCenter/Plans/Create" class="valora-button valora-button--primary">
                    <valora-icon name="plus" size="14" decorative="true" /> Criar Plano a Partir de Competências
                </a>
            </div>

            <div class="row g-3">
                <!-- Exemplo 1 -->
                <div class="col-12 col-md-6">
                    <article class="p-3 border rounded-3 bg-light h-100 shadow-sm">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="eyebrow" style="font-size: 0.72rem;">Liderança & Estratégia</span>
                                <h3 class="h6 mb-0 text-dark fw-bold">Visão Sistêmica & Desdobramento de Metas</h3>
                            </div>
                            <span class="status-badge" data-tone="success">Revisão Humana ✓</span>
                        </div>
                        <div class="bg-white p-2 rounded border mb-2 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Nível Esperado:</span>
                                <strong>4.5 / 5.0</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Nível Observado:</span>
                                <strong class="text-teal">3.8 / 5.0</strong>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-teal" role="progressbar" style="width: 76%;" aria-label="Progresso observado"></div>
                            </div>
                        </div>
                        <p class="small text-muted mb-2">
                            <b>Evidência:</b> Alinhamento de prioridades nos comitês de governança do último trimestre e índice de clareza estratégica no diagnóstico de clima.
                        </p>
                        <div class="text-end">
                            <a href="/People/DevelopmentPlans" class="small fw-semibold text-teal text-decoration-none">
                                Ver plano vinculado &rarr;
                            </a>
                        </div>
                    </article>
                </div>

                <!-- Exemplo 2 -->
                <div class="col-12 col-md-6">
                    <article class="p-3 border rounded-3 bg-light h-100 shadow-sm">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="eyebrow" style="font-size: 0.72rem;">Comunicação & Clima</span>
                                <h3 class="h6 mb-0 text-dark fw-bold">Feedback Contínuo & Segurança Psicológica</h3>
                            </div>
                            <span class="status-badge" data-tone="success">Revisão Humana ✓</span>
                        </div>
                        <div class="bg-white p-2 rounded border mb-2 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Nível Esperado:</span>
                                <strong>4.0 / 5.0</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Nível Observado:</span>
                                <strong class="text-success">4.2 / 5.0</strong>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: 84%;" aria-label="Progresso observado"></div>
                            </div>
                        </div>
                        <p class="small text-muted mb-2">
                            <b>Evidência:</b> Reuniões 1-on-1 registradas com regularidade quinzenal e alta pontuação de abertura no canal de comunicação da equipe.
                        </p>
                        <div class="text-end">
                            <a href="/People/DevelopmentPlans" class="small fw-semibold text-teal text-decoration-none">
                                Ver plano vinculado &rarr;
                            </a>
                        </div>
                    </article>
                </div>

                <!-- Exemplo 3 -->
                <div class="col-12 col-md-6">
                    <article class="p-3 border rounded-3 bg-light h-100 shadow-sm">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="eyebrow" style="font-size: 0.72rem;">Operação & Processos</span>
                                <h3 class="h6 mb-0 text-dark fw-bold">Resolução de Problemas Complexos & SLAs</h3>
                            </div>
                            <span class="status-badge" data-tone="warning">Lacuna Identificada</span>
                        </div>
                        <div class="bg-white p-2 rounded border mb-2 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Nível Esperado:</span>
                                <strong>4.0 / 5.0</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Nível Observado:</span>
                                <strong class="text-warning">3.1 / 5.0</strong>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-warning" role="progressbar" style="width: 62%;" aria-label="Progresso observado"></div>
                            </div>
                        </div>
                        <p class="small text-muted mb-2">
                            <b>Evidência:</b> Tempo de resposta a chamados críticos fora do prazo pactuado nos últimos 60 dias. Requer treinamento e revisão de fluxos.
                        </p>
                        <div class="text-end">
                            <a href="/People/DevelopmentPlans" class="small fw-semibold text-teal text-decoration-none">
                                Ver plano vinculado &rarr;
                            </a>
                        </div>
                    </article>
                </div>

                <!-- Exemplo 4 -->
                <div class="col-12 col-md-6">
                    <article class="p-3 border rounded-3 bg-light h-100 shadow-sm">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="eyebrow" style="font-size: 0.72rem;">Qualidade & Cliente</span>
                                <h3 class="h6 mb-0 text-dark fw-bold">Foco no Cliente & Excelência na Entrega</h3>
                            </div>
                            <span class="status-badge" data-tone="success">Revisão Humana ✓</span>
                        </div>
                        <div class="bg-white p-2 rounded border mb-2 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Nível Esperado:</span>
                                <strong>5.0 / 5.0</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Nível Observado:</span>
                                <strong class="text-teal">4.6 / 5.0</strong>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-teal" role="progressbar" style="width: 92%;" aria-label="Progresso observado"></div>
                            </div>
                        </div>
                        <p class="small text-muted mb-2">
                            <b>Evidência:</b> Avaliação de satisfação dos usuários finais com índice de 94% de conformidade com os entregáveis prometidos.
                        </p>
                        <div class="text-end">
                            <a href="/People/DevelopmentPlans" class="small fw-semibold text-teal text-decoration-none">
                                Ver plano vinculado &rarr;
                            </a>
                        </div>
                    </article>
                </div>
            </div>
        </section>
    }
    else
    {
        <div class="row g-3">
            @foreach (var x in compList)
            {
                <div class="col-12 col-md-6">
                    <article class="valora-card p-3 shadow-sm border h-100">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <span class="eyebrow" style="font-size: 0.72rem;">@x.SubjectType</span>
                                <h3 class="h6 mb-0 text-dark fw-bold">@x.Competency</h3>
                            </div>
                            <span class="status-badge" data-tone="@(x.HumanReviewed ? "success" : "warning")">
                                @(x.HumanReviewed ? "Revisão Confirmada" : "Pendente de Revisão")
                            </span>
                        </div>

                        <div class="bg-light p-2 rounded border my-2 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Nível Esperado:</span>
                                <strong>@x.ExpectedLevel.ToString("F1") / 5.0</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Nível Observado:</span>
                                <strong class="text-teal">@x.ObservedLevel.ToString("F1") / 5.0</strong>
                            </div>
                            @{
                                var pct = (int)(x.ObservedLevel * 20);
                            }
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-teal" role="progressbar" style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                        <p class="small text-muted mb-2">
                            <b>Evidência Verificável:</b> @x.EvidenceSummary
                        </p>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top small text-muted">
                            <span>Avaliado em @x.AssessedAt.ToString("dd/MM/yyyy")</span>
                            <a href="/People/DevelopmentPlans" class="valora-button valora-button--sm valora-button--ghost">
                                Criar Plano de Ação
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</main>
