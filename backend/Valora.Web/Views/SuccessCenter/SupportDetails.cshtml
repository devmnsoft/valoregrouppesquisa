@model Valora.Web.Models.ViewModels.SuccessCenter.SupportTicketDetailsViewModel
@{ViewData["Title"]=Model.Subject;Layout="_AdminLayout";}<div class="page-container success-center"><nav class="breadcrumb"><a href="/SuccessCenter/Support">Chamados</a><span>/</span><strong>@Model.Id</strong></nav><header class="page-header"><div><span class="eyebrow">CHAMADO @Model.Id</span><h1>@Model.Subject</h1><p><span class="badge bg-primary">@Model.Status</span> @Model.Category · prioridade @Model.Priority</p></div></header><section class="surface-card"><h2>Histórico completo</h2>@if(Model.Messages.Count==0){<div class="empty-state"><h3>Aguardando primeira interação</h3><p>Mensagens e mudanças de status aparecerão aqui, em ordem cronológica.</p></div>}</section></div>
