@model IReadOnlyList<Valora.Application.DecisionCenter.IntelligentAlertDto>
@{ ViewData["Title"]="Alertas Inteligentes"; }
<style>.dc-page{display:grid;gap:1.4rem}.dc-hero{padding:2rem;border-radius:24px;background:linear-gradient(135deg,#102b35,#174b57);color:#fff}.dc-hero p{max-width:760px;color:#d4e9e8}.dc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem}.dc-card{background:#fff;border:1px solid #dce7e7;border-radius:18px;padding:1.2rem;box-shadow:0 8px 24px #173e4910}.dc-kpi strong{font-size:2rem;display:block}.dc-badge{display:inline-flex;padding:.3rem .65rem;border-radius:999px;background:#e7f1f0;font-size:.78rem;font-weight:700}.critical{background:#fee2e2;color:#991b1b}.high,.regression{background:#ffedd5;color:#9a3412}.dc-list{display:grid;gap:.75rem}.dc-row{display:flex;justify-content:space-between;gap:1rem;padding:1rem;border:1px solid #e3ecec;border-radius:14px}.dc-actions{display:flex;gap:.5rem;flex-wrap:wrap}.dc-empty{text-align:center;padding:2.5rem;color:#567}.dc-table{width:100%;border-collapse:collapse}.dc-table th,.dc-table td{padding:.85rem;border-bottom:1px solid #e5eeee;text-align:left}@@media(max-width:700px){.dc-row{flex-direction:column}.dc-table{display:block;overflow:auto}}</style>
<main class="dc-page"><header class="dc-hero"><small>DECISION CENTER</small><h1>Alertas Inteligentes</h1><p>Cada alerta explicita sua evidência e limitação. Reconhecer ou resolver é sempre uma ação humana rastreável.</p></header><form method="get" class="dc-card dc-actions"><select name="severity"><option value="">Todas as severidades</option><option>critical</option><option>high</option><option>medium</option><option>low</option><option>info</option></select><select name="status"><option value="">Todos os status</option><option>open</option><option>acknowledged</option><option>in_progress</option><option>resolved</option><option>dismissed</option></select><button>Filtrar</button></form><section class="dc-card dc-list">@if(Model.Count==0){<div class="dc-empty"><h2>Nenhum alerta encontrado</h2><p>O Valora não gera alertas sem evidência verificável.</p></div>}else foreach(var x in Model){<article class="dc-row"><div><span class="dc-badge @x.Severity">@x.Severity</span> <span class="dc-badge">@x.Status</span><h2>@x.Title</h2><p>@x.Message</p><small><strong>Evidência:</strong> @x.EvidenceSummary</small></div><div class="dc-actions">@if(x.Status=="open"){<form method="post" action="/DecisionCenter/Alerts/@x.Id/Acknowledge">@Html.AntiForgeryToken()<button>Reconhecer</button></form>}@if(x.Status!="resolved"){<form method="post" action="/DecisionCenter/Alerts/@x.Id/Resolve">@Html.AntiForgeryToken()<button>Resolver</button></form>}<a href="/Decisions">Criar decisão</a></div></article>}</section></main>
