@{ ViewData["Title"] = "Saúde do Sistema"; }
<section class="valora-page" data-page="environment-status-page">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel("Saúde do Sistema", "Acompanhe a disponibilidade do ambiente sem expor credenciais ou detalhes técnicos sensíveis.", "Operação", "Verificação sob demanda", new[] { new PageHeaderAction("Atualizar status", "#refresh-health", Style: "primary", Icon: "activity") }))" />
  <div class="executive-grid" data-summary-cards>
    <article class="valora-card metric-card"><span>Web</span><strong data-card="web">Verificando…</strong><small>Interface e sessão</small></article>
    <article class="valora-card metric-card"><span>API</span><strong data-card="api">Verificando…</strong><small>Serviços de aplicação</small></article>
    <article class="valora-card metric-card"><span>PostgreSQL</span><strong data-card="database">Verificando…</strong><small>Persistência oficial</small></article>
    <article class="valora-card metric-card"><span>Configuração</span><strong data-card="config">Verificando…</strong><small>Dependências opcionais</small></article>
  </div>
  <div class="valora-alert valora-alert--warning mt-3" data-warning hidden></div>
  <div class="valora-alert valora-alert--danger mt-3" role="alert" data-error hidden></div>
  <article class="valora-card mt-3">
    <div class="v9-section-title"><div><p class="eyebrow">Dependências</p><h2>Última verificação operacional</h2><p class="text-muted" data-environment>Carregando ambiente…</p></div><button id="refresh-health" type="button" class="valora-button valora-button--ghost" data-refresh>Atualizar</button></div>
    <div class="table-responsive"><table class="valora-table table"><thead><tr><th>Componente</th><th>Status</th><th>Leitura segura</th><th>Referência</th></tr></thead><tbody data-items><tr><td colspan="4">Verificando dependências…</td></tr></tbody></table></div>
  </article>
  <div class="mt-3"><a class="valora-button valora-button--ghost" href="/Audit">Abrir Governança e Auditoria</a></div>
</section>
@section Scripts { <script src="/js/pages/environment-status-page.js" asp-append-version="true"></script> }
