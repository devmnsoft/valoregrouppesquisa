@model Valora.Web.Models.ViewModels.SaasAdminDashboardViewModel
@{ ViewData["Title"] = "Administração SaaS"; }
<main class="saas-console"><partial name="_PageHeader" model="@(new PageHeaderViewModel("Administração SaaS", "Clientes, planos, módulos e auditoria em uma visão global.", "Super Admin", null, new[] { new PageHeaderAction("Novo cliente", "/Admin/Clients/Create", null, "primary") }))" />
 <section class="saas-kpis"><article><span>Clientes cadastrados</span><strong>@Model.Customers.Count</strong><small>Contas comerciais</small></article><article><span>Módulos ativos</span><strong>@Model.Modules.Count</strong><small>Catálogo modular</small></article><article><span>Planos comerciais</span><strong>@Model.Plans.Count</strong><small>Ofertas publicadas</small></article></section>
 <section class="admin-action-grid"><a href="/Admin/Clients"><valora-icon name="building" decorative="true" /><strong>Clientes</strong><span>Planos, usuários e módulos por organização.</span></a><a href="/Admin/Modules"><valora-icon name="layers" decorative="true" /><strong>Módulos</strong><span>Catálogo, preços, rotas e contratação.</span></a><a href="/Admin/Plans"><valora-icon name="credit-card" decorative="true" /><strong>Planos</strong><span>Comparação e composição comercial.</span></a><a href="/Admin/Permissions"><valora-icon name="shield" decorative="true" /><strong>Permissões</strong><span>Catálogo único por funcionalidade.</span></a></section>
</main>
