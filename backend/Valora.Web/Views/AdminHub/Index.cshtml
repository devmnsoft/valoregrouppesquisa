@model Valora.Web.Models.ViewModels.AdminHubIndexViewModel
@{ ViewData["Title"] = "Valora Admin Hub™"; }
<section class="valora-page">
    <partial name="_PageHeader" model="@(new Valora.Web.Models.PageHeaderViewModel("Valora Admin Hub™", Model.ScopeLabel, "Admin Hub"))" />
    @if (TempData["AdminNotice"] is string adminNotice) { <div class="alert alert-success">@adminNotice</div> }
    @if (Model.Notice is not null) { <div class="alert alert-warning">@Model.Notice</div> }
    @if (Model.Cards.Count > 0) {
        <div class="admin-metrics">
            @foreach (var card in Model.Cards) {
                <article class="admin-metric">
                    <span>@card.Label</span>
                    <strong>@card.Value</strong>
                    <small>Consultado em tempo real</small>
                </article>
            }
        </div>
    }
    <div class="admin-module-grid mt-4">
        <a asp-action="Organizations"><strong>Organizações</strong><small>Plano, consumo e saúde</small></a>
        <a asp-action="Users"><strong>Usuários</strong><small>Pessoas, papéis e situação</small></a>
        <a asp-action="Roles"><strong>Papéis e permissões</strong><small>Catálogo por módulo</small></a>
        <a asp-action="Settings"><strong>Configurações</strong><small>Privacidade e uso</small></a>
        <a asp-action="Audit"><strong>Auditoria</strong><small>Histórico pesquisável</small></a>
    </div>
</section>
