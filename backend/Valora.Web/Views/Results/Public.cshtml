@{ Layout = "_PublicLayout"; ViewData["Title"] = "Resultado da avaliação"; }
<section class="section diagnostic-section" data-page="public-result"><div class="container-public"><input type="hidden" name="responseId" value="@ViewData["ResponseId"]"><p class="eyebrow">Resultado</p><h1>Resultado da avaliação</h1><p class="lead">Score, dimensões e recomendações são carregados pela API oficial com erro amigável em caso de indisponibilidade.</p><div class="result-card" data-result-card><div class="empty-state">Carregando resultado...</div></div><div class="cta-row"><button class="btn-public primary" type="button" data-send-result-email>Enviar por e-mail</button><a class="btn-public secondary" href="/certificado/@ViewData["ResponseId"]">Abrir certificado</a><a class="btn-public ghost" href="/whatsapp">Falar no WhatsApp</a></div></div></section>
@section Scripts { <script src="/js/public/public-result.js"></script> }
