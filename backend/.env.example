# Exemplos sem credenciais reais. No ASP.NET Core, __ representa ':'.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Postgres=Host=db.example;Port=5432;Database=valora;Username=valora_app;Password=CHANGE_ME;SSL Mode=Require
Jwt__Issuer=ValoraInsight
Jwt__Audience=ValoraInsight
# Obrigatório em produção: gere um segredo aleatório exclusivo (32+ caracteres). Nunca use a chave demo de Development.
Jwt__SigningKey=CHANGE_ME_WITH_AT_LEAST_32_CHARACTERS_FOR_PRODUCTION
App__PublicBaseUrl=https://app.example.com
App__AdminBaseUrl=https://app.example.com
App__EnvironmentName=Production
App__EnableDemoSeed=false
App__EnableDetailedErrors=false
App__MaintenanceModeEnabled=false
App__MaintenanceMessage=O sistema está em manutenção programada. Tente novamente mais tarde.
Api__BaseUrl=https://api.example.com
Build__Sha=release-sha
Email__Enabled=false
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
Email__Username=CHANGE_ME
Email__Password=CHANGE_ME
Email__From=no-reply@example.com
Storage__Provider=Local
Storage__BasePath=D:\\ValoraData\\storage
Certificates__PdfEnabled=false
Reports__PdfEnabled=false
Security__RequireHttps=true
Security__AllowedOrigins__0=https://app.example.com
Cors__AllowedOrigins__0=https://app.example.com
Integrations__PowerBiEnabled=false
Integrations__WebhooksEnabled=false
Backup__Configured=false
Backup__LastKnownAt=
VALORA_SEED_DEMO=false
