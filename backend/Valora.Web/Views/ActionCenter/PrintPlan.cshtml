@model Valora.Web.Controllers.ActionPlanPrintViewModel
@using Valora.Application.ActionCenter
@{
  Layout = null;
  var plan = Model.Plan;
  var zoneName = string.IsNullOrWhiteSpace(plan.OrganizationTimeZone) ? "UTC" : plan.OrganizationTimeZone;
  var zone = TimeZoneInfo.FindSystemTimeZoneById(zoneName);
  var issued = TimeZoneInfo.ConvertTime(Model.IssuedAt, zone);
  string EventLabel(string operation) => operation switch { "approve"=>"Plano aprovado", "start"=>"Execução iniciada", "complete"=>"Plano concluído", "cancel"=>"Plano cancelado", "return"=>"Plano devolvido", "submit"=>"Plano submetido", "assign"=>"Responsável alterado", "reschedule"=>"Prazo reagendado", "edit"=>"Conteúdo atualizado", "approval_invalidated"=>"Aprovação invalidada", _=>"Plano atualizado" };
  string OriginLabel(string origin) => origin switch { "manual"=>"Cadastro manual", "diagnostic"=>"Diagnóstico", "result"=>"Resultado", "ai_insight"=>"Insight revisado", "alert"=>"Alerta", "decision"=>"Decisão", _=>"Origem não identificada" };
}
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@(Model.Detailed?"Detalhamento":"Resumo executivo") — @plan.Title</title><link rel="stylesheet" href="~/css/action-plan-print.css" asp-append-version="true"></head>
<body>
<nav class="print-toolbar no-print" aria-label="Ações da visualização"><a class="button" asp-action="PlanDetails" asp-route-id="@plan.Id">Voltar ao plano</a><form method="get" asp-action="PrintPlan"><input type="hidden" name="id" value="@plan.Id"><label for="scope">Escopo permitido<select id="scope" name="scope"><option value="summary" selected="@(!Model.Detailed)">Resumo executivo</option><option value="detail" selected="@Model.Detailed">Detalhamento autorizado</option></select></label><button type="submit">Visualizar</button></form><button type="button" data-print-plan>Imprimir</button></nav>
<main class="print-document">
<header class="document-header"><div class="brand"><strong>Valora</strong><span>Insight™</span></div><div><p class="eyebrow">@(Model.Detailed?"Detalhamento autorizado":"Resumo executivo")</p><h1>@plan.Title</h1><p>@(plan.OrganizationName??"Organização não identificada nos dados disponíveis")</p></div></header>
<section class="report-notice"><strong>Conteúdo incluído:</strong> @(Model.Detailed?$"{Model.Activities.Items.Count} de {Model.Activities.Total} atividades e {Model.History.Items.Count} de {Model.History.Total} eventos autorizados.":"identificação, situação, resultados, síntese das atividades e eventos relevantes de encerramento.") @if(Model.Detailed&&(Model.Activities.Total>Model.ActivityLimit||Model.History.Total>Model.HistoryLimit)){<span>Esta visualização respeita os limites informados antes da geração: até @Model.ActivityLimit atividades e @Model.HistoryLimit eventos. Use a navegação do plano para consultar os demais registros.</span>}</section>
<section><h2>Identificação e situação</h2><dl class="facts"><div><dt>Situação</dt><dd>@ActionStatuses.Label(plan.Status)</dd></div><div><dt>Versão consultada</dt><dd>@plan.Version</dd></div><div><dt>Responsável</dt><dd>@(plan.OwnerName??"Não atribuído")</dd></div><div><dt>Origem</dt><dd>@OriginLabel(plan.OriginType)</dd></div><div><dt>Criação</dt><dd>@plan.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Prazo planejado</dt><dd>@(plan.DueAt?.ToString("dd/MM/yyyy")??"Não informado")</dd></div><div><dt>Início real</dt><dd>@(plan.ActualStartedAt?.ToString("dd/MM/yyyy HH:mm")??"Não registrado")</dd></div><div><dt>Encerramento</dt><dd>@(plan.CompletedAt?.ToString("dd/MM/yyyy HH:mm")??"Não registrado nos dados históricos")</dd></div><div><dt>Autoria do encerramento</dt><dd>@(plan.CompletedByName??"Autoria não recuperada nos dados históricos")</dd></div><div><dt>Emissão</dt><dd>@issued.ToString("dd/MM/yyyy HH:mm") (@zoneName)</dd></div></dl></section>
@if(plan.Status=="canceled"){<section class="cancellation"><h2>Cancelamento</h2><dl><dt>Motivo</dt><dd>@(string.IsNullOrWhiteSpace(plan.CancellationReason)?"Motivo não recuperado nos dados históricos.":plan.CancellationReason)</dd><dt>Autoria</dt><dd>@(plan.CompletedByName??"Autoria não recuperada nos dados históricos.")</dd></dl></section>}
<section><h2>Resultados e evidências</h2><h3>Resultado esperado</h3><p class="long-text">@plan.ExpectedOutcome</p><h3>Resultado alcançado</h3><p class="long-text">@(plan.Status=="canceled"?"O plano foi cancelado; não há resultado de execução a declarar.":string.IsNullOrWhiteSpace(plan.CompletionResult)?"Resultado de conclusão não recuperado nos dados históricos.":plan.CompletionResult)</p><h3>Evidência de conclusão</h3><p class="long-text">@(plan.Status=="canceled"?"Não aplicável ao encerramento por cancelamento.":string.IsNullOrWhiteSpace(plan.CompletionEvidence)?"Evidência de conclusão não recuperada nos dados históricos.":plan.CompletionEvidence)</p><details class="source-evidence"><summary>Evidência de origem</summary><p class="long-text">@(string.IsNullOrWhiteSpace(plan.EvidenceSummary)?"Não informada.":plan.EvidenceSummary)</p></details></section>
<section><h2>Síntese das atividades</h2><dl class="facts"><div><dt>Total autorizado</dt><dd>@Model.Activities.Total</dd></div><div><dt>Progresso consolidado</dt><dd>@plan.ProgressPercent%</dd></div><div><dt>Atividades ainda abertas</dt><dd>@plan.ActiveItemCount</dd></div></dl></section>
@if(Model.Detailed){<section><h2>Atividades autorizadas</h2>@if(Model.Activities.Items.Count==0){<p>Nenhuma atividade autorizada foi encontrada.</p>}else{<div class="table-wrap"><table><thead><tr><th>Atividade</th><th>Situação</th><th>Responsável</th><th>Prazo</th><th>Resultado</th></tr></thead><tbody>@foreach(var item in Model.Activities.Items){<tr><td class="long-text">@item.Title</td><td>@ActionStatuses.Label(item.Status)</td><td>@(item.ResponsibleName??"Não atribuído")</td><td>@(item.DueAt?.ToString("dd/MM/yyyy")??"Não informado")</td><td class="long-text">@(string.IsNullOrWhiteSpace(item.CompletionResult)?"Não registrado":item.CompletionResult)</td></tr>}</tbody></table></div>}</section>}
<section><h2>@(Model.Detailed?"Histórico autorizado":"Eventos relevantes do encerramento")</h2>@if(Model.History.Items.Count==0){<p>Nenhum evento correspondente foi recuperado.</p>}else{<div class="table-wrap"><table><thead><tr><th>Data</th><th>Evento</th><th>Autoria</th><th>Justificativa</th></tr></thead><tbody>@foreach(var item in Model.History.Items){<tr><td>@item.ChangedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@EventLabel(item.Operation)</td><td>@(item.AuthorName??"Autoria não identificada")</td><td class="long-text">@(string.IsNullOrWhiteSpace(item.Reason)?"Sem justificativa adicional":item.Reason)</td></tr>}</tbody></table></div>}</section>
<footer>Valora Insight™ · Documento emitido para consulta autorizada · Versão @plan.Version</footer>
</main><script src="~/js/action-plan-print.js" asp-append-version="true" defer></script></body></html>
