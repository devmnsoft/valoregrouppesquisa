@{ Layout = "_PublicLayout"; ViewData["Title"] = "Contato"; }
<section class="section" data-page="public-contact"><div class="container-public two-col"><div><p class="eyebrow">Contato</p><h1>Fale com a Valora Group</h1><p class="lead">Solicite atendimento comercial sobre diagnóstico, governança, controller ou advisory.</p><form class="form-public" data-contact-form><input name="name" placeholder="Nome" required><input name="email" type="email" placeholder="E-mail corporativo" required><textarea name="message" placeholder="Como podemos ajudar?" required></textarea><button class="btn-public primary" type="submit">Enviar solicitação</button></form></div><div class="public-card"><h2>Atendimento consultivo</h2><p>Também estamos disponíveis pelo CTA de WhatsApp.</p><a class="btn-public ghost" href="/whatsapp">Abrir WhatsApp</a></div></div></section>
