@{ ViewData["Title"] = "Central de Acessos"; }
<section class="page-card access-center" data-page="users-page">
<header class="module-heading"><div><p class="eyebrow">Administração · Segurança</p><h1>Central de Acessos</h1><p class="text-muted">Gerencie pessoas, papéis e acesso efetivo da organização.</p></div><button class="btn btn-primary" data-new-role>Novo papel</button></header>
<div class="alert alert-danger d-none" role="alert" data-error></div>
<nav class="nav nav-tabs access-tabs" aria-label="Áreas da Central de Acessos">
<button class="nav-link active" data-bs-toggle="tab" data-bs-target="#users-list">Usuários</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#roles-list">Papéis</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#permissions-list">Permissões</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#invitations-list">Convites</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#sessions-list">Sessões</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#scopes-list">Escopos</button>
</nav>
<div class="tab-content py-4">
<div class="tab-pane show active" id="users-list"><form data-filters class="access-filters"><input class="form-control" name="search" aria-label="Buscar usuários" placeholder="Buscar por nome ou e-mail"><select class="form-select" name="status" aria-label="Filtrar status"><option value="">Todos os status</option><option value="active">Ativos</option><option value="inactive">Inativos</option></select><button class="btn btn-outline-primary">Filtrar</button></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Usuário</th><th>Papéis</th><th>Status</th><th>Último acesso</th></tr></thead><tbody data-users></tbody></table></div></div>
<div class="tab-pane" id="roles-list"><div class="access-toolbar"><input class="form-control" data-role-search placeholder="Pesquisar papel"><select class="form-select" data-role-type><option value="">Todos</option><option value="system">Sistema</option><option value="custom">Personalizados</option></select></div><div class="access-role-list" data-roles></div></div>
<div class="tab-pane" id="permissions-list"><p class="text-muted">Catálogo oficial agrupado por módulo. O nível de impacto ajuda a revisar alterações críticas.</p><div class="permission-matrix" data-permission-matrix></div></div>
<div class="tab-pane" id="invitations-list"><div data-invitations></div></div>
<div class="tab-pane" id="sessions-list"><p class="text-muted">Sessões são revogadas automaticamente quando um papel perde permissões.</p></div>
<div class="tab-pane" id="scopes-list"><p class="text-muted">Escopos limitam o acesso a grupos, empresas, unidades e setores da organização.</p></div>
</div></section>
<dialog class="access-dialog" data-role-dialog><form method="dialog" data-role-form><header><div><p class="eyebrow">Papel personalizado</p><h2 data-dialog-title>Novo papel</h2></div><button class="btn-close" value="cancel" aria-label="Fechar"></button></header><label>Nome<input class="form-control" name="name" required maxlength="100"></label><label>Código<input class="form-control" name="code" required pattern="[a-z0-9_]+" maxlength="60"></label><label>Descrição<textarea class="form-control" name="description" rows="2"></textarea></label><div class="permission-matrix editor" data-role-permissions></div><div class="access-actions"><button class="btn btn-outline-secondary" value="cancel">Cancelar</button><button class="btn btn-primary" value="default" data-save-role>Salvar papel</button></div></form></dialog>
@section Scripts { <script src="/js/pages/users-page.js"></script> }
