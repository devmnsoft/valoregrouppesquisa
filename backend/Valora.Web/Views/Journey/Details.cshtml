@model Valora.Application.Journey.JourneyEventDto@{ViewData["Title"]=Model.Title;}<main class="valora-page"><header class="leadership-hero"><div><p class="eyebrow">@Model.EventType · @Model.OccurredAt.ToString("dd/MM/yyyy")</p><h1>@Model.Title</h1><p>@Model.Description</p></div></header><section class="leadership-grid"><article class="valora-card"><h2>Evidência resumida</h2><p>@Model.EvidenceSummary</p></article><article class="valora-card"><h2>Vínculos</h2><p><strong>Origem:</strong> @Model.SourceType</p><p><strong>Impacto:</strong> @Model.ImpactLevel</p><p><strong>Dimensão:</strong> @(Model.RelatedDimension??"Não informada")</p><p><strong>Índice:</strong> @(Model.RelatedIndexCode??"Não informado")</p></article></section></main>
