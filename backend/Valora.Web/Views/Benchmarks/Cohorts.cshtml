@model Valora.Web.Models.ViewModels.BenchmarksViewModel
@{Layout="_Layout";}<partial name="_BenchmarkShell" model="Model" /><div class="bm-grid" style="margin-top:16px"><article class="bm-card"><h2>Coortes configuradas</h2>@foreach(var x in Model.Cohorts){<p><strong>@x.Name</strong><br/>@x.Segment · @x.CompanySizeRange · @x.Region<br/><span class="bm-badge">mín. @x.MinimumSampleSize · @x.MemberCount membros protegidos</span></p>}</article><form class="bm-card" asp-action="CreateCohort" method="post">@Html.AntiForgeryToken()<h2>Nova coorte segura</h2><label>Nome<input name="Name" required maxlength="160" /></label><label>Descrição<textarea name="Description" maxlength="1000"></textarea></label><label>Segmento<input name="Segment" required /></label><label>Indústria<input name="Industry" required /></label><label>Porte<select name="CompanySizeRange" required><option>Micro e pequena</option><option>Média</option><option>Grande</option></select></label><label>Região<input name="Region" required /></label><label>Amostra mínima<input name="MinimumSampleSize" type="number" min="5" value="5" required /></label><button>Criar coorte</button></form></div>
