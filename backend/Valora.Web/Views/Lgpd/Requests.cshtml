@{ Layout = "_PublicLayout"; ViewData["Title"] = "Solicitação LGPD"; }
<section class="section" data-page="public-lgpd-request"><div class="container-public"><p class="eyebrow">Solicitação LGPD</p><h1>Exerça seus direitos</h1><form class="form-public" data-lgpd-form><input name="name" placeholder="Nome" required><input name="email" type="email" placeholder="E-mail" required><select name="requestType"><option>Acesso</option><option>Correção</option><option>Exclusão</option></select><textarea name="message" placeholder="Detalhes da solicitação"></textarea><button class="btn-public primary" type="submit">Enviar solicitação</button></form></div></section>
@section Scripts { <script src="/js/public/public-lgpd.js"></script> }
