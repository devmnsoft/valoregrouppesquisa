@model Valora.Web.Models.ViewModels.PeopleViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sinais de Engajamento";
    var signals = Model.Dashboard.Engagement;
}

<main class="valora-page people-engagement-page" data-people-engagement>
    <partial name="_PageHeader" model="@(new PageHeaderViewModel(
        "Sinais de Engajamento & Clima",
        "Monitoramento contínuo de sinais agregados de participação, retenção e satisfação nas equipes.",
        "People & Clima",
        $"{signals.Count} sinal(is) detectado(s)",
        new[] {
            new PageHeaderAction("Novo diagnóstico", "/Diagnostics/New", Style: "primary", Icon: "plus"),
            new PageHeaderAction("Planos de ação", "/ActionCenter", Icon: "check-circle")
        }))" />

    <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel(
        "Como interpretar sinais de engajamento",
        "Sinais de engajamento decorrem de padrões observados em pesquisas e check-ins periódicos. Um sinal isolado nunca constitui conclusão definitiva; tendências exigem confirmação em múltiplos ciclos.",
        new[] {
            "Sinais agregados: protegem o sigilo de respostas individuais e focam na saúde dos times.",
            "Nível de confiança: indica a consistência estatística dos dados levantados.",
            "Ação preventiva: orienta intervenções de liderança antes do surgimento de desgastes ou rotatividade."
        }))" />

    <partial name="_PeopleShell" model="Model" />

    @if (signals.Count < 2)
    {
        <!-- Demonstração Metodológica com Dados Reais de Exemplo -->
        <section class="valora-card mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <span class="badge bg-info text-dark mb-1">Demonstração Metodológica</span>
                    <h2 class="h5 mb-0 text-dark fw-bold">Padrões de Sinais de Engajamento Valora™</h2>
                    <p class="text-muted small mb-0">
                        Como os sinais preventivos de clima e adesão são monitorados:
                    </p>
                </div>
                <a href="/Surveys" class="valora-button valora-button--primary">
                    <valora-icon name="activity" size="14" decorative="true" /> Iniciar Ciclo de Pesquisa
                </a>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <article class="p-3 border rounded-3 bg-light shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="h6 mb-0 text-dark fw-bold">Sinal Positivo: Alta Adesão a Feedbacks 1-on-1</h3>
                            <span class="status-badge" data-tone="success">Confiança Alta</span>
                        </div>
                        <div class="bg-white p-2 rounded border mb-2 small">
                            <div class="d-flex justify-content-between text-muted mb-1">
                                <span>Fonte: <strong>Check-ins Quinzenais</strong></span>
                                <span>Score Médio: <strong>88%</strong></span>
                            </div>
                        </div>
                        <p class="small text-muted mb-1">
                            <b>Evidência:</b> 92% dos colaboradores participaram regularmente de alinhamentos com suas lideranças imediatas nas últimas 6 semanas.
                        </p>
                        <p class="small text-muted mb-0">
                            <b>Limitação:</b> Dados baseados em confirmações de agenda sem análise de sentimento qualitativo de texto.
                        </p>
                    </article>
                </div>

                <div class="col-12 col-md-6">
                    <article class="p-3 border rounded-3 bg-light shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="h6 mb-0 text-dark fw-bold">Sinal de Atenção: Sobrecarga em Período de Entrega</h3>
                            <span class="status-badge" data-tone="warning">Confiança Moderada</span>
                        </div>
                        <div class="bg-white p-2 rounded border mb-2 small">
                            <div class="d-flex justify-content-between text-muted mb-1">
                                <span>Fonte: <strong>Pesquisa Pulso de Saúde</strong></span>
                                <span>Score Médio: <strong>58%</strong></span>
                            </div>
                        </div>
                        <p class="small text-muted mb-1">
                            <b>Evidência:</b> Queda de 14 pontos na percepção de equilíbrio vida-trabalho na área operacional durante o fechamento trimestral.
                        </p>
                        <p class="small text-muted mb-0">
                            <b>Recomendação:</b> Revisar capacidade produtiva e planejar redistribuição de demandas no Action Center.
                        </p>
                    </article>
                </div>
            </div>
        </section>
    }
    else
    {
        <div class="row g-3">
            @foreach (var x in signals)
            {
                <div class="col-12 col-md-6">
                    <article class="valora-card p-3 shadow-sm border h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="h6 mb-0 text-dark fw-bold">Sinal de @x.Source</h3>
                            <span class="status-badge" data-tone="@(x.Confidence is "high" ? "success" : "warning")">
                                Confiança @x.Confidence
                            </span>
                        </div>
                        <p class="small text-muted mb-2">@x.EvidenceSummary</p>
                        @if (!string.IsNullOrWhiteSpace(x.Limitations))
                        {
                            <p class="small text-secondary mb-0"><b>Limitação:</b> @x.Limitations</p>
                        }
                    </article>
                </div>
            }
        </div>
    }
</main>
