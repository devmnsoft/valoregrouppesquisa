<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@ViewData["Title"] - Valora Group</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%230c3448'/%3E%3Ctext x='32' y='37' font-size='13' text-anchor='middle' fill='%2375dce8' font-family='Arial'%3EValora%3C/text%3E%3C/svg%3E">
  <link rel="icon" type="image/svg+xml" href="/img/brand/valora-symbol.svg">
  <meta name="theme-color" content="#0c3448">
  <meta name="description" content="Valora Group apresenta Valora Insight™: plataforma de Inteligência Organizacional que transforma evidências em decisão e plano de evolução.">
  <meta property="og:title" content="@ViewData["Title"] — Valora Insight™">
  <meta property="og:description" content="Plataforma de inteligência organizacional para diagnóstico, maturidade e decisão baseada em evidências.">
  <meta property="og:type" content="website">
  <link href="~/lib/bootstrap/bootstrap.min.css" rel="stylesheet" asp-append-version="true">
  <link rel="stylesheet" href="~/css/design-system/tokens.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/valora-design-system.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/valora-public.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/valora-print.css" media="print" asp-append-version="true">
</head>
<body class="public-body">
  <a class="skip-link" href="#app">Ir para o conteúdo principal</a>
  @await Html.PartialAsync("Public/_PublicTopbar")
  <main id="app" class="public-main" tabindex="-1">@RenderBody()</main>
  @await Html.PartialAsync("Public/_PublicFooter")
  @await Html.PartialAsync("Public/_PublicModalLayer")
  @await Html.PartialAsync("Public/_PublicToastZone")
  @await Html.PartialAsync("Public/_PublicBotPanel")
  @await Html.PartialAsync("Public/_PublicFloatingActions")
    <script src="/lib/bootstrap/bootstrap.bundle.min.js"></script>
  <script src="/web-config.js"></script>
  <script src="/js/config.js"></script>
  <script src="/js/api/ajax-client.js"></script>
  <script src="/js/api/public-survey-api.js"></script>
  <script src="/js/api/results-api.js"></script>
  <script src="/js/api/certificates-api.js"></script>
  <script src="/js/api/free-diagnostics-api.js"></script>
  <script src="/js/api/communications-api.js"></script>
  <script src="/js/public/valora-date.js"></script>
  <script src="/js/public/valora-public.js"></script>
  <script src="/js/public/valorabot.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
