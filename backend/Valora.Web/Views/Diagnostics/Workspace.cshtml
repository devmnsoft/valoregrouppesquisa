@section Styles {
    <link rel="stylesheet" href="~/css/diagnostic-workspace.css" asp-append-version="true" />
}
@{
    ViewData["Title"]="Workspace do Diagnóstico";
    var diagnosticId=(Guid)ViewData["DiagnosticId"]!;
    var isReadOnly = User.Claims.Any(c => (c.Type is System.Security.Claims.ClaimTypes.Role or "role") && c.Value.Equals("visualizador_somente_leitura", StringComparison.OrdinalIgnoreCase));
}
<main class="valora-page intelligence-workspace" data-page="diagnostic-workspace" data-diagnostic-id="@diagnosticId" data-read-only="@(isReadOnly ? "true" : "false")">
@Html.AntiForgeryToken()
<nav><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Surveys">Diagnósticos</a></li><li class="breadcrumb-item active">Workspace</li></ol></nav>
<section class="workspace-hero">
  <div>
    <span class="eyebrow">Ciclo diagnóstico</span>
    <h1 data-title>Workspace do Diagnóstico</h1>
    <p data-description>Carregando o contexto do ciclo…</p>
    <div class="d-flex align-items-center gap-2 mt-2">
      <span class="valora-status" data-status>—</span>
      <span class="valora-status" data-confidence>Confiança —</span>
    </div>
  </div>
  <div class="d-flex flex-wrap gap-2 align-items-center">
    <button class="btn btn-primary" data-command="process">Processar Inteligência Valora™</button>
    <button class="btn btn-outline-secondary" data-command="report/preview">Gerar Executive Report™</button>
    <button class="btn btn-outline-danger" data-command="close">Encerrar Ciclo</button>
  </div>
</section>
<div class="alert alert-danger d-none" data-error></div><div class="alert alert-info d-none" data-message></div>
<section class="metric-grid"><article class="metric-card"><span>Respostas</span><strong data-value="responses">—</strong><small>participações concluídas</small></article><article class="metric-card"><span>Evidências</span><strong data-value="evidence">—</strong><small>itens rastreáveis</small></article><article class="metric-card"><span>Cobertura</span><strong data-value="coverage">—</strong><small>mapeamento metodológico</small></article><article class="metric-card"><span>Processamento</span><strong data-value="processing">—</strong><small>último job do ciclo</small></article></section>
<nav class="workspace-tabs workspace-tabs-bar" data-tabs aria-label="Navegação da Jornada Diagnóstica">
  <div class="workspace-tab-cluster" data-cluster="coleta">
    <div class="cluster-heading"><span class="cluster-num">1</span> <span class="cluster-title">Coleta & Campo</span></div>
    <div class="cluster-actions">
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="overview">Visão Geral</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="preparation">Preparação</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="campaign">Campanha & Links</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="participation">Participação</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="responses">Respostas</button>
    </div>
  </div>
  <div class="workspace-tab-cluster" data-cluster="inteligencia">
    <div class="cluster-heading"><span class="cluster-num">2</span> <span class="cluster-title">Inteligência & Evidências</span></div>
    <div class="cluster-actions">
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="evidence">Evidências</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="insights">Achados & Revisão</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="metrics">Métricas</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="indices">Índices</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="inferences">Inferências</button>
    </div>
  </div>
  <div class="workspace-tab-cluster" data-cluster="visual">
    <div class="cluster-heading"><span class="cluster-num">3</span> <span class="cluster-title">Visual & Benchmarks</span></div>
    <div class="cluster-actions">
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="heatmap">Heatmap™</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="radar">Radar™</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="benchmark">Benchmark™</button>
    </div>
  </div>
  <div class="workspace-tab-cluster" data-cluster="acao">
    <div class="cluster-heading"><span class="cluster-num">4</span> <span class="cluster-title">Ação & Evolução</span></div>
    <div class="cluster-actions">
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="actions">Action™ (Planos)</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="evolution">Evolution™ (Reavaliação)</button>
    </div>
  </div>
  <div class="workspace-tab-cluster" data-cluster="entregaveis">
    <div class="cluster-heading"><span class="cluster-num">5</span> <span class="cluster-title">Entregáveis & Governança</span></div>
    <div class="cluster-actions">
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="report">Executive Report™</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="certificates">Certificados</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="exports">Exportações</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-tab="shares">Compartilhamentos</button>
    </div>
  </div>
</nav>
<section class="workspace-section mt-3" aria-live="polite"><div class="survey-skeleton" data-loading><span></span><span></span><span></span></div><div data-content></div></section>
</main>
@section Scripts{<script src="~/js/pages/diagnostic-workspace.js" asp-append-version="true"></script>}

