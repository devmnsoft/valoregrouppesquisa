@model Valora.Web.Models.ViewModels.AdminOrganizationsViewModel
@{ ViewData["Title"]="Organizações"; }
<section class="valora-page"><partial name="_PageHeader" model="@(new Valora.Web.Models.PageHeaderViewModel("Organizações", "Planos, consumo e saúde de cada tenant.", "Admin Hub"))" />
<form method="get" class="admin-panel mb-3"><label for="search">Pesquisar por nome</label><input id="search" name="search" value="@Model.Search" class="form-control" /><button class="btn btn-outline-primary mt-2">Filtrar</button> <a asp-action="CreateOrganization" class="btn btn-primary mt-2">Nova organização</a></form>
<div class="admin-panel">@if(Model.Organizations.Count==0){<div class="admin-empty"><strong>Nenhuma organização encontrada.</strong><p>Crie a primeira organização para começar.</p></div>}else{<table class="table"><thead><tr><th>Organização</th><th>Plano</th><th>Status</th><th>Uso</th></tr></thead><tbody>@foreach(var item in Model.Organizations){<tr><td><a asp-action="OrganizationDetails" asp-route-id="@item.Id">@item.Name</a></td><td>@item.Plan</td><td><span class="badge text-bg-success">@item.Status</span></td><td>@item.Users usuários · @item.Units unidades</td></tr>}</tbody></table>}</div></section>
