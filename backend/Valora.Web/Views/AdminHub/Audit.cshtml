@model Valora.Web.Models.ViewModels.AdminAuditViewModel
@{ ViewData["Title"]="Auditoria"; }
<section class="valora-page"><partial name="_PageHeader" model="@(new Valora.Web.Models.PageHeaderViewModel("Auditoria", "Eventos administrativos pesquisáveis e isolados por tenant.", "Admin Hub"))" /><form method="get" class="admin-panel row g-3"><div class="col-md-6"><label for="search">Ação, usuário ou entidade</label><input id="search" name="search" value="@Model.Search" class="form-control"/></div><div class="col-md-3"><label for="from">De</label><input id="from" name="from" type="date" class="form-control"/></div><div class="col-md-3"><label for="to">Até</label><input id="to" name="to" type="date" class="form-control"/></div><div><button class="btn btn-primary">Pesquisar</button></div></form><div class="admin-empty mt-3"><strong>Nenhum evento no período.</strong></div></section>
