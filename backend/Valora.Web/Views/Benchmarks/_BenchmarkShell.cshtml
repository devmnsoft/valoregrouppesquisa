@model Valora.Web.Models.ViewModels.BenchmarksViewModel
@{ var current=Model.Current; }
<style>.bm{background:linear-gradient(135deg,#071d2b,#123b46);color:#eaf8f5;border-radius:24px;padding:28px}.bm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px}.bm-card{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:20px}.bm-nav{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.bm-nav a{padding:9px 14px;border-radius:999px;background:#e9f3f1;color:#17443e;text-decoration:none}.bm-badge{background:#b9f5d8;color:#123d31;padding:5px 10px;border-radius:999px;font-size:.8rem}.bm-warning{background:#fff4d6;color:#694d00;padding:14px;border-radius:14px;margin:14px 0}.bm table{width:100%;border-collapse:collapse}.bm th,.bm td{text-align:left;padding:12px;border-bottom:1px solid #ffffff20}.bm input,.bm select,.bm textarea{width:100%;padding:10px;border-radius:10px;border:1px solid #9cb5b1;margin:5px 0 12px}.bm button{background:#42d39b;border:0;border-radius:12px;padding:11px 18px;font-weight:700}.radar{height:12px;border-radius:10px;background:linear-gradient(90deg,#43d19e var(--score),#ffffff24 var(--score))}@media(max-width:640px){.bm{padding:18px}.bm table{display:block;overflow:auto}}</style>
<section class="bm"><header><small>VALORA INSIGHT™</small><h1>Benchmark & Comparative Intelligence Center</h1><p>Comparações reais, agregadas e auditáveis — nenhuma organização externa é identificada.</p></header>
<nav class="bm-nav"><a asp-action="Index">Painel</a><a asp-action="Compare">Compare</a><a asp-action="Cohorts">Coortes</a><a asp-action="Insights">Insights</a><a asp-action="Privacy">Privacidade</a></nav>
@if(TempData["BenchmarkError"] is string e){<div class="bm-warning">@e</div>} @if(TempData["BenchmarkMessage"] is string m){<div class="bm-warning">@m</div>}
<div class="bm-grid"><article class="bm-card"><small>Maturidade real mais recente</small><h2>@(current is null?"Sem base":$"{current.MaturityScore:N1}/100")</h2><span class="bm-badge">Confiança: @(current?.ConfidenceLevel??"indisponível")</span></article><article class="bm-card"><small>Amostra observada</small><h2>@(current?.SampleSize??0)</h2><span class="bm-badge">k mínimo: @Math.Max(Model.Privacy.MinimumSampleSize,Model.Privacy.KAnonymity)</span></article><article class="bm-card"><small>Percentil</small><h2>Não calculado</h2><p>Exibido somente quando a base anônima for suficiente.</p></article></div>
@if(current is null||current.SampleSize<Math.Max(Model.Privacy.MinimumSampleSize,Model.Privacy.KAnonymity)){<div class="bm-warning"><strong>Amostra insuficiente.</strong> O benchmark e o percentil permanecem ocultos para impedir reidentificação.</div>}
</section>
