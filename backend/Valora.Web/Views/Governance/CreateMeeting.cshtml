@{ ViewData["Title"]="Cadastrar reunião"; }

<main class="dc-page"><header class="dc-hero"><h1>Cadastrar reunião de governança</h1><p>Registre pauta, evidências e próximos passos com clareza.</p></header><form method="post" class="dc-card dc-list">@Html.AntiForgeryToken()<label>Título<input class="form-control" name="Title" required></label><label>Pauta<textarea class="form-control" name="Agenda" required></textarea></label><label>Data e hora<input class="form-control" type="datetime-local" name="ScheduledAt" required></label><label>Participantes<textarea class="form-control" name="ParticipantsSummary"></textarea></label><label>Evidências discutidas<textarea class="form-control" name="EvidenceSummary"></textarea></label><label>Próximos passos<textarea class="form-control" name="NextSteps"></textarea></label><button class="btn btn-primary">Registrar reunião</button></form></main>
