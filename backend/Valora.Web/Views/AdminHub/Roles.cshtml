@model Valora.Web.Models.ViewModels.AdminRolesViewModel
@{ ViewData["Title"]="Papéis e permissões"; }
<section class="valora-page"><partial name="_PageHeader" model="@(new Valora.Web.Models.PageHeaderViewModel("Papéis e permissões", "Atribuição pelo catálogo canônico, sem duplicatas.", "Admin Hub"))" /><article class="admin-panel"><h2>Permissões disponíveis</h2><div class="row">@foreach(var permission in Model.CanonicalPermissions){<div class="col-md-4"><label class="form-check"><input type="checkbox" class="form-check-input" name="permissions" value="@permission"/><span class="form-check-label">@permission</span></label></div>}</div></article></section>
