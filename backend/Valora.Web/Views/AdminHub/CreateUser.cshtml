@model Valora.Web.Models.ViewModels.CreateAdminUserViewModel
@{ ViewData["Title"]="Criar usuário"; }
<section class="valora-page"><partial name="_PageHeader" model="@(new Valora.Web.Models.PageHeaderViewModel("Criar usuário", "Selecione os vínculos — nenhum ID técnico precisa ser digitado.", "Admin Hub"))" /><form method="post" class="admin-panel"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Name">Nome</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name"></span></div><div class="col-md-6"><label asp-for="Email">E-mail</label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email"></span></div><div class="col-md-4"><label asp-for="OrganizationId">Organização</label><select asp-for="OrganizationId" asp-items="Model.Organizations" class="form-select"><option value="">Selecione…</option></select><span asp-validation-for="OrganizationId"></span></div><div class="col-md-4"><label asp-for="UnitId">Unidade</label><select asp-for="UnitId" asp-items="Model.Units" class="form-select"><option value="">Sem unidade</option></select></div><div class="col-md-4"><label asp-for="RoleId">Papel</label><select asp-for="RoleId" asp-items="Model.Roles" class="form-select"><option value="">Selecione…</option></select><span asp-validation-for="RoleId"></span></div></div><button class="btn btn-primary mt-4">Criar usuário</button></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
