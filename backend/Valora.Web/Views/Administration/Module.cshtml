@using Valora.Web.Models
@{ var module = (string?)ViewData["Module"] ?? "administration"; }
<section class="valora-page page-card official-module" data-page="administration-module" data-module="@module" data-endpoint="@ViewData["Endpoint"]">
  <partial name="_PageHeader" model="@(new PageHeaderViewModel((string)ViewData["Title"]!, (string)ViewData["Subtitle"]!, "Administração", Actions: new[] { new PageHeaderAction("Atualizar", DataAction: "refresh", Style: "primary", Icon: "refresh") }))" />
  <div class="admin-health" role="status"><span class="admin-health-dot"></span><div><strong>Módulo monitorado</strong><small>Permissão necessária: @ViewData["Permission"]</small></div><span>Escopo global seguro</span></div>
  <div class="row g-3 mt-2" data-summary>
    <div class="col-md-4"><div class="metric-card"><span>Registros encontrados</span><strong data-total>0</strong><small>Dados reais disponíveis</small></div></div>
    <div class="col-md-4"><div class="metric-card"><span>Escopo</span><strong>Plataforma</strong><small>Isolamento por tenant aplicado</small></div></div>
    <div class="col-md-4"><div class="metric-card"><span>Rastreabilidade</span><strong>Ativa</strong><small>Correlation ID e auditoria</small></div></div>
  </div>
  <div class="alert alert-danger d-none mt-3" role="alert" data-error></div>
  <div class="table-responsive mt-3">
    <table class="table table-sm align-middle"><thead><tr><th>Tipo</th><th>Descrição</th><th>Status</th><th>Data</th></tr></thead><tbody data-items><tr><td colspan="4">Carregando…</td></tr></tbody></table>
  </div>
  <div class="empty-state d-none" data-empty><strong>Pronto para o primeiro registro.</strong><p>Não há dados neste filtro. Configure o módulo ou atualize os filtros; novos eventos aparecerão aqui com tenant e permissões respeitados.</p><button type="button" class="btn btn-primary" data-action="refresh">Atualizar dados</button></div>
</section>
@section Scripts { <script src="/js/pages/administration-module.js" asp-append-version="true"></script> }
