@model Valora.Web.Controllers.InsightListPageViewModel
@using Valora.Application.ValoraAi
@using Valora.Application.Access
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@{ ViewData["Title"]="Insights"; var page=Model.Result.Page; var canReview=(await Authorization.AuthorizeAsync(User,ValoraPermissions.Insights.Approve)).Succeeded||(await Authorization.AuthorizeAsync(User,ValoraPermissions.Insights.Reject)).Succeeded; }
<main class="valora-page v9-page">
 <partial name="_PageHeader" model="@(new PageHeaderViewModel("Insights Valora IA™","Fila operacional para analisar evidências, registrar revisão humana e acompanhar iniciativas.","Intelligence Hub",$"{page.Total} registro(s)",new[]{new PageHeaderAction("Gerar análise","/Intelligence/Generate",Style:"primary",Icon:"sparkles")}))" />
 <section class="valora-card" aria-labelledby="queue-help"><h2 id="queue-help">Para que serve</h2><p>Priorize leituras sustentadas por evidências. Aprovação editorial não comprova causalidade e recomendação não equivale a decisão executiva.</p><details><summary>Como usar</summary><p>Filtre a fila, abra o detalhe, confira limitações e evidências, revise quando autorizado e crie planos rastreáveis.</p></details></section>
 <section class="v9-executive-grid" aria-label="Indicadores da fila"><article class="valora-card"><strong>@Model.Result.Indicators.PendingReview</strong><span>Pendentes de revisão</span></article><article class="valora-card"><strong>@Model.Result.Indicators.ApprovedWithoutPlan</strong><span>Aprovados sem plano</span></article><article class="valora-card"><strong>@Model.Result.Indicators.WithPlansInExecution</strong><span>Com planos em execução</span></article><article class="valora-card"><strong>@Model.Result.Indicators.WithAllPlansClosed</strong><span>Com todos os planos encerrados</span></article></section>
 <form method="get" class="valora-card action-form" aria-label="Filtros de insights"><fieldset><legend>Buscar e filtrar</legend><div class="action-form-grid"><label class="action-field--full">Título ou resumo<input name="Search" value="@Model.Query.Search" type="search" /></label><label>Situação<select name="Status"><option value="">Todas</option>@foreach(var option in new[]{("pending_review","Pendente de revisão"),("approved","Aprovado"),("converted_to_action","Encaminhado para execução"),("rejected","Rejeitado"),("archived","Arquivado")}){<option value="@option.Item1" selected="@(Model.Query.Status==option.Item1)">@option.Item2</option>}</select></label><label>Prioridade<select name="Priority"><option value="">Todas</option>@foreach(var option in new[]{("critical","Crítica"),("high","Alta"),("medium","Média"),("low","Baixa")}){<option value="@option.Item1" selected="@(Model.Query.Priority==option.Item1)">@option.Item2</option>}</select></label><label>Dimensão<input name="Dimension" value="@Model.Query.Dimension" /></label><label>Plano vinculado<select name="HasPlan"><option value="">Todos</option><option value="true" selected="@(Model.Query.HasPlan==true)">Com plano</option><option value="false" selected="@(Model.Query.HasPlan==false)">Sem plano</option></select></label><label>Ordenação<select name="Sort"><option value="">Mais recentes</option><option value="title" selected="@(Model.Query.Sort=="title")">Título</option><option value="priority" selected="@(Model.Query.Sort=="priority")">Prioridade</option></select></label></div></fieldset><div class="d-flex gap-2"><button class="valora-button valora-button--primary">Aplicar filtros</button><a class="valora-button valora-button--ghost" href="/Insights">Limpar</a></div></form>
 @if(page.Items.Count==0){<section class="valora-card empty-state"><h2>@(page.Total==0?"Nenhum insight disponível":"Nenhum resultado para estes filtros")</h2><p>@(page.Total==0?"Gere uma análise a partir de um resultado consolidado. Nada será aprovado automaticamente.":"Altere ou limpe os filtros para consultar outros registros.")</p></section>}
 else{<section class="valora-card table-responsive"><table class="table"><thead><tr><th>Insight</th><th>Diagnóstico / dimensão</th><th>Prioridade / confiança</th><th>Revisão</th><th>Planos</th><th>Data</th><th>Próxima ação</th></tr></thead><tbody>@foreach(var row in page.Items){var x=row.Insight;var status=x.Status switch{AiInsightStatuses.PendingReview=>"Pendente de revisão",AiInsightStatuses.Approved=>"Aprovado",AiInsightStatuses.Rejected=>"Rejeitado",AiInsightStatuses.ConvertedToAction=>"Encaminhado para execução",_=>x.Status};<tr><td><strong>@x.Title</strong><br/><small>@x.Summary</small></td><td>@(row.DiagnosticName??"Diagnóstico sem nome disponível")<br/><small>@(x.RelatedDimension??"Sem dimensão")</small></td><td>@x.Priority<br/><small>Confiança: @x.ConfidenceLevel</small></td><td><span class="badge">@status</span>@if(x.Status==AiInsightStatuses.PendingReview&&!canReview){<br/><small>Sem permissão para revisar</small>}</td><td>@row.PlanCount total<br/><small>@row.ActivePlanCount ativo(s), @row.ClosedPlanCount encerrado(s)</small></td><td>@x.CreatedAt.ToString("dd/MM/yyyy")</td><td><a class="valora-button" asp-action="Details" asp-route-id="@x.Id" asp-route-returnUrl="@Model.CurrentUrl">@(x.Status==AiInsightStatuses.PendingReview&&canReview?"Analisar e revisar":"Consultar detalhe")</a></td></tr>}</tbody></table></section>}
 @if(page.TotalPages>1){<nav aria-label="Paginação"><span>Página @page.Page de @page.TotalPages</span> @if(page.Page>1){<a class="valora-button" asp-route-Page="@(page.Page-1)" asp-route-Search="@Model.Query.Search" asp-route-Status="@Model.Query.Status" asp-route-Priority="@Model.Query.Priority" asp-route-Dimension="@Model.Query.Dimension" asp-route-HasPlan="@Model.Query.HasPlan" asp-route-Sort="@Model.Query.Sort">Anterior</a>} @if(page.HasNext){<a class="valora-button" asp-route-Page="@(page.Page+1)" asp-route-Search="@Model.Query.Search" asp-route-Status="@Model.Query.Status" asp-route-Priority="@Model.Query.Priority" asp-route-Dimension="@Model.Query.Dimension" asp-route-HasPlan="@Model.Query.HasPlan" asp-route-Sort="@Model.Query.Sort">Próxima</a>}</nav>}
</main>
