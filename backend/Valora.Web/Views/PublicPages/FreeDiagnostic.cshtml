@{ Layout = "_PublicLayout"; ViewData["Title"] = "Diagnóstico gratuito"; }
<section class="section diagnostic-section" data-page="public-diagnostic">
  <div class="container-public two-col">
    <div>
      <p class="eyebrow">Diagnóstico gratuito</p>
      <h1>Comece sua avaliação Valora Insight</h1>
      <p class="lead">Uma jornada guiada, com LGPD antes das respostas, progresso por dimensão, escala clara de 1 a 5 e envio protegido contra duplo clique.</p>
      <div class="diagnostic-progress" aria-label="Progresso por dimensão"><span></span></div>
      <form class="form-public" data-free-diagnostic-form data-prevent-double-submit>
        <div class="public-card"><h2>1. Consentimento LGPD</h2><p>Usaremos seus dados somente para processar o diagnóstico, enviar a devolutiva e permitir contato solicitado.</p><label><input type="checkbox" name="lgpdConsent" required> Li e aceito o tratamento para esta finalidade.</label></div>
        <label>Nome da organização<input name="organizationName" autocomplete="organization" required></label>
        <label>E-mail corporativo<input name="email" type="email" autocomplete="email" required></label>
        <div class="survey-question"><h3>Exemplo de escala</h3><p>1 = inicial, 5 = alta maturidade.</p><div class="scale-grid" role="group" aria-label="Escala de 1 a 5"><button type="button">1</button><button type="button">2</button><button type="button">3</button><button type="button">4</button><button type="button">5</button></div></div>
        <p class="empty-state" data-friendly-error hidden>Não foi possível enviar agora. Revise os campos ou tente novamente em instantes.</p>
        <button class="btn-public primary" type="submit" data-loading-text="Enviando diagnóstico...">Iniciar diagnóstico</button>
      </form>
    </div>
    <div class="public-card"><h2>Fluxo</h2><ol><li>LGPD e dados mínimos</li><li>Progresso por dimensão</li><li>Perguntas legíveis</li><li>Resultado após envio</li><li>Certificado, e-mail e WhatsApp</li></ol></div>
  </div>
</section>
@section Scripts { <script src="/js/public/public-survey.js"></script> }
