@model Valora.Web.Models.ViewModels.AdminUsersViewModel
@{ ViewData["Title"] = "Usuários"; }
<section class="valora-page">
    <partial name="_PageHeader" model="@(new Valora.Web.Models.PageHeaderViewModel("Usuários", Model.OrganizationName is null ? "Perfis, papéis e situação de acesso." : $"Pessoas da organização {Model.OrganizationName}.", "Admin Hub"))" />
    @if (TempData["AdminNotice"] is string adminNotice) { <div class="alert alert-success">@adminNotice</div> }
    <form method="get" class="admin-panel mb-3" role="search">
        <div class="row g-3">
            <div class="col-md-5">
                <label for="user-search">Nome ou e-mail</label>
                <input id="user-search" name="search" value="@Model.Search" class="form-control" />
            </div>
            <div class="col-md-3">
                <label for="user-status">Status</label>
                <select id="user-status" name="status" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var st in new[] { "active", "inactive", "suspended", "locked" }) {
                        <option value="@st" selected="@(st == Model.Status ? "selected" : null)">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button class="btn btn-outline-primary" type="submit">Filtrar</button>
                <a asp-action="CreateUser" class="btn btn-primary">Novo usuário</a>
            </div>
        </div>
    </form>
    @if (Model.Error is not null) {
        <div class="alert alert-danger" role="alert">
            <strong>@Model.Error</strong>
            <div class="mt-2"><a asp-action="Users">Tentar novamente</a></div>
        </div>
    }
    else if (Model.Users.Count == 0) {
        <div class="admin-empty">
            <strong>Nenhum usuário encontrado.</strong>
            <p>Ajuste os filtros ou cadastre um novo usuário. A lista respeita o contexto da organização autenticada.</p>
        </div>
    }
    else {
        <div class="admin-panel table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Telefone</th>
                        <th scope="col">Papéis</th>
                        <th scope="col">Status</th>
                        <th scope="col">Último login</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Users) {
                        <tr>
                            <td><strong>@item.Name</strong><small class="text-muted d-block">@item.Email</small></td>
                            <td>@(string.IsNullOrEmpty(item.Phone) ? "—" : item.Phone)</td>
                            <td>@(string.IsNullOrEmpty(item.Roles) ? "—" : item.Roles)</td>
                            <td><span class="badge text-bg-@(item.Status == "active" ? "success" : "secondary")">@item.Status</span></td>
                            <td>@(item.LastLoginAt is null ? "—" : item.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td><a asp-action="UserEdit" asp-route-id="@item.Id">Editar</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1) {
            <nav class="mt-3 d-flex align-items-center gap-2" aria-label="Paginação de usuários">
                @if (Model.Page > 1) { <a class="btn btn-outline-secondary btn-sm" asp-action="Users" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)">Anterior</a> }
                <span>Página @Model.Page de @Model.TotalPages (@Model.TotalItems usuários)</span>
                @if (Model.Page < Model.TotalPages) { <a class="btn btn-outline-secondary btn-sm" asp-action="Users" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)">Próxima</a> }
            </nav>
        }
    }
</section>
