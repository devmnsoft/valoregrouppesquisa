@model Valora.Web.Models.ViewModels.IntelligenceModuleViewModel
@{ ViewData["Title"] = Model.ProductName; }
<main class="v9-page intelligence-module" data-intelligence-module data-module="@Model.Slug" data-resource="@Model.ApiResource">
  <nav class="v9-breadcrumb" aria-label="Navegação estrutural"><a href="/Intelligence">Inteligência Organizacional</a><span aria-hidden="true">/</span><span>@Model.ProductName</span></nav>
  <header class="v9-hero v9-hero--executive intelligence-module__hero">
    <div><p class="eyebrow">@Model.Eyebrow</p><h1>@Model.ProductName</h1><p>@Model.Title</p><small>@Model.Description</small></div>
    <span class="valora-badge valora-badge--gold">Plano @Model.RequiredPlan</span>
  </header>
  <section class="intelligence-module__grid" aria-label="Capacidades do módulo">
    @foreach (var capability in Model.Capabilities) { <article class="valora-card"><span class="intelligence-module__marker" aria-hidden="true"></span><h2>@capability</h2><p>Leitura rastreável a partir de @Model.DataSource.ToLowerInvariant().</p></article> }
  </section>
  <section class="valora-card intelligence-module__workspace" aria-live="polite">
    <div class="v9-section-title"><div><p class="eyebrow">Leitura atual</p><h2>Dados reais da organização</h2></div><a class="valora-button" href="/Intelligence">Abrir central completa</a></div>
    @if (Model.Slug == "evidence")
    {
      <div class="intelligence-module__evidence-summary" data-evidence-summary hidden>
        <article class="valora-card"><small>Total de evidências</small><strong data-summary-total>0</strong></article>
        <article class="valora-card"><small>Evidências mapeadas</small><strong data-summary-mapped>0</strong></article>
        <article class="valora-card"><small>Pendências de mapeamento</small><strong data-summary-pending>0</strong></article>
        <article class="valora-card"><small>Confiança média</small><strong data-summary-confidence>0%</strong></article>
      </div>
      <div class="intelligence-module__filters" data-evidence-filters>
        <label>Diagnóstico <input class="valora-input" type="search" placeholder="ID do diagnóstico" data-filter-survey /></label>
        <label>Resposta <input class="valora-input" type="search" placeholder="ID da resposta" data-filter-response /></label>
        <label>Conceito <input class="valora-input" type="search" placeholder="Filtrar conceito" data-filter-concept /></label>
        <label>Métrica <input class="valora-input" type="search" placeholder="Filtrar métrica" data-filter-metric /></label>
        <label>Índice <input class="valora-input" type="search" placeholder="Ex.: IGO" data-filter-index /></label>
        <label>Mapeamento <select class="valora-input" data-filter-mapping><option value="">Todos</option><option value="mapped">Mapeado</option><option value="pending">Pendência metodológica</option></select></label>
      </div>
    }
    <div class="valora-skeleton" data-module-loading>Consultando evidências autorizadas…</div>
    <div class="valora-alert valora-alert--danger" data-module-error hidden></div>
    <div data-module-content hidden></div>
    <div class="valora-empty" data-module-empty hidden><h3>Sem evidência suficiente</h3><p>@Model.EmptyMessage</p><small>As informações disponíveis ainda não permitem concluir essa análise com segurança. Recomenda-se ampliar a coleta de evidências antes de definir uma causa ou prioridade.</small></div>
  </section>
  <dialog class="valora-card intelligence-module__drawer" data-module-drawer><button class="valora-button valora-button--ghost" type="button" data-drawer-close>Fechar</button><div data-drawer-content></div></dialog>
  @if (Model.Slug == "power-bi") { <aside class="valora-alert"><strong>Integração Power BI™ preparada para configuração.</strong> Nenhum dado será enviado sem autorização.</aside> }
  @if (Model.Slug == "benchmark") { <aside class="valora-alert"><strong>Benchmark Externo.</strong> Ainda não existem dados suficientes para gerar um Benchmark Externo confiável para este perfil organizacional.</aside> }
  @if (Model.Slug == "executive-report") { <aside class="valora-alert"><strong>Exportação PDF ainda não configurada neste ambiente.</strong> O preview executivo está disponível.</aside> }
  @if (Model.Slug == "one-on-one") { <aside class="valora-alert"><strong>Limite ético.</strong> Este módulo estrutura conversas e compromissos; não classifica pessoas, não realiza avaliação psicológica e não recomenda decisões de carreira.</aside> }
</main>
@section Scripts { <script src="/js/pages/intelligence-module.js"></script> }
