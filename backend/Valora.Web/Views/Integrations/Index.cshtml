@model string
@{ ViewData["Title"] = "Integrações Enterprise"; }
<section class="page-shell" data-integrations-page data-module="@(Model ?? "catalog")">
  <header class="page-header">
    <div>
      <nav aria-label="Breadcrumb"><a href="/Dashboard">Visão geral</a> <span aria-hidden="true">/</span> <span>Enterprise</span></nav>
      <p class="eyebrow">Valora Insight™ · Enterprise</p>
      <h1>Central de Integrações</h1>
      <p>Conexões, credenciais e exportações autorizadas em uma operação governada e auditável.</p>
    </div>
    <span class="badge text-bg-dark">Enterprise</span>
  </header>

  <div class="alert alert-info" role="status">Credenciais e secrets nunca são exibidos nesta central. Conectores sem configuração real permanecem identificados como <strong>não configurados</strong>.</div>
  <div class="alert alert-warning d-none" data-enterprise-locked>Este recurso faz parte dos módulos Enterprise do Valora Insight™.</div>
  <div class="enterprise-loading" data-loading><span class="spinner-border" aria-hidden="true"></span><span>Consultando configurações autorizadas…</span></div>
  <div class="alert alert-danger d-none" data-error>Não foi possível consultar as integrações. Use o correlationId exibido no suporte.</div>
  <div class="row g-4" data-integration-grid aria-live="polite"></div>
</section>

<template id="integration-card-template">
  <article class="col-12 col-md-6 col-xl-4">
    <div class="card h-100 shadow-sm"><div class="card-body d-flex flex-column gap-3">
      <div class="d-flex justify-content-between align-items-start"><div><p class="eyebrow mb-1">Conector governado</p><h2 class="h5 mb-0" data-name></h2></div><span class="badge" data-status></span></div>
      <p class="text-muted mb-0" data-description></p>
      <dl class="row small mb-0"><dt class="col-6">Plano</dt><dd class="col-6 text-end" data-plan></dd><dt class="col-6">Última execução</dt><dd class="col-6 text-end" data-last-run></dd></dl>
      <a class="btn btn-outline-primary mt-auto" data-open>Ver configuração</a>
    </div></div>
  </article>
</template>
@section Scripts { <script src="/js/pages/integrations-page.js" asp-append-version="true"></script> }
