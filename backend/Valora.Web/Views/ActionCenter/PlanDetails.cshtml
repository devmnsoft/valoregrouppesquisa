@model Valora.Web.Controllers.ActionPlanDetailsViewModel

@{
    ViewData["Title"]=Model.Plan.Title;
}

<main class="valora-page"><header class="leadership-hero"><div><p class="eyebrow">@Model.Plan.Priority · @Model.Plan.Status</p><h1>@Model.Plan.Title</h1><p>@Model.Plan.Summary</p></div></header><section class="leadership-grid"><article class="valora-card"><h2>Evidência</h2><p>@Model.Plan.EvidenceSummary</p><h3>Resultado esperado</h3><p>@Model.Plan.ExpectedOutcome</p></article><article class="valora-card"><h2>Progresso</h2><progress max="100" value="@Model.Plan.ProgressPercent"></progress><strong>@Model.Plan.ProgressPercent%</strong></article></section><section class="valora-card"><h2>Ações</h2>@foreach(var i in Model.Items){<p><a href="/ActionCenter/Items/Details/@i.Id">@i.Title</a> · @i.Status · @i.ProgressPercent%</p>}</section></main>
