<header class="topbar valora-topbar" data-admin-topbar>
  <a href="/Dashboard" class="topbar-brand" aria-label="Valora Group"><img src="/img/brand/valora-logo-full.svg" alt="" onerror="this.hidden=true;this.nextElementSibling.hidden=false"><span class="brand-fallback-text" hidden>Valora Group</span></a>
  <button class="icon-button mobile-navigation-trigger" type="button" data-action="toggle-navigation" aria-expanded="false" aria-controls="mobileSidebar" aria-label="Abrir navegação" title="Abrir navegação">
    <valora-icon name="menu" size="22" decorative="true" />
  </button>
  <div class="topbar-title">
    <nav class="valora-breadcrumbs" aria-label="Breadcrumb"><a href="/Dashboard">Início</a><span aria-hidden="true">/</span><span aria-current="page">@ViewData["Title"]</span></nav>
    <strong data-page-title>@(ViewData["Title"] ?? "Painel Valora")</strong>
  </div>
  <div class="topbar-actions">
    <a class="icon-button" href="/Help" aria-label="Abrir Central de Ajuda" title="Como usar o Valora Insight"><valora-icon name="help-circle" size="20" decorative="true" /></a>
    <details class="quick-actions" data-quick-actions>
      <summary class="valora-button valora-button--primary" aria-label="Abrir atalhos rápidos">
        <valora-icon name="plus" size="18" decorative="true" /><span>Criar</span>
      </summary>
      <div class="quick-actions__menu">
        <strong>Atalhos rápidos</strong>
        <a href="/Diagnostics/New"><valora-icon name="activity" size="18" decorative="true" /><span><b>Novo diagnóstico</b><small>Configure público e período</small></span></a>
        <a href="/Forms/Create"><valora-icon name="file-text" size="18" decorative="true" /><span><b>Novo formulário</b><small>Estruture dimensões e perguntas</small></span></a>
        <a href="/Reports"><valora-icon name="chart-radar" size="18" decorative="true" /><span><b>Gerar relatório</b><small>Consolide uma leitura executiva</small></span></a>
        <a href="/ActionCenter/Plans/Create"><valora-icon name="check-circle" size="18" decorative="true" /><span><b>Novo plano de ação</b><small>Defina responsáveis e prazos</small></span></a>
      </div>
    </details>
    <details class="organization-switcher" data-organization-switcher>
      <summary aria-label="Selecionar organização">
        <valora-icon name="building" size="18" decorative="true" />
        <span><small>Organização</small><strong data-current-organization>Nenhuma organização selecionada</strong></span>
        <valora-icon name="chevron-down" size="16" decorative="true" />
      </summary>
      <div class="organization-switcher__menu">
        <strong>Contexto de trabalho</strong>
        <p>Escolha uma organização para carregar identidade visual, dados e recursos do plano.</p>
        <a class="valora-button valora-button--primary" href="/Organization">Buscar organizações</a>
        <form method="post" action="/Organization/Select">
          @Html.AntiForgeryToken()
          <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
          <button class="valora-button valora-button--ghost" type="submit">Limpar seleção</button>
        </form>
      </div>
    </details>
    <button class="search-trigger" type="button" data-action="open-command-palette" aria-haspopup="dialog">
      <valora-icon name="search" size="20" decorative="true" /><span>Buscar</span><kbd>Ctrl K</kbd>
    </button>
    <button class="icon-button" type="button" data-action="toggle-notifications" aria-expanded="false" aria-controls="notificationPanel" aria-label="Abrir notificações" title="Notificações">
      <valora-icon name="bell" size="20" decorative="true" /><span class="notification-count" data-notification-count hidden>0</span>
    </button>
    <button class="user-menu-trigger" type="button" data-action="toggle-user-menu" aria-expanded="false" aria-controls="userMenu">
      <span class="user-avatar" data-user-initials aria-hidden="true">VA</span><span class="user-summary"><strong data-user-name>Conta Valora</strong><small data-user-profile>Perfil</small></span><valora-icon name="chevron-down" size="16" decorative="true" />
    </button>
  </div>
</header>
<section class="topbar-popover notification-panel" id="notificationPanel" data-notification-panel hidden aria-label="Notificações">
  <header><strong>Notificações</strong><button type="button" data-action="read-all">Marcar todas como lidas</button></header>
  <div data-notification-list><p class="empty-message">Você está em dia. Novas atualizações aparecerão aqui.</p></div>
</section>
<nav class="topbar-popover user-menu" id="userMenu" data-user-menu hidden aria-label="Menu da conta">
  <div class="user-menu-identity"><strong data-user-name>Carregando conta…</strong><small data-user-email>Carregando e-mail…</small><span data-current-organization>Carregando organização…</span><span data-current-plan>Carregando plano…</span></div>
  <a href="/Users/Profile">Meu perfil</a><a href="/Settings">Preferências</a><a href="/Users?tab=sessions">Sessões</a>
  <button id="logoutButton" type="button"><valora-icon name="log-out" size="18" decorative="true" /> Sair</button>
</nav>
<dialog class="command-palette" data-command-palette aria-labelledby="commandPaletteTitle">
  <form method="dialog" class="command-palette-frame"><header><valora-icon name="search" size="20" decorative="true" /><label id="commandPaletteTitle" class="visually-hidden" for="globalSearch">Busca global</label><input id="globalSearch" type="search" placeholder="Pesquisar pesquisas, resultados, usuários…" autocomplete="off" data-global-search><button class="icon-button" value="cancel" aria-label="Fechar busca" title="Fechar"><valora-icon name="x" size="20" decorative="true" /></button></header><div class="command-results" data-command-results><p>Digite para pesquisar em todos os módulos permitidos.</p></div><footer><span>↑↓ navegar</span><span>Enter abrir</span><span>Esc fechar</span></footer></form>
</dialog>
