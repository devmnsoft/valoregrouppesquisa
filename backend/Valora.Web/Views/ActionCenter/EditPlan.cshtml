@model Valora.Web.Controllers.ActionPlanEditPageViewModel
@{ ViewData["Title"]="Editar plano"; }
<main class="valora-page action-center-page">
 <partial name="_PageHeader" model="@(new PageHeaderViewModel("Editar plano", "Atualize somente os campos operacionais permitidos.", "Valora Action™", Model.Plan.Title, Array.Empty<PageHeaderAction>()))" />
 <form method="post" class="valora-card action-form" data-unsaved-form data-prevent-double-submit>
  @Html.AntiForgeryToken()
  <input asp-for="Command.Version" type="hidden"><input asp-for="Command.CommandId" type="hidden"><input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
  <div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div>
  <p>Origem, identidade, autoria, evidências e vínculos metodológicos serão preservados.</p>
  <label asp-for="Command.Title">Título <span aria-hidden="true">*</span></label><input asp-for="Command.Title" required><span asp-validation-for="Command.Title"></span>
  <label asp-for="Command.Summary">Descrição <span aria-hidden="true">*</span></label><textarea asp-for="Command.Summary" required></textarea><span asp-validation-for="Command.Summary"></span>
  <label asp-for="Command.Priority">Prioridade <span aria-hidden="true">*</span></label><select asp-for="Command.Priority" required><option value="critical">Crítica</option><option value="high">Alta</option><option value="medium">Média</option><option value="low">Baixa</option></select><span asp-validation-for="Command.Priority"></span>
  <label asp-for="Command.ExpectedOutcome">Resultado esperado <span aria-hidden="true">*</span></label><textarea asp-for="Command.ExpectedOutcome" required></textarea><span asp-validation-for="Command.ExpectedOutcome"></span>
  <partial name="_FormActions" model="@(new FormActionsViewModel("Salvar alterações", "Cancelar", Model.ReturnUrl))" />
 </form>
</main>
<script src="~/js/form-submit-state.js" asp-append-version="true"></script><script src="~/js/unsaved-form.js" asp-append-version="true"></script>
