{
  "Demo": {
    "SeedEnabled": false
  },
  "Valora": {
    "Environment": "production"
  },
  "App": {
    "EnvironmentName": "Production",
    "EnableDemoSeed": false,
    "EnableDetailedErrors": false,
    "MaintenanceModeEnabled": false,
    "MaintenanceBlockPublicResponses": true,
    "MaintenanceBlockAdminWrites": true
  },
  "Security": { "RequireHttps": true, "CorsPolicy": "ValoraWebCors", "AllowedOrigins": [] },
  "Cors": { "AllowedOrigins": [] },
  "WebApp": {
    "EnableDebugLogs": false
  }
}
