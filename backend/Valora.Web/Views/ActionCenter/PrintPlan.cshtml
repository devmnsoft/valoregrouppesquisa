@model Valora.Web.Controllers.ActionPlanPrintViewModel
@using Valora.Application.ActionCenter
@{ Layout = null; }
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Resumo — @Model.Plan.Title</title><style>body{font:12pt system-ui;color:#17212b;margin:2cm}h1{font-size:22pt}h2{margin-top:1.5rem;border-bottom:1px solid #999}dl{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem}dt{font-weight:700}dd{margin:0}table{width:100%;border-collapse:collapse}th,td{border:1px solid #999;padding:.45rem;text-align:left;vertical-align:top}tr{break-inside:avoid}.no-print{margin-bottom:1rem}@media print{body{margin:0}.no-print{display:none}h2{break-after:avoid}table{font-size:10pt}}@page{margin:1.5cm}</style></head><body>
<nav class="no-print"><button type="button" onclick="window.print()">Imprimir</button> <a href="/ActionCenter/Plans/Details/@Model.Plan.Id">Voltar ao plano</a></nav>
<header><h1>@Model.Plan.Title</h1><p>Resumo final do plano · emitido em @Model.IssuedAt.ToString("dd/MM/yyyy HH:mm 'UTC'")</p></header>
<h2>Contexto</h2><dl><div><dt>Origem</dt><dd>@Model.Plan.OriginType</dd></div><div><dt>Responsável</dt><dd>@(Model.Plan.OwnerName??"Sem responsável")</dd></div><div><dt>Situação final</dt><dd>@ActionStatuses.Label(Model.Plan.Status)</dd></div><div><dt>Criação</dt><dd>@Model.Plan.CreatedAt.ToString("dd/MM/yyyy")</dd></div><div><dt>Prazo planejado</dt><dd>@(Model.Plan.DueAt?.ToString("dd/MM/yyyy")??"Não informado")</dd></div><div><dt>Início real</dt><dd>@(Model.Plan.ActualStartedAt?.ToString("dd/MM/yyyy HH:mm")??"Não registrado")</dd></div><div><dt>Encerramento</dt><dd>@(Model.Plan.CompletedAt?.ToString("dd/MM/yyyy HH:mm")??"Não registrado")</dd></div></dl>
<h2>Resultado e evidências</h2><h3>Resultado esperado</h3><p>@Model.Plan.ExpectedOutcome</p><h3>Resultado alcançado</h3><p>@(Model.Plan.CompletionResult??"Não se aplica ao cancelamento")</p><h3>Evidência</h3><p>@(Model.Plan.CompletionEvidence??Model.Plan.EvidenceSummary)</p>
<h2>Atividades visíveis</h2><table><thead><tr><th>Atividade</th><th>Situação</th><th>Responsável</th><th>Prazo</th></tr></thead><tbody>@foreach(var item in Model.Activities.Items){<tr><td>@item.Title</td><td>@ActionStatuses.Label(item.Status)</td><td>@(item.ResponsibleName??"Sem responsável")</td><td>@(item.DueAt?.ToString("dd/MM/yyyy")??"—")</td></tr>}</tbody></table>@if(Model.Activities.Total>Model.Activities.Items.Count){<p><strong>Recorte:</strong> somente as primeiras @Model.Activities.Items.Count atividades autorizadas são exibidas.</p>}
<h2>Histórico relevante</h2><table><thead><tr><th>Data</th><th>Evento</th><th>Autoria</th><th>Justificativa</th></tr></thead><tbody>@foreach(var item in Model.History.Items){<tr><td>@item.ChangedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Operation</td><td>@(item.AuthorName??"Não identificada")</td><td>@(item.Reason??"—")</td></tr>}</tbody></table>@if(Model.History.Total>Model.History.Items.Count){<p><strong>Recorte:</strong> o histórico completo permanece consultável no plano.</p>}
</body></html>
