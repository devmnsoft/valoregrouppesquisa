@model Valora.Web.Models.ViewModels.BenchmarksViewModel
@{Layout="_Layout";}<partial name="_BenchmarkShell" model="Model" /><div class="bm-grid" style="margin-top:16px">@foreach(var x in Model.Insights){<article class="bm-card"><span class="bm-badge">@x.InsightType · confiança @x.ConfidenceLevel</span><h3>@x.Title</h3><p>@x.Description</p><small>Evidência: @x.EvidenceSummary</small><p>Recomendação sujeita à decisão humana.</p></article>}@if(Model.Insights.Count==0){<article class="bm-card"><h2>Sem inferências inventadas</h2><p>Insights surgirão apenas após uma comparação disponível e sustentada por evidência.</p></article>}</div>
