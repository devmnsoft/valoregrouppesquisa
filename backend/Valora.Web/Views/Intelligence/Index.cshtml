@{ ViewData["Title"] = "Inteligência Organizacional"; }
<main class="v9-page" data-intelligence-page>
  <header class="v9-hero v9-hero--executive"><div><p class="eyebrow">Inteligência Organizacional</p><h1>Evidências que orientam a evolução</h1><p>Leitura determinística, agregada e segura da maturidade da organização.</p></div><button class="valora-button valora-button--primary" data-generate>Gerar nova leitura</button></header>
  <nav class="v9-intelligence-nav" aria-label="Central de inteligência"><a href="#dashboard">Dashboard Valora™</a><a href="#heatmap">Heatmap Valora™</a><a href="#evolution">Evolution Valora™</a><a href="#journey">Journey Valora™</a><a href="#action">Action Valora™</a><a href="#report">Executive Report™</a></nav>
  <div class="valora-alert valora-alert--danger" data-error hidden></div><div class="valora-alert" data-warning hidden></div>
  <section id="dashboard" class="v9-kpis" aria-label="Indicadores executivos"><article><span>Maturidade</span><strong data-kpi="maturity">—</strong><small>Índice consolidado</small></article><article><span>Confiança</span><strong data-kpi="confidence">—</strong><small>Robustez da evidência</small></article><article><span>Gap estrutural</span><strong data-kpi="gap">—</strong><small>Distância entre dimensões</small></article><article><span>Evidências</span><strong data-kpi="evidence">—</strong><small>Registros agregados</small></article></section>
  <div class="v9-executive-grid"><section id="heatmap" class="valora-card"><p class="eyebrow">Heatmap Valora™</p><h2>Dimensões organizacionais</h2><div data-heatmap class="v9-attention"></div></section><section class="valora-card"><p class="eyebrow">Método Valora</p><h2>Da evidência à evolução</h2><p>Observação → Evidências → Correlação → Causa provável → Impacto → Prioridade → Plano de evolução</p><small>Hipóteses são explicitadas e nenhuma resposta individual ou dado pessoal é exibido.</small></section></div>
  <section><p class="eyebrow">Leitura executiva</p><h2>Insights</h2><div data-insights class="v9-executive-grid"></div></section>
  <div class="v9-executive-grid"><section id="evolution" class="valora-card"><p class="eyebrow">Valora Evolution™</p><h2>Evolução longitudinal</h2><div class="v9-evolution" data-evolution></div></section><section id="action" class="valora-card"><div class="v9-section-title"><div><p class="eyebrow">Valora Action™</p><h2>Prioridades em execução</h2></div><button class="valora-button" data-open-action>Nova ação</button></div><div data-actions class="v9-action-list"></div></section></div>
  <section id="journey" class="valora-card"><div class="d-flex justify-content-between align-items-center"><div><p class="eyebrow">Valora Journey™</p><h2>Marcos de evolução</h2></div><button class="valora-button" data-open-journey>Novo marco</button></div><ol class="v9-timeline" data-journey></ol></section>
  <section id="report" class="valora-card v9-report"><div><p class="eyebrow">Executive Report™</p><h2>Leitura executiva rastreável</h2><p>O relatório consolida exclusivamente indicadores e evidências disponíveis, com alertas explícitos de insuficiência.</p></div><a class="valora-button" href="/Reports">Acessar relatórios</a></section>
  <dialog data-journey-modal class="valora-card"><form data-journey-form><h2>Registrar marco</h2><label>Título<input class="form-control" name="title" maxlength="160" required></label><label>Descrição<textarea class="form-control" name="description" maxlength="1000" required></textarea></label><label>Tipo<select class="form-select" name="eventType"><option value="milestone">Marco</option><option value="action">Ação</option><option value="cycle">Novo ciclo</option></select></label><div class="d-flex gap-2 mt-3"><button class="valora-button valora-button--primary">Salvar</button><button type="button" class="valora-button" data-close-journey>Cancelar</button></div></form></dialog>
  <dialog data-action-modal class="v9-dialog"><button type="button" class="v9-dialog__close" data-close-action aria-label="Fechar">×</button><form data-action-form><p class="eyebrow">Valora Action™</p><h2>Ação baseada em evidências</h2><div class="v9-form-grid"><label>Título<input name="title" required maxlength="180"></label><label>Capacidade afetada<input name="capability" required maxlength="120"></label></div><label>Descrição<textarea name="description" required maxlength="1500"></textarea></label><label>Justificativa baseada em evidências<textarea name="evidenceJustification" required minlength="20" maxlength="2000"></textarea></label><div class="v9-form-grid"><label>Prioridade<select name="priority"><option value="critical">Crítica</option><option value="high">Alta</option><option value="medium">Média</option><option value="low">Baixa</option></select></label><label>Complexidade<select name="complexity"><option value="low">Baixa</option><option value="medium">Média</option><option value="high">Alta</option></select></label><label>Responsável<input name="owner"></label><label>Patrocinador executivo<input name="executiveSponsor"></label><label>Prazo<input name="dueAt" type="date"></label><label>Indicadores vinculados<input name="indicators" required></label></div><label>Resultado esperado<textarea name="expectedResult" required></textarea></label><label>Critério de conclusão<textarea name="completionCriteria" required></textarea></label><button class="valora-button valora-button--primary">Criar ação rastreável</button></form></dialog>
</main>
@section Scripts { <script src="/js/api/intelligence-api.js"></script><script src="/js/pages/intelligence-page.js"></script> }
