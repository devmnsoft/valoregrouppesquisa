@{ ViewData["Title"] = "Agendar One-on-One"; }
<main class="valora-page leadership-page"><nav class="v9-breadcrumb"><a href="/OneOnOne">One-on-One</a><span>/</span><span>Agendar</span></nav><header class="leadership-hero"><div><p class="eyebrow">Nova conversa</p><h1>Agendar sessão</h1><p>Comece pelo propósito e pela evidência organizacional que justifica o acompanhamento.</p></div></header><form class="valora-card leadership-form"><div class="form-grid"><label>Líder<select class="valora-input" required><option value="">Selecione um líder</option></select></label><label>Participante<select class="valora-input" required><option value="">Selecione um participante</option></select></label><label class="span-2">Título<input class="valora-input" required maxlength="200" placeholder="Ex.: Alinhamento do ciclo trimestral"></label><label class="span-2">Objetivo<textarea class="valora-input" required rows="3" placeholder="Qual contexto, evidência ou diagnóstico sustenta esta conversa?"></textarea></label><label>Data e horário<input class="valora-input" type="datetime-local" required></label><label>Duração (minutos)<input class="valora-input" type="number" min="15" max="480" value="60" required></label><label class="span-2">Pauta inicial<textarea class="valora-input" rows="5" placeholder="Observações, evidências e temas organizacionais"></textarea></label></div><aside class="valora-alert"><strong>Privacidade:</strong> notas privadas ficam separadas das informações reportáveis e exigem permissão específica.</aside><div class="form-actions"><a class="valora-button valora-button--ghost" href="/OneOnOne">Cancelar</a><button class="valora-button valora-button--primary" type="submit">Agendar sessão</button></div></form></main>
