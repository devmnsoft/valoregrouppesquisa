@model IReadOnlyList<Valora.Application.OneOnOne.OneOnOneSessionDto>
@{ViewData["Title"]="Sessões One-on-One";}<main class="valora-page"><header class="leadership-hero"><div><p class="eyebrow">Desenvolvimento contínuo</p><h1>Sessões One-on-One</h1></div><a class="btn btn-primary" href="/OneOnOne/Sessions/Create">Criar sessão</a></header><section class="valora-card table-responsive">@if(Model.Count==0){<div class="valora-empty"><h3>Nenhuma sessão ainda</h3><p>Comece com um objetivo claro e uma conversa segura.</p></div>}else{<table class="table"><thead><tr><th>Líder</th><th>Participante</th><th>Data</th><th>Status</th><th>Compromissos</th><th>Evolução</th></tr></thead><tbody>@foreach(var s in Model){<tr><td><a href="/OneOnOne/Sessions/Details/@s.Id">@s.LeaderName</a></td><td>@s.ParticipantName</td><td>@(s.ScheduledAt?.ToString("dd/MM/yyyy HH:mm")??"A definir")</td><td><span class="badge status-@s.Status">@s.Status</span></td><td>@s.PendingCommitments</td><td>@(s.Summary??"Em construção")</td></tr>}</tbody></table>}</section></main>
