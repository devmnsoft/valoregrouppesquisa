@model Valora.Web.Controllers.ActionPlanDetailsViewModel
@{ ViewData["Title"]=Model.Plan.Title; var p=Model.Plan; var page=Model.Activities; var command=Model.Command; var canCreate=Model.CanCreate && p.Status is "draft" or "proposed" or "approved" or "in_execution"; string Label(string value)=>value switch { "draft"=>"Rascunho", "proposed"=>"Proposto", "approved"=>"Aprovado", "in_execution"=>"Em execução", "completed"=>"Concluído", "canceled"=>"Cancelado", "pending"=>"Pendente", "in_progress"=>"Em execução", "blocked"=>"Bloqueada", "overdue"=>"Atrasada", "critical"=>"Crítica", "high"=>"Alta", "medium"=>"Média", "low"=>"Baixa", _=>value }; }
<main class="valora-page action-detail">
 <partial name="_PageHeader" model="@(new PageHeaderViewModel(p.Title,p.Summary,"Valora Action™",$"{Label(p.Priority)} · {Label(p.Status)}",new[]{new PageHeaderAction("Voltar aos planos","/ActionCenter/Plans",Icon:"arrow-left")}))" />
 <partial name="_PageHelpPanel" model="@(new PageHelpPanelViewModel("Como usar","Acompanhe o resultado pelas atividades autorizadas e registre entregas verificáveis.",new[]{"Revise prazo e responsável.","Crie atividades com evidência.","Acompanhe bloqueios antes do prazo."}))" />
 <div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-validation-summary></div>
 <section class="action-summary-grid"><article class="valora-card"><h2>Resumo do plano</h2><dl class="action-facts"><div><dt>Situação</dt><dd>@Label(p.Status)</dd></div><div><dt>Responsável</dt><dd>@(p.OwnerName??"Sem responsável")</dd></div><div><dt>Prazo</dt><dd>@(p.DueAt?.ToString("dd/MM/yyyy")??"A definir")</dd></div><div><dt>Progresso operacional</dt><dd><progress max="100" value="@p.ProgressPercent"></progress> @p.ProgressPercent%</dd></div></dl></article><article class="valora-card"><h2>Resultado e evidência</h2><h3>Resultado esperado</h3><p>@p.ExpectedOutcome</p><h3>Evidência de origem</h3><p>@p.EvidenceSummary</p></article></section>
 <section class="valora-card"><div class="section-heading"><div><h2>Atividades</h2><p>@page.Total compromisso(s) autorizado(s) neste plano.</p></div>@if(canCreate){<button type="button" class="valora-button valora-button--primary" data-action-dialog-open="create-item-dialog">Nova atividade</button>}</div>@if(page.Items.Count==0){<p>Nenhuma atividade nesta página.</p>}else{<div class="table-responsive"><table class="valora-table"><thead><tr><th>Atividade</th><th>Situação</th><th>Prioridade</th><th>Responsável</th><th>Progresso</th><th>Prazo</th></tr></thead><tbody>@foreach(var i in page.Items){<tr><td><a href="/ActionCenter/Items/Details/@i.Id">@i.Title</a></td><td>@Label(i.Status)</td><td>@Label(i.Priority)</td><td>@(i.ResponsibleName??"Sem responsável")</td><td>@i.ProgressPercent%</td><td>@(i.DueAt?.ToString("dd/MM/yyyy")??"A definir")</td></tr>}</tbody></table></div>}<nav class="pagination" aria-label="Páginas das atividades"><a aria-disabled="@(page.Page<=1)" href="?itemPage=@(page.Page-1)">Anterior</a><span>Página @page.Page de @Math.Max(1,((page.Total + page.PageSize - 1) / page.PageSize))</span><a aria-disabled="@(page.Page>=((page.Total + page.PageSize - 1) / page.PageSize))" href="?itemPage=@(page.Page+1)">Próxima</a></nav></section>
</main>
@if(canCreate){<dialog id="create-item-dialog" class="action-detail" aria-labelledby="create-item-title"><form method="post" action="/ActionCenter/Items/Create">@Html.AntiForgeryToken()<h2 id="create-item-title">Nova atividade em @p.Title</h2><label for="title">Título *</label><input id="title" name="Title" minlength="3" maxlength="180" value="@command?.Title" required><label for="description">Descrição</label><textarea id="description" name="Description" maxlength="2000">@command?.Description</textarea><label for="outcome">Resultado esperado *</label><textarea id="outcome" name="ExpectedOutcome" minlength="3" maxlength="2000" required>@command?.ExpectedOutcome</textarea><label for="evidence">Evidência inicial *</label><textarea id="evidence" name="EvidenceSummary" minlength="3" maxlength="2000" required>@command?.EvidenceSummary</textarea><div class="form-grid"><label for="responsible">Responsável<select id="responsible" name="ResponsibleUserId"><option value="">Sem responsável</option>@foreach(var owner in Model.ResponsibleOptions){<option value="@owner.Id" selected="@(command?.ResponsibleUserId==owner.Id)">@owner.Title</option>}</select></label><label for="priority">Prioridade *<select id="priority" name="Priority"><option value="medium">Média</option><option value="high">Alta</option><option value="critical">Crítica</option><option value="low">Baixa</option></select></label><label for="due">Prazo<input id="due" name="DueAt" type="date" value="@command?.DueAt?.ToString("yyyy-MM-dd")"></label></div><input type="hidden" name="ActionPlanId" value="@p.Id"><input type="hidden" name="OriginType" value="manual"><div class="dialog-actions"><button type="button" data-dialog-close>Cancelar</button><button class="valora-button valora-button--primary">Criar atividade</button></div></form></dialog>}
<script src="~/js/action-center.js" asp-append-version="true" data-open-dialog="@Model.OpenDialog"></script>
